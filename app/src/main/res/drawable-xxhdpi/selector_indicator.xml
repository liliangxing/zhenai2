<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#b5b4b8"/>
            <size
                android:height="@dimen/indicator_size"
                android:width="@dimen/indicator_size"/>
        </shape>
    </item>
    <item android:state_activated="false">
        <shape android:shape="oval">
            <solid android:color="#dad9db"/>
            <size
                android:height="@dimen/indicator_size_default"
                android:width="@dimen/indicator_size_default"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#dad9db"/>
            <size
                android:height="@dimen/indicator_size_default"
                android:width="@dimen/indicator_size_default"/>
        </shape>
    </item>
</selector>
