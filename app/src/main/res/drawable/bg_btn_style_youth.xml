<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff4c82"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:left="50dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp"/>
            <gradient
                android:startColor="#7b4cfc"
                android:endColor="#ff4c82"
                android:angle="-90"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#391f4d"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
