    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <solid android:color="#9362e5"/>
        </shape>
    </item>
    <item android:drawable="@drawable/guide_point_select_mode_unselected_btn"/>
</selector>
