<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:dither="true"
            android:shape="oval">
            <solid android:color="@android:color/white"/>
            <stroke
                android:width="10dp"
                android:color="#ffbe85ef"/>
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#ffbe85ef"/>
            <size
                android:height="30dp"
                android:width="30dp"/>
        </shape>
    </item>
</layer-list>
