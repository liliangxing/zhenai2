<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#ff12131a"
        android:gravity="start|top"
        android:id="@+id/question_edit_text"
        android:background="@color/transparent"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="187dp"
        android:hint="快来跟大家说说你遇到的问题吧（不能少于30个字哦）"
        android:maxLength="500"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="#9d9fa6"
        android:id="@+id/font_num_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question_edit_text"/>
    <View
        android:id="@+id/v_start_line"
        android:background="@color/color_dividing_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_line_height"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/font_num_tv"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_check"
        android:paddingLeft="@dimen/dimen_15dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_start_line">
        <TextView
            android:textSize="15sp"
            android:textColor="#666978"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="匿名"
            android:layout_weight="1"/>
        <Switch
            android:id="@+id/anonymous_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/shape_question_switch_thumb"
            android:track="@drawable/shape_question_switch_rack_selector"
            android:layout_marginStart="@dimen/dimen_10dp"/>
    </LinearLayout>
    <View
        android:background="@color/color_dividing_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_line_height"
        app:layout_constraintTop_toBottomOf="@+id/ll_check"/>
</androidx.constraintlayout.widget.ConstraintLayout>
