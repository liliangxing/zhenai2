<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"/>
    <ImageView
        android:id="@+id/img_brand_icon"
        android:layout_width="@dimen/dp77"
        android:layout_height="@dimen/dp77"
        android:layout_marginTop="@dimen/dp22"
        android:src="@drawable/splash_logo"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:text="@string/app_version_n"
        app:layout_constraintEnd_toEndOf="@+id/img_brand_icon"
        app:layout_constraintStart_toStartOf="@+id/img_brand_icon"
        app:layout_constraintTop_toBottomOf="@+id/img_brand_icon"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_767dff"
        android:gravity="center"
        android:id="@+id/tv_update"
        android:background="@drawable/rect_767dff_stroke_1_r200"
        android:layout_width="@dimen/dp222"
        android:layout_height="@dimen/dp42"
        android:layout_marginTop="@dimen/dp23"
        android:text="@string/version_update"
        app:layout_constraintEnd_toEndOf="@+id/img_brand_icon"
        app:layout_constraintStart_toStartOf="@+id/img_brand_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_version"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="#b3b4b9"
        android:gravity="center_horizontal"
        android:id="@+id/tv_icp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/icp_number_text"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_update"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tv_brand_introduce"
        android:paddingLeft="@dimen/dp27"
        android:paddingRight="@dimen/dp27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp15"
        android:text="@string/brand_introduce"
        android:lineSpacingExtra="5sp"
        android:layout_marginHorizontal="@dimen/dp15"
        android:paddingHorizontal="@dimen/dp27"
        app:layout_constraintTop_toBottomOf="@+id/tv_icp"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_aeafb3"
        android:gravity="center_horizontal"
        android:id="@+id/tv_protocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/tv_phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tv_phone"
        android:paddingTop="@dimen/dp7"
        android:paddingBottom="@dimen/dp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/client_telephone"
        android:layout_above="@+id/tv_copyright"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_copyright"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_aeafb3"
        android:gravity="center_horizontal"
        android:id="@+id/tv_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp1"
        android:layout_marginBottom="@dimen/dp21"
        android:text="@string/copyright"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="3sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
