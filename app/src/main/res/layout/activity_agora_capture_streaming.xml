<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/camera_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/img_voice_type_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/capture_svga_img_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:id="@+id/img_voice_type_bg_shape"
        android:background="@drawable/bg_live_photo_bg_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_head"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/status_bar_height">
            <ImageButton
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/img_switch_camera"
                android:background="@null"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/icon_zalive_start_change"/>
            <ImageButton
                android:id="@+id/img_beauty"
                android:background="@null"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:src="@drawable/icon_zalive_start_skin"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_change_room_type"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_15dp"
                android:text="@string/live_video_before_start_type_video"
                android:shadowColor="#3d000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:drawableLeft="@drawable/icon_zalive_start_room"
                android:drawablePadding="@dimen/dimen_2dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_offline_vip_room_type"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_15dp"
                android:text="@string/offline_vip_room_live_star_page_select_type"
                android:shadowColor="#3d000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:drawableLeft="@drawable/icon_zalive_start_room"
                android:drawablePadding="@dimen/dimen_2dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/img_effect"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:src="@drawable/sv_icon_paster"
                android:onClick="onClickEffect"/>
            <ImageButton
                android:id="@+id/img_back"
                android:background="@null"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="15dp"
                android:src="@drawable/icon_zalive_start_close"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/upload_avatar_view"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="-97dp">
            <ImageView
                android:id="@+id/upload_avatar_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_avatar"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/live_before_avatar_tag"
                android:background="@drawable/live_before_avatar_tag"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:text="上传头像作为封面"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="120dp"
            android:layout_marginRight="20dp">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textColorHint="#80ffffff"
                android:gravity="center"
                android:id="@+id/et_title"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/start_video_title_hint"
                android:maxLength="10"
                android:layout_centerInParent="true"
                android:textCursorDrawable="@null"
                android:layout_marginEnd="15dp"
                android:layout_toStartOf="@+id/tv_random_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/tv_random_title"
                android:background="@drawable/bg_4d000000_retangle_12radio"
                android:visibility="gone"
                android:layout_width="70dp"
                android:layout_height="26dp"
                android:text="@string/random_text"
                android:drawablePadding="3dp"
                android:drawableStart="@drawable/live_video_random_random"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="12dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="21dp"
            android:src="@drawable/icon_live_video_line"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_topics"
            android:paddingLeft="17dp"
            android:paddingRight="17dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="选择热门话题"/>
            <com.zhenai.live.widget.label.SingleCheckableLabelLayout
                android:id="@+id/layout_topics_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/go_mic_tips_layout"
            android:background="@drawable/bg_33000000_retangle_5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/tv_go_mic_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/link_mic_need_agree"
                android:layout_marginStart="15dp"/>
            <Switch
                android:id="@+id/switch_go_mic_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:checked="true"
                android:textOn=""
                android:textOff=""
                android:thumb="@drawable/switch_custom_thumb"
                android:track="@drawable/switch_custom_track_selector"
                android:switchMinWidth="32dp"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_marginEnd="15dp"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white_60"
                android:id="@+id/tv_go_mic_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp"
                android:text="@string/link_mic_need_agree_tips1"
                android:layout_below="@+id/tv_go_mic_title"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
        </RelativeLayout>
        <android.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:id="@+id/start_layout"
            android:layout_width="match_parent"
            android:layout_height="107dp">
            <FrameLayout
                android:id="@+id/btn_start"
                android:background="@drawable/live_video_start"
                android:layout_width="107dp"
                android:layout_height="107dp"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/tv_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zhima_start_video_now"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_change_voice_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背景"
                android:drawableTop="@drawable/icon_live_star_voice_photo"
                android:drawablePadding="@dimen/dimen_3dp"
                android:layout_toRightOf="@+id/btn_start"
                android:layout_centerVertical="true"
                android:layout_marginStart="37dp"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/bottom_text_layout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="28dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zhima_start_video_detail1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#a089f9"
                android:id="@+id/tv_live_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zhima_start_video_detail2"/>
        </LinearLayout>
    </LinearLayout>
    <com.zhenai.business.widget.autosrcoll_banner_listview.AutoScrollBanner
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tip_banner"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="85dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:indicatorSelected="@drawable/banner_select_point"
        app:indicatorUnSelected="@drawable/banner_unselect_point"/>
</FrameLayout>
