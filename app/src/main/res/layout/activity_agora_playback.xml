<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live.widget.SizeObservableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_live_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/live_video_bg"
        android:scaleType="centerCrop"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/live_bg_svga_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="51dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_live_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.live.widget.VideoRoomHeader
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/rankLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="41dp"
                app:layout_constraintTop_toBottomOf="@+id/header_layout">
                <ViewStub
                    android:id="@+id/hour_rank_layout"
                    android:layout="@layout/layout_hour_rank"
                    android:inflatedId="@+id/hour_rank_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginStart="@dimen/dimen_8dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tv_more_recommend_live"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_alignTop="@+id/hour_rank_layout"
                    android:layout_alignBottom="@+id/hour_rank_layout"
                    android:layout_marginEnd="@dimen/dp8"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:background="@drawable/icon_more_recommend_live_left"
                        android:layout_width="17dp"
                        android:layout_height="16dp"/>
                    <TextView
                        android:textSize="@dimen/dimen_12sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:text="@string/live_more_live"
                        android:layout_marginHorizontal="2dp"/>
                    <ImageView
                        android:background="@drawable/icon_arrow_right_2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/rankLayout">
                <com.zhenai.live.live_views.AgoraVideoLayout
                    android:id="@+id/live_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.zhenai.live.live_views.LiveLoadingViewHolder
                        android:id="@+id/audience_loading_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.zhenai.live.live_views.AgoraVideoLayout>
                <com.zhenai.live.widget.LiveVideoWaitMaskView
                    android:id="@+id/mir_empty_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"/>
                <com.zhenai.live.widget.AudienceCloseWindowLayout
                    android:layout_gravity="top"
                    android:id="@+id/audience_close_window_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="top|right"
                    android:background="@drawable/bg_pressed"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:src="@drawable/ic_close"
                    android:onClick="onClickExit"/>
            </RelativeLayout>
            <com.zhenai.live.decorate.widget.LiveFrameLayout
                android:id="@+id/live_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/rlLayout"
                app:layout_constraintTop_toTopOf="@+id/rlLayout"/>
            <com.zhenai.tx_ktv.lrc.widget.LyricsView
                android:id="@+id/live_lrc_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="45dp"
                app:layout_constraintBottom_toBottomOf="@+id/rlLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.zhenai.live.widget.OpenRemindLayout
                android:id="@+id/layout_remind_go_mic"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/rlLayout"
                app:remind_mode="go_mic"/>
            <include
                android:id="@+id/layout_live_video_room_manager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="@+id/rlLayout"
                layout="@layout/layout_live_room_manager"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.zhenai.live.ktv.widget.KTVOperationPanelView
            android:id="@+id/ktv_operation_layout"
            android:background="#341f5d"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@+id/layout_live_view"/>
        <com.zhenai.live.connection.widget.AttachmentPKProgressLayout
            android:id="@+id/attachment_pk_progress_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_below="@+id/ktv_operation_layout"/>
        <com.zhenai.live.danmaku.DanmakuLayout
            android:id="@+id/layout_live_video_danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/attachment_pk_progress_layout"
            app:intercept_recyclerview="true"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/attachment_pk_red_svga_frame"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:layout_alignBottom="@+id/attachment_pk_progress_layout"
            android:layout_centerHorizontal="true"
            app:antiAlias="true"
            app:autoPlay="true"
            app:loopCount="-1"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/attachemnt_svga_frame"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="50dp"
            android:scaleType="fitCenter"
            android:layout_alignTop="@+id/layout_live_view"
            android:layout_alignBottom="@+id/layout_live_view"
            android:layout_centerHorizontal="true"
            app:antiAlias="true"
            app:autoPlay="true"
            app:loopCount="0"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/user_show_frame_layout"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live.emotion.EmotionFooter
        android:layout_gravity="bottom"
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.zhenai.live.widget.ShadowLayout
        android:id="@+id/vice_secret_shadow_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live.focus.FocusGuideLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/layout_focus_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:layout_marginEnd="45dp"/>
    <ViewStub
        android:layout_gravity="start|bottom"
        android:id="@+id/emotionCourse_Recommend"
        android:layout="@layout/layout_emotion_recommend_view"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="49dp"
        android:layout_marginStart="1dp"/>
    <ViewStub
        android:id="@+id/view_stub_midNight_transition"
        android:layout="@layout/layout_mid_night_transition_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live_common.gift.layout.GiftEffectLayout2
        android:id="@+id/layout_live_video_gift_effect_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/view_stub_red_packet_rain_svga_view"
        android:layout="@layout/layout_red_packet_rain_svga_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live.record_screen.RecordScreenLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_live_video_record_screen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iv_bg_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/live_room_bg"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.zhenai.live.widget.SizeObservableFrameLayout>
