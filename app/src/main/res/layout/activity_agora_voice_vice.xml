<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live.widget.SizeObservableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_voice_type_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/live_voice_bg"
        android:scaleType="centerCrop"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/live_bg_svga_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/bg_container_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/img_voice_type_bg_shape"
        android:background="@drawable/bg_live_photo_bg_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/live_video_footer_height">
        <RelativeLayout
            android:id="@+id/rlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp">
            <com.zhenai.live.widget.VideoRoomHeader
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:id="@+id/rankLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:minHeight="41dp"
                android:layout_below="@+id/header_layout">
                <ViewStub
                    android:id="@+id/hour_rank_layout"
                    android:layout="@layout/layout_hour_rank"
                    android:inflatedId="@+id/hour_rank_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginStart="@dimen/dimen_8dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tv_more_recommend_live"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_alignTop="@+id/hour_rank_layout"
                    android:layout_alignBottom="@+id/hour_rank_layout"
                    android:layout_marginEnd="@dimen/dp8"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:background="@drawable/icon_more_recommend_live_left"
                        android:layout_width="17dp"
                        android:layout_height="16dp"/>
                    <TextView
                        android:textSize="@dimen/dimen_12sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:text="@string/live_more_live"
                        android:layout_marginHorizontal="2dp"/>
                    <ImageView
                        android:background="@drawable/icon_arrow_right_2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                </LinearLayout>
            </RelativeLayout>
            <com.zhenai.live.voice.LiveVoiceLayout
                android:id="@+id/live_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rankLayout"
                android:layout_centerHorizontal="true"/>
            <com.zhenai.live.voice.widget.VoiceWaitLayerView
                android:id="@+id/mir_empty_mask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/live_container"
                android:layout_alignBottom="@+id/live_container"
                android:layout_alignParentRight="true"/>
            <com.zhenai.live.widget.AudienceCloseWindowLayout
                android:layout_gravity="top"
                android:id="@+id/audience_close_window_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/live_container"/>
            <com.zhenai.live.widget.OpenRemindLayout
                android:id="@+id/layout_remind_go_mic"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/live_container"
                app:remind_mode="go_mic"/>
            <include
                android:id="@+id/layout_live_video_room_manager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_alignTop="@+id/live_container"
                layout="@layout/layout_live_room_manager"/>
            <ImageView
                android:layout_gravity="top|right"
                android:background="@drawable/bg_pressed"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:src="@drawable/ic_close"/>
            <com.zhenai.tx_ktv.lrc.widget.LyricsView
                android:id="@+id/live_lrc_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginTop="172dp"
                android:layout_alignTop="@+id/live_container"/>
        </RelativeLayout>
        <com.zhenai.live.ktv.widget.KTVOperationPanelView
            android:id="@+id/ktv_operation_layout"
            android:background="#341f5d"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <com.zhenai.live.danmaku.DanmakuLayout
            android:id="@+id/layout_live_video_danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:intercept_recyclerview="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/user_show_frame_layout"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live.emotion.EmotionFooter
        android:layout_gravity="bottom"
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.zhenai.live.widget.ShadowLayout
        android:id="@+id/vice_secret_shadow_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.live.focus.FocusGuideLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/layout_focus_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:layout_marginEnd="45dp"/>
    <com.zhenai.live_common.gift.layout.GiftEffectLayout2
        android:id="@+id/layout_live_video_gift_effect_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/view_stub_red_packet_rain_svga_view"
        android:layout="@layout/layout_red_packet_rain_svga_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_bg_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/live_room_bg"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.zhenai.live.widget.SizeObservableFrameLayout>
