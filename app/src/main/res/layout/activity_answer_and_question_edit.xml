<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/my_concept_of_marriage_title_height"
            android:src="@drawable/bg_my_concept_of_marriage_title"
            android:scaleType="fitXY"/>
        <FrameLayout
            android:id="@+id/layout_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/img_back"
                android:background="@drawable/recommend_search_selector"
                android:src="@drawable/back_icon"
                style="@style/TitleBarLeftIconStyle"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/my_concept_of_marriage"
                style="@style/TitleBarMiddleTextViewStyle"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/layout_all_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/layout_title_bar"
            style="@style/CommonCardLayoutStyle">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bg_answer_watermark"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="2dp"
                android:layout_alignParentEnd="true"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_title_cube"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="14dp"
                    style="@style/InfoCardHeadCubeStyle"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#42475c"
                    android:id="@+id/tv_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="27dp"
                    android:layout_marginTop="27dp"
                    android:layout_marginRight="27dp"
                    android:lineSpacingExtra="4sp"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_custom_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/layout_question"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView
                    android:id="@+id/editTextScrollViewMiddleView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">
                    <EditText
                        android:scrollbarSize="4dp"
                        android:scrollbarThumbVertical="@drawable/infomation_scrollbar_bg"
                        android:textSize="14sp"
                        android:textColor="#666978"
                        android:textColorHint="#a5a5a5"
                        android:gravity="start|top"
                        android:id="@+id/edt_custom_answer"
                        android:background="@drawable/bg_custom_answer_edit_text"
                        android:padding="10dp"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="11dp"
                        android:layout_marginBottom="11dp"
                        android:maxLength="150"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginStart="12.5dp"
                        android:layout_marginEnd="12.5dp"/>
                </com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView>
                <Button
                    android:id="@+id/btn_commit"
                    android:layout_marginBottom="18dp"
                    android:text="@string/commit_answer"
                    style="@style/common_long_btn_style"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
