<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f3f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_aeafb3"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_previous_question"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/previous_question"
            android:drawablePadding="8dp"
            android:paddingStart="28dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_aeafb3"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_question_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.legacy.widget.Space
                android:id="@+id/layout_title_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/status_bar_height"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/img_back"
                android:background="@drawable/go_back_v8"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/layout_title_bar"
                app:layout_constraintStart_toStartOf="@+id/layout_title_bar"
                app:layout_constraintTop_toTopOf="@+id/layout_title_bar"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/color_26273c"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/marriage_views_title"
                app:layout_constraintBottom_toBottomOf="@+id/layout_title_bar"
                app:layout_constraintEnd_toEndOf="@+id/layout_title_bar"
                app:layout_constraintStart_toStartOf="@+id/layout_title_bar"
                app:layout_constraintTop_toTopOf="@+id/layout_title_bar"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/layout_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:minHeight="124dp"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_title_bar">
                <View
                    android:id="@+id/question_bg"
                    android:background="@drawable/bg_emotion_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_26273c"
                    android:id="@+id/tv_question"
                    android:paddingLeft="20dp"
                    android:paddingTop="20dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="40dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintEnd_toEndOf="@+id/question_bg"
                    app:layout_constraintStart_toStartOf="@+id/question_bg"
                    app:layout_constraintTop_toTopOf="@+id/question_bg"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_aeafb3"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/tv_sub_question"
                    android:paddingBottom="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginStart="20dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_title_bar"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_answer_item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_question">
                <com.zhenai.psychology_test.widget.AnswerItemLayoutV2
                    android:id="@+id/layout_answer_item_a"
                    style="@style/AnswerItemStyle"/>
                <com.zhenai.psychology_test.widget.AnswerItemLayoutV2
                    android:id="@+id/layout_answer_item_b"
                    style="@style/AnswerItemStyle"/>
                <com.zhenai.psychology_test.widget.AnswerItemLayoutV2
                    android:id="@+id/layout_answer_item_c"
                    style="@style/AnswerItemStyle"/>
                <com.zhenai.psychology_test.widget.AnswerItemLayoutV2
                    android:id="@+id/layout_answer_item_d"
                    style="@style/AnswerItemStyle"/>
                <com.zhenai.psychology_test.widget.AnswerItemLayoutV2
                    android:id="@+id/layout_answer_item_e"
                    style="@style/AnswerItemStyle"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
