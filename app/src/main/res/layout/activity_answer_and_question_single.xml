<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.common.widget.scroll_view.AnimationScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/my_concept_of_marriage_title_height"
            android:src="@drawable/bg_my_concept_of_marriage_title"
            android:scaleType="fitXY"/>
        <FrameLayout
            android:id="@+id/layout_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/img_back"
                android:background="@drawable/recommend_search_selector"
                android:src="@drawable/back_icon"
                style="@style/TitleBarLeftIconStyle"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/my_concept_of_marriage"
                style="@style/TitleBarMiddleTextViewStyle"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/layout_all_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_title_bar">
            <View
                android:id="@+id/view_layout_question_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/layout_question"
                style="@style/CommonCardLayoutStyle"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_question"
                android:paddingBottom="27dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                style="@style/CommonCardLayoutStyle.NullBackground">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bg_answer_watermark"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="2dp"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/img_title_cube"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="14dp"
                    style="@style/InfoCardHeadCubeStyle"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#42475c"
                    android:id="@+id/tv_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="27dp"
                    android:layout_marginTop="27dp"
                    android:layout_marginRight="27dp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="4sp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#a5a5a5"
                    android:id="@+id/tv_sub_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_question"
                    android:layout_alignStart="@+id/tv_question"
                    android:layout_alignEnd="@+id/tv_question"/>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="-4dp"
                android:layout_below="@+id/layout_question"
                android:layout_marginStart="22dp">
                <com.zhenai.base.widget.DashedLineView
                    android:id="@+id/view_dashed_line"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    app:color="#caadef"
                    app:dashGap="4dp"
                    app:dashWidth="4dp"
                    app:isVertical="true"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/layout_answer_item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marriage_view_single_question_answer_margin_top"
                android:layout_below="@+id/layout_question">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_answer_item_list_inner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zhenai.psychology_test.widget.AnswerItemLayout
                        android:id="@+id/layout_answer_item_a"
                        style="@style/AnswerItemStyle"/>
                    <com.zhenai.psychology_test.widget.AnswerItemLayout
                        android:id="@+id/layout_answer_item_b"
                        style="@style/AnswerItemStyle"/>
                    <com.zhenai.psychology_test.widget.AnswerItemLayout
                        android:id="@+id/layout_answer_item_c"
                        style="@style/AnswerItemStyle"/>
                    <com.zhenai.psychology_test.widget.AnswerItemLayout
                        android:id="@+id/layout_answer_item_d"
                        style="@style/AnswerItemStyle"/>
                    <com.zhenai.psychology_test.widget.AnswerItemLayout
                        android:id="@+id/layout_answer_item_e"
                        style="@style/AnswerItemStyle"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_custom_answer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:layout_below="@+id/layout_answer_item_list"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8970f1"
                    android:layout_gravity="end"
                    android:id="@+id/tv_choose_again"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_again"
                    android:layout_marginEnd="5dp"/>
                <com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView
                    android:id="@+id/editTextScrollViewMiddleView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="#666978"
                        android:textColorHint="#a5a5a5"
                        android:gravity="start|top"
                        android:id="@+id/edt_custom_answer"
                        android:background="@drawable/bg_custom_answer_edit_text"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="11dp"
                        android:layout_marginBottom="11dp"
                        android:maxLength="300"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginStart="12.5dp"
                        android:layout_marginEnd="12.5dp"/>
                </com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView>
                <Button
                    android:id="@+id/btn_commit"
                    android:layout_marginBottom="18dp"
                    android:text="@string/next_question"
                    style="@style/common_long_btn_style"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</com.zhenai.common.widget.scroll_view.AnimationScrollView>
