<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f2f4f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/rect_white_r16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="@dimen/dp5"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/score_default"
            android:background="@drawable/zhima_score_zero_default_image_2"
            android:visibility="visible"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/score_default">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/card_txt"
                android:text="@string/zhima_certify_card_id"
                android:drawableRight="@drawable/icon_identify_pass_2"
                android:drawablePadding="4dp"
                style="@style/Certify_info_style"/>
            <androidx.legacy.widget.Space
                android:layout_width="24dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/age_txt"
                android:text="@string/zhima_certify_age"
                android:drawableRight="@drawable/icon_identify_pass_2"
                android:drawablePadding="4dp"
                style="@style/Certify_info_style"/>
            <androidx.legacy.widget.Space
                android:layout_width="24dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/sex_txt"
                android:text="@string/zhima_certify_sex"
                android:drawableRight="@drawable/icon_identify_pass_2"
                android:drawablePadding="4dp"
                style="@style/Certify_info_style"/>
        </LinearLayout>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:layout_gravity="center_horizontal"
            android:id="@+id/center_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/zhima_certify_suc_txt"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_certify"
            android:background="@drawable/bg_rectangle_767dff_40r_shape"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="60dp"
            android:layout_marginHorizontal="12dp">
            <com.zhenai.common.widget.BoldTextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_certify_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/complete"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/white_80"
                android:gravity="center"
                android:id="@+id/tv_certify_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
