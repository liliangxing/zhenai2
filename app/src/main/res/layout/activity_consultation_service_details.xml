<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_8b76f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.module_emotion.widget.ptr.PtrClassicFrameLayout
        android:id="@+id/pfl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_70dp"
        app:layout_constraintTop_toTopOf="parent">
        <ScrollView
            android:id="@+id/sv_content"
            android:background="@color/color_f2f2f2"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintlayout_content"
                android:paddingBottom="74dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#8b76f9"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@drawable/bg_order_service"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_marginTop="116dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="232dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_right_icon"
                    android:layout_width="@dimen/dimen_100dp"
                    android:layout_height="@dimen/dimen_100dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginRight="@dimen/dimen_25dp"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dimen_17sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_des"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_45dp"
                    android:maxLines="2"
                    app:layout_constraintBottom_toTopOf="@+id/tv_reservation"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/iv_right_icon"
                    app:layout_constraintTop_toTopOf="@+id/iv_right_icon"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_8b76f9"
                    android:gravity="center"
                    android:id="@+id/tv_reservation"
                    android:visibility="gone"
                    android:layout_width="98dp"
                    android:layout_height="@dimen/dimen_25dp"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_right_icon"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_des"
                    app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintlayout_top"
                    android:background="@drawable/bg_round_white_8dp"
                    android:paddingBottom="@dimen/dimen_15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_15dp"
                    android:layout_marginTop="@dimen/dimen_11dp"
                    android:layout_marginRight="@dimen/dimen_15dp"
                    android:layout_marginBottom="@dimen/dimen_15dp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_right_icon">
                    <ImageView
                        android:id="@+id/iv_status"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_60dp"
                        android:layout_marginLeft="@dimen/dimen_15dp"
                        android:layout_marginTop="@dimen/dimen_8dp"
                        android:layout_marginRight="@dimen/dimen_15dp"
                        android:src="@drawable/banner_loading_small"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.zhenai.common.widget.BoldTextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textColor="@color/color_42475c"
                        android:id="@+id/tv_tips_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_15dp"
                        android:layout_marginTop="@dimen/dimen_12dp"
                        android:text="温馨提示"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_status"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/color_666666"
                        android:id="@+id/tv_tips_content"
                        android:paddingTop="@dimen/dimen_5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_15dp"
                        android:layout_marginRight="@dimen/dimen_15dp"
                        android:lineSpacingExtra="@dimen/dimen_3dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_tips_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintlayout_center"
                    android:background="@drawable/bg_round_white_8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_15dp"
                    android:layout_marginTop="@dimen/dimen_11dp"
                    android:layout_marginRight="@dimen/dimen_15dp"
                    android:layout_marginBottom="@dimen/dimen_15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraintlayout_top">
                    <View
                        android:id="@+id/bg_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/il_feeback_phone"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_poster"
                        android:layout_width="@dimen/dimen_50dp"
                        android:layout_height="@dimen/dimen_50dp"
                        android:layout_marginLeft="@dimen/dimen_18dp"
                        android:layout_marginTop="@dimen/dimen_13dp"
                        android:src="@drawable/default_avatar"
                        app:layout_constraintBottom_toTopOf="@+id/il_feeback_phone"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.zhenai.common.widget.BoldTextView
                        android:textSize="@dimen/dimen_18sp"
                        android:textColor="@color/color_42475C"
                        android:id="@+id/tv_teacher_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_10dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_count"
                        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
                        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/color_999999"
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_10dp"
                        android:layout_marginTop="@dimen/dimen_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_poster"
                        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
                        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_name"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/color_999999"
                        android:id="@+id/tv_teacher_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_teacher_name"
                        app:layout_constraintLeft_toRightOf="@+id/tv_teacher_name"
                        app:layout_constraintTop_toTopOf="@+id/tv_teacher_name"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_feeback_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_13dp"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="咨询方式"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_poster"
                        app:leftIconVisible="false"
                        app:righContenteColor="@color/color_333333"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_feeback_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="预约时间"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_feeback_phone"
                        app:leftIconVisible="false"
                        app:righContenteColor="@color/color_333333"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_feeback_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="咨询时长"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_feeback_name"
                        app:leftIconVisible="false"
                        app:righContenteColor="@color/color_333333"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_feeback_agree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="支付金额"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_feeback_time"
                        app:leftIconVisible="false"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintlayout_comment"
                        android:paddingTop="@dimen/dimen_15dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_feeback_agree">
                        <com.zhenai.module_emotion.widget.EmotionItemLayout
                            android:id="@+id/il_comment_agree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:itemArrow="false"
                            app:itemHeight="@dimen/dimen_30dp"
                            app:itemLine="false"
                            app:itemTitleColor="@color/color_666666"
                            app:itemTitleText="满意度调查： "
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:leftIconVisible="false"/>
                        <com.zhenai.module_emotion.widget.StarBar
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/starBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/il_comment_agree"/>
                        <TextView
                            android:textSize="@dimen/dimen_14sp"
                            android:textColor="@color/color_333333"
                            android:id="@+id/tv_comment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_18dp"
                            android:layout_marginTop="@dimen/dimen_16dp"
                            android:layout_marginRight="@dimen/dimen_18dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/starBar"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textColor="@color/color_333333"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_order_info"
                        android:paddingLeft="@dimen/dimen_18dp"
                        android:paddingTop="@dimen/dimen_15dp"
                        android:paddingBottom="@dimen/dimen_5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="订单信息"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/constraintlayout_comment"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_order_number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="订单编号"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_order_info"
                        app:leftIconVisible="false"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_order_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="下单时间"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_order_number"
                        app:leftIconVisible="false"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_confirm_time"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="确认时间"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_order_time"
                        app:leftIconVisible="false"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <com.zhenai.module_emotion.widget.EmotionItemLayout
                        android:id="@+id/il_comment_time"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:itemArrow="false"
                        app:itemHeight="@dimen/dimen_35dp"
                        app:itemLine="false"
                        app:itemTitleColor="@color/color_666666"
                        app:itemTitleText="评价时间"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_confirm_time"
                        app:leftIconVisible="false"
                        app:rightContent=""
                        app:rightContentVisible="true"/>
                    <TextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="#318fec"
                        android:id="@+id/tv_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_18dp"
                        android:layout_marginTop="@dimen/dimen_5dp"
                        android:layout_marginBottom="@dimen/dimen_15dp"
                        android:text="查看《珍爱情感电话咨询服务协议》"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/il_comment_time"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.zhenai.module_emotion.widget.ptr.PtrClassicFrameLayout>
    <FrameLayout
        android:id="@+id/fl_order_bottom_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pfl_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fra_title_container"
        android:background="@color/color_8b76f9"
        android:paddingTop="@dimen/dimen_30dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_70dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_back"
            android:paddingLeft="@dimen/dimen_14dp"
            android:paddingRight="@dimen/dimen_14dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/back_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_avathor_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="订单详情"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_chat"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_35dp"
            android:layout_height="@dimen/dimen_35dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:drawableLeft="@drawable/ic_kefu_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
