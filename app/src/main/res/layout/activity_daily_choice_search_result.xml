<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/white"
    android:paddingBottom="@dimen/dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search"
        android:background="@color/color_dfdfdf"
        android:paddingLeft="@dimen/dimen_10dp"
        android:paddingRight="@dimen/dimen_10dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:layout_marginTop="@dimen/dimen_9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_cancel">
        <ImageView
            android:id="@+id/tv_search_img"
            android:background="@drawable/ic_daily_choice_topic_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/cl_search"
            app:layout_constraintTop_toTopOf="@+id/cl_search"/>
        <EditText
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_333333"
            android:textColorHint="@color/color_999999"
            android:ellipsize="end"
            android:id="@+id/et_search"
            android:background="@null"
            android:paddingRight="@dimen/dimen_10dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dimen_4dp"
            android:hint="@string/please_input_key_word"
            android:cursorVisible="true"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            app:layout_constraintLeft_toRightOf="@+id/tv_search_img"
            app:layout_constraintRight_toLeftOf="@+id/iv_clear"/>
        <ImageView
            android:id="@+id/iv_clear"
            android:background="@drawable/del_icon"
            android:visibility="invisible"
            android:layout_width="@dimen/dimen_19dp"
            android:layout_height="@dimen/dimen_19dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_search_img"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_search_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_bcbcbc"
        android:id="@+id/tv_cancel"
        android:paddingLeft="@dimen/dimen_15dp"
        android:paddingTop="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="@+id/cl_search"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_search"/>
    <androidx.core.widget.NestedScrollView
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_50dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_search">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_search_result"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingTop="@dimen/dimen_32dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:paddingBottom="@dimen/dimen_10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="搜索结果"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rl_search_classify"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_search_result"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rl_search_result"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_search_result"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_999999"
                android:gravity="center_horizontal"
                android:id="@+id/tv_default"
                android:paddingTop="@dimen/dimen_15dp"
                android:paddingBottom="@dimen/dimen_15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_60dp"
                android:text="无匹配内容"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_search_result"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/color_666666"
                android:id="@+id/tv_search_recommend"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingTop="@dimen/dimen_32dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:paddingBottom="@dimen/dimen_10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分类搜索"
                app:layout_constraintTop_toBottomOf="@+id/rl_search_result"/>
            <com.zhenai.business.emotion.view.CustomTagListView
                android:id="@+id/tag_classify_search"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingTop="@dimen/dimen_10dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:paddingBottom="@dimen/dimen_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:emotion_orientation="horizontal"
                app:horizontalSpacing="@dimen/dimen_10dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_tag"
                app:verticalSpacing="@dimen/dimen_10dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rl_classify_search"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
