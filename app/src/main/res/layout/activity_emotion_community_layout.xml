<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/header_layout"
        android:background="@drawable/bg_emotion_community_title"
        android:layout_width="120dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="14sp"
            android:textColor="@color/color_42475c"
            android:gravity="center"
            android:id="@+id/default_btn"
            android:background="@drawable/bg_emotion_community_title_select_shape"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp2"
            android:text="默认"
            android:layout_weight="1"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="14sp"
            android:textColor="@color/color_666978"
            android:gravity="center"
            android:id="@+id/hot_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp2"
            android:text="热门"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.zhenai.login.widget.NoScrollHorizontalViewPager
        android:id="@+id/view_pager_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"/>
    <ImageView
        android:id="@+id/img_publish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:src="@drawable/icon_publish_moment"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
