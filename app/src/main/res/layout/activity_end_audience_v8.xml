<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/bg_end_live_activity_v8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_live_video_end_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/live_video_endpage_close"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/dimen_12dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_live_video_end_audience"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_22sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直播结束"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/white_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="关注Ta，第一时间收到直播通知"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/shape_white_13"/>
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_live_video_end_anchor_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/white_90"
                android:id="@+id/tv_live_video_end_anchor_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="#767dff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/btn_live_video_end_talk"
                    android:background="@drawable/live_video_watch_income_bg_v8"
                    android:layout_width="112dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="@dimen/dimen_7dp"
                    android:text="私聊"/>
                <CheckBox
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/cb_live_video_end_subscribe"
                    android:background="@drawable/live_video_end_subscribe_selector_v8"
                    android:layout_width="112dp"
                    android:layout_height="44dp"
                    android:checked="false"
                    android:button="@null"
                    android:text="关注"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white_90"
                android:gravity="center"
                android:id="@+id/tv_violation_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp12"
                android:lineSpacingExtra="@dimen/dp3"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white_90"
                android:id="@+id/tv_violation_desc"
                android:background="@drawable/shape_26273c_radius16_bg"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp20"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp12"
                android:lineSpacingExtra="@dimen/dp3"
                android:layout_marginHorizontal="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp20"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/layout_live_video_end_impression"
            android:background="@drawable/shape_26273c_radius16_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/dimen_12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintBottom_toTopOf="@+id/sv_live_video_end_daemon_v8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginBottom="22dp">
                <TextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/white_90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/daemon_impression_text"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_impression_edit"
                    android:background="@drawable/icon_audience_end_edit_impress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
            <com.zhenai.base.widget.scroll_view.MaxHeightScrollView
                android:id="@+id/sv_live_video_end_daemon_v8"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:maxHeight="140dp">
                <com.zhenai.business.widget.label_layout.LabelLayout
                    android:id="@+id/label_live_video_end_daemon_impression_v8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:auto_select_effect="false"/>
            </com.zhenai.base.widget.scroll_view.MaxHeightScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/layout_live_video_end_recommend"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            layout="@layout/layout_live_video_end_recommend_v8"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_live_video_end_feedback"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            layout="@layout/layout_live_video_end_feedback_v8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/payment_guaid"
            android:background="@drawable/live_free_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_64dp"
            android:layout_marginTop="@dimen/dimen_64dp"
            android:layout_marginBottom="54dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/dimen_12dp">
            <ImageView
                android:id="@+id/free_live_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/live_free_icon"
                android:adjustViewBounds="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textStyle="bold"
                android:textColor="@color/white_90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/free_live_title"
                app:layout_constraintStart_toEndOf="@+id/free_live_icon"
                app:layout_constraintTop_toTopOf="@+id/free_live_icon"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textStyle="bold"
                android:textColor="@color/white_80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:text="@string/free_live_tips"
                app:layout_constraintBottom_toBottomOf="@+id/free_live_icon"
                app:layout_constraintStart_toEndOf="@+id/free_live_icon"/>
            <ImageView
                android:id="@+id/free_live_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_free_button"
                android:layout_marginEnd="@dimen/dimen_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ViewStub
            android:id="@+id/viewstub_live_end_footer"
            android:layout="@layout/viewstub_live_end_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_20dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
