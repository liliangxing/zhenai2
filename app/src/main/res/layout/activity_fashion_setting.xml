<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_show_my_fashion"
        android:layout_width="match_parent"
        android:layout_height="98dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_show_my_fashion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/show_my_fashion"
            android:layout_marginStart="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_end"
            android:visibility="invisible"
            android:layout_width="@dimen/dimen_1dp"
            android:layout_height="1dp"
            android:layout_marginEnd="55dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#7f818d"
            android:id="@+id/tv_show_my_fashion_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/show_my_fashion_tips"
            android:lineSpacingExtra="4dp"
            android:layout_marginEnd="15dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="@+id/tv_show_my_fashion"
            app:layout_constraintRight_toLeftOf="@+id/view_end"
            app:layout_constraintTop_toBottomOf="@+id/tv_show_my_fashion"/>
        <Switch
            android:id="@+id/switch_show_my_fashion"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:checked="true"
            android:thumb="@drawable/switch_fashion_show_thumb"
            android:track="@drawable/switch_fashion_show_selector"
            android:layout_marginEnd="15dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="#0f221c33"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="98dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_show_other_fashion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/show_other_fashion"
            android:layout_marginStart="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_end2"
            android:visibility="invisible"
            android:layout_width="@dimen/dimen_1dp"
            android:layout_height="1dp"
            android:layout_marginEnd="55dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#7f818d"
            android:id="@+id/tv_show_other_fashion_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/show_other_fashion_tips"
            android:lineSpacingExtra="4dp"
            android:layout_marginEnd="15dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="@+id/tv_show_other_fashion"
            app:layout_constraintRight_toLeftOf="@+id/view_end2"
            app:layout_constraintTop_toBottomOf="@+id/tv_show_other_fashion"/>
        <Switch
            android:id="@+id/switch_show_other_fashion"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:checked="true"
            android:thumb="@drawable/switch_fashion_show_thumb"
            android:track="@drawable/switch_fashion_show_selector"
            android:layout_marginEnd="15dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
