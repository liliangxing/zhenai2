<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_common_dialog_v8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/gradientBg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:text="@string/version_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6C6D75"
        android:gravity="center_horizontal"
        android:id="@+id/update_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dimen_24dp"
        android:text="@string/force_update_app_tips2"
        android:lineSpacingExtra="6dp"
        android:layout_marginHorizontal="@dimen/dimen_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <Button
        android:id="@+id/btn_update"
        android:background="@drawable/bg_rectangle_767dff_22r_shape"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dimen_24dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginRight="@dimen/dimen_24dp"
        android:text="@string/update"
        android:layout_marginHorizontal="@dimen/dimen_24dp"
        app:layout_constraintTop_toBottomOf="@+id/update_tip"
        style="@style/common_long_btn_style_8.0_no_shadow"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_767dff"
        android:gravity="center"
        android:id="@+id/btn_quit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dimen_24dp"
        android:layout_marginRight="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        android:text="@string/quit"
        android:layout_marginHorizontal="@dimen/dimen_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_update"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
