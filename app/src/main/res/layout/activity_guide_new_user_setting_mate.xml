<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_mate"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ff414253"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:text="@string/new_user_mate_condition"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaeaeae"
            android:id="@+id/tv_title_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:text="@string/new_user_mate_condition_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_age"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="38dp"
            android:layout_marginTop="@dimen/dimen_50dp"
            android:button="@null"
            android:text="年龄"
            app:layout_constraintEnd_toStartOf="@+id/tv_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_hint"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_height"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="@dimen/dimen_50dp"
            android:button="@null"
            android:text="身高"
            app:layout_constraintEnd_toStartOf="@+id/tv_monthly_income"
            app:layout_constraintStart_toEndOf="@+id/tv_age"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_hint"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_monthly_income"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="@dimen/dimen_50dp"
            android:layout_marginRight="38dp"
            android:button="@null"
            android:text="月收入"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_height"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_hint"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_educational"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="38dp"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:button="@null"
            android:text="学历"
            app:layout_constraintEnd_toStartOf="@+id/tv_marital_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_age"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_marital_status"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:button="@null"
            android:text="婚姻状况"
            app:layout_constraintEnd_toStartOf="@+id/tv_not_required"
            app:layout_constraintStart_toEndOf="@+id/tv_educational"
            app:layout_constraintTop_toBottomOf="@+id/tv_age"/>
        <CheckBox
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@drawable/guide_point_select_new_user_item_text_color"
            android:gravity="center"
            android:id="@+id/tv_not_required"
            android:background="@drawable/guide_point_select_new_user_item_bg"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:layout_marginRight="38dp"
            android:button="@null"
            android:text="没有要求"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_marital_status"
            app:layout_constraintTop_toBottomOf="@+id/tv_age"/>
        <Button
            android:textSize="@dimen/dimen_15sp"
            android:textColor="#ffffff"
            android:id="@+id/btn_continue"
            android:background="@drawable/common_long_btn_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="140dp"
            android:layout_marginRight="25dp"
            android:text="继续"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_not_required"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.login.widget.NoScrollHorizontalViewPager
        android:id="@+id/view_pager_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
