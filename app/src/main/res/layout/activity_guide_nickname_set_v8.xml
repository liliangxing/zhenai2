<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_guide_nickname_set_v8_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="32sp"
            android:textColor="@color/color_191C32"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/guide_set_nickname_hint_2"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_191C32"
            android:id="@+id/title_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/profile_finish_welcom_to_zhenai"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.zhenai.login.widget.InputItemLayoutV8
            android:id="@+id/set_nick_name"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/dp54"
            android:layout_marginStart="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_8dp"
            app:inputContentHintV8="@string/guide_set_nickname_hint"
            app:inputContentSizeV8="@dimen/dimen_18sp"
            app:inputMaxLengthV8="16"
            app:inputPaddingEndV8="6dp"
            app:inputPaddingStartV8="@dimen/dimen_20dp"
            app:inputRightIconVisibilityV8="true"
            app:layout_constraintEnd_toStartOf="@+id/changeBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tip"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/white"
            android:id="@+id/changeBtn"
            android:tag="binding_2"
            android:background="@drawable/bg_rectangle_ff707095_28r_shape"
            android:paddingLeft="@dimen/dimen_21dp"
            android:paddingTop="@dimen/dimen_15dp"
            android:paddingRight="@dimen/dimen_21dp"
            android:paddingBottom="@dimen/dimen_15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_next"
            android:layout_marginEnd="24dp"
            android:paddingHorizontal="@dimen/dimen_21dp"
            android:paddingVertical="@dimen/dimen_15dp"
            app:layout_constraintBottom_toBottomOf="@+id/set_nick_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/set_nick_name"
            app:layout_constraintTop_toTopOf="@+id/set_nick_name"/>
        <Button
            android:id="@+id/check_nick_name_btn"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp48"
            android:text="@string/start_zhenai"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/set_nick_name"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
