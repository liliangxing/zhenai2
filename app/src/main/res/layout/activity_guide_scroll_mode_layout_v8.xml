<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32sp"
            android:textColor="@color/color_26273C"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/title_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.zhenai.login.login_intercept_guide.widget.No3dChoicePickerView
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/wheelView"
            android:layout_width="match_parent"
            android:layout_height="241dp"
            android:layout_marginTop="21dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tip"
            app:layout_constraintVertical_bias="0"/>
        <View
            android:id="@+id/view_space"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            app:layout_constraintTop_toBottomOf="@+id/wheelView"/>
        <Button
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_quickly_location"
            android:padding="@dimen/dimen_18dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:text="@string/quickly_location"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintTop_toBottomOf="@+id/view_space"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
        <Button
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide_enter_button"
            android:padding="@dimen/dimen_18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:text="@string/continue_go"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintTop_toBottomOf="@+id/btn_quickly_location"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
