<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="30sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/tv_go2face_cert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:text="@string/go2_1v1_server"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/tv_go2face_cert_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:layout_marginRight="24dp"
            android:lineSpacingExtra="@dimen/dimen_3dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_go2face_cert"/>
        <ImageView
            android:id="@+id/iv_cert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="37dp"
            android:src="@drawable/icon_1v1_server"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="37dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_go2face_cert_tip"/>
        <Button
            android:enabled="true"
            android:id="@+id/btn_add_wechat"
            android:padding="@dimen/dimen_18dp"
            android:layout_marginTop="43dp"
            android:text="@string/click_to_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_cert"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
