<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_help_and_feedback_0"
    android:background="#f3f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <com.zhenai.common.widget.ListItemLayout
            android:id="@+id/layout_online_client"
            android:tag="binding_1"
            android:background="@drawable/rectangle_ffffff_radius_12_top"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            app:arrowIcon="@drawable/icon_enter"
            app:contentColor="#ff8162"
            app:contentMarginRight="16dp"
            app:contentSize="12sp"
            app:lineMarginLeft="19dp"
            app:lineMarginRight="18dp"
            app:lineVisibility="true"
            app:paddingLeft="19dp"
            app:paddingRight="19dp"
            app:titleColor="@color/color_26273C"
            app:titleSize="16sp"
            app:titleText="@string/online_client"/>
        <com.zhenai.common.widget.ListItemLayout
            android:id="@+id/layout_feedback"
            android:tag="binding_2"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            app:arrowIcon="@drawable/icon_enter"
            app:contentColor="#ff8162"
            app:contentMarginRight="16dp"
            app:contentSize="12sp"
            app:lineMarginLeft="19dp"
            app:lineMarginRight="18dp"
            app:lineVisibility="true"
            app:paddingLeft="19dp"
            app:paddingRight="19dp"
            app:titleColor="@color/color_26273C"
            app:titleSize="16sp"
            app:titleText="@string/opinion_feedback"/>
        <com.zhenai.common.widget.ListItemLayout
            android:id="@+id/layout_report_bad_information"
            android:tag="binding_3"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            app:arrowIcon="@drawable/icon_enter"
            app:contentColor="#ff8162"
            app:contentMarginRight="16dp"
            app:contentSize="12sp"
            app:lineMarginLeft="19dp"
            app:lineMarginRight="18dp"
            app:lineVisibility="true"
            app:paddingLeft="19dp"
            app:paddingRight="19dp"
            app:titleColor="@color/color_26273C"
            app:titleSize="16sp"
            app:titleText="@string/report_bad_information"/>
        <com.zhenai.common.widget.ListItemLayout
            android:id="@+id/layout_mark"
            android:tag="binding_4"
            android:background="@drawable/rectangle_ffffff_radius_12_bottom"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            app:arrowIcon="@drawable/icon_enter"
            app:contentColor="#ff8162"
            app:contentMarginRight="16dp"
            app:contentSize="12sp"
            app:contentText="@string/mark_tips"
            app:lineVisibility="false"
            app:paddingLeft="19dp"
            app:paddingRight="19dp"
            app:titleColor="@color/color_26273C"
            app:titleSize="16sp"
            app:titleText="@string/mark_za"/>
    </LinearLayout>
</ScrollView>
