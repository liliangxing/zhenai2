<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live.widget.SizeObservableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_content"
    android:background="@drawable/bg_zalive_hn_match_shape"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.live.hong_niang_match_vip.widget.HnMatchVIPHnLeaveInfoView
                android:id="@+id/hn_leave_info_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.live.hong_niang_match_vip.widget.HnMatchVIPMaskView
                android:id="@+id/mir_mask_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="75dp"
                android:layout_marginStart="@dimen/dimen_8dp"
                android:layout_marginEnd="@dimen/dimen_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.live.hong_niang_match_vip.widget.HnMatchVIPLiveLayout
                android:id="@+id/live_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="75dp"
                android:layout_marginStart="@dimen/dimen_8dp"
                android:layout_marginEnd="@dimen/dimen_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.live.widget.VideoRoomHeader
                android:id="@+id/header_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="140dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.live.hong_niang_match_vip.widget.HnMatchVipMicCountDownTimeLayout
                android:id="@+id/count_down_timer"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_64dp"
                android:layout_marginStart="7dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_container"/>
            <include
                android:id="@+id/layout_live_video_room_manager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="145dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_layout"
                layout="@layout/layout_live_room_manager"/>
            <include
                android:id="@+id/layout_live_video_room_manager_announce"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="145dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_layout"
                layout="@layout/layout_live_video_room_manager_announce"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/btn_view_this_room_info"
                android:background="@drawable/bg_hn_match_anchor_invite_send_gift_shape"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="@string/offline_vip_this_room_meeting_info"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_container"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/btn_invite_go_mic"
                android:background="@drawable/bg_hn_match_anchor_invite_send_gift_shape"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_64dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/live_container"/>
            <ImageView
                android:id="@+id/img_close"
                android:background="@drawable/bg_pressed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:src="@drawable/ic_close"
                app:layout_constraintBottom_toTopOf="@+id/live_container"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.zhenai.live.danmaku.DanmakuLayout
            android:id="@+id/layout_live_video_danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.zhenai.live.footer.HnMatch7Footer
        android:layout_gravity="bottom"
        android:id="@+id/footer_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.zhenai.live_common.gift.layout.GiftEffectLayout2
        android:id="@+id/layout_live_video_gift_effect_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.zhenai.live.widget.SizeObservableFrameLayout>
