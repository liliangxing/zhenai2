<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.legacy.widget.Space
        android:id="@+id/title_space"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/status_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:background="@drawable/go_back_v8"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_space"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/housekeeper_preemptive_interaction"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintEnd_toEndOf="@+id/title_space"
        app:layout_constraintStart_toStartOf="@+id/title_space"
        app:layout_constraintTop_toTopOf="@+id/title_space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group_item"
        android:background="@drawable/rectangle_ffffff_radius_8"
        android:paddingTop="14dp"
        android:paddingBottom="17dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:minHeight="97dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_space">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_26273c"
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toTopOf="@+id/item_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/img_item_about"
            android:layout_width="@dimen/dp28"
            android:layout_height="@dimen/dp28"
            android:src="@drawable/ic_setting_about"
            app:layout_constraintBottom_toBottomOf="@+id/item_title"
            app:layout_constraintStart_toEndOf="@+id/item_title"
            app:layout_constraintTop_toTopOf="@+id/item_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_6c6d75"
            android:id="@+id/item_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="@dimen/dp3"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_title"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/item_switch"
            android:background="@drawable/bg_switch_style_v8"
            android:layout_width="54dp"
            android:layout_height="29dp"
            android:checked="false"
            android:thumb="@android:color/transparent"
            android:track="@android:color/transparent"
            android:switchMinWidth="54dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
