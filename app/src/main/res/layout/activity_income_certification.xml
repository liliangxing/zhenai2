<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.RadioImageView
        android:id="@+id/headerBg"
        android:background="@drawable/bg_income_certification_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        app:height_weight="247"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:width_weight="375"/>
    <View
        android:id="@+id/contentBg"
        android:background="@drawable/bg_dialog_ffffff_30"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp207"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/certificationLayout"
        android:background="@drawable/bg_education_certification"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp88"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toTopOf="@+id/contentBg"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_2_tax_app_to_certify_income"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/certificationLayout"
        app:layout_constraintStart_toStartOf="@+id/certificationLayout"
        app:layout_constraintTop_toTopOf="@+id/certificationLayout"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right_go_2_education_certification"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/certificationLayout"
        app:layout_constraintEnd_toEndOf="@+id/certificationLayout"
        app:layout_constraintTop_toTopOf="@+id/certificationLayout"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_767dff"
        android:id="@+id/certification_cost_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/certificationLayout"/>
    <FrameLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="44dp"
            android:src="@drawable/icon_back_black_and_white_circle_bg"
            android:paddingStart="12dp"
            android:paddingEnd="@dimen/dimen_15dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/income_certification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="53dp"
            android:text="@string/income_certification"
            android:lineSpacingMultiplier="1.2"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
