<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.legacy.widget.Space
        android:id="@+id/title_space"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/status_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:background="@drawable/go_back_v8"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintStart_toStartOf="@+id/title_space"
        app:layout_constraintTop_toTopOf="@+id/title_space"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/income_certification"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintEnd_toEndOf="@+id/title_space"
        app:layout_constraintStart_toStartOf="@+id/title_space"
        app:layout_constraintTop_toTopOf="@+id/title_space"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_space">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/company_layout"
                android:background="@drawable/bg_ffffff_16_radius_rectangle"
                android:paddingTop="@dimen/dp21"
                android:paddingBottom="@dimen/dp21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp13"
                android:paddingEnd="@dimen/dp16">
                <com.zhenai.common.widget.BoldTextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/color_26273c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/job_company_show_setting"
                    android:layout_marginStart="@dimen/dp3"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/color_6c6d75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="@string/job_company_show_setting_tips"
                    android:layout_marginStart="@dimen/dp3"/>
                <GridLayout
                    android:id="@+id/company_grid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp13"
                    android:columnCount="7"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/month_salary_layout"
                android:background="@drawable/bg_ffffff_16_radius_rectangle"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp21"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp125"
                android:paddingHorizontal="@dimen/dp16">
                <com.zhenai.common.widget.BoldTextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textColor="@color/color_26273c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/month_salary_show_setting"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/color_6c6d75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp16"
                    android:text="@string/month_salary_show_setting_tips"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/bg_btn_767dff_r28_shape"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp55"
        android:layout_marginLeft="@dimen/dp36"
        android:layout_marginRight="@dimen/dp36"
        android:layout_marginBottom="@dimen/dp46"
        android:text="@string/sure"
        android:layout_marginHorizontal="@dimen/dp36"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
