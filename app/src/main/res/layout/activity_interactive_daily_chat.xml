<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="vertical"
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/btn_unlock_msg"
        android:background="@drawable/bg_26273b_rectangle_62_radius"
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:layout_marginLeft="49dp"
        android:layout_marginRight="49dp"
        android:layout_marginBottom="67dp"
        android:text="@string/unlock_all_msg"
        android:drawableStart="@drawable/icon_interactive_daily_unlock_msg"
        android:paddingStart="70dp"
        android:paddingEnd="70dp"
        android:layout_marginHorizontal="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/scroll_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_arrow_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_interactive_daily_arrow_up"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/tv_scroll_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_next_page"
            android:layout_marginStart="24dp"/>
    </FrameLayout>
    <androidx.legacy.widget.Space
        android:id="@+id/title_space"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back"
        android:background="@drawable/go_back_v8"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_space"/>
    <RelativeLayout
        android:id="@+id/title_layout"
        android:background="@drawable/bg_ffffff_rectangle_18_radius"
        android:layout_width="160dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_space">
        <Button
            android:id="@+id/btn_left"
            android:background="@drawable/icon_interactive_daily_left_arrow_selector"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="16sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_right"
            android:layout_toEndOf="@+id/btn_left"/>
        <Button
            android:enabled="false"
            android:id="@+id/btn_right"
            android:background="@drawable/icon_interactive_daily_right_arrow_selector"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
