<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/rect_white_r16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            style="@style/CommonCardLayoutStyle">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/color_6c6d75"
                android:textColorHint="@color/color_aeafb3"
                android:gravity="start|top"
                android:id="@+id/edt"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:hint="@string/hints_heart_word"
                android:lines="8"
                android:maxLength="1500"
                android:layout_marginHorizontal="16dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="15dp">
                <TextView
                    android:textColor="@color/color_aeafb3"
                    android:layout_gravity="end"
                    android:id="@+id/tv_num"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_margin="0dp"
                    android:text="0/1500"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/CommonEditTextInputNumTextStyle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffadb1ff"
                    android:ellipsize="end"
                    android:id="@+id/tv_ai_content_tag"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/content_create_by_ai"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_num"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_num"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_aeafb3"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:text="@string/tips_heart_word_default"
            android:lineSpacingExtra="7dp"
            android:layout_marginHorizontal="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_8b76f9"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_standard"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginTop="24dp"
            android:text="@string/tips_heart_word_failure_click"/>
    </LinearLayout>
    <com.zhenai.business.business.zhenxiaoai.main.ZhenxiaoaiView
        android:id="@+id/view_zhenxiaoai"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
