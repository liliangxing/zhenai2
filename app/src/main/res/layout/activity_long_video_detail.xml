<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.lib.media.player.widget.VideoView
        android:id="@+id/video_view_record"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/img_video_first_iamge"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/img_show_praise"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_fileName="animation/short_video_praise_anim.json"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_record_video_play_header_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/img_close"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:src="@drawable/sv_detail_close"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/img_more"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:src="@drawable/sv_detail_more"
            android:layout_toLeftOf="@+id/img_close"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_bottom"
        android:background="@drawable/bg_record_video_play_footer_shape"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/tv_video_play_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:text="--:--"
            android:layout_centerVertical="true"/>
        <SeekBar
            android:id="@+id/seek_bar_video_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="2dp"
            android:progressDrawable="@drawable/bg_video_record_play_progress"
            android:minHeight="2dp"
            android:thumb="@drawable/circle_white_shape_12dp"
            android:layout_toLeftOf="@+id/tv_video_play_total_time"
            android:layout_toRightOf="@+id/tv_video_play_current_time"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/tv_video_play_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="--:--"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/layout_comment"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="@dimen/dimen_5dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_playrec_discuss_white"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/school_comment"
            android:shadowColor="@color/semitransparent_black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_praise"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_comment"
        app:layout_constraintRight_toRightOf="@+id/layout_comment">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_praise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_playrec_like_white"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_praise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/click_praise"
            android:shadowColor="@color/semitransparent_black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_follow"
        android:layout_width="73dp"
        android:layout_height="73dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_praise"
        app:layout_constraintRight_toRightOf="@+id/layout_comment">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_playrec_flow_white"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/follow"
            android:shadowColor="@color/semitransparent_black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/layout_anchor_is_living"
        android:background="@drawable/bg_record_video_gift_go_to_living_room"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginBottom="@dimen/dimen_80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/img_go_to_living"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:src="@drawable/icon_record_video_play_go_to_living"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_go_to_living"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TA正在直播，点击进入"
            android:maxLines="1"
            android:layout_centerInParent="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="@dimen/dimen_16dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/record_video_play_anchor_is_living.json"
            app:lottie_loop="true"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/progress_bar_loading"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateDuration="700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/videoProgressBarStyle"/>
    <ImageView
        android:id="@+id/img_play"
        android:background="@drawable/bg_video_circle_semitransparent_black"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:src="@drawable/ic_video_play"
        android:paddingStart="20dp"
        android:paddingEnd="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_try_load"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载失败，请检查网络设置"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_try_load"
            android:background="@drawable/lib_video_drawble_bg_stroke_white"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="点击重试"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
