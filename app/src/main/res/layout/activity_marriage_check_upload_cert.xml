<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/bg_root"
            android:background="@drawable/marriage_bg_v8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/tv_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="@string/skip_now"
            android:layout_marginEnd="24dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/shape_solid_fff_top_radius_35"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="149dp">
            <com.zhenai.common.widget.BoldTextView
                android:textSize="18sp"
                android:textColor="@color/color_26273C"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/color_6C6D75"
                android:gravity="start"
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="21dp"
                android:layout_marginRight="@dimen/dp24"
                android:lineSpacingExtra="4sp"
                android:layout_marginHorizontal="@dimen/dp24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <ImageView
                android:id="@+id/cert_demo"
                android:background="@drawable/marriage_status_cert_demo"
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_marginTop="36dp"
                app:layout_constraintEnd_toStartOf="@+id/cert_holder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/desc"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rect_5a5a6a_a50_r40"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_margin="4dp"
                android:text="@string/demo"
                android:paddingHorizontal="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/cert_demo"
                app:layout_constraintEnd_toEndOf="@+id/cert_demo"/>
            <ImageView
                android:id="@+id/cert_holder"
                android:background="@drawable/marriage_status_cert_holder"
                android:layout_width="152dp"
                android:layout_height="152dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cert_demo"
                app:layout_constraintTop_toTopOf="@+id/cert_demo"/>
            <ImageView
                android:id="@+id/cert_clear"
                android:background="@drawable/icon_clear_input_v8"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="4dp"
                app:layout_constraintEnd_toEndOf="@+id/cert_holder"
                app:layout_constraintTop_toTopOf="@+id/cert_holder"/>
            <TextView
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/upload_btn"
                android:background="@drawable/common_btn_v8"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="50dp"
                android:layout_marginRight="24dp"
                android:text="提交审核"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cert_demo"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_26273C"
                android:id="@+id/tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:lineSpacingExtra="4sp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/upload_btn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
