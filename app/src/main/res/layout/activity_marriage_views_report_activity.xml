<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f3f5f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.ScrollListenerView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/marriage_bg_height"
                android:src="@drawable/bg_my_concept_of_marriage_title"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="68dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/OtherProfileInfoItemCardLayoutStyle">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="15dp">
                        <ImageView
                            android:id="@+id/avatar_view"
                            android:background="@drawable/marriage_views_avatar_bg_shape"
                            android:padding="3dp"
                            android:layout_width="81dp"
                            android:layout_height="81dp"
                            android:src="@drawable/default_avatar"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_42475c"
                                    android:id="@+id/nick_name_tv"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/nickname_vertical_line_shape"
                                    android:drawablePadding="10dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/infomation"
                                    android:paddingLeft="10dp"
                                    android:paddingRight="10dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/infomation"/>
                            </LinearLayout>
                            <com.zhenai.base.widget.FlowLayout
                                android:orientation="horizontal"
                                android:id="@+id/label_layout"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                android:layout_marginTop="12dp"
                                app:type="radial"/>
                        </LinearLayout>
                    </LinearLayout>
                    <android.widget.Space
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>
                    <View
                        android:background="#0c000000"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"/>
                    <com.zhenai.psychology_test.widget.curve_chart_view.CurveChartView
                        android:id="@+id/curve_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="20dp"/>
                    <View
                        android:background="@drawable/dash_line_shape"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <com.zhenai.psychology_test.widget.SimpleTextVerticalLayout
                        android:id="@+id/result_vertical_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#8b76f9"
                        android:id="@+id/watch_more_report"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-10dp"
                        android:layout_marginBottom="15dp"
                        android:text="@string/watch_all_report"
                        android:drawablePadding="7dp"
                        android:drawableEnd="@drawable/report_arrow_expand"
                        android:layout_marginStart="24dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/result_test_block2"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:background="#1a000000"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"/>
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_42475c"
                            android:id="@+id/match_people_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/persons_who_match_you"
                            android:drawableLeft="@drawable/nickname_vertical_line_shape"
                            android:drawablePadding="10dp"/>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/wave"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/wave_marriage_female"/>
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:layout_gravity="left"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="30dp">
                                <com.zhenai.psychology_test.widget.MarriageViewAvatarImageView
                                    android:id="@+id/marriageViewOtherAvatarImageView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#42475c"
                                    android:ellipsize="end"
                                    android:id="@+id/object_nickname"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:maxLines="1"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:layout_gravity="right"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="30dp">
                                <com.zhenai.psychology_test.widget.MarriageViewAvatarImageView
                                    android:id="@+id/marriageViewMyAvatarImageView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#42475c"
                                    android:ellipsize="end"
                                    android:id="@+id/my_nickname"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_gravity="right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:src="@drawable/marriage_view_report_bg"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#a088fa"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/summarize_txt"
                                    android:paddingLeft="10dp"
                                    android:paddingRight="10dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="30dp"
                                    android:lineSpacingExtra="6sp"/>
                                <TextView
                                    android:id="@+id/analysis_text"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginEnd="10dp"
                                    style="@style/OtherProfileInfoItemMonologueTextStyle"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/bottom_button2"
                        android:background="@drawable/common_long_btn_selector"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="17dp"
                        android:text="@string/watch_more_match_people"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.zhenai.common.widget.ScrollListenerView>
    <com.zhenai.base.widget.BaseTitleBar
        android:id="@+id/marriage_result_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/img_back"
            android:background="@drawable/recommend_search_selector"
            android:visibility="gone"
            android:src="@drawable/back_icon"
            style="@style/TitleBarLeftIconStyle"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tool_bar_title"
            android:text="@string/marriage_views_title"
            style="@style/TitleBarMiddleTextViewStyle"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/tool_bar_right"
            android:visibility="gone"
            android:text="@string/test_again"
            style="@style/TitleBarTextViewStyle"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/tool_bar_right_finish"
            android:visibility="gone"
            android:text="@string/complete"
            style="@style/TitleBarTextViewStyle"/>
    </FrameLayout>
</RelativeLayout>
