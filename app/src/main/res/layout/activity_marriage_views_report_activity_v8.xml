<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.common.widget.ScrollListenerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:background="#f3f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@drawable/rectangle_ffffff_radius_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <View
                android:id="@+id/avatar_circle_round"
                android:background="@drawable/marriage_view_avatar_bg"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="13dp"
                android:layout_marginStart="13dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/avatar_view"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_circle_round"
                app:layout_constraintEnd_toEndOf="@+id/avatar_circle_round"
                app:layout_constraintStart_toStartOf="@+id/avatar_circle_round"
                app:layout_constraintTop_toTopOf="@+id/avatar_circle_round"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff26273c"
                android:id="@+id/nick_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="13dp"
                app:layout_constraintStart_toEndOf="@+id/avatar_circle_round"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.base.widget.FlowLayout
                android:orientation="horizontal"
                android:id="@+id/label_layout"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/avatar_circle_round"
                app:layout_constraintTop_toBottomOf="@+id/nick_name_tv"
                app:type="radial"/>
            <ImageView
                android:id="@+id/infomation"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@drawable/marriage_question"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.psychology_test.widget.curve_chart_view.CurveChartView
                android:id="@+id/curve_chart_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/avatar_circle_round"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.zhenai.psychology_test.widget.SimpleTextVerticalLayout
            android:id="@+id/result_vertical_layout"
            android:background="@drawable/rectangle_ffffff_radius_16"
            android:paddingTop="10dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="47dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@drawable/rectangle_ffffff_radius_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#8b76f9"
                android:id="@+id/watch_more_report"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="15dp"
                android:text="@string/watch_all_report"
                android:drawablePadding="7dp"
                android:drawableEnd="@drawable/report_arrow_expand"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/result_test_block2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/watch_more_report">
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_42475c"
                    android:id="@+id/match_people_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/persons_who_match_you"
                    android:drawableLeft="@drawable/nickname_vertical_line_shape"
                    android:drawablePadding="10dp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/wave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/wave_marriage_female"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="left"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp">
                        <com.zhenai.psychology_test.widget.MarriageViewAvatarImageView
                            android:id="@+id/marriageViewOtherAvatarImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#42475c"
                            android:ellipsize="end"
                            android:id="@+id/object_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:maxLines="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="right"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="30dp">
                        <com.zhenai.psychology_test.widget.MarriageViewAvatarImageView
                            android:id="@+id/marriageViewMyAvatarImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#42475c"
                            android:ellipsize="end"
                            android:id="@+id/my_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:maxLines="1"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/marriage_view_report_bg"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#a088fa"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/summarize_txt"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:lineSpacingExtra="6sp"/>
                        <TextView
                            android:id="@+id/analysis_text"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            style="@style/OtherProfileInfoItemMonologueTextStyle"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/bottom_button2"
                android:background="@drawable/common_long_btn_selector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="47dp"
                android:text="@string/watch_more_match_people"
                app:layout_constraintTop_toBottomOf="@+id/result_test_block2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.zhenai.common.widget.ScrollListenerView>
