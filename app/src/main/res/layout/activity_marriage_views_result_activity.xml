<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f3f5f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.ScrollListenerView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_button_layout"
        android:overScrollMode="never">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/marriage_bg_height"
                android:src="@drawable/bg_my_concept_of_marriage_title"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="68dp"
                android:layout_marginRight="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="15dp">
                        <ImageView
                            android:id="@+id/avatar_view"
                            android:background="@drawable/marriage_views_avatar_bg_shape"
                            android:padding="3dp"
                            android:layout_width="81dp"
                            android:layout_height="81dp"
                            android:src="@drawable/default_avatar"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_42475c"
                                    android:id="@+id/nick_name_tv"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:drawableLeft="@drawable/nickname_vertical_line_shape"
                                    android:drawablePadding="10dp"
                                    android:layout_weight="1"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/infomation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/infomation"/>
                            </LinearLayout>
                            <com.zhenai.base.widget.FlowLayout
                                android:orientation="horizontal"
                                android:id="@+id/label_layout"
                                android:layout_width="match_parent"
                                android:layout_height="20dp"
                                android:layout_marginTop="12dp"
                                app:type="radial"/>
                        </LinearLayout>
                    </LinearLayout>
                    <android.widget.Space
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>
                    <View
                        android:background="#0c000000"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"/>
                    <com.zhenai.psychology_test.widget.curve_chart_view.CurveChartView
                        android:id="@+id/curve_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="20dp"/>
                </LinearLayout>
                <android.widget.Space
                    android:layout_width="match_parent"
                    android:layout_height="9.5dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_42475c"
                        android:id="@+id/result_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25dp"
                        android:layout_marginTop="16.5dp"
                        android:layout_marginRight="25dp"/>
                    <com.zhenai.psychology_test.widget.SimpleTextVerticalLayout
                        android:id="@+id/result_vertical_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <android.widget.Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp"/>
            </LinearLayout>
        </FrameLayout>
    </com.zhenai.common.widget.ScrollListenerView>
    <FrameLayout
        android:id="@+id/bottom_button_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_go_recommend"
            android:background="@drawable/common_long_btn_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/marriage_views_button_text"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/marriage_views_button_sub_text"/>
        </LinearLayout>
    </FrameLayout>
    <com.zhenai.base.widget.BaseTitleBar
        android:id="@+id/marriage_result_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/img_back"
            android:background="@drawable/recommend_search_selector"
            android:src="@drawable/back_icon"
            style="@style/TitleBarLeftIconStyle"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tool_bar_title"
            android:text="@string/marriage_views_title"
            style="@style/TitleBarMiddleTextViewStyle"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/tool_bar_right"
            android:visibility="gone"
            android:text="@string/test_again"
            style="@style/TitleBarTextViewStyle"/>
    </FrameLayout>
</RelativeLayout>
