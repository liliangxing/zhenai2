<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.album.internal.ui.widget.PreviewViewPager
        android:id="@+id/pager"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/bottom_toolbar"
        android:background="@color/preview_bottom_toolbar_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/res_0x7f040450_preview_bottomtoolbar_back_textcolor"
            android:layout_gravity="start"
            android:id="@+id/button_back"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/button_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/preview_bottom_size"
            android:layout_gravity="center"
            android:id="@+id/size"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/res_0x7f04044f_preview_bottomtoolbar_apply_textcolor"
            android:layout_gravity="end"
            android:id="@+id/button_apply"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"/>
    </FrameLayout>
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_alignParentRight="true">
        <com.zhenai.album.internal.ui.widget.CheckView
            android:id="@+id/check_view"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</RelativeLayout>
