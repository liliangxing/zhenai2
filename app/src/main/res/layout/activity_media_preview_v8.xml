<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.business.media.widget.PhotoViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/bg_mask_media_preview_title"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp36"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_back"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp36"
            android:src="@drawable/ic_back_v8_gray"
            android:scaleType="center"
            android:layout_marginStart="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_current_position"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp27"
            android:paddingHorizontal="@dimen/dp12"
            android:paddingVertical="@dimen/dp2"
            app:bg_colorGradientEnd="#4c000000"
            app:bg_colorGradientStart="#4c000000"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dp13"
            app:bg_shape="round"
            app:layout_constraintLeft_toLeftOf="@+id/iv_picture"
            app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
        <TextView
            android:textColor="@color/color_ffffff"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/img_delete"
            android:background="@drawable/recommend_search_selector"
            android:paddingTop="@dimen/dimen_15dp"
            android:paddingRight="@dimen/dimen_15dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableRight="@drawable/img_title_delete_v8"
            style="@style/TitleBarRightIconStyle"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rlStyleOne"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/layout_praise"
            android:background="@drawable/bg_praise_layout"
            android:visibility="gone"
            android:layout_width="85dp"
            android:layout_height="45dp"
            android:layout_marginRight="@dimen/dp15"
            android:layout_marginBottom="@dimen/dp77"
            android:layout_alignParentBottom="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_alignParentEnd="true">
            <FrameLayout
                android:id="@+id/layout_praise_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/dimen_3dp"
                android:layout_marginBottom="@dimen/dimen_3dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="3dp">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/lav_praise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/tv_praise_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:maxLines="1"
                android:layout_toEndOf="@+id/layout_praise_icon"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/tv_praise_new_num"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_praise_num"
                android:alpha="0"
                android:layout_alignStart="@+id/tv_praise_num"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_praise_v8"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dimen_10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp80"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dimen_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iv_praise_v8"
            android:background="@drawable/ic_praise"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="@dimen/dp32"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:id="@+id/tv_praise_num_v8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:layout_alignBottom="@+id/iv_praise_v8"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
