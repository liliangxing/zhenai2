<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.mine.widget.MineProfileProgressView
        android:id="@+id/profile_progress_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_wechat"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/profile_progress_view">
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_26273C"
            android:ellipsize="end"
            android:id="@+id/tv_wechat_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="免费添加对方微信，享受上线提醒特权"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp12"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_wechat_immediate_use"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/tv_wechat_immediate_use"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp32"
            android:text="@string/go_to_wechat"
            android:layout_marginEnd="@dimen/dp12"
            android:paddingHorizontal="8dp"
            app:bg_colorStroke="@color/color_767dff"
            app:bg_radius="@dimen/dp38"
            app:bg_shape="round"
            app:bg_strokeMode="solid"
            app:bg_strokeWidth="@dimen/dp1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp10"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_wechat">
        <com.zhenai.common.widget.WithoutOutlineAppBarLayout
            android:id="@+id/app_bar_Layout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.zhenai.business.widget.app_bar_layout_behavior.FlingBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <androidx.appcompat.widget.Toolbar
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_collapseMode="pin"/>
                <include
                    android:id="@+id/activity_mine_profile_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:layout_collapseMode="pin"
                    layout="@layout/activity_mine_profile_header_v8"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <FrameLayout
                android:id="@+id/mine_profile_tab_layout"
                android:background="@drawable/rectangle_ffffff_radius_8_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <com.zhenai.lib.zaui.tablayout.ZTabLayout
                    android:id="@+id/mine_profile_tab"
                    android:layout_width="206dp"
                    android:layout_height="70dp"
                    app:zIndicatorCornerRadius="2dp"
                    app:zIndicatorEndColor="@color/color_767dff"
                    app:zIndicatorHeight="4dp"
                    app:zIndicatorMarginBottom="16dp"
                    app:zIndicatorMarginTop="51dp"
                    app:zIndicatorScrollScale="true"
                    app:zIndicatorStartColor="@color/color_767dff"
                    app:zIndicatorStyle="block"
                    app:zIndicatorWidth="16dp"
                    app:zSelectedTextColor="#42475c"
                    app:zSelectedTextSize="18sp"
                    app:zTabMode="fixed"
                    app:zTabPaddingLeft="15dp"
                    app:zTabPaddingRight="15dp"
                    app:zTextBold="text_bold_when_select"
                    app:zUnSelectedTextColor="#6c6d75"
                    app:zUnSelectedTextSize="16sp"/>
            </FrameLayout>
        </com.zhenai.common.widget.WithoutOutlineAppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <ViewStub
        android:id="@+id/mine_add_point_view"
        android:layout="@layout/layout_mine_add_point_svga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
