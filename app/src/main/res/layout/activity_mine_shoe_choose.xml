<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.module_emotion.widget.MineSchoolTitleIndicator
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/titleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:background="@color/color_ebebeb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1dp"
            app:layout_constraintTop_toBottomOf="@+id/titleIndicator"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/mViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_opr"
        android:background="@color/white"
        android:paddingTop="@dimen/dimen_14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_finish"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44dp"
            android:layout_marginLeft="@dimen/dimen_16dp"
            android:layout_marginRight="@dimen/dimen_16dp"
            android:text="@string/mine_shop_finish_tips"
            app:bg_colorGradientEnd="@color/color_1ec7b1"
            app:bg_colorGradientStart="@color/color_1ec7b1"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_4dp"
            app:bg_shape="round"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_8b76f9"
            android:gravity="center"
            android:id="@+id/tv_mine_shop_protocol"
            android:paddingTop="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:text="@string/mine_shop_protocol"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_finish"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
