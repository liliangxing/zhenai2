<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top"
        android:background="@drawable/bg_mine_shop_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_mine_shop_back"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingBottom="@dimen/dimen_5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp">
                <ImageView
                    android:id="@+id/iv_mine_shop_back"
                    android:background="@drawable/back_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/dimen_18sp"
                android:textColor="@color/white"
                android:id="@+id/tv_mine_shop_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_shop_title"
                app:layout_constraintBottom_toBottomOf="@+id/rl_mine_shop_back"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rl_mine_shop_back"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/v_center_line"
            android:background="@color/white"
            android:layout_width="@dimen/dimen_1dp"
            android:layout_height="@dimen/dimen_45dp"
            android:layout_marginTop="@dimen/dimen_25dp"
            android:layout_marginBottom="@dimen/dimen_25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_title"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:id="@+id/tv_cur_account_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_shop_account_amount"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="@+id/v_center_line"
            app:layout_constraintTop_toTopOf="@+id/v_center_line"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/white"
            android:id="@+id/tv_cur_account_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_shop_default_amount"
            app:layout_constraintBottom_toBottomOf="@+id/v_center_line"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="@+id/v_center_line"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:id="@+id/tv_cur_ratio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_shop_ratio"
            app:layout_constraintLeft_toLeftOf="@+id/v_center_line"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_center_line"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/white"
            android:id="@+id/tv_cur_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mine_shop_default_ratio"
            app:layout_constraintBottom_toBottomOf="@+id/v_center_line"
            app:layout_constraintLeft_toLeftOf="@+id/v_center_line"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_divider_line"
        android:background="@color/color_f2eef4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_6dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_top"/>
    <View
        android:background="@color/color_a088fa"
        android:layout_width="@dimen/dimen_3dp"
        android:layout_height="@dimen/dimen_14dp"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_shop_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:layout_marginTop="@dimen/dimen_14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider_line"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_opr"
        android:padding="@dimen/dimen_10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_10dp"
        android:text="@string/mine_shop_edit_tips"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shop_num"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_shop_num"/>
    <View
        android:background="@color/color_8b76f9"
        android:layout_width="@dimen/dimen_3dp"
        android:layout_height="@dimen/dimen_14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shop_num"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_shop_num"/>
    <View
        android:id="@+id/v_bottom_divider_line"
        android:background="@color/color_ebebeb"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shop_num"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pic"
        android:paddingLeft="@dimen/dimen_15dp"
        android:paddingTop="@dimen/dimen_7dp"
        android:paddingBottom="@dimen/dimen_7dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_bottom_divider_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
