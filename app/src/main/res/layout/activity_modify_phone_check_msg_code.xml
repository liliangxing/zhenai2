<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_modify_phone_check_msg_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="32sp"
            android:textColor="#ff26273c"
            android:gravity="start"
            android:id="@+id/input_code_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/please_input_phone_num2"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273C"
            android:gravity="start"
            android:id="@+id/tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/phone_num_security_note2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/input_code_tip"
            app:layout_constraintTop_toBottomOf="@+id/input_code_tip"/>
        <com.zhenai.login.widget.PhoneInputLayout
            android:id="@+id/phone_input_layout"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dp37"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:inputContentHintV8="@string/input_phone_num"
            app:inputTypeV8="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tip"/>
        <Button
            android:id="@+id/get_msg_code"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/request_check_code_txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/phone_input_layout"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaeafb3"
            android:gravity="center"
            android:id="@+id/customer_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="@+id/get_msg_code"
            app:layout_constraintStart_toStartOf="@+id/get_msg_code"
            app:layout_constraintTop_toBottomOf="@+id/get_msg_code"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
