<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/message_tips_guide_layout"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sv_question_list"
        android:paddingBottom="123dp"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <View
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/opt_bg"
        android:background="@drawable/bg_most_concern_things_opt"
        android:layout_width="match_parent"
        android:layout_height="118dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_setting_finish_v2"
        android:background="@drawable/bg_rectangle_767dff_40r_shape"
        android:visibility="gone"
        android:layout_width="231dp"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="58dp"
        android:text="@string/setting_finish"
        android:layout_marginHorizontal="15dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">
        <CheckBox
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#737583"
            android:gravity="center_vertical"
            android:id="@+id/cb_auto_reply"
            android:padding="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/selecter_2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/tv_auto_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_reply_greetings"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</FrameLayout>
