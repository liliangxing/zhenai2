<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="#ff26273c"
        android:id="@+id/tv_top_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/my_label_top_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_label_type"
        android:background="@color/white"
        android:layout_width="62dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_tips"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_sub_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/recycler_view_label_type"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_tips"/>
    <View
        android:id="@+id/view_bottom_bg"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff26273c"
        android:id="@+id/tv_have_selected_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/have_selected_label_n_divide_10"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/view_bottom_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bottom_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_60"
        android:gravity="center"
        android:id="@+id/tv_choose_finish"
        android:background="@drawable/bg_9f9df3_rectangle_15_radius"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:text="@string/my_label_choose_finish"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/view_bottom_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bottom_bg"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_select_labels"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_choose_finish"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/layout_protocol"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view_select_labels">
        <CheckBox
            android:id="@+id/checkbox_agree"
            android:background="@drawable/user_privacy_check_box_selector_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ffaeafb3"
            android:id="@+id/tv_protocol_text"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
