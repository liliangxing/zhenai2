<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/OtherProfileInfoItemCardLayoutStyle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/marriage_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.InfoCardTitleLayout
                android:id="@+id/marriage_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:right_image="@drawable/icon_enter"
                app:title="@string/test_result"/>
            <com.zhenai.base.widget.FlowLayout
                android:orientation="horizontal"
                android:id="@+id/label_layout"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                app:type="radial"/>
            <com.zhenai.psychology_test.widget.curve_chart_view.CurveChartView
                android:id="@+id/curve_chart_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="19dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/divide_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#14000000"
                android:layout_width="80dp"
                android:layout_height="0.5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#28292d"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_more_to_match"/>
            <View
                android:background="#14000000"
                android:layout_width="80dp"
                android:layout_height="0.5dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/question_layout"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/answer_more_bg"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7.5dp"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/answer_more_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/question_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginRight="45dp"
                    android:maxLines="2"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
