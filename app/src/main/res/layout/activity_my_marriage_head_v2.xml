<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.common.widget.ScrollListenerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/marriage_view_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/OtherProfileInfoItemCardLayoutStyle">
        <com.zhenai.common.widget.InfoCardTitleLayout
            android:id="@+id/marriage_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:right_image="@drawable/icon_enter"
            app:title="@string/test_result"/>
        <com.zhenai.base.widget.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/label_layout"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            app:type="radial"/>
        <com.zhenai.psychology_test.widget.curve_chart_view.CurveChartView
            android:id="@+id/curve_chart_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="19dp"/>
    </LinearLayout>
</com.zhenai.common.widget.ScrollListenerView>
