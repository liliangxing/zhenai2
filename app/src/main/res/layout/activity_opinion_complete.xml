<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_opinion_complete_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/dp46"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_rectangle_ffffff_16r_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273c"
            android:gravity="start"
            android:id="@+id/title"
            android:tag="binding_1"
            android:paddingLeft="@dimen/dimen_16dp"
            android:paddingRight="@dimen/dimen_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:paddingHorizontal="@dimen/dimen_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RelativeLayout
            android:id="@+id/rl_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:tag="binding_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </RelativeLayout>
        <EditText
            android:scrollbarSize="2dp"
            android:scrollbarThumbVertical="@drawable/infomation_scrollbar_bg"
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_6c6d75"
            android:textColorHint="@color/color_AEAFB3"
            android:gravity="start|top"
            android:id="@+id/editText"
            android:tag="binding_3"
            android:background="@drawable/bg_opinion_edit_text"
            android:paddingLeft="10dp"
            android:paddingTop="@dimen/dimen_8dp"
            android:paddingRight="10dp"
            android:paddingBottom="@dimen/dp31"
            android:focusable="true"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp185"
            android:layout_marginLeft="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:layout_marginRight="@dimen/dimen_16dp"
            android:layout_marginBottom="@dimen/dp46"
            android:lineSpacingExtra="3dp"
            android:textCursorDrawable="@drawable/editext_cursor_shape_8"
            android:layout_marginHorizontal="@dimen/dimen_16dp"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_rv"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_ff7599"
            android:id="@+id/et_unpass"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp6"
            android:drawablePadding="@dimen/dimen_4dp"
            android:layout_marginStart="@dimen/dp6"
            app:drawableStartCompat="@drawable/ic_opinion_unpass"
            app:layout_constraintBottom_toBottomOf="@+id/editText"
            app:layout_constraintStart_toStartOf="@+id/editText"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_AEAFB3"
            android:id="@+id/et_tip"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_6dp"
            android:layout_marginEnd="@dimen/dp6"
            app:layout_constraintBottom_toBottomOf="@+id/editText"
            app:layout_constraintEnd_toEndOf="@+id/editText"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_next"
            android:tag="binding_6"
            android:background="@drawable/common_btn_v8"
            android:layout_width="231dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dp22"
            android:layout_marginBottom="@dimen/dp46"
            android:text="@string/publish"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editText"
            app:layout_constraintVertical_bias="0"
            style="?android:attr/borderlessButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
