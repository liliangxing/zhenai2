<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/special_root_layout"
    android:background="@color/white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/flAvatar">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_22sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/tv_nick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dimen_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tv_special_user_tips"
        android:paddingBottom="@dimen/dimen_5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp7"
        android:lineSpacingExtra="2dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_nick_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_nick_name"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_special_user_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
