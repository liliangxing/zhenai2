<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_phone_login_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="32sp"
            android:textColor="#ff26273c"
            android:gravity="start"
            android:id="@+id/input_code_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/please_input_phone_num2"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.login.widget.PhoneInputLayout
            android:id="@+id/phone_input_layout"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dp72"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:inputContentHintV8="@string/input_phone_num"
            app:inputTypeV8="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_code_tip"/>
        <com.zhenai.login.widget.ImageCodeLayout
            android:id="@+id/image_code_layout"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            app:inputContentHintV8="@string/please_input_code"
            app:inputRightIconVisibilityV8="false"
            app:inputTypeV8="4"
            app:layout_constraintEnd_toEndOf="@+id/phone_input_layout"
            app:layout_constraintStart_toStartOf="@+id/phone_input_layout"
            app:layout_constraintTop_toBottomOf="@+id/phone_input_layout"/>
        <Button
            android:id="@+id/get_msg_code"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/request_check_code_txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_code_layout"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_767dff"
            android:id="@+id/user_password_login"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/use_password_login"
            app:layout_constraintStart_toStartOf="@+id/get_msg_code"
            app:layout_constraintTop_toBottomOf="@+id/get_msg_code"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
