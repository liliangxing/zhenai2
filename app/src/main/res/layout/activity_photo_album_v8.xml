<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.business.widget.autosrcoll_banner_listview.ZAAutoScrollBanner
        android:id="@+id/view_banners"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:indicatorBottomMargin="1dp"
        app:indicatorSelected="@drawable/indicator_banner_selected"
        app:indicatorSpace="8dp"
        app:indicatorUnSelected="@drawable/indicator_banner_unselected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_normal"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_banners">
        <RelativeLayout
            android:id="@+id/layout_become_zhenxin_member"
            android:background="#ffedbf"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="13sp"
                android:textColor="#563f1b"
                android:gravity="center_vertical"
                android:id="@+id/tv_become_zhenxin_member"
                android:background="@drawable/bg_album_member_open"
                android:padding="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_member"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#563f1b"
                android:id="@+id/tv_upload_limitation_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photo_album_no_zhenxin_member_tips"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/tv_become_zhenxin_member"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.zhenai.common.widget.refresh.ZARefreshLayout
            android:id="@+id/recycler_view_photo_album"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.zhenai.common.widget.refresh.ZARefreshLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_camera_photo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:src="@drawable/camera_take_photo_v8"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/album_upload_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:src="@drawable/album_upload_tips1"
        android:layout_above="@+id/iv_camera_photo"
        android:layout_alignEnd="@+id/iv_camera_photo"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/empty_tips_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/my_album_default"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:gravity="center"
            android:id="@+id/empty_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="40dp"
            android:text="@string/empty_photo_album_tips_v8"
            android:layout_marginHorizontal="40dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/btn_upload_photo"
            android:background="@drawable/round_767dff_btn_bg"
            android:layout_width="231dp"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="62dp"
            android:text="@string/upload_photo"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/empty_tips"/>
    </LinearLayout>
</RelativeLayout>
