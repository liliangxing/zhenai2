<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="@drawable/shape_privilege_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/status_bar_height">
        <FrameLayout
            android:layout_gravity="start|center_vertical"
            android:id="@+id/backLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/backIcon"
                android:background="@drawable/back_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/privilege_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/privilege_center"/>
    </FrameLayout>
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:id="@+id/privilege_tab"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:zIndicatorCornerRadius="2dp"
        app:zIndicatorEndColor="@color/white"
        app:zIndicatorHeight="4dp"
        app:zIndicatorMarginTop="36dp"
        app:zIndicatorScrollScale="true"
        app:zIndicatorStartColor="@color/white"
        app:zIndicatorStyle="block"
        app:zIndicatorWidth="12dp"
        app:zSelectedTextColor="@color/white"
        app:zSelectedTextSize="18sp"
        app:zTabMode="scrollable"
        app:zTabPaddingLeft="15dp"
        app:zTabPaddingRight="15dp"
        app:zTextBold="text_bold_when_select"
        app:zUnSelectedTextColor="@color/white_70"
        app:zUnSelectedTextSize="18sp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="96dp">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/buy_now"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/buy_action_mine"
            android:layout_marginHorizontal="16dp"/>
    </FrameLayout>
</LinearLayout>
