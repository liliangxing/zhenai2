<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@drawable/bg_dialog_ffffff_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.login.widget.NoScrollHorizontalViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/supplement_progess"/>
    <ProgressBar
        android:orientation="horizontal"
        android:id="@+id/supplement_progess"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_4dp"
        android:max="100"
        android:progressDrawable="@drawable/bg_767dff_progressbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/back"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/go_back_v8"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
