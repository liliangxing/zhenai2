<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_head_view"
        android:background="@color/color_f7f7f7"
        android:paddingBottom="@dimen/dimen_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="@dimen/dimen_105dp"
            android:layout_height="@dimen/dimen_105dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_17sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:id="@+id/tv_course_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_8dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:maxLines="2"
            app:layout_constraintLeft_toRightOf="@+id/iv_poster"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_a0a0a0"
            android:ellipsize="end"
            android:id="@+id/tv_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_6dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="@+id/tv_course_name"
            app:layout_constraintLeft_toRightOf="@+id/iv_poster"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_course_name"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_a0a0a0"
            android:id="@+id/tv_buyed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:text="@string/already_buy"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toRightOf="@+id/v_base"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_a0a0a0"
            android:id="@+id/tv_undercarriage"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:text="@string/already_undercarriage"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toRightOf="@+id/v_base"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/color_fd7979"
            android:gravity="center"
            android:id="@+id/tv_not_free_price"
            android:paddingLeft="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toRightOf="@+id/tv_label_type_name"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
        <View
            android:id="@+id/v_base"
            android:layout_width="1dp"
            android:layout_height="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_poster"
            app:layout_constraintLeft_toLeftOf="@+id/tv_course_name"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_a0a0a0"
            android:id="@+id/tv_price"
            android:paddingRight="@dimen/dimen_8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toLeftOf="@+id/v_base"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_label_type_name"
            android:paddingLeft="@dimen/dimen_3dp"
            android:paddingTop="@dimen/dimen_1dp"
            android:paddingRight="@dimen/dimen_3dp"
            android:paddingBottom="@dimen/dimen_1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_4dp"
            android:text="限时免费"
            android:layout_marginEnd="@dimen/dimen_4dp"
            app:bg_colorGradientEnd="@color/color_fd7979"
            app:bg_colorGradientStart="@color/color_fd7979"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_2dp"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toRightOf="@+id/tv_price"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textColor="@color/color_fd7979"
            android:gravity="center"
            android:id="@+id/tv_now_price"
            android:paddingLeft="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_base"
            app:layout_constraintLeft_toRightOf="@+id/tv_label_type_name"
            app:layout_constraintTop_toTopOf="@+id/v_base"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/fl_course_bottom_pay"
        app:layout_constraintTop_toBottomOf="@+id/cl_head_view"/>
    <FrameLayout
        android:id="@+id/fl_course_bottom_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
