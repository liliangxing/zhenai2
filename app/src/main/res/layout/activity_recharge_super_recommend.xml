<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="-25dp"
        android:layout_above="@+id/bottom_profile_view">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.business.widget.autosrcoll_banner_listview.ZAAutoScrollBanner
                android:id="@+id/view_recharge_banners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:indicatorBottomMargin="16dp"/>
            <RelativeLayout
                android:background="@drawable/bg_ffffff_top_16_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-16dp"
                android:layout_below="@+id/view_recharge_banners">
                <FrameLayout
                    android:id="@+id/super_recommend_privilege_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_666978"
                        android:gravity="center"
                        android:id="@+id/tv_privilege_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/super_recommend_privilege_title"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="44dp">
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_666978"
                            android:gravity="center"
                            android:id="@+id/tv_icon_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/super_recommend_privilege_str_1"
                            android:drawableTop="@drawable/icon_super_recommend_privilege_1"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_666978"
                            android:gravity="center"
                            android:id="@+id/tv_icon_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/super_recommend_privilege_str_2"
                            android:drawableTop="@drawable/icon_super_recommend_privilege_2"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_666978"
                            android:gravity="center"
                            android:id="@+id/tv_icon_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/super_recommend_privilege_str_3"
                            android:drawableTop="@drawable/icon_super_recommend_privilege_3"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_666978"
                            android:gravity="center"
                            android:id="@+id/tv_icon_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/super_recommend_privilege_str_4"
                            android:drawableTop="@drawable/icon_super_recommend_privilege_4"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </FrameLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/product_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="154dp"
                    android:layout_marginTop="18dp"
                    android:layout_below="@+id/super_recommend_privilege_head"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="7.5dp"
                    android:layout_marginEnd="7.5dp"/>
                <com.zhenai.business.widget.pay.PayTypeLayout
                    android:gravity="center"
                    android:id="@+id/payTypeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:layout_below="@+id/product_layout"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"/>
                <Button
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_sure"
                    android:background="@drawable/bg_rectangle_767dff_28r_shape"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/sure_to_pay"
                    android:layout_below="@+id/payTypeLayout"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_introduce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:layout_below="@+id/btn_sure"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="90dp">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="44dp"
            android:src="@drawable/ic_back_v8_gray"
            android:paddingStart="12dp"
            android:paddingEnd="@dimen/dimen_15dp"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_my_sup_recom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:lineSpacingMultiplier="1.2"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottom_profile_view"
        android:background="@drawable/bg_super_recommend_recharge_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_avatar_bottom"
            android:background="@drawable/default_circle_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#26273c"
            android:id="@+id/tv_surplus_num_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxWidth="190dp"
            android:maxLines="1"
            android:layout_marginStart="74dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6c6d75"
            android:linksClickable="true"
            android:layout_gravity="bottom"
            android:id="@+id/tv_link_to_profile"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="可以在和其他用户聊天时，点击提醒他@使用"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="74dp"/>
        <Button
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@+id/btn_use"
            android:background="@drawable/bg_rectangle_ffff776f_19_radius"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:layout_marginTop="18dp"
            android:text="@string/use_immediatily"
            android:layout_marginEnd="15dp"
            style="?android:attr/borderlessButtonStyle"/>
    </FrameLayout>
</RelativeLayout>
