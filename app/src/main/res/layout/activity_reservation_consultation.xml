<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/dp15"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/ll_process"
            android:background="@color/white"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_process"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_60dp"
                android:src="@drawable/ic_order_process"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintlayout_top"
            android:background="@drawable/bg_round_white_8dp"
            android:paddingBottom="@dimen/dp10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_process">
            <View
                android:id="@+id/bg_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/il_feeback_phone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="@dimen/dimen_50dp"
                android:layout_height="@dimen/dimen_50dp"
                android:layout_marginLeft="@dimen/dimen_18dp"
                android:layout_marginTop="@dimen/dimen_13dp"
                app:layout_constraintBottom_toTopOf="@+id/il_feeback_phone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.common.widget.BoldTextView
                android:textSize="@dimen/dimen_18sp"
                android:textColor="@color/color_333333"
                android:id="@+id/tv_teacher_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_count"
                app:layout_constraintLeft_toRightOf="@+id/iv_poster"
                app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_poster"
                app:layout_constraintLeft_toRightOf="@+id/iv_poster"
                app:layout_constraintTop_toBottomOf="@+id/tv_teacher_name"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tv_teacher_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_teacher_name"
                app:layout_constraintLeft_toRightOf="@+id/tv_teacher_name"
                app:layout_constraintTop_toTopOf="@+id/tv_teacher_name"/>
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_consultation_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13dp"
                app:itemArrow="false"
                app:itemHeight="@dimen/dimen_50dp"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="咨询方式"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_poster"
                app:leftIconVisible="false"
                app:righContenteColor="@color/color_333333"
                app:rightContent="电话咨询"
                app:rightContentVisible="true"/>
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_consultation_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:itemArrow="false"
                app:itemHeight="@dimen/dimen_50dp"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="咨询时长"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/il_consultation_mode"
                app:leftIconVisible="false"
                app:righContenteColor="@color/color_333333"
                app:rightContent=""
                app:rightContentVisible="true"/>
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_consultation_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:itemArrow="false"
                app:itemHeight="@dimen/dimen_50dp"
                app:itemLine="false"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="支付金额"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/il_consultation_time"
                app:leftIconVisible="false"
                app:rightContent=""
                app:rightContentVisible="true"/>
            <View
                android:id="@+id/view_consultation_amount_line"
                android:background="@color/color_dividing_line"
                android:paddingTop="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/common_line_height"
                android:layout_marginStart="@dimen/dp18"
                android:layout_marginEnd="@dimen/dp18"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/il_consultation_amount"/>
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_coupon"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:itemArrow="true"
                app:itemHeight="@dimen/dimen_50dp"
                app:itemLine="false"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="代金券"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_consultation_amount_line"
                app:leftIconVisible="false"
                app:rightContent=""
                app:rightContentVisible="true"
                app:rightTitleColor="@color/color_8b76f9"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout_center"
            android:background="@drawable/bg_round_white_8dp"
            android:paddingBottom="@dimen/dimen_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            app:layout_constraintTop_toBottomOf="@+id/constraintlayout_top">
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                app:itemArrow="false"
                app:itemLine="true"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="手机号"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:leftIconVisible="false"
                app:leftTextVisible="true"
                app:righContenteColor="@color/color_333333"
                app:rightEdHint="请填写"
                app:rightEdVisible="true"/>
            <com.zhenai.module_emotion.widget.EmotionItemLayout
                android:id="@+id/il_problem_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:itemArrow="false"
                app:itemHeight="@dimen/dimen_50dp"
                app:itemLine="false"
                app:itemTitleColor="@color/color_666666"
                app:itemTitleText="问题描述"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/il_phone"
                app:leftIconVisible="false"
                app:leftTextVisible="false"/>
            <com.zhenai.common.widget.ScrollEditText
                android:textSize="@dimen/dimen_14sp"
                android:textColorHint="#bfbfbf"
                android:gravity="start"
                android:id="@+id/tv_edit"
                android:background="@drawable/bg_reservation_input"
                android:paddingLeft="@dimen/dimen_15dp"
                android:paddingTop="@dimen/dimen_10dp"
                android:paddingRight="@dimen/dimen_15dp"
                android:paddingBottom="@dimen/dimen_30dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp140"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginRight="@dimen/dimen_10dp"
                android:layout_marginBottom="@dimen/dimen_10dp"
                android:hint="请简要描述您的问题，方便我们更快的了解~"
                android:maxLines="6"
                android:maxLength="200"
                app:layout_constraintTop_toBottomOf="@+id/il_problem_des"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/color_bfbfbf"
                android:id="@+id/tv_edit_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dimen_5dp"
                android:layout_marginBottom="@dimen/dimen_5dp"
                android:text="@string/reservation_consultation_comment_length_default"
                app:layout_constraintBottom_toBottomOf="@+id/tv_edit"
                app:layout_constraintRight_toRightOf="@+id/tv_edit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RadioButton
            android:id="@+id/radioButton"
            android:paddingTop="@dimen/dimen_15dp"
            android:paddingRight="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/service_radiobutton_background"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_service"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout_center"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#318fec"
            android:gravity="center"
            android:id="@+id/tv_service"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_3dp"
            android:text="已阅读并同意《珍爱情感电话咨询服务协议》"
            app:layout_constraintLeft_toRightOf="@+id/radioButton"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/radioButton"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_reservation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:text="预约"
            app:bg_colorGradientEnd="@color/color_8070f1"
            app:bg_colorGradientStart="@color/color_b06cef"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_2dp"
            app:bg_shape="round"
            app:layout_constraintTop_toBottomOf="@+id/radioButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
