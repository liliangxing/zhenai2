<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_retrieve_password_input_verify_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/input_code_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/modify_password"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/modify_phone"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintStart_toStartOf="@+id/input_code_tip"
        app:layout_constraintTop_toBottomOf="@+id/input_code_tip"/>
    <com.zhenai.login.widget.InputItemLayoutV8
        android:id="@+id/input_box_view"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="@dimen/dimen_24dp"
        android:layout_marginTop="69dp"
        android:layout_marginRight="@dimen/dimen_24dp"
        android:singleLine="true"
        android:maxLength="4"
        android:layout_marginHorizontal="@dimen/dimen_24dp"
        app:inputContentHintV8="@string/please_input_code"
        app:inputTypeV8="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modify_phone"/>
    <Button
        android:id="@+id/re_get_msg_code"
        android:tag="binding_3"
        android:padding="@dimen/dp18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:height="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_box_view"
        style="@style/common_long_btn_style_8.0_no_shadow"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_767dff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/no_password"
        android:tag="binding_4"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:text="@string/do_not_receive_verification_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/re_get_msg_code"
        app:layout_constraintTop_toBottomOf="@+id/re_get_msg_code"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
