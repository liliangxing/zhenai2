<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_title_bar"
        layout="@layout/activity_select_location_title_bar_v2"/>
    <FrameLayout
        android:id="@+id/layout_et_search"
        android:background="#f4f5f7"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_title_bar">
        <com.zhenai.moments.widget.CenterEditText
            android:textSize="14sp"
            android:textColor="@color/color_bcbcbc"
            android:textColorHint="@color/color_bcbcbc"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/et_search"
            android:background="@drawable/bg_location_search"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="9dp"
            android:hint="@string/search_location_nearby"
            android:singleLine="true"
            android:drawableLeft="@drawable/search_edit_icon"
            android:drawablePadding="6dp"
            android:imeOptions="actionSearch"/>
    </FrameLayout>
    <com.zhenai.base.widget.recyclerview.xrecylerview.XRecyclerView
        android:id="@+id/rv_poi_list"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_et_search"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_rotate_animation"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-40dp"
        android:layout_below="@+id/rv_poi_list">
        <ImageView
            android:id="@+id/iv_rotate"
            android:background="@drawable/icon_rotate_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_bcbcbc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/is_searching_location_nearby"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_666978"
        android:gravity="center_horizontal"
        android:id="@+id/tv_poi_no_result"
        android:background="#f4f5f7"
        android:paddingTop="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/search_location_no_result"
        android:layout_below="@+id/rv_poi_list"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_666978"
        android:gravity="center_horizontal"
        android:id="@+id/tv_location_unavailable"
        android:background="#f4f5f7"
        android:paddingTop="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/location_unavailable"
        android:layout_below="@+id/rv_poi_list"/>
    <RelativeLayout
        android:id="@+id/layout_search_title"
        android:background="#eceef4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/color_666978"
            android:textColorHint="@color/color_bcbcbc"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/et_search_title"
            android:background="@drawable/bg_location_search"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/search_location_nearby"
            android:singleLine="true"
            android:drawableLeft="@drawable/search_edit_icon"
            android:drawablePadding="6dp"
            android:imeOptions="actionSearch"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"/>
        <ImageView
            android:id="@+id/iv_search_title_clear"
            android:background="@drawable/btn_close"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="5dp"
            android:layout_alignTop="@+id/et_search_title"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/layout_search_result"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_title_bar">
        <com.zhenai.base.widget.recyclerview.xrecylerview.XRecyclerView
            android:id="@+id/rv_search_result"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_666978"
            android:gravity="center_horizontal"
            android:id="@+id/tv_search_no_result"
            android:paddingTop="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/search_location_no_result"/>
    </FrameLayout>
</RelativeLayout>
