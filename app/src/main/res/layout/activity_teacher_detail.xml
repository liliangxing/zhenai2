<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/msg_root_view"
    android:background="@color/color_f2f2f2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.WithoutOutlineAppBarLayout
            android:id="@+id/layout_appbar"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.zhenai.module_emotion.widget.AppBarLayoutBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/ctb"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:expandedTitleMarginStart="10dp"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zhenai.module_emotion.teacher.widget.TeacherDetailHeaderBaseInfoView
                        android:id="@+id/v_header_base_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <com.zhenai.module_emotion.teacher.widget.TeacherDetailHeaderView
                android:id="@+id/v_header_choose"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="pin"/>
        </com.zhenai.common.widget.WithoutOutlineAppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_teacher_head_title"
        android:background="@color/color_f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp35"
        android:alpha="0">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_teacher_detail_title"
            android:paddingLeft="@dimen/dp42"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_teacher_detail_back"
        android:paddingLeft="@dimen/dp14"
        android:paddingRight="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp35"
        android:minWidth="@dimen/dp42">
        <ImageView
            android:id="@+id/iv_teacher_back"
            android:background="@drawable/back_icon_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="@dimen/dimen_10dp"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingRight="@dimen/dimen_10dp"
        android:paddingBottom="@dimen/dimen_18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_consult"
            android:background="@color/color_80_white"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_10dp"
            android:layout_marginRight="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_18dp"
            android:text="@string/reservation_now"
            app:bg_colorGradientEnd="@color/color_7a00ff"
            app:bg_colorGradientStart="@color/color_ff5694"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_5dp"
            app:bg_shape="round"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
