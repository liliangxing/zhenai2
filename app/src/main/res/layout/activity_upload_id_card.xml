<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f2f4f5"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rect_white_r30_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="#222833"
            android:id="@+id/user_name"
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credit_upload_id_cards_dear"
            android:paddingHorizontal="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#6c6d75"
            android:id="@+id/user_name_tip"
            android:paddingLeft="24dp"
            android:paddingTop="8dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credit_upload_id_cards_title"
            android:paddingHorizontal="24dp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_name"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/upload_cards"
            android:paddingTop="@dimen/dimen_8dp"
            android:paddingBottom="@dimen/dimen_8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credit_upload_cards"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_id_card_title"
            android:layout_marginStart="24dp"
            android:paddingVertical="@dimen/dimen_8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_name_tip"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#6c7175"
            android:id="@+id/upload_id_card_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:text="@string/credit_upload_id_cards_tip"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="@dimen/dimen_10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_cards"/>
        <FrameLayout
            android:id="@+id/frame_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/upload_id_card_tips">
            <com.zhenai.certification.credit.view.IdCardUploadView
                android:id="@+id/frontIdCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                app:dimensionRatioWH="1.6"
                app:id_card_type="front"
                app:layout_constraintEnd_toStartOf="@+id/backIdCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/upload_id_card_tips"/>
            <com.zhenai.certification.credit.view.IdCardUploadView
                android:layout_gravity="end"
                android:id="@+id/backIdCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                app:dimensionRatioWH="1.6"
                app:id_card_type="back"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/frontIdCardView"
                app:layout_constraintTop_toBottomOf="@+id/upload_id_card_tips"/>
        </FrameLayout>
        <View
            android:id="@+id/blank2"
            android:background="#f2f4f5"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/frame_layout"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/upload_id_card_write_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/credit_upload_id_cards_write_info"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_id_card_title"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="@dimen/dimen_15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/blank2"/>
        <com.zhenai.common.widget.InputItemLayoutWithLeftText
            android:id="@+id/write_name"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:inputContentHint="@string/credit_upload_id_cards_name_hint"
            app:inputContentSize="15sp"
            app:inputHintColor="#aeafb3"
            app:inputLineColor="#f3f5f6"
            app:inputLineVisibility="false"
            app:inputMaxLength="20"
            app:inputRightIconVisibility="false"
            app:inputType="phone"
            app:layout_constraintTop_toBottomOf="@+id/upload_id_card_write_info"
            style="@style/InputItemLayout_style"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/id_card_write_container"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/write_name">
            <TextView
                android:textSize="15sp"
                android:textColor="#6c6d75"
                android:gravity="center"
                android:id="@+id/tv_card"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:text="@string/credit_upload_id_cards_no"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.zhenai.business.widget.CardEditText
                android:textSize="15sp"
                android:textColor="#42475c"
                android:textColorHint="#aeafb3"
                android:gravity="center_vertical"
                android:id="@+id/et_card"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/credit_upload_id_cards_no_hint"
                android:singleLine="true"
                android:maxLength="20"
                android:textCursorDrawable="@drawable/editext_cursor_shape_8"
                android:layout_marginEnd="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_card"/>
            <View
                android:background="#f3f5f6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_1dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:enabled="false"
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:id="@+id/id_card_submit"
            android:background="@drawable/common_long_btn_selector_blue_8"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:layout_marginBottom="@dimen/dimen_20dp"
            android:text="@string/credit_upload_id_cards_submit"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id_card_write_container"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#6c6d75"
            android:gravity="center_horizontal"
            android:id="@+id/upload_id_card_phone"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="36dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/credit_upload_id_cards_telephone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id_card_submit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
