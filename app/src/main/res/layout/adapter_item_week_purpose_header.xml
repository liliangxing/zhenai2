<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:background="@drawable/bg_week_purpose_header_left"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="22">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_week_purpose_line_left"
                android:translationY="-1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/tvHintNumTwo"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_number_two"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guidelineTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <FrameLayout
                android:background="@drawable/crown_silver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLikeTwo"
                app:layout_constraintEnd_toStartOf="@+id/guidelineTwo"
                app:layout_constraintTop_toTopOf="@+id/ivLikeTwo">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSenderIconTwo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/crown_silver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLikeTwo"
                app:layout_constraintStart_toEndOf="@+id/guidelineTwo"
                app:layout_constraintTop_toTopOf="@+id/ivLikeTwo">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivReceiverIconTwo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/ivLikeTwo"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_week_purpose_like_01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHintNumTwo"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#26273c"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvNameTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:singleLine="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintTop_toBottomOf="@+id/ivLikeTwo"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#6c6d75"
                android:gravity="center"
                android:id="@+id/tvPurposeTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="本周心意值"
                app:layout_constraintTop_toBottomOf="@+id/tvNameTwo"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#767dff"
                android:gravity="center"
                android:id="@+id/tvPurposeValueTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="0"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:background="@drawable/bg_week_purpose_header_middle"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="27">
            <ImageView
                android:id="@+id/tvHintNum"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_number_one"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <FrameLayout
                android:background="@drawable/crown_golden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLike"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/ivLike">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSenderIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/crown_golden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLike"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/ivLike">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivReceiverIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="37dp"
                android:src="@drawable/ic_week_purpose_like_01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHintNum"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#26273c"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:singleLine="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintTop_toBottomOf="@+id/ivLike"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#6c6d75"
                android:gravity="center"
                android:id="@+id/tvPurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="本周心意值"
                app:layout_constraintTop_toBottomOf="@+id/tvName"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#767dff"
                android:gravity="center"
                android:id="@+id/tvPurposeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:text="0"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:background="@drawable/bg_week_purpose_header_right"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="22">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_week_purpose_line_right"
                android:translationY="-1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/tvHintNumThree"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_number_three"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guidelineThree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.5"/>
            <FrameLayout
                android:background="@drawable/crown_copper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLikeThree"
                app:layout_constraintEnd_toStartOf="@+id/guidelineThree"
                app:layout_constraintTop_toTopOf="@+id/ivLikeThree">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSenderIconThree"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/crown_copper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivLikeThree"
                app:layout_constraintStart_toEndOf="@+id/guidelineThree"
                app:layout_constraintTop_toTopOf="@+id/ivLikeThree">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivReceiverIconThree"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/default_circle_avatar"
                    app:roundImageType="circle"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/ivLikeThree"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_week_purpose_like_01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHintNumThree"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#26273c"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvNameThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:singleLine="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintTop_toBottomOf="@+id/ivLikeThree"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#6c6d75"
                android:gravity="center"
                android:id="@+id/tvPurposeThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="本周心意值"
                app:layout_constraintTop_toBottomOf="@+id/tvNameThree"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#767dff"
                android:gravity="center"
                android:id="@+id/tvPurposeValueThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="0"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:background="#fffff7fc"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#aeafb3"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tvRangeNum"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="我的排名：9999+"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff7a9c"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tvTipAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="如何登上心意榜"
            android:drawableLeft="@drawable/ic_week_prpose_help"
            android:drawablePadding="4dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
