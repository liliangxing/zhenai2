<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_mask"
        android:background="#73000000"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_chat_marquee"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toEndOf="@+id/bg"
            app:layout_constraintStart_toStartOf="@+id/bg"
            app:layout_constraintTop_toTopOf="@+id/bg"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/live_annunciation_marquee.json"
            app:lottie_imageAssetsFolder="images/live_annunciation"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/ivSenderIcon"
            android:background="@drawable/white_circle_shape"
            android:padding="@dimen/dimen_1dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="9.5dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="10.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivReceiverIcon"
            android:background="@drawable/white_circle_shape"
            android:padding="@dimen/dimen_1dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="9.5dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="37dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/iv_rob_in_castle"
            android:layout_width="82dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivReceiverIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivReceiverIcon"/>
        <com.zhenai.common.widget.MarqueeText
            android:textSize="15sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/tv_annunciation"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivReceiverIcon"
            app:layout_constraintEnd_toStartOf="@+id/iv_rob_in_castle"
            app:layout_constraintStart_toEndOf="@+id/ivReceiverIcon"
            app:layout_constraintTop_toTopOf="@+id/ivReceiverIcon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
