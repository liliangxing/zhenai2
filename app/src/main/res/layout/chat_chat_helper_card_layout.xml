<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <RelativeLayout
        android:id="@+id/chat_helper_view1"
        android:background="@drawable/bg_card_chat_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/chat_helper_card_bg"
            android:visibility="gone"
            android:layout_width="320dp"
            android:layout_height="140dp"
            android:scaleType="fitXY"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/chat_helper_title_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp">
            <ImageView
                android:id="@+id/chat_helper_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="1dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#42475c"
                android:ellipsize="end"
                android:id="@+id/chat_helper_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="17sp"
            android:textColor="#8b76f9"
            android:ellipsize="end"
            android:id="@+id/chat_helper_answer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            android:layout_below="@+id/chat_helper_title_layout"
            android:lineSpacingExtra="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff666978"
            android:id="@+id/chat_helper_advise"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/chat_helper_answer"
            android:lineSpacingExtra="8dp"
            android:layout_marginStart="20dp"/>
        <FrameLayout
            android:id="@+id/say_hi_button"
            android:visibility="gone"
            android:layout_marginBottom="15dp"
            android:layout_alignParentBottom="true"
            style="@style/common_long_round_btn_style">
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/say_hi"
                android:drawableLeft="@drawable/icon_chat_say_hi"
                android:drawablePadding="7dp"/>
        </FrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/chat_helper_view2"
        android:background="@drawable/chat_helper_icon_bg_selector"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true">
        <FrameLayout
            android:id="@+id/loading_point1"
            android:background="@drawable/chat_helper_loading_circle"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <FrameLayout
            android:id="@+id/loading_point2"
            android:background="@drawable/chat_helper_loading_circle"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
