<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/chat_voice_record_dialog_bg"
    android:paddingLeft="7dp"
    android:paddingRight="7dp"
    android:paddingBottom="7dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_record_dialog_mic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/chat_recording_mic_anim"
            android:scaleType="centerInside"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_record_dialog_cancel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/chat_recording_cancel"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_record_dialog_tips"
        android:background="@drawable/chat_record_dialog_tips_bg"
        android:padding="3.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slide_up_to_stop_record"/>
</LinearLayout>
