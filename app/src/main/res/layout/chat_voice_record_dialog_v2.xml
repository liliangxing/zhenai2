<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_svga_bg"
        android:background="@drawable/bg_9aa0ff_rectangle_16_radius"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="160dp"
        android:layout_height="80dp"
        android:minWidth="160dp"
        android:layout_centerInParent="true"
        android:paddingStart="35dp"
        android:paddingEnd="35dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_svga"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingStart="35dp"
        android:paddingEnd="35dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp">
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svga_img"
            android:layout_width="90dp"
            android:layout_height="40dp"
            app:antiAlias="true"
            app:autoPlay="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/tv_record_time_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_time_countdown_v2"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_record_dialog_tips"
        android:padding="3.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/slide_up_to_stop_record_v2"
        android:layout_below="@+id/layout_svga"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#26273c"
        android:gravity="center"
        android:background="@drawable/bg_d4d4d8_rectangle_24_radius"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="52dp"
        android:text="@string/press_to_say"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="48dp"/>
</RelativeLayout>
