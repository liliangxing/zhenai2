<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/view_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_layout"
        android:background="@drawable/bg_card_corner_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="#42475c"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:paddingTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/right_top_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/right_star_image"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#666978"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/middle_content_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">
            <Button
                android:textSize="14sp"
                android:textColor="#8b76f9"
                android:id="@+id/left_btn"
                android:background="@drawable/shape_solid_white_purple_stock_radius4_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"
                android:layout_marginEnd="9dp"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/right_btn"
                android:background="@drawable/common_long_btn_purple_selector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
