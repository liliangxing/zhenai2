<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/relativelayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_white_style"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginRight="34dp"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/bg_comp_popup_filter_tip_01"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <FrameLayout
            android:id="@+id/layout_opt_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btnIdentityAuthentication"
                android:background="@drawable/dialog_live_video_pay_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="@string/identity_authentication"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_opt_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btnOpenStartMemberShip"
                android:background="@drawable/dialog_live_video_pay_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="@string/open_star_membership"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/iv_discount_1"
                android:visibility="visible"
                android:layout_width="54dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff775bf7"
            android:gravity="center"
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:text="@string/cancel"/>
    </LinearLayout>
</RelativeLayout>
