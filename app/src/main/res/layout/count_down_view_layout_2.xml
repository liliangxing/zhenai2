<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hour_part"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/hour_1"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/hour_0"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/hour_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginHorizontal="10dp">
            <View
                android:background="@drawable/rect_white_r8"
                android:layout_width="4dp"
                android:layout_height="4dp"/>
            <View
                android:background="@drawable/rect_white_r8"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/minute_part"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/minute_1"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/minute_0"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/minute_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginHorizontal="10dp">
            <View
                android:background="@drawable/rect_white_r8"
                android:layout_width="4dp"
                android:layout_height="4dp"/>
            <View
                android:background="@drawable/rect_white_r8"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/second_part"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/second_1"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/second_0"
            android:background="@drawable/rect_white_r8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="@string/_0"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</merge>
