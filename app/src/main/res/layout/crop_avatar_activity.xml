<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_191C32"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/header_take_photo_tips_v2"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <ImageView
            android:id="@+id/avatar_1"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:src="@drawable/avoid_avatar_v2_1"
            android:adjustViewBounds="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:src="@drawable/avatar_yes_v2"
            android:layout_alignBottom="@+id/avatar_1"
            android:layout_marginEnd="4dp"
            android:layout_alignEnd="@+id/avatar_1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/crop_avatar_limit_tips_detail_1"
            android:layout_below="@+id/avatar_1"
            android:layout_alignStart="@+id/avatar_1"
            android:layout_alignEnd="@+id/avatar_1"/>
        <ImageView
            android:id="@+id/avatar_2"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:src="@drawable/avoid_avatar_v2_2"
            android:adjustViewBounds="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/avatar_1"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:src="@drawable/avatar_no_v2"
            android:layout_alignBottom="@+id/avatar_2"
            android:layout_marginEnd="4dp"
            android:layout_alignEnd="@+id/avatar_2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/crop_avatar_limit_tips_detail_2"
            android:layout_below="@+id/avatar_2"
            android:layout_alignStart="@+id/avatar_2"
            android:layout_alignEnd="@+id/avatar_2"/>
        <ImageView
            android:id="@+id/avatar_3"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:src="@drawable/avoid_avatar_v2_3"
            android:adjustViewBounds="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/avatar_2"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:src="@drawable/avatar_no_v2"
            android:layout_alignBottom="@+id/avatar_3"
            android:layout_marginEnd="4dp"
            android:layout_alignEnd="@+id/avatar_3"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/crop_avatar_limit_tips_detail_3"
            android:layout_below="@+id/avatar_3"
            android:layout_alignStart="@+id/avatar_3"
            android:layout_alignEnd="@+id/avatar_3"/>
        <ImageView
            android:id="@+id/avatar_4"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:src="@drawable/avoid_avatar_v2_4"
            android:adjustViewBounds="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/avatar_3"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:src="@drawable/avatar_no_v2"
            android:layout_alignBottom="@+id/avatar_4"
            android:layout_marginEnd="4dp"
            android:layout_alignEnd="@+id/avatar_4"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/crop_avatar_limit_tips_detail_4"
            android:layout_below="@+id/avatar_4"
            android:layout_alignStart="@+id/avatar_4"
            android:layout_alignEnd="@+id/avatar_4"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/header_take_photo_tips"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/avatar_avoid_11"
            android:layout_width="63dp"
            android:layout_height="63dp"
            android:layout_marginTop="36dp"
            android:src="@drawable/avatar_avoid_11"
            android:contentDescription="@string/could_not_pass_demo"
            app:layout_constraintEnd_toStartOf="@+id/avatar_avoid_22"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/avatar_avoid_22"
            android:layout_width="63dp"
            android:layout_height="63dp"
            android:src="@drawable/avatar_avoid_22"
            android:contentDescription="@string/could_not_pass_demo"
            android:layout_marginStart="6.5dp"
            app:layout_constraintEnd_toStartOf="@+id/avatar_avoid_33"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/avatar_avoid_11"
            app:layout_constraintTop_toTopOf="@+id/avatar_avoid_11"/>
        <ImageView
            android:id="@+id/avatar_avoid_33"
            android:layout_width="63dp"
            android:layout_height="63dp"
            android:src="@drawable/avatar_avoid_33"
            android:contentDescription="@string/could_not_pass_demo"
            android:layout_marginStart="6.5dp"
            app:layout_constraintEnd_toStartOf="@+id/avatar_avoid_44"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/avatar_avoid_22"
            app:layout_constraintTop_toTopOf="@+id/avatar_avoid_11"/>
        <ImageView
            android:id="@+id/avatar_avoid_44"
            android:layout_width="63dp"
            android:layout_height="63dp"
            android:src="@drawable/avatar_avoid_44"
            android:contentDescription="@string/could_not_pass_demo"
            android:layout_marginStart="6.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/avatar_avoid_33"
            app:layout_constraintTop_toTopOf="@+id/avatar_avoid_11"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="近期正面"
            app:layout_constraintBottom_toTopOf="@+id/avatar_avoid_11"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_11"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_11"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="过于模糊"
            app:layout_constraintBottom_toTopOf="@+id/avatar_avoid_22"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_22"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_22"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="头像太小"
            app:layout_constraintBottom_toTopOf="@+id/avatar_avoid_33"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_33"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_33"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="网络照"
            app:layout_constraintBottom_toTopOf="@+id/avatar_avoid_44"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_44"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_44"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/avatar_yes"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_11"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_11"
            app:layout_constraintTop_toBottomOf="@+id/avatar_avoid_11"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/avatar_no"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_22"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_22"
            app:layout_constraintTop_toBottomOf="@+id/avatar_avoid_22"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/avatar_no"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_33"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_33"
            app:layout_constraintTop_toBottomOf="@+id/avatar_avoid_33"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/avatar_no"
            app:layout_constraintEnd_toEndOf="@+id/avatar_avoid_44"
            app:layout_constraintStart_toStartOf="@+id/avatar_avoid_44"
            app:layout_constraintTop_toBottomOf="@+id/avatar_avoid_44"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.cropview.CropView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center_horizontal"
        android:id="@+id/footer_content"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crop_avatar_operate_tips"/>
    <FrameLayout
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_rotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rotate"
            android:drawablePadding="6dp"
            android:contentDescription="@string/rotate"
            android:drawableStart="@drawable/rotation_90"
            android:layout_marginStart="12dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="#fefffe"
            android:layout_gravity="right"
            android:id="@+id/btn_ok"
            android:background="@drawable/round_767dff_btn_bg"
            android:layout_width="88dp"
            android:layout_height="36dp"
            android:layout_marginBottom="0dp"
            android:text="@string/upload_avatar_btn_upload"
            android:layout_marginStart="140dp"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</LinearLayout>
