<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="188dp">
    <ImageView
        android:background="@drawable/bg_fragment_decoration_avatar_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_avatar"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginBottom="24dp"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center"
        android:id="@+id/iv_avatar_svga"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginBottom="24dp"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:bg_colorNormal="#4219191b"
        app:bg_radiusLeftTop="@dimen/dimen_10dp"
        app:bg_radiusRightTop="@dimen/dimen_10dp"
        app:bg_shape="round">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"/>
        <View
            android:id="@+id/view_line"
            android:background="#80ffffff"
            android:visibility="invisible"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="9dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#baffffff"
            android:id="@+id/tv_expire_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_exchange"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/exchange_now"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/icon_zhenai_coin"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="16dp"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
</FrameLayout>
