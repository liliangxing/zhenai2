<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.base.frame.widget.DefaultEmptyLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:id="@+id/default_empty_layout"
    android:background="@color/color_f3f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/load_fail_img_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/network_error_v8"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/load_fail_tips_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:text="@string/empty_data"
            android:lineSpacingExtra="5dp"/>
        <Button
            android:enabled="false"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/common_long_btn_selector_blue_8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="8dp"
            android:text="@string/re_load"/>
    </LinearLayout>
</com.zhenai.base.frame.widget.DefaultEmptyLayout>
