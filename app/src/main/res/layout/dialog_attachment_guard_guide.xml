<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_ffffff_12_radius_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">
        <ImageView
            android:id="@+id/iv_bg_top"
            android:layout_width="match_parent"
            android:layout_height="206dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_avatar_1"
            android:background="@drawable/white_circle_shape"
            android:padding="2dp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/color_a65b00"
            android:gravity="center"
            android:id="@+id/tv_level_1"
            android:background="@drawable/bg_attachment_live_level_icon"
            android:layout_width="56dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_1"
            app:layout_constraintEnd_toEndOf="@+id/iv_avatar_1"
            app:layout_constraintStart_toStartOf="@+id/iv_avatar_1"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/icon_attachment_guard_guide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_avatar_2"
            android:background="@drawable/white_circle_shape"
            android:padding="2dp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/color_a65b00"
            android:gravity="center"
            android:id="@+id/tv_level_2"
            android:background="@drawable/bg_attachment_live_level_icon"
            android:layout_width="56dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_2"
            app:layout_constraintEnd_toEndOf="@+id/iv_avatar_2"
            app:layout_constraintStart_toStartOf="@+id/iv_avatar_2"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_42475C"
            android:gravity="center"
            android:id="@+id/tv_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:lineHeight="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_avatar_1"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_42475e"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_msg"/>
        <Button
            android:id="@+id/btn_open_guard"
            android:background="@drawable/common_long_btn_normal_za7_without_shadow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/open_guard"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/CommonMiddleFullBtnStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_marginEnd="30dp"/>
</FrameLayout>
