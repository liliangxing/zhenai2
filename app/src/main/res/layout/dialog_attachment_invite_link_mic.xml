<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_ffffff_12_radius_rectangle"
    android:layout_width="295dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_bg_top"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_avatar"
        android:background="@drawable/white_circle_shape"
        android:padding="2dp"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/default_circle_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_guard"
        android:background="@drawable/bg_ff846b_ff606a_11radius_retangle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/white_circle_shape"
            android:padding="3dp"
            android:layout_width="@dimen/dimen_18dp"
            android:layout_height="18dp"
            android:src="@drawable/zalive_list_tag_guard"
            android:layout_marginStart="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/tv_guard_msg"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/your_guard"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_nick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_42475e"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/iv_current_level"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/tv_nickname"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_666978"
        android:gravity="center"
        android:id="@+id/tv_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_nick_name"/>
    <FrameLayout
        android:id="@+id/layout_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg">
        <Button
            android:textSize="15sp"
            android:textColor="@color/color_8b76f9"
            android:layout_gravity="start"
            android:id="@+id/btn_left"
            android:layout_width="127dp"
            android:layout_height="match_parent"
            android:layout_marginStart="15dp"
            android:stateListAnimator="@null"
            style="@style/CommonMiddleStrokeBtnStyle"/>
        <Button
            android:textSize="15sp"
            android:layout_gravity="end"
            android:id="@+id/btn_right"
            android:layout_width="127dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="15dp"
            android:stateListAnimator="@null"
            style="@style/CommonMiddleFullBtnStyle"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_btn">
        <ImageView
            android:id="@+id/iv_check_img"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/icon_live_audio_check_box_status_normal"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_666978"
            android:id="@+id/tv_link_mic_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/iv_check_img"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
