<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:layout_gravity="center"
        android:id="@+id/tabLayout"
        android:paddingTop="17dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp52"
        app:zIndicatorCornerRadius="2dp"
        app:zIndicatorEndColor="@color/white"
        app:zIndicatorHeight="@dimen/dp4"
        app:zIndicatorScrollScale="false"
        app:zIndicatorStartColor="@color/white"
        app:zIndicatorWidth="@dimen/dp16"
        app:zSelectedTextColor="@color/color_e6ffffff"
        app:zSelectedTextSize="16sp"
        app:zTabMode="scrollable"
        app:zTabPaddingLeft="17dp"
        app:zTabPaddingRight="17dp"
        app:zTextBold="text_bold_when_select"
        app:zUnSelectedTextColor="@color/color_99_fff"
        app:zUnSelectedTextSize="16sp"/>
    <View
        android:background="@color/color_14_fff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="327dp"/>
</LinearLayout>
