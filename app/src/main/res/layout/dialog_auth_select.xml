<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_close_v8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rect_white_r16"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="13dp"
        android:layout_marginHorizontal="13dp">
        <com.zhenai.common.widget.RoundCornerImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="16dp"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/dialog_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_select_list"
            android:layout_width="match_parent"
            android:layout_height="184dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_title_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
