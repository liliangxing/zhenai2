<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/beauty_content"
    android:background="#141629"
    android:layout_width="match_parent"
    android:layout_height="279dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_title"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <com.zhenai.lib.zaui.tablayout.ZTabLayout
            android:id="@+id/choose_tab"
            android:paddingBottom="3dp"
            android:layout_width="130dp"
            android:layout_height="55dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:zIndicatorColorOrientation="left_right"
            app:zIndicatorCornerRadius="1dp"
            app:zIndicatorEndColor="#ffffff"
            app:zIndicatorHeight="4dp"
            app:zIndicatorMarginBottom="10dp"
            app:zIndicatorScrollScale="true"
            app:zIndicatorStartColor="#ffffff"
            app:zIndicatorStyle="line"
            app:zIndicatorWidth="16dp"
            app:zSelectedTextColor="#ffffff"
            app:zSelectedTextSize="16sp"
            app:zTabMode="fixed"
            app:zTabWidth="62dp"
            app:zUnSelectedTextColor="#99ffffff"
            app:zUnSelectedTextSize="16sp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_beauty"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/icon_fu_beauty_reset_white"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/choose_tab"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/choose_tab"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.business.widget.view_pager.NoScrollViewPager
        android:id="@+id/choose_content"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:overScrollMode="never"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/content_tail"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <ImageView
            android:id="@+id/close"
            android:background="@drawable/take_photo_dialog_back"
            android:layout_width="24dp"
            android:layout_height="26dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="73dp"
            android:layout_marginVertical="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/take_photo_action"
            app:layout_constraintEnd_toStartOf="@+id/take_photo_action"
            app:layout_constraintTop_toTopOf="@+id/take_photo_action"/>
        <ImageView
            android:id="@+id/take_photo_action"
            android:background="@drawable/take_photo_action_small"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="97dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/choose_content"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
