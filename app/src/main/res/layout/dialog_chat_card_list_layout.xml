<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/view_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/root"
        android:background="@drawable/bg_common_dialog_v8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/gradientBg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#42475c"
                    android:gravity="center"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/chat_card_list_title"
                    android:includeFontPadding="false"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="#666978"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/middle_content_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp24"
                android:text="@string/chat_card_list_tips"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp4"
                android:layout_marginHorizontal="@dimen/dp24"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_chat_card_target"
                    android:paddingBottom="20dp"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="185dp"
                    android:scrollIndicators="right"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/button_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_12dp"
                android:layout_marginStart="@dimen/dimen_24dp"
                android:layout_marginEnd="@dimen/dimen_24dp">
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/right_btn"
                    android:background="@drawable/bg_rectangle_767dff_22r_shape"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="成为会员，解锁更多人的消息"
                    style="?android:attr/borderlessButtonStyle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_6c6d75"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/card_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_close_v8"
        android:background="@drawable/ic_close_v8"
        android:visibility="visible"
        android:layout_width="@dimen/dp26"
        android:layout_height="@dimen/dp26"
        android:layout_marginTop="-34dp"
        android:layout_alignTop="@+id/root"
        android:layout_marginEnd="-13dp"
        android:layout_alignEnd="@+id/root"/>
</RelativeLayout>
