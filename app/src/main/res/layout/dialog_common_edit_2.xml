<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_content"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/rect_white_r16_top"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_26273c"
            android:id="@+id/tv_title"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="17dp"
            android:drawablePadding="8dp"
            android:layout_marginHorizontal="16dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:textColorHint="@color/color_6c6d75"
            android:gravity="start|top"
            android:id="@+id/edt_input"
            android:background="@drawable/rect_f2f4f5_r12"
            android:padding="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:textCursorDrawable="@drawable/editext_cursor_shape_8"
            android:layout_marginHorizontal="16dp"/>
        <TextView
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/bg_rectangle_767dff_40r_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/done"
            android:layout_marginHorizontal="16dp"/>
    </LinearLayout>
</FrameLayout>
