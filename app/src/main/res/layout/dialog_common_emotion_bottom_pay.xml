<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:background="@color/black_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_dialog"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/viewstub_guide_banner"
            android:layout="@layout/layout_zhenai_coin_dialog_guide_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/login_btn_sweet_date_shape"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="15dp"
                android:text="@string/sure_recharge_price"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/dimen_10dp"
                app:layout_constraintTop_toBottomOf="@+id/recharge_way"/>
            <ImageView
                android:id="@+id/img_zhen_ai_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_zhenai_coin"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/tv_zhen_ai_value_title"
                app:layout_constraintStart_toEndOf="@+id/tv_zhen_ai_value_title"
                app:layout_constraintTop_toTopOf="@+id/tv_zhen_ai_value_title"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_zhen_ai_pay_protocol"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_sure">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#b9b9b9"
                    android:id="@+id/tv_pay_terms_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支付即同意"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_8b76f9"
                    android:id="@+id/tv_pay_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《珍爱币用户协议》"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/recharge_way"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_recharge_way">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_wechat"
                    android:background="@drawable/bg_recharge_checked_old"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:layout_marginEnd="@dimen/dimen_4dp">
                    <ImageView
                        android:layout_width="@dimen/dimen_20dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_wechat"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:id="@+id/tv_pay_wechat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_wechat"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_alipay"
                    android:background="@drawable/bg_emotion_recharge_unchecked"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_4dp"
                    android:layout_marginEnd="@dimen/dimen_4dp">
                    <ImageView
                        android:layout_width="@dimen/dimen_20dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_alipay"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_alipay"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_union"
                    android:background="@drawable/bg_emotion_recharge_unchecked"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_4dp"
                    android:layout_marginEnd="@dimen/dimen_10dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_union"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_union"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="#666978"
                android:gravity="center"
                android:id="@+id/tv_zhen_ai_value_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="当前余额："
                android:layout_marginStart="@dimen/dimen_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="#ff666978"
                android:id="@+id/tv_zhen_ai_value"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_3dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_zhen_ai_icon"
                app:layout_constraintStart_toEndOf="@+id/img_zhen_ai_icon"
                app:layout_constraintTop_toTopOf="@+id/img_zhen_ai_icon"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff666978"
                android:id="@+id/tv_recharge_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:text="支付方式："
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_recharge_num"/>
            <View
                android:id="@+id/view_line"
                android:background="#efefef"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_1dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhen_ai_value_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recharge_num"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
