<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/layout_bg"
        android:layout_width="295dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:src="@drawable/bg_attachment_guard_guide_dialog_top"
        android:layout_centerHorizontal="true"
        app:borderRadius="12dp"
        app:roundImageType="round"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475e"
        android:id="@+id/anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/be_in_connecting_mode"
        android:layout_below="@+id/anchor_name"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/btn_open_guard"
        android:background="@drawable/common_long_btn_normal_za7_without_shadow"
        android:layout_width="265dp"
        android:layout_height="44dp"
        android:layout_marginBottom="20dp"
        android:text="@string/open_guard"
        android:layout_alignBottom="@+id/layout_bg"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        style="@style/CommonMiddleFullBtnStyle"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textStyle="bold"
        android:textColor="@color/color_42475e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/be_guarder_tips"
        android:layout_above="@+id/btn_open_guard"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/dimen_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-17dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_alignTop="@+id/layout_bg"
        android:layout_marginEnd="-17dp"
        android:layout_alignEnd="@+id/layout_bg"/>
</RelativeLayout>
