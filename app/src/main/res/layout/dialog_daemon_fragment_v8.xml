<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/topImageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_live_v8_daemon_dialog_top_image"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:id="@+id/tabLayout"
        android:paddingTop="@dimen/dp23"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:zIndicatorCornerRadius="2dp"
        app:zIndicatorEndColor="@color/white"
        app:zIndicatorHeight="@dimen/dp4"
        app:zIndicatorScrollScale="false"
        app:zIndicatorStartColor="@color/white"
        app:zIndicatorWidth="@dimen/dp16"
        app:zSelectedTextColor="@color/white"
        app:zSelectedTextSize="16sp"
        app:zTabMode="scrollable"
        app:zTabPaddingLeft="17dp"
        app:zTabPaddingRight="17dp"
        app:zTextBold="text_bold_when_select"
        app:zUnSelectedTextColor="@color/white_60"
        app:zUnSelectedTextSize="16sp"/>
    <ImageView
        android:id="@+id/profileBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_live_v8_daemon_dialog_profile"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/topImageView"/>
    <FrameLayout
        android:id="@+id/avatarLayout"
        android:background="@drawable/bg_daemon_avatar_guard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/profileBackground">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/avatarImageView"
            android:layout_width="@dimen/dp56"
            android:layout_height="@dimen/dp56"
            android:src="@drawable/default_circle_avatar"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/nickName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp25"
        app:layout_constraintBottom_toTopOf="@+id/guardTimeTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toTopOf="@+id/profileBackground"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:id="@+id/guardTimeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp25"
        app:layout_constraintBottom_toBottomOf="@+id/profileBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nickName"
        app:layout_constraintTop_toBottomOf="@+id/nickName"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp335"
        app:layout_constraintTop_toBottomOf="@+id/profileBackground"/>
</androidx.constraintlayout.widget.ConstraintLayout>
