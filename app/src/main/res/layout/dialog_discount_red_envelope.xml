<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black_60"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.libpag.PAGView
        android:id="@+id/pag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.004"/>
    <Space
        android:id="@+id/top_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pag"
        app:layout_constraintEnd_toEndOf="@+id/pag"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toStartOf="@+id/pag"
        app:layout_constraintTop_toTopOf="@+id/pag"
        app:layout_constraintVertical_bias="0.3"/>
    <Space
        android:id="@+id/bottom_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pag"
        app:layout_constraintEnd_toEndOf="@+id/pag"
        app:layout_constraintHorizontal_bias="0.84"
        app:layout_constraintStart_toStartOf="@+id/pag"
        app:layout_constraintTop_toTopOf="@+id/pag"
        app:layout_constraintVertical_bias="0.81"/>
    <View
        android:id="@+id/check_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_end"
        app:layout_constraintEnd_toEndOf="@+id/bottom_end"
        app:layout_constraintStart_toStartOf="@+id/top_start"
        app:layout_constraintTop_toTopOf="@+id/top_start"/>
    <Space
        android:id="@+id/space_start_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pag"
        app:layout_constraintEnd_toEndOf="@+id/pag"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/pag"
        app:layout_constraintTop_toTopOf="@+id/pag"
        app:layout_constraintVertical_bias="0.24"/>
    <Space
        android:id="@+id/space_end_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/pag"
        app:layout_constraintEnd_toEndOf="@+id/pag"
        app:layout_constraintHorizontal_bias="0.88"
        app:layout_constraintStart_toStartOf="@+id/pag"
        app:layout_constraintTop_toTopOf="@+id/pag"
        app:layout_constraintVertical_bias="0.35"/>
    <View
        android:id="@+id/close"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_end_bottom"
        app:layout_constraintEnd_toEndOf="@+id/space_end_bottom"
        app:layout_constraintStart_toStartOf="@+id/space_start_top"
        app:layout_constraintTop_toTopOf="@+id/space_start_top"/>
</androidx.constraintlayout.widget.ConstraintLayout>
