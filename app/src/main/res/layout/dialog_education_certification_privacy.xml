<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/bg_common_dialog_v8"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/gradientBg"
        android:layout_width="@dimen/dp279"
        android:layout_height="100dp"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_26273C"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_24dp"
        app:layout_constraintEnd_toEndOf="@+id/gradientBg"
        app:layout_constraintStart_toStartOf="@+id/gradientBg"
        app:layout_constraintTop_toTopOf="@+id/gradientBg"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/protocolLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp19"
        android:layout_marginStart="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="@+id/gradientBg"
        app:layout_constraintStart_toStartOf="@+id/gradientBg"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <CheckBox
            android:id="@+id/agreeCheckBox"
            android:background="@color/transparent"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="@dimen/dp30"
            android:layout_height="@dimen/dp30"
            android:button="@null"
            android:drawableStart="@drawable/show_shcool_setting_check_box_selector"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp6"
            android:paddingVertical="@dimen/dp8"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="start"
            android:layout_gravity="start"
            android:id="@+id/agreeProtocol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_767dff"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@drawable/bg_767dff_rectangle_22_radius_stroke"
        android:layout_width="@dimen/dp112"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="4dp"
        app:layout_constraintStart_toStartOf="@+id/gradientBg"
        app:layout_constraintTop_toTopOf="@+id/go2certify"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/go2certify"
        android:background="@drawable/bg_rectangle_767dff_22r_shape"
        android:layout_width="@dimen/dp112"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp21"
        android:text="@string/identification_txt_identify"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="@+id/gradientBg"
        app:layout_constraintTop_toBottomOf="@+id/protocolLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
