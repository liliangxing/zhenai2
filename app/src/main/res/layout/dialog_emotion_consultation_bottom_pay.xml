<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:background="@color/black_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:background="@color/white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sure"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_10dp"
            android:layout_marginTop="44dp"
            android:layout_marginRight="@dimen/dimen_10dp"
            android:text="@string/sure_recharge_price"
            app:bg_colorGradientEnd="@color/color_8070f1"
            app:bg_colorGradientStart="@color/color_b06cef"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_5dp"
            app:bg_shape="round"
            app:layout_constraintTop_toBottomOf="@+id/recharge_way"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_zhen_ai_pay_protocol"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sure">
            <TextView
                android:textSize="11sp"
                android:textColor="#b9b9b9"
                android:id="@+id/tv_pay_terms_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支付即同意"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_8b76f9"
                android:id="@+id/tv_pay_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="《珍爱情感电话咨询服务协议》"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/recharge_way"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_recharge_way">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_wechat"
                android:background="@drawable/bg_recharge_checked_old"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_marginEnd="@dimen/dimen_4dp">
                <ImageView
                    android:layout_width="@dimen/dimen_20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pay_type_wechat"
                    android:layout_marginEnd="@dimen/dimen_5dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff666978"
                    android:gravity="center"
                    android:id="@+id/tv_pay_wechat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_wechat"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_alipay"
                android:background="@drawable/bg_emotion_recharge_unchecked"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_marginEnd="@dimen/dimen_4dp">
                <ImageView
                    android:layout_width="@dimen/dimen_20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pay_type_alipay"
                    android:layout_marginEnd="@dimen/dimen_5dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff666978"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_alipay"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_union"
                android:background="@drawable/bg_emotion_recharge_unchecked"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_marginEnd="@dimen/dimen_10dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pay_type_union"
                    android:layout_marginEnd="@dimen/dimen_5dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff666978"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_union"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff666978"
            android:id="@+id/tv_recharge_way"
            android:paddingTop="@dimen/dimen_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:text="支付方式："
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_recharge_num"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
