<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="350dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coin_balance"
            android:layout_marginStart="15dp"/>
        <ImageView
            android:background="@drawable/icon_zhen_ai_coin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_666978"
            android:id="@+id/coin_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#9267f6"
            android:id="@+id/emotion_clazz_recharge"
            android:padding="@dimen/dimen_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exclusive_recharge_dialog_sure"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:id="@+id/anchor_header"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="@string/emotion_course_list"
        android:paddingStart="15dp"
        android:paddingEnd="0dp"/>
    <View
        android:id="@+id/divide"
        android:background="#efefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/clazz_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
