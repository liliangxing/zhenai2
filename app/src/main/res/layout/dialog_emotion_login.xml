<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:paddingBottom="@dimen/dimen_10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_content"
            android:layout_width="295dp"
            android:layout_height="295dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp26"
            android:layout_height="@dimen/dp26"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:layout_marginRight="@dimen/dimen_8dp"
            android:src="@drawable/ic_live_video_dialog_close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:enabled="true"
            android:id="@+id/btn_look"
            android:background="@drawable/common_long_btn_normal_za7"
            android:layout_width="295dp"
            android:layout_height="66dp"
            android:text="立即查看"
            app:layout_constraintTop_toBottomOf="@+id/iv_content"
            style="@style/common_long_btn_style"/>
        <CheckBox
            android:textSize="12sp"
            android:textColor="@color/color_848484"
            android:id="@+id/cb_no_more_week"
            android:paddingLeft="@dimen/dimen_4dp"
            android:paddingTop="@dimen/dimen_4dp"
            android:paddingRight="@dimen/dimen_4dp"
            android:paddingBottom="@dimen/dimen_4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/mass_layer_round_check_selector"
            android:text="@string/emotion_layer_checkbox_hint"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_look"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
