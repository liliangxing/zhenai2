<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_pic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space_margin_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_pic"
        app:layout_constraintHeight_percent="0.05"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/tv_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:height="100dp"
        app:layout_constraintBottom_toTopOf="@+id/space_margin_bottom"
        app:layout_constraintEnd_toEndOf="@+id/img_pic"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="@+id/img_pic"
        app:layout_constraintWidth_percent="0.65"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_close_v8"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toTopOf="@+id/img_pic"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
