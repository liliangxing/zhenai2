<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_freely_chat_guide_verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginTop="97dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="26dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8b76f9"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:maxWidth="180dp"
            android:text="@string/ta_feel_good_with_you"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_666978"
            android:id="@+id/tv_content"
            android:layout_width="185dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ta_use_freely_chat_you_can_chat_now"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_safety_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="@string/freely_chat_verify_tips"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#8b76f9"
            android:gravity="center_horizontal"
            android:id="@+id/btn_verify_now"
            android:background="@drawable/bg_btn_freely_chat_guide_verify"
            android:paddingTop="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="6dp"
            android:text="@string/verify_and_chat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_safety_tips"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:background="@drawable/dialog_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="10dp"/>
</FrameLayout>
