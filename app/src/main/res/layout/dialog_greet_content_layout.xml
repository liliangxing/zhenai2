<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/view_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/root"
        android:background="@drawable/bg_common_dialog_v8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/gradientBg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/color_26273C"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_6c6d75"
                android:layout_gravity="center_horizontal"
                android:id="@+id/middle_content_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp24"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp4"
                android:layout_marginHorizontal="@dimen/dp24"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/button_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_12dp"
                android:layout_marginStart="@dimen/dimen_24dp"
                android:layout_marginEnd="@dimen/dimen_24dp">
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/write_btn"
                    android:background="@drawable/bg_rectangle_767dff_22r_shape"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/write_say_hi_content"
                    style="?android:attr/borderlessButtonStyle"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/close_btn"
                    android:background="@color/color_transparent"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/close_str"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_greet_content"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="-24dp"
        android:src="@drawable/greet_content_icon"
        android:layout_alignTop="@+id/root"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
