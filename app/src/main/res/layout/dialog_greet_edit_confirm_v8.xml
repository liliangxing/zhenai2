<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/rect_white_r16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/gradientBg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_17sp"
            android:textColor="@color/color_26273c"
            android:id="@+id/dialog_greet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp23"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center"
            android:id="@+id/dialog_greet_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/greet_count_over_limit_content_no_gift_v8"
            android:layout_below="@+id/dialog_greet_title"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_greet_title"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_write_more"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp42"
            android:layout_marginLeft="@dimen/dp23"
            android:layout_marginTop="@dimen/dp23"
            android:layout_marginRight="@dimen/dp23"
            android:text="@string/greet_count_edit_more"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/dp23"
            app:bg_colorNormal="@color/color_767dff"
            app:bg_fillMode="color"
            app:bg_radius="@dimen/dp22"
            app:bg_shape="round"
            app:layout_constraintTop_toBottomOf="@+id/dialog_greet_content"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_767dff"
            android:gravity="center_horizontal"
            android:id="@+id/btn_continue_save"
            android:paddingLeft="@dimen/dp20"
            android:paddingTop="@dimen/dp5"
            android:paddingRight="@dimen/dp20"
            android:paddingBottom="@dimen/dp23"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:text="@string/greet_count_continue_save"
            android:layout_below="@+id/btn_write_more"
            android:layout_centerHorizontal="true"
            android:paddingHorizontal="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_write_more"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
