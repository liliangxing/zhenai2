<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_guard_guide_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:tag="binding_1"
        android:background="@drawable/live_dialog_close_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/dialog_guard_guide_top_bg"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/my_avatar"
            android:tag="binding_2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="37dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="25dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/my_level"
            android:tag="binding_3"
            android:background="@drawable/icon_zhenxin_rank_range5"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:minWidth="@dimen/dimen_40dp"
            android:paddingStart="25dp"
            app:layout_constraintBottom_toBottomOf="@+id/my_avatar"
            app:layout_constraintEnd_toEndOf="@+id/my_avatar"
            app:layout_constraintStart_toStartOf="@+id/my_avatar"/>
        <ImageView
            android:background="@drawable/dialog_guard_guide_top_icon"
            android:layout_width="48dp"
            android:layout_height="54dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/object_avatar"
            android:tag="binding_4"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="7dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginEnd="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/object_level"
            android:tag="binding_5"
            android:background="@drawable/icon_zhenxin_rank_range5"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:minWidth="@dimen/dimen_40dp"
            app:layout_constraintBottom_toBottomOf="@+id/object_avatar"
            app:layout_constraintEnd_toEndOf="@+id/object_avatar"
            app:layout_constraintStart_toStartOf="@+id/object_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_ffffff_12_radius_rectangle"
        android:paddingBottom="@dimen/dimen_24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/top_view"
            android:background="@drawable/bg_rectangle_a5726ff_shape"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:background="@drawable/dialog_guard_guide_center_bg"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            app:layout_constraintTop_toBottomOf="@+id/top_view"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273C"
            android:id="@+id/title"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/content"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gift_layout"
            android:background="@drawable/bg_767dff_8_radius_rectangle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="@dimen/dimen_20dp"
            android:layout_marginEnd="@dimen/dimen_20dp"
            app:layout_constraintTop_toBottomOf="@+id/content">
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/color_191C32"
                android:id="@+id/gift_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_12dp"
                app:layout_constraintBottom_toTopOf="@+id/gift_desc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/gift_desc"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/gift_name"
                app:layout_constraintTop_toBottomOf="@+id/gift_name"/>
            <ImageView
                android:id="@+id/gift_img"
                android:tag="binding_9"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/dimen_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:tag="binding_10"
            android:background="@drawable/bg_767dff_radius_shape"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/live_dialog_send_gift_and_mic_btn_txt"
            android:layout_marginStart="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_24dp"
            app:layout_constraintTop_toBottomOf="@+id/gift_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
