<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="260dp">
    <View
        android:background="@drawable/bg_guide_gift_tips_dialog"
        android:layout_width="match_parent"
        android:layout_height="260dp"/>
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/tips_avatar_frame_layout"
        android:padding="@dimen/dimen_4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:avatar_height="60dp"
        app:avatar_width="60dp"
        app:imgBg="@drawable/bg_live_hn_match_gift_send_tip_head"
        app:setSvgaDimen="true"
        app:svga_height="95dp"
        app:svga_width="95dp"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textStyle="bold"
        android:textColor="@color/color_42475e"
        android:gravity="center"
        android:id="@+id/txt_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/tips_avatar_frame_layout"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/dimen_6dp"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475e_60"
        android:gravity="center"
        android:id="@+id/txt_userinfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_below="@+id/txt_nickname"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/dimen_6dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:id="@+id/txt_send_gift_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_below="@+id/txt_userinfo"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/dimen_6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="15dp"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/layout_send_gift"
            android:background="@drawable/bg_send_gift_purple_corner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_flower_icon"
                android:layout_width="@dimen/dimen_30dp"
                android:layout_height="@dimen/dimen_30dp"
                android:layout_marginLeft="@dimen/dimen_20dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_flower_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginTop="7dp"
                android:layout_toRightOf="@+id/iv_flower_icon"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:id="@+id/txt_flower_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginBottom="7dp"
                android:layout_toRightOf="@+id/iv_flower_icon"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_send_chat"
            android:background="@drawable/bg_live_rectangle_purple_corner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="15dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_bixin_icon"
                android:layout_width="@dimen/dimen_30dp"
                android:layout_height="@dimen/dimen_30dp"
                android:layout_marginLeft="@dimen/dimen_20dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_send_bixin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginTop="7dp"
                android:layout_toRightOf="@+id/iv_bixin_icon"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:id="@+id/txt_send_bixin_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:layout_marginBottom="7dp"
                android:layout_toRightOf="@+id/iv_bixin_icon"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
