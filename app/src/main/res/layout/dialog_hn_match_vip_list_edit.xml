<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="27dp"
    android:paddingRight="27dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:background="@drawable/bg_ffffffff_rectangle_r8_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="#ff42475c"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="见面信息"
            android:paddingStart="@dimen/dimen_10dp"
            android:paddingEnd="@dimen/dimen_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="见面日期："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_start_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_start_time"/>
        <TextView
            android:textSize="9sp"
            android:textColor="#ff8b76f5"
            android:gravity="center"
            android:id="@+id/tv_start_time"
            android:background="@drawable/bg_ffe8e4fd_rectangle_r2_r2_shape"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_marginTop="17dp"
            android:text="@string/vip_list_edit_dialog_start_time"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="9sp"
            android:textColor="#ff8b76f5"
            android:gravity="center"
            android:id="@+id/tv_end_time"
            android:background="@drawable/bg_ffe8e4fd_rectangle_r2_r2_shape"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_marginTop="17dp"
            android:text="@string/vip_list_edit_dialog_end_time"
            android:layout_marginStart="@dimen/dimen_5dp"
            app:layout_constraintStart_toEndOf="@+id/tv_start_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP客户id："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_vip_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_vip_id"/>
        <EditText
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:ellipsize="end"
            android:id="@+id/et_vip_id"
            android:background="@drawable/bg_fff2f2f2_rectangle_r2_shape"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:maxLines="1"
            android:inputType="number"
            android:imeOptions="actionSearch"
            android:paddingStart="@dimen/dimen_10dp"
            android:paddingEnd="50dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_end_time"
            app:layout_constraintStart_toStartOf="@+id/tv_start_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_start_time"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_vip_search"
            android:background="@drawable/bg_ff8b76f9_rectangle_r2_shape"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:text="查询"
            android:layout_marginEnd="@dimen/dimen_2dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_vip_id"
            app:layout_constraintEnd_toEndOf="@+id/et_vip_id"
            app:layout_constraintTop_toTopOf="@+id/et_vip_id"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="昵称："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_vip_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_vip_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:ellipsize="end"
            android:id="@+id/tv_vip_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dimen_10dp"
            app:layout_constraintEnd_toEndOf="@+id/et_vip_id"
            app:layout_constraintStart_toStartOf="@+id/et_vip_id"
            app:layout_constraintTop_toBottomOf="@+id/et_vip_id"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="头像："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_vip_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_vip_header"/>
        <ImageView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:id="@+id/img_vip_header"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="@+id/tv_vip_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="约见对象id："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_inviter_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_inviter_id"/>
        <EditText
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:ellipsize="end"
            android:id="@+id/et_inviter_id"
            android:background="@drawable/bg_fff2f2f2_rectangle_r2_shape"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:inputType="number"
            android:imeOptions="actionSearch"
            android:paddingStart="@dimen/dimen_10dp"
            android:paddingEnd="50dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_end_time"
            app:layout_constraintStart_toStartOf="@+id/tv_start_time"
            app:layout_constraintTop_toBottomOf="@+id/img_vip_header"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_inviter_search"
            android:background="@drawable/bg_ff8b76f9_rectangle_r2_shape"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:text="查询"
            android:layout_marginEnd="@dimen/dimen_2dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_inviter_id"
            app:layout_constraintEnd_toEndOf="@+id/et_inviter_id"
            app:layout_constraintTop_toTopOf="@+id/et_inviter_id"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="昵称："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_inviter_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_inviter_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:ellipsize="end"
            android:id="@+id/tv_inviter_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dimen_10dp"
            app:layout_constraintEnd_toEndOf="@+id/et_vip_id"
            app:layout_constraintStart_toStartOf="@+id/et_vip_id"
            app:layout_constraintTop_toBottomOf="@+id/et_inviter_id"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="头像："
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_inviter_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_inviter_header"/>
        <ImageView
            android:textSize="12sp"
            android:textColor="#ff666978"
            android:id="@+id/img_inviter_header"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_line"
            app:layout_constraintStart_toStartOf="@+id/tv_inviter_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_inviter_name"/>
        <View
            android:id="@+id/bottom_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1dp"
            android:layout_marginTop="26dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_inviter_header"/>
        <Button
            android:textSize="16sp"
            android:textColor="#ff8570f1"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:background="@drawable/bg_ff8570f1_rectangle_r2_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="@dimen/dimen_18dp"
            android:text="提交"
            android:layout_marginStart="@dimen/dimen_15dp"
            android:layout_marginEnd="@dimen/dimen_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_inviter_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_top_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_content"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_live_video_dialog_close"
        app:layout_constraintBottom_toBottomOf="@+id/view_top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_top_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
