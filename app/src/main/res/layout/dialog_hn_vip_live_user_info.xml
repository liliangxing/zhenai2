<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:bg_colorNormal="@color/white"
        app:bg_radius="@dimen/dimen_9dp"
        app:bg_shape="round">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/dimen_16dp"
            android:paddingBottom="@dimen/dimen_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_9942475c"
                android:id="@+id/report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report"
                android:layout_marginStart="@dimen/dimen_15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_avatar"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:src="@drawable/default_circle_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_advantage"
                android:paddingBottom="19dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginStart="@dimen/dimen_15dp"
                android:layout_marginEnd="@dimen/dimen_15dp"
                app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_42475c"
                android:ellipsize="end"
                android:id="@+id/tv_introduce"
                android:paddingTop="17dp"
                android:paddingBottom="@dimen/dimen_20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/live_hn_match_vip_no_introduce"
                android:maxLines="5"
                android:layout_marginStart="27dp"
                android:layout_marginEnd="27dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_advantage"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_other_profile"
                android:background="@drawable/bg_live_rectangle_purple_corner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="11dp"
                android:text="@string/personal_profile_page"
                android:layout_marginStart="@dimen/dimen_30dp"
                android:layout_marginEnd="@dimen/dimen_30dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_force_other_end_live"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="#ff824be5"
                android:gravity="center"
                android:id="@+id/tv_force_other_end_live"
                android:background="@drawable/bg_live_rectangle_purple_corner_line"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="@dimen/dimen_15dp"
                android:text="@string/kick_out"
                android:layout_marginStart="@dimen/dimen_30dp"
                android:layout_marginEnd="@dimen/dimen_30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_other_profile"/>
            <View
                android:id="@+id/bottom_line"
                android:background="#ffd8d8d8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dimen_8dp"
                android:layout_marginBottom="17dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_end_live"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_a088fa"
                android:gravity="center_horizontal"
                android:id="@+id/tv_end_live"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/go_down_mir"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_live_video_dialog_close"/>
</FrameLayout>
