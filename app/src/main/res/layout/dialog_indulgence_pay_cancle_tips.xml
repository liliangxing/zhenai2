<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/bg_white_6dp_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="42.5dp"
        android:layout_marginEnd="42.5dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_737583"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="47dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_sure"
            android:background="@drawable/bg_new_person_pay_coin_guide_btn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/tv_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:background="@drawable/ic_close_style_zhenai"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="35dp"/>
</FrameLayout>
