<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="332dp"
    android:layout_height="404dp"
    android:layout_centerVertical="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/infomation_pager"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="300dp"
        android:layout_height="372dp">
        <FrameLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <com.zhenai.lib.zaui.tablayout.ZTabLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/tab_layout_title"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                app:zIndicatorCornerRadius="2dp"
                app:zIndicatorEndColor="@color/color_8b76f9"
                app:zIndicatorEqualTitle="true"
                app:zIndicatorHeight="3dp"
                app:zIndicatorScrollScale="true"
                app:zIndicatorStartColor="@color/color_8b76f9"
                app:zSelectedTextColor="@color/color_12131a"
                app:zSelectedTextSize="15sp"
                app:zTabMode="fixed"
                app:zTextBold="text_bold_both"
                app:zUnSelectedTextColor="@color/color_12131a"
                app:zUnSelectedTextSize="15sp"/>
        </FrameLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:layout_marginRight="-16dp"
        android:layout_alignTop="@+id/infomation_pager"
        android:layout_alignRight="@+id/infomation_pager"
        app:srcCompat="@drawable/icon_close_gray"/>
</RelativeLayout>
