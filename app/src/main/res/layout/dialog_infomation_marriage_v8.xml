<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/infomation_pager"
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:layout_width="match_parent"
        android:layout_height="418dp"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="48dp">
        <com.zhenai.common.widget.RadioRoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            app:borderRadius="16dp"
            app:height_weight="330"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="round"
            app:width_weight="837"/>
        <com.zhenai.lib.zaui.tablayout.ZTabLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/tab_layout_title"
            android:layout_width="180dp"
            android:layout_height="38dp"
            android:layout_marginTop="18dp"
            android:layout_centerHorizontal="true"
            app:zIndicatorCornerRadius="2dp"
            app:zIndicatorEndColor="@color/color_767dff"
            app:zIndicatorEqualTitle="true"
            app:zIndicatorHeight="4dp"
            app:zIndicatorScrollScale="true"
            app:zIndicatorStartColor="@color/color_767dff"
            app:zIndicatorWidth="22dp"
            app:zSelectedTextColor="@color/color_26273C"
            app:zSelectedTextSize="18sp"
            app:zTabMode="fixed"
            app:zTextBold="text_bold_both"
            app:zUnSelectedTextColor="@color/color_6C6D75"
            app:zUnSelectedTextSize="18sp"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/tab_layout_title"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="14dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ic_close_v8"/>
</RelativeLayout>
