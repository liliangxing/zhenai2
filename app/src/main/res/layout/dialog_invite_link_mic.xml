<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_invite_link_mic_0"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:paddingBottom="56dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white_90"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/live_invite_link_mic_dialog_des"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/link_other_anchor"
        android:tag="binding_1"
        android:background="@drawable/invite_link_mic_item_bg_radius_shape"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:id="@+id/link_other_anchor_icon"
            android:background="@drawable/link_other_anchor_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white_90"
            android:id="@+id/link_other_anchor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_invite_link_mic_dialog_link_other_anchor_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/link_other_anchor_des"
            app:layout_constraintStart_toEndOf="@+id/link_other_anchor_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_60"
            android:id="@+id/link_other_anchor_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/live_invite_link_mic_dialog_link_other_anchor_des"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/link_other_anchor_title"
            app:layout_constraintTop_toBottomOf="@+id/link_other_anchor_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/link_other_anchor_arrow"
            android:background="@drawable/invite_right_arrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.live.widget.AvatarsLineView
            android:id="@+id/link_other_anchor_avatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/link_other_anchor_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/one_key_convene_layout"
        android:tag="binding_2"
        android:background="@drawable/invite_link_mic_item_bg_radius_shape"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintTop_toBottomOf="@+id/link_other_anchor">
        <ImageView
            android:id="@+id/one_key_icon"
            android:background="@drawable/live_dialog_one_key_convene_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white_90"
            android:id="@+id/one_key_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_invite_link_mic_dialog_one_key_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/one_key_des"
            app:layout_constraintStart_toEndOf="@+id/one_key_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_60"
            android:id="@+id/one_key_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/live_invite_link_mic_dialog_one_key_des"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/one_key_title"
            app:layout_constraintTop_toBottomOf="@+id/one_key_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:background="@drawable/invite_right_arrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/poke_layout"
        android:tag="binding_3"
        android:background="@drawable/invite_link_mic_item_bg_radius_shape"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintTop_toBottomOf="@+id/one_key_convene_layout">
        <ImageView
            android:id="@+id/poke_icon"
            android:background="@drawable/live_dialog_poke_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white_90"
            android:id="@+id/poke_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_invite_link_mic_dialog_poke_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/poke_des"
            app:layout_constraintStart_toEndOf="@+id/poke_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_60"
            android:id="@+id/poke_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:text="@string/live_invite_link_mic_dialog_poke_des"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/poke_title"
            app:layout_constraintTop_toBottomOf="@+id/poke_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:background="@drawable/invite_right_arrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/invite_layout"
        android:tag="binding_4"
        android:background="@drawable/invite_link_mic_item_bg_radius_shape"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintTop_toBottomOf="@+id/poke_layout">
        <ImageView
            android:id="@+id/invite_icon"
            android:background="@drawable/live_dialog_invite_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white_90"
            android:id="@+id/invite_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_invite_link_mic_dialog_invite_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/invite_des"
            app:layout_constraintStart_toEndOf="@+id/invite_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_60"
            android:id="@+id/invite_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:text="@string/live_invite_link_mic_dialog_invite_des"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/invite_title"
            app:layout_constraintTop_toBottomOf="@+id/invite_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:background="@drawable/invite_right_arrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
