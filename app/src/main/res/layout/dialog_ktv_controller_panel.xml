<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:paddingBottom="45dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controller_str"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_original_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/original_song"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <Switch
        android:id="@+id/switch_original_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_ffffff_17dp_oval"
        android:track="@drawable/switch_custom_track_selector_4"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_original_song"
        app:layout_constraintStart_toEndOf="@+id/tv_original_song"
        app:layout_constraintTop_toTopOf="@+id/tv_original_song"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_auricular_gyrus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/auricular_gyrus"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="72dp"
        app:layout_constraintEnd_toStartOf="@+id/switch_auricular_gyrus"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <Switch
        android:id="@+id/switch_auricular_gyrus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_ffffff_17dp_oval"
        android:track="@drawable/switch_custom_track_selector_4"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_auricular_gyrus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_auricular_gyrus"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_person_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/person_volume"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_original_song"/>
    <SeekBar
        android:id="@+id/seekbar_person_volume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="20"
        android:progressDrawable="@drawable/ktv_controller_seekbar_progress"
        android:thumb="@drawable/ktv_controller_thumb"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_person_volume"
        app:layout_constraintEnd_toStartOf="@+id/tv_person_volume_count"
        app:layout_constraintStart_toEndOf="@+id/tv_person_volume"
        app:layout_constraintTop_toTopOf="@+id/tv_person_volume"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/tv_person_volume_count"
        android:layout_width="25dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_person_volume"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_music_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/music_volume"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_person_volume"/>
    <SeekBar
        android:id="@+id/seekbar_music_volume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="20"
        android:progressDrawable="@drawable/ktv_controller_seekbar_progress"
        android:thumb="@drawable/ktv_controller_thumb"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_music_volume"
        app:layout_constraintEnd_toStartOf="@+id/tv_music_volume_count"
        app:layout_constraintStart_toEndOf="@+id/tv_music_volume"
        app:layout_constraintTop_toTopOf="@+id/tv_music_volume"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/tv_music_volume_count"
        android:layout_width="25dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_music_volume"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_lifting_adjustment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="39dp"
        android:text="@string/lifting_adjustment"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_music_volume"/>
    <SeekBar
        android:id="@+id/seekbar_lifting_adjustment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="22"
        android:progress="11"
        android:progressDrawable="@drawable/ktv_controller_seekbar_progress"
        android:thumb="@drawable/ktv_controller_thumb"
        android:layout_marginStart="59dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_lifting_adjustment"
        app:layout_constraintEnd_toStartOf="@+id/tv_music_volume_count"
        app:layout_constraintStart_toEndOf="@+id/tv_lifting_adjustment"
        app:layout_constraintTop_toTopOf="@+id/tv_lifting_adjustment"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="end"
        android:id="@+id/tv_lifting_adjustment_count"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:text="0.0"
        android:maxLines="1"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_lifting_adjustment"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_scene"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekbar_lifting_adjustment"/>
</androidx.constraintlayout.widget.ConstraintLayout>
