<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/bg_ffffff_16_radius_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitStart"
            app:layout_constraintTop_toTopOf="parent"
            app:radius_left_up="@dimen/dp16"
            app:radius_right_up="@dimen/dp16"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="18sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:text="珍爱ktv开唱啦"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/tv_title"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_open_now"
            android:background="@drawable/bg_common_btn_full_767dff_22_radio"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/open_now_time_step"
            android:layout_below="@+id/tv_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/imag_ktv_pick_guide"
        android:layout_width="132dp"
        android:layout_height="132dp"/>
</FrameLayout>
