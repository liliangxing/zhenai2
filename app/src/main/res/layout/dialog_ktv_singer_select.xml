<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ffffff_16_radius_rectangle"
    android:layout_width="297dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="48dp"
    android:layout_marginEnd="48dp">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitStart"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="@dimen/dp16"
        app:radius_right_up="@dimen/dp16"
        app:roundImageType="round"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="18sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/please_select_singer"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_singer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_sure"
        android:background="@drawable/bg_common_btn_full_767dff_22_radio"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/sure_select_singer"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_singer"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_select_for_him"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_sure">
        <CheckBox
            android:id="@+id/checkbox_agree"
            android:background="@drawable/user_privacy_check_box_selector_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="start"
            android:id="@+id/tv_select_for_him"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本场默认点给ta不再提醒"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="@string/select_singer_tips"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_select_for_him"/>
</androidx.constraintlayout.widget.ConstraintLayout>
