<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_btn"
        android:background="@drawable/ic_close_v8"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableImageView
        android:id="@+id/rootBackground"
        android:layout_width="279dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="13dp"
        app:bg_colorNormal="@color/white"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp16"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/close_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_btn"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginTop="0dp"/>
    <ImageView
        android:id="@+id/topImageView"
        android:background="@drawable/bg_live_v8_middle_dialog_top_image"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/rootBackground"
        app:layout_constraintStart_toStartOf="@+id/rootBackground"
        app:layout_constraintTop_toTopOf="@+id/rootBackground"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rootBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rootBackground">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_link_mir"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="25dp"
            android:text="@string/get_link_mir_privilege"
            app:bg_colorNormal="@color/color_767dff"
            app:bg_radius="@dimen/dp22"
            app:bg_shape="round"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
