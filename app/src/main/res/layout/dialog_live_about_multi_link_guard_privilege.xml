<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/layout_content"
        android:background="@drawable/bg_guard_privilege_content"
        android:layout_width="295dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_operate"
        android:background="@drawable/btn_bg_live_guard_privilege_operrate"
        android:paddingTop="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_multi_link_mir_now"
        android:layout_alignBottom="@+id/layout_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_alignStart="@+id/layout_content"
        android:layout_alignEnd="@+id/layout_content"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/dimen_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_marginEnd="-15dp"
        android:layout_alignEnd="@+id/layout_content"/>
</RelativeLayout>
