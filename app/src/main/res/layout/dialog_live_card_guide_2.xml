<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="305dp"
        android:layout_height="463dp">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/layout_content"
            android:background="@color/white"
            android:layout_width="279dp"
            android:layout_height="429dp"
            android:layout_marginTop="34dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:background="@drawable/bg_dialog_v8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="@dimen/dimen_18sp"
                android:textColor="@color/color_26273C"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:text="@string/live_card_introduction"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="57dp">
                <TextView
                    android:textColor="@color/color_6C6D75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_point"
                    android:layout_marginStart="@dimen/dimen_15dp"/>
                <TextView
                    android:textColor="@color/color_6C6D75"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_point_details"
                    android:lineSpacingExtra="@dimen/dimen_2dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_marginEnd="@dimen/dimen_16dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="107dp">
                <TextView
                    android:textColor="@color/color_6C6D75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/second_point"
                    android:layout_marginStart="@dimen/dimen_15dp"/>
                <TextView
                    android:textColor="@color/color_6C6D75"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/second_point_details"
                    android:lineSpacingExtra="@dimen/dimen_2dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_marginEnd="@dimen/dimen_16dp"/>
            </LinearLayout>
            <com.opensource.svgaplayer.SVGAPlayer
                android:layout_gravity="bottom"
                android:id="@+id/guide_anim_man_view_svga"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="258dp"
                app:antiAlias="true"
                app:autoPlay="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:source="card_match_men_guide.svga"/>
            <com.opensource.svgaplayer.SVGAPlayer
                android:layout_gravity="bottom"
                android:id="@+id/guide_anim_woman_view_svga"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="258dp"
                app:antiAlias="true"
                app:autoPlay="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:source="card_match_women_guide.svga"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_close_v8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
