<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_setting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:text="@string/setting"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_alignParentStart="true"/>
    <RelativeLayout
        android:id="@+id/link_mic_record_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_setting_title"
        android:layout_alignParentStart="true">
        <View
            android:background="@color/color_eaeaea"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_link_mic_record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="17dp"
            android:text="@string/not_allow_link_user_record"
            android:layout_marginStart="14dp"/>
        <Switch
            android:id="@+id/switch_link_mic_record_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="17dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/switch_custom_thumb"
            android:track="@drawable/switch_custom_track_selector"
            android:switchMinWidth="32dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/link_mic_need_agree_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/link_mic_record_layout"
        android:layout_alignParentStart="true">
        <View
            android:background="@color/color_eaeaea"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_link_mic_need_agree_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/link_mic_need_agree"
            android:layout_marginStart="14dp"/>
        <Switch
            android:id="@+id/switch_link_mic_need_agree_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/switch_custom_thumb"
            android:track="@drawable/switch_custom_track_selector"
            android:switchMinWidth="32dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6642475c"
            android:id="@+id/tv_link_mic_need_agree_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="27dp"
            android:text="@string/link_mic_need_agree_tips1"
            android:layout_below="@+id/tv_link_mic_need_agree_title"
            android:layout_marginStart="14dp"/>
    </RelativeLayout>
</RelativeLayout>
