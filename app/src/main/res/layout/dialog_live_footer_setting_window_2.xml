<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:paddingBottom="58dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_setting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/live_invite_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/link_mic_record_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_alignParentStart="true"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_link_mic_record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:text="@string/not_allow_link_user_record"
            android:layout_marginStart="16dp"/>
        <Switch
            android:id="@+id/switch_link_mic_record_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="17dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/switch_custom_thumb_3"
            android:track="@drawable/switch_custom_track_selector_3"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="22dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/link_mic_need_agree_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:layout_constraintTop_toBottomOf="@+id/link_mic_record_layout">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_link_mic_need_agree_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/link_mic_need_agree"
            android:layout_marginStart="16dp"/>
        <Switch
            android:id="@+id/switch_link_mic_need_agree_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/switch_custom_thumb_3"
            android:track="@drawable/switch_custom_track_selector_3"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="22dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white_60"
            android:id="@+id/tv_link_mic_need_agree_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:text="@string/link_mic_need_agree_tips1"
            android:layout_below="@+id/tv_link_mic_need_agree_title"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/link_setting"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/link_mic_need_agree_layout">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_mic_setting_title"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/link_setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/link_setting"/>
        <ImageView
            android:background="@drawable/icon_setting_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/link_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/link_setting"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
