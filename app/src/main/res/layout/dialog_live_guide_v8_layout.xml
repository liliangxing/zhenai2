<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="279dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/dialog_viewpager"
            android:layout_width="match_parent"
            android:layout_height="244dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#27273c"
            android:gravity="center"
            android:id="@+id/bottom_tv"
            android:background="@color/color_f2f4f5"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
    </LinearLayout>
    <com.zhenai.business.widget.indicator.IndicatorLayout
        android:id="@+id/indicator_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:item_image_margin="9dp"
        app:item_image_size="12dp"
        app:item_selected_image_res_id="@drawable/indicator_circle_selected_v8"
        app:item_unselected_image_res_id="@drawable/indicator_circle_unselected_v8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_content"/>
    <ImageView
        android:layout_width="220dp"
        android:layout_height="83dp"
        android:src="@drawable/live_guide_dialog_v8_title_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/dialog_close_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@drawable/live_guide_dialog_v8_close_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
