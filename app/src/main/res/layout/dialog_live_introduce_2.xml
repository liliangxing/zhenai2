<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:paddingBottom="58dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/close_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/my_live_introduce"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_custom_live_introduce"/>
        <Switch
            android:layout_gravity="end"
            android:id="@+id/switch_live_introduce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/switch_custom_thumb_3"
            android:track="@drawable/switch_custom_track_selector_3"/>
    </FrameLayout>
    <View
        android:background="@color/white_10"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/show_intro_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/avatar_group"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_upload_avatar"
                android:background="@drawable/default_avatar"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
        </FrameLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/avatar_group"
            app:layout_constraintTop_toTopOf="@+id/avatar_group"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white_60"
            android:id="@+id/advantage_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tv_nickname"
            app:layout_constraintStart_toStartOf="@+id/tv_nickname"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_767dff"
            android:id="@+id/edit_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:drawablePadding="5dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatar_group"/>
        <EditText
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textColorHint="@color/white_40"
            android:gravity="start"
            android:id="@+id/live_introduce_words"
            android:background="@drawable/rect_white_08_r8"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:minHeight="63dp"
            android:hint="@string/custom_live_introduce_words"
            android:maxLines="3"
            android:maxLength="61"
            android:textCursorDrawable="@drawable/greet_edit_cursor_shape"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="6dp"
            app:layout_constraintTop_toBottomOf="@+id/avatar_group"/>
        <ImageView
            android:id="@+id/cb_show_pic_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/cb_show_pic"
            app:layout_constraintStart_toStartOf="@+id/live_introduce_words"
            app:layout_constraintTop_toTopOf="@+id/cb_show_pic"/>
        <CheckBox
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/white_40"
            android:gravity="start|top"
            android:id="@+id/cb_show_pic"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:button="@null"
            android:text="@string/live_introduce_show_pic"
            app:layout_constraintEnd_toEndOf="@+id/live_introduce_words"
            app:layout_constraintStart_toEndOf="@+id/cb_show_pic_icon"
            app:layout_constraintTop_toBottomOf="@+id/live_introduce_words"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_sure"
            android:background="@drawable/common_btn_v8"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="15dp"
            android:text="@string/sure"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/cb_show_pic"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/show_your_live_introduce"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/show_your_live_introduce"
        android:layout_marginHorizontal="16dp"/>
    <ImageView
        android:id="@+id/live_introduce_pic"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="16dp"/>
</LinearLayout>
