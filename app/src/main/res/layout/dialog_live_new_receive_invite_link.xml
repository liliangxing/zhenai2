<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ffffff_12_radius_rectangle"
    android:paddingBottom="@dimen/dimen_24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:background="@drawable/bg_live_v8_middle_dialog_top_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/avatar_img"
        android:background="@drawable/default_circle_avatar"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_img"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="房主邀请你连麦，是否接受"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nickname"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gift_layout"
        android:background="@drawable/bg_767dff_8_radius_rectangle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintTop_toBottomOf="@+id/title_tv">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textStyle="bold"
            android:id="@+id/gift_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_request_link_mic_txt"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toTopOf="@+id/gift_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:id="@+id/gift_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@{entity.giftDesc}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/gift_title"
            app:layout_constraintTop_toBottomOf="@+id/gift_title"/>
        <ImageView
            android:id="@+id/gift_img"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:id="@+id/btn_ok"
        android:background="@drawable/bg_767dff_radius_shape"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:text="@string/agree_invite_link_mir"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_24dp"
        app:layout_constraintTop_toBottomOf="@+id/gift_layout"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_767dff"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:text="@string/live_reject_invite_link_mir"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_24dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_ok"/>
</androidx.constraintlayout.widget.ConstraintLayout>
