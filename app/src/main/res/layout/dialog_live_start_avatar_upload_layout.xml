<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="279dp"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_bg_view"
        android:background="@drawable/bg_common_dialog_corner_16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="70dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundCornerImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialog_bg_view"
        app:radius="16dp"/>
    <ImageView
        android:id="@+id/dialog_icon_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_upload_avatar_v8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#26273c"
        android:gravity="center"
        android:id="@+id/dialog_title_view"
        android:layout_width="231dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="上传头像"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_icon_view"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:gravity="start"
        android:id="@+id/dialog_content_view"
        android:layout_width="231dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="当前没有上传头像，可能会影响其他人通过直播认识你，上传后开播可获得更多推荐曝光哦"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/dialog_content_view">
        <TextView
            android:textSize="16sp"
            android:textColor="#767dff"
            android:gravity="center"
            android:id="@+id/upload_avatar_tv"
            android:background="@drawable/bg_ffffff_store_767dff_r40_shape"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="上传头像"
            android:layout_weight="1"
            android:layout_marginEnd="7dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/goto_live_tv"
            android:background="@drawable/bg_btn_767dff_shape"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="直接开播"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:id="@+id/bottom_space_view"
        android:layout_width="100dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_button_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
