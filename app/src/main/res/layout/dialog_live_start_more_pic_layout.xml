<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="305dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_close_v8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_common_dialog_corner_16dp"
        android:paddingBottom="24dp"
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_iv">
        <com.zhenai.common.widget.RoundCornerImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="16dp"/>
        <com.zhenai.base.widget.viewpager.AutoScrollViewPager
            android:id="@+id/more_pic_view_pager"
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_marginTop="27dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/space_layout"
            android:background="@drawable/bg_f3f5f6_bottom_r12_shape"
            android:layout_width="172dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/more_pic_view_pager"
            app:layout_constraintStart_toStartOf="@+id/more_pic_view_pager"
            app:layout_constraintTop_toBottomOf="@+id/more_pic_view_pager">
            <View
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <View
                android:background="@color/white"
                android:layout_width="63dp"
                android:layout_height="14dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="11dp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:id="@+id/tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="多图轮播封面能吸引更多有缘人"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space_layout"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/goto_upload_tv"
            android:background="@drawable/bg_btn_767dff_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="21dp"
            android:text="前往上传"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
