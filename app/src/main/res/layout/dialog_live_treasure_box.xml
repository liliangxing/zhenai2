<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="292dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/bg_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_treasure_box_get"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:id="@+id/retain_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="207dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bg_box"/>
        <Button
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_box"
            android:background="@drawable/btn_get_treasure_box"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/live_treasure_box_get"
            app:layout_constraintTop_toBottomOf="@+id/bg_box"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_box_gift"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_50dp"
            android:layout_marginTop="@dimen/dp234"
            android:layout_marginRight="@dimen/dimen_50dp"
            android:layout_marginHorizontal="@dimen/dimen_50dp"
            app:layout_constraintEnd_toEndOf="@+id/btn_box"
            app:layout_constraintStart_toStartOf="@+id/btn_box"
            app:layout_constraintTop_toTopOf="@+id/bg_box"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="#ffe7a6"
            android:gravity="center"
            android:id="@+id/box_exit"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/live_treasure_box_exit"
            android:layout_marginEnd="23dp"
            app:bg_colorGradientEnd="@color/transparent"
            app:bg_colorGradientStart="@color/transparent"
            app:bg_colorStroke="#ffe7a6"
            app:bg_fillMode="linearGradient"
            app:bg_linearGradientOrientation="left_right"
            app:bg_radius="23dp"
            app:bg_shape="round"
            app:bg_strokeMode="solid"
            app:bg_strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/box_wait_get"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@+id/bg_box"
            app:layout_constraintTop_toBottomOf="@+id/bg_box"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/box_wait_get"
            android:background="@drawable/btn_treasure_box"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/live_treasure_box_wait_get"
            app:layout_constraintEnd_toEndOf="@+id/bg_box"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/box_exit"
            app:layout_constraintTop_toBottomOf="@+id/bg_box"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_wait"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="box_exit,box_wait_get"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/dialog_close_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:src="@drawable/live_guide_dialog_v8_close_view"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
