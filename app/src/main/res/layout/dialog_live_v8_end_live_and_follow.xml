<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ffffff_12_radius_rectangle"
    android:paddingBottom="@dimen/dp40"
    android:layout_width="279dp"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/bg_live_v8_follow_and_end_live"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp142"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/avatarImageView"
        android:background="@drawable/white_circle_shape"
        android:padding="@dimen/dp2"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp31"
        android:text="@string/live_tips_end_live_and_follow_dialog"
        android:layout_marginStart="@dimen/dp37"
        app:bg_bitmap="@drawable/bg_live_v8_dialog_live_end_follow_tips"
        app:bg_fillMode="bitmap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:gravity="center"
        android:id="@+id/nickNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatarImageView"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/tipsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nickNameTextView"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/followAndLeaveTextView"
        android:paddingTop="@dimen/dp14"
        android:paddingBottom="@dimen/dp14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:text="@string/live_follow_and_end_live"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:bg_colorNormal="@color/color_767dff"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp22"
        app:bg_shape="round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tipsTextView"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_767dff"
        android:id="@+id/leave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/live_end_live_at_once"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/followAndLeaveTextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
