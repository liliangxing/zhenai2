<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_live_v8_profile_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/emptyClickSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/topImageView"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@drawable/bg_ffffffff_rectangle_tltrr16_shape"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topImageView"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableImageView
        android:id="@+id/topImageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp52"
        app:bg_bitmap="@drawable/bg_live_v8_profile_dialog"
        app:bg_fillMode="bitmap"
        app:bg_radiusLeftTop="@dimen/dp16"
        app:bg_radiusRightTop="@dimen/dp16"
        app:bg_shape="round"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/report"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="@+id/topImageView"
        app:layout_constraintTop_toTopOf="@+id/topImageView"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/manage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manager_text"
        android:layout_marginEnd="@dimen/dp20"
        app:layout_constraintEnd_toStartOf="@+id/report"
        app:layout_constraintTop_toTopOf="@+id/report"/>
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/nickName"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp68"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvRecommendTa"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/topImageView"
        app:layout_constraintTop_toTopOf="@+id/topImageView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/iconLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintStart_toStartOf="@+id/nickName"
        app:layout_constraintTop_toBottomOf="@+id/nickName">
        <com.zhenai.business.widget.FlagLayout
            android:id="@+id/flagLayout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp4"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/rankTv"
            android:tag="binding_2"
            android:layout_width="@dimen/dp38"
            android:layout_height="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_goneMarginStart="0dp"/>
        <ImageView
            android:id="@+id/metalImageView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp16"
            android:adjustViewBounds="true"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:ellipsize="end"
        android:id="@+id/advantageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp9"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/iconLayout"
        app:layout_goneMarginTop="@dimen/dp8"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/atTaTextView"
        android:tag="binding_3"
        android:background="@drawable/bg_f2f4f5_rectangle_r18_shape"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp28"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/nickName"
        app:layout_constraintEnd_toEndOf="@+id/topImageView"
        app:layout_constraintTop_toTopOf="@+id/nickName"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/tvRecommendTa"
        android:background="@drawable/bg_f2f4f5_rectangle_r18_shape"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp28"
        android:layout_marginEnd="@dimen/dp8"
        android:paddingHorizontal="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/nickName"
        app:layout_constraintEnd_toStartOf="@+id/atTaTextView"
        app:layout_constraintTop_toTopOf="@+id/nickName"
        app:layout_goneMarginEnd="24dp"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/introduceTextView"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/advantageTextView"/>
    <ImageView
        android:id="@+id/guardBackGround"
        android:background="@drawable/bg_live_v8_profile_dialog_guard_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/introduceTextView"/>
    <ImageView
        android:id="@+id/iconGuard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_live_v8_profile_dialog_guard_layout"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/guardBackGround"
        app:layout_constraintStart_toStartOf="@+id/guardBackGround"
        app:layout_constraintTop_toTopOf="@+id/guardBackGround"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/guardTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/iconGuard"
        app:layout_constraintStart_toEndOf="@+id/iconGuard"
        app:layout_constraintTop_toTopOf="@+id/iconGuard"/>
    <FrameLayout
        android:id="@+id/guardAvatarsLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp72"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/guardBackGround"
        app:layout_constraintEnd_toStartOf="@+id/rightArrow"
        app:layout_constraintTop_toTopOf="@+id/guardBackGround">
        <ImageView
            android:id="@+id/guardAvatar1"
            android:tag="binding_5"
            android:background="@drawable/bg_circle_white"
            android:padding="@dimen/dp1"
            android:visibility="gone"
            android:layout_width="@dimen/dp28"
            android:layout_height="@dimen/dp28"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/guardAvatar2"
            android:tag="binding_6"
            android:background="@drawable/bg_circle_white"
            android:padding="@dimen/dp1"
            android:visibility="gone"
            android:layout_width="@dimen/dp28"
            android:layout_height="@dimen/dp28"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp22"/>
        <ImageView
            android:id="@+id/guardAvatar3"
            android:tag="binding_7"
            android:background="@drawable/bg_circle_white"
            android:padding="@dimen/dp1"
            android:visibility="gone"
            android:layout_width="@dimen/dp28"
            android:layout_height="@dimen/dp28"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp44"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/rightArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/right_arrow"
        android:layout_marginEnd="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="@+id/guardBackGround"
        app:layout_constraintEnd_toEndOf="@+id/guardBackGround"
        app:layout_constraintTop_toTopOf="@+id/guardBackGround"
        app:tint="@color/color_26273C"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/photosLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/guardBackGround"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/followTextView"
        android:tag="binding_8"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp20"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintBottom_toTopOf="@+id/operationLayout"
        app:layout_constraintEnd_toStartOf="@+id/chatTextView"
        app:layout_constraintHorizontal_weight="1.53"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photosLayout"
        app:layout_goneMarginBottom="@dimen/dp20"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/chatTextView"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:text="@string/live_secret_send_message"
        android:layout_marginStart="@dimen/dp8"
        app:bg_colorNormal="#fff2f4f5"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp22"
        app:bg_shape="round"
        app:layout_constraintEnd_toStartOf="@+id/go2ProfileTextView"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/followTextView"
        app:layout_constraintTop_toTopOf="@+id/followTextView"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/go2ProfileTextView"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:text="@string/live_go2_profile"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp24"
        app:bg_colorNormal="#fff2f4f5"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp22"
        app:bg_shape="round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/chatTextView"
        app:layout_constraintTop_toTopOf="@+id/chatTextView"/>
    <FrameLayout
        android:id="@+id/operationLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="#0d26273c"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp2"
            android:layout_marginStart="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp24"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/operationTextView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"/>
    </FrameLayout>
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/avatarImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp6"
        app:avatar_height="@dimen/dp80"
        app:avatar_width="@dimen/dp80"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:setSvgaDimen="true"
        app:stroke_background="@drawable/bg_circle_white"
        app:stroke_size="@dimen/dp84"
        app:svga_height="@dimen/dp120"
        app:svga_width="@dimen/dp120"/>
    <FrameLayout
        android:id="@+id/guardAvatarLayout"
        android:tag="binding_9"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp112"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topImageView">
        <ImageView
            android:layout_gravity="center"
            android:tag="binding_10"
            android:layout_width="@dimen/dp34"
            android:layout_height="@dimen/dp34"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_live_v8_guard_avatar_profile_dialog"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
