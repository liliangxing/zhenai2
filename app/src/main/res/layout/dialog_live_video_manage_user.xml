<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/dimen_8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_20sp"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/cancel"
        app:bg_colorNormal="@color/white"
        app:bg_colorPressed="@color/white_80"
        app:bg_radius="@dimen/dimen_10dp"
        app:bg_shape="round"
        app:bg_stateMode="clickable"/>
</LinearLayout>
