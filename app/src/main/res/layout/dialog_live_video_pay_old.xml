<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/relativelayout"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_white_4dp_radius"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginRight="34dp"
        android:layout_centerVertical="true">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/bannerImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dialog_live_video_pay_banner"
            app:radius_left_up="4dp"
            app:radius_right_up="4dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#666978"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="14dp"
            android:text="@string/no_member_only_one"/>
        <FrameLayout
            android:id="@+id/layout_opt_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_operation_0"
                android:background="@drawable/dialog_live_video_pay_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="@string/open_and_start_video"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/iv_discount_1"
                android:visibility="visible"
                android:layout_width="54dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_opt_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_operation_1"
                android:background="@drawable/dialog_live_video_pay_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/iv_discount_2"
                android:visibility="visible"
                android:layout_width="54dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:background="@drawable/ic_live_video_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-11dp"
        android:layout_alignTop="@+id/evaluatelay"
        android:layout_alignRight="@+id/evaluatelay"/>
</RelativeLayout>
