<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/semitransparent_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_close_v8"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toTopOf="@+id/center_content"
        app:layout_constraintEnd_toEndOf="@+id/center_content"
        app:layout_constraintStart_toEndOf="@+id/center_content"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/center_content"
        android:layout_width="286dp"
        android:layout_height="wrap_content"
        app:bg_colorNormal="@color/white"
        app:bg_radius="16dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextureView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="286dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:id="@+id/iv_video_cover"
            android:layout_width="match_parent"
            android:layout_height="286dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:id="@+id/shadow_view_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_50dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:id="@+id/shadow_view_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_50dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignBottom="@+id/video_view"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:id="@+id/view_mask"
            android:layout_width="match_parent"
            android:layout_height="286dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@+id/video_view">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_6c6d75"
                android:gravity="center"
                android:id="@+id/tv_save_to_local"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/save_to_local"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                android:background="@color/color_05_191c32"
                android:layout_width="1dp"
                android:layout_height="24dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_767dff"
                android:gravity="center"
                android:id="@+id/tv_release_moments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/release_moments"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
