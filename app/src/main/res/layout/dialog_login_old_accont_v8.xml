<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/layout"
        android:background="@drawable/bg_common_dialog_v8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginRight="34dp"
        android:layout_centerInParent="true">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/gradientBg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_26273C"
            android:id="@+id/nickname_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp120"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.business.widget.label_layout.LabelLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/label_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:auto_select_effect="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nickname_tv"
            app:layout_goneMarginTop="@dimen/dp110"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6C6D75"
            android:gravity="center_horizontal"
            android:id="@+id/update_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:text="该手机号已在珍爱注册过"
            android:lineSpacingExtra="6dp"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_lay"/>
        <Button
            android:id="@+id/btn_direct_login"
            android:background="@drawable/bg_rectangle_767dff_22r_shape"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:text="@string/direct_login"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintTop_toBottomOf="@+id/update_tip"
            style="@style/common_long_btn_style_8.0_no_shadow"/>
        <Button
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/re_register_new_account"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:layout_marginBottom="22dp"
            android:text="@string/re_register_new_account"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_direct_login"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_width="135dp"
        android:layout_height="135dp"
        android:layout_marginTop="-24dp"
        android:src="@drawable/register_select_v8"
        android:layout_alignTop="@+id/layout"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
