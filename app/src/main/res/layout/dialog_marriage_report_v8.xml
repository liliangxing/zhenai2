<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="@dimen/dp360"
    android:layout_height="550dp"
    android:layout_centerVertical="true">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/main_container"
        android:background="@drawable/bg_common_dialog_v8"
        android:layout_width="@dimen/dp314"
        android:layout_height="397dp">
        <RelativeLayout
            android:id="@+id/main_container_anim"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhenai.common.widget.RoundImageView
                android:layout_gravity="center"
                android:id="@+id/head_view"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="-1dp"
                android:layout_marginRight="-1dp"
                android:src="@drawable/dialog_bg_report"
                android:scaleType="fitXY"
                app:radius_left_up="4dp"
                app:radius_right_up="4dp"
                app:roundImageType="round"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="49dp"
                android:layout_marginRight="20dp"
                android:text="@string/generated_by_big_data"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="21dp"
                android:layout_marginTop="18dp"
                android:src="@drawable/glass_bg"/>
            <ImageView
                android:id="@+id/glass_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="33dp"
                android:layout_marginTop="45dp"
                android:src="@drawable/glass_view"/>
            <FrameLayout
                android:id="@+id/star_1"
                android:background="@drawable/star_glass_big_circle"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="62dp"
                android:layout_marginTop="22dp"/>
            <FrameLayout
                android:id="@+id/star_2"
                android:background="@drawable/star_glass_small_circle"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="102dp"/>
            <ImageView
                android:id="@+id/star_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="126dp"
                android:layout_marginTop="71dp"
                android:src="@drawable/glass_big_star"/>
            <ImageView
                android:id="@+id/star_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="38dp"
                android:layout_marginTop="41dp"
                android:src="@drawable/glass_small_star"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/items_analyzing_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-10dp"
                android:layout_below="@+id/head_view">
                <ImageView
                    android:id="@+id/item_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/item_bg_analyzing"
                    android:scaleType="centerInside"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-10dp"
                android:layout_below="@+id/head_view">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">
                    <FrameLayout
                        android:id="@+id/point_analyzing1"
                        android:background="@drawable/circle_black_item"
                        android:visibility="gone"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginLeft="31dp"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#bcbcbc"
                        android:id="@+id/text_analyzing1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="51dp"
                        android:text="@string/watch_report_item1"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/checkbox_analyzing1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="29dp"
                        android:src="@drawable/checkbox_analyzing_pre"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">
                    <FrameLayout
                        android:id="@+id/point_analyzing2"
                        android:background="@drawable/circle_black_item"
                        android:visibility="gone"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginLeft="31dp"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#bcbcbc"
                        android:id="@+id/text_analyzing2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="51dp"
                        android:text="@string/watch_report_item2"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/checkbox_analyzing2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="29dp"
                        android:src="@drawable/checkbox_analyzing_pre"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">
                    <FrameLayout
                        android:id="@+id/point_analyzing3"
                        android:background="@drawable/circle_black_item"
                        android:visibility="gone"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginLeft="31dp"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#bcbcbc"
                        android:id="@+id/text_analyzing3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="51dp"
                        android:text="@string/watch_report_item3"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#8670f1"
                        android:id="@+id/text_wating3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:layout_toRightOf="@+id/text_analyzing3"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/checkbox_analyzing3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="29dp"
                        android:src="@drawable/checkbox_analyzing_pre"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btn_watch_report"
                android:visibility="gone"
                android:text="@string/sayhi_and_watch_report"
                android:layout_alignParentBottom="true"
                style="@style/common_long_btn_style"/>
        </RelativeLayout>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/gradientBg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/bg_dialog_v8"
            android:scaleType="fitXY"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <ScrollView
            android:id="@+id/scroll_view"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.zhenai.common.widget.BoldTextView
                    android:textSize="27sp"
                    android:textColor="@color/color_767dff"
                    android:gravity="center_vertical"
                    android:id="@+id/match_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp55"
                    android:layout_alignTop="@+id/fl_avatar"
                    android:layout_alignBottom="@+id/fl_avatar"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/color_767dff"
                    android:gravity="center_vertical"
                    android:id="@+id/match_point_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="@string/match_point"
                    android:layout_toLeftOf="@+id/match_point"
                    android:layout_alignTop="@+id/fl_avatar"
                    android:layout_alignBottom="@+id/fl_avatar"/>
                <FrameLayout
                    android:id="@+id/fl_avatar"
                    android:background="@drawable/marriage_report_avatar_bg"
                    android:layout_width="@dimen/dp90"
                    android:layout_height="@dimen/dp90"
                    android:layout_marginTop="@dimen/dp13"
                    android:layout_marginStart="@dimen/dp42">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/my_avatar_iv"
                        android:layout_width="@dimen/dp54"
                        android:layout_height="@dimen/dp54"
                        android:src="@drawable/default_circle_avatar"/>
                </FrameLayout>
                <FrameLayout
                    android:background="@drawable/marriage_report_avatar_bg"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="@dimen/dp13">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/other_avatar_iv"
                        android:layout_width="@dimen/dp54"
                        android:layout_height="@dimen/dp54"
                        android:src="@drawable/default_circle_avatar"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/quote_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp19"
                    android:layout_marginTop="107dp"
                    android:src="@drawable/ic_quote_left_v8"/>
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_summarize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_4dp"
                    android:layout_marginRight="31dp"
                    android:layout_toRightOf="@+id/quote_left"
                    android:layout_alignTop="@+id/quote_left"/>
                <TextView
                    android:background="@drawable/bg_marriage_he"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp26"
                    android:layout_below="@+id/report_summarize"/>
                <TextView
                    android:background="@drawable/bg_marriage_she"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="26dp"
                    android:layout_marginTop="@dimen/dp26"
                    android:layout_below="@+id/report_summarize"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="42dp"
                    android:layout_marginTop="@dimen/dp23"
                    android:text="@string/detail_analysis"
                    android:layout_below="@+id/report_summarize"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_detail"
                    android:background="@drawable/marriage_desc_dialog_detail_bg_v8"
                    android:padding="@dimen/dimen_12sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="20dp"
                    android:layout_below="@+id/report_detail_title"/>
                <com.zhenai.psychology_test.widget.MarriageReportTeacherInfoView
                    android:id="@+id/cl_teacher_info"
                    android:background="@drawable/marriage_desc_dialog_detail_bg_v8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_20dp"
                    android:layout_marginTop="@dimen/dimen_12dp"
                    android:layout_marginRight="@dimen/dimen_20dp"
                    android:layout_below="@+id/report_detail"/>
                <TextView
                    android:background="@drawable/bg_marriage_he"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="21dp"
                    android:layout_below="@+id/cl_teacher_info"/>
                <TextView
                    android:background="@drawable/bg_marriage_she"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="26dp"
                    android:layout_marginTop="21dp"
                    android:layout_below="@+id/cl_teacher_info"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_advise_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="42dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/stay_together_advise"
                    android:layout_below="@+id/cl_teacher_info"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_advise"
                    android:background="@drawable/marriage_desc_dialog_detail_bg_v8"
                    android:padding="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="20dp"
                    android:layout_below="@+id/report_advise_title"/>
                <TextView
                    android:id="@+id/report_recommend_course_left"
                    android:background="@drawable/bg_marriage_he"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp26"
                    android:layout_below="@+id/report_advise"/>
                <TextView
                    android:id="@+id/report_recommend_course_right"
                    android:background="@drawable/bg_marriage_she"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="26dp"
                    android:layout_marginTop="@dimen/dp26"
                    android:layout_below="@+id/report_advise"/>
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/report_recommend_course_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="42dp"
                    android:layout_marginTop="@dimen/dp23"
                    android:text="@string/recommend_course_tips"
                    android:layout_below="@+id/report_advise"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recommend_course"
                    android:background="@drawable/marriage_desc_dialog_detail_bg_v8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dimen_20dp"
                    android:layout_below="@+id/report_recommend_course_title"/>
            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:background="@drawable/ic_close_v8"
        android:visibility="visible"
        android:layout_width="@dimen/dp25"
        android:layout_height="@dimen/dp25"
        android:layout_marginTop="-33dp"
        android:layout_alignTop="@+id/main_container"
        android:layout_alignRight="@+id/main_container"
        android:layout_marginEnd="-13dp"/>
</RelativeLayout>
