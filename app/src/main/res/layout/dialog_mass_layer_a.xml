<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_parent"
    android:paddingTop="10dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="bottom"
            android:background="@drawable/mass_layer_image_bg"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginHorizontal="18dp"/>
        <ImageView
            android:id="@+id/iv_bg"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="18dp"
            android:layout_marginHorizontal="18dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/mass_layer_pass_btn"
            android:background="@drawable/icon_mass_layer_dialog_close"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_group"
        android:background="@drawable/bg_mass_layer_multi_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginHorizontal="18dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_mass_layer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_title"
                android:background="@drawable/mass_layer_a_title"
                android:visibility="gone"
                android:layout_width="168dp"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="top"
                    android:background="@drawable/icon_mass_layer_quote_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_slogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:layout_below="@+id/iv_title"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="6dp"/>
                <ImageView
                    android:layout_gravity="bottom"
                    android:background="@drawable/icon_mass_layer_quote_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:id="@+id/layout_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_mass_layer_multi_dash_line"
                    android:layout_width="54dp"
                    android:layout_height="2dp"
                    android:layerType="software"
                    android:layout_marginEnd="22dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_b1b1b1"
                    android:id="@+id/tv_recommend_for_you"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mass_layer_recommend_for_you"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_mass_layer_multi_dash_line"
                    android:layout_width="54dp"
                    android:layout_height="2dp"
                    android:layerType="software"
                    android:layout_marginStart="22dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarThumbVertical="@drawable/mass_layer_scroll_bar"
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/rv_recommend_list"
                android:scrollbars="vertical"
                android:layout_width="wrap_content"
                android:layout_height="225dp"
                android:layout_marginTop="9dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"/>
            <Button
                android:enabled="true"
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/mass_layer_say_hello_btn"
                android:background="@drawable/bg_btn_767dff_shape"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/mass_layer_say_hello"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff42475c"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/mass_custom_greet"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"/>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="96dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mass_layout_dialog_bottom_line"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffa1a1a1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mass_layer_bottom_tips"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:layout_width="96dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mass_layout_dialog_bottom_line"
                android:rotation="180"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
