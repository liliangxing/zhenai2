<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/bg_white_6dp_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="42.5dp"
        android:layout_marginEnd="42.5dp">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="match_parent"
            android:layout_height="290dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_indulgence_pay_dialog_tips"
            android:paddingTop="6dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_person_private"
            android:paddingStart="13dp"
            android:paddingEnd="15dp"
            android:layout_alignParentStart="true"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svga_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:layout_alignBottom="@+id/iv_avatar"
            app:antiAlias="true"
            app:autoPlay="true"/>
        <ImageView
            android:id="@+id/iv_gift_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:layout_alignBottom="@+id/iv_avatar"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_42475c"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:maxLines="1"
            android:layout_below="@+id/iv_avatar"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_737583"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tv_title"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_sure"
            android:background="@drawable/bg_new_person_pay_coin_guide_btn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/tv_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:background="@drawable/ic_close_style_zhenai"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="35dp"/>
</FrameLayout>
