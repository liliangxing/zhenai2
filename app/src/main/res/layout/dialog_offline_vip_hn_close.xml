<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/layout_root"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_dialog_content"
        android:background="@drawable/bg_round_white_style"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginRight="34dp"
        android:layout_centerVertical="true">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/bannerImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/dialog_live_video_pay_banner"
            app:radius_left_up="4dp"
            app:radius_right_up="4dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#666978"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="14dp"
            android:text="@string/dialog_offline_vip_hn_close_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_leave_temporarily"
            android:background="@drawable/dialog_live_video_pay_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="14dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_leave_temporarily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="14dp"
                android:text="@string/dialog_offline_vip_hn_close_btn_pause"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_pause_dec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="@string/dialog_offline_vip_hn_close_btn_pause_des"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_close"
            android:background="@drawable/dialog_live_video_pay_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="14dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="14dp"
                android:text="@string/dialog_offline_vip_hn_close_btn_close"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_close_dec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="@string/dialog_offline_vip_hn_close_btn_close_des"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="#824be5"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/live_video_apply_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="14dp"
            android:text="@string/cancel"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/img_close_dialog"
        android:background="@drawable/ic_live_video_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:layout_alignTop="@+id/layout_dialog_content"
        android:layout_marginEnd="-13dp"
        android:layout_alignEnd="@+id/layout_dialog_content"/>
</RelativeLayout>
