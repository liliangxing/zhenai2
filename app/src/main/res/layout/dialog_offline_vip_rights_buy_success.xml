<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="305dp"
        android:layout_height="390dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dialog_offline_buy_suc"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/layout_btn_str"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:layout_alignBottom="@+id/iv_image">
            <TextView
                android:textSize="10sp"
                android:textColor="#ff8b76f9"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本活动由"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff42475c"
                android:gravity="center"
                android:id="@+id/btn_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="珍爱优恋空间"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff8b76f9"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发起"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/btn_bottom"
            android:background="@drawable/login_btn_sweet_date_shape"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="9dp"
            android:text="领取特权"
            android:layout_above="@+id/layout_btn_str"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/layout_count_down_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_above="@+id/btn_bottom">
            <TextView
                android:textSize="12sp"
                android:textColor="#ff42475c"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="礼包领取时间剩余："/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffff8162"
                android:gravity="center"
                android:id="@+id/count_down_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:layout_marginRight="-16dp"
        android:layout_alignTop="@+id/view_dialog_content"
        android:layout_alignRight="@+id/view_dialog_content"
        android:elevation="10dp"
        app:srcCompat="@drawable/ic_common_dialog_close_btn"/>
</RelativeLayout>
