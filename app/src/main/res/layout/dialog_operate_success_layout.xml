<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_bg_view"
        android:background="@drawable/bg_common_dialog_corner_16dp"
        android:layout_width="270dp"
        android:layout_height="0dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="45dp"
        android:layout_marginHorizontal="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundCornerImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_bg_view"
        app:radius="16dp"/>
    <ImageView
        android:id="@+id/img_avatar_bg"
        android:layout_width="200dp"
        android:layout_height="132dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/ic_invite_wechat_dialog_top"
        app:layout_constraintEnd_toEndOf="@+id/img_avatar"
        app:layout_constraintStart_toStartOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/img_avatar"
        android:layout_width="83.5dp"
        android:layout_height="83.5dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#26273c"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_avatar_bg"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#26273c"
        android:id="@+id/tv_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <View
        android:id="@+id/wechat_bg"
        android:background="@drawable/bg_f2f4f5_rectangle_22_radius"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_id"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_wechat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wechat_number"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/wechat_bg"
        app:layout_constraintStart_toStartOf="@+id/wechat_bg"
        app:layout_constraintTop_toTopOf="@+id/wechat_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_wechat_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/wechat_number"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/wechat_bg"
        app:layout_constraintEnd_toEndOf="@+id/wechat_bg"
        app:layout_constraintStart_toEndOf="@+id/tv_wechat_title"
        app:layout_constraintTop_toTopOf="@+id/wechat_bg"
        app:layout_goneMarginEnd="14dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/bg_btn_767dff_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="23dp"
        android:text="复制微信号"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/wechat_bg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_a0a0a0"
        android:id="@+id/copy_wechat_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/confirm_btn"/>
    <View
        android:id="@+id/bottom_space_view"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/copy_wechat_tips"/>
    <ImageView
        android:id="@+id/dialog_close_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_close_v8"
        android:layout_marginStart="255dp"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
