<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp304">
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_good_amount_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="商品金额"
        android:layout_marginStart="@dimen/dp15"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_b9b9b9"
        android:id="@+id/tv_original_price"
        android:paddingRight="@dimen/dp3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_good_amount_title"
        app:layout_constraintRight_toLeftOf="@+id/tv_current_amount"
        app:layout_constraintTop_toTopOf="@+id/tv_good_amount_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_current_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp11"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:includeFontPadding="false"
        app:layout_constraintRight_toLeftOf="@+id/tv_current_zhenai_coin"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_current_zhenai_coin"
        android:paddingLeft="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp15"
        android:text="珍爱币"
        app:layout_constraintBottom_toBottomOf="@+id/tv_good_amount_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_good_amount_title"/>
    <ImageView
        android:id="@+id/iv_close"
        android:paddingLeft="@dimen/dimen_15dp"
        android:paddingTop="@dimen/dimen_14dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:paddingBottom="@dimen/dimen_9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_goods_line"
        android:background="@color/color_efefef"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dp14"
        app:layout_constraintTop_toBottomOf="@+id/tv_good_amount_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_coupon"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_goods_line">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/color_666978"
            android:id="@+id/tv_coupon_title"
            android:paddingLeft="@dimen/dp14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp14"
            android:text="@string/emotion_coupon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_8b76f9"
            android:id="@+id/tv_coupon_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emotion_choose_coupon"
            android:layout_marginEnd="@dimen/dp5"
            app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_title"
            app:layout_constraintRight_toLeftOf="@+id/iv_coupon_arrow"
            app:layout_constraintTop_toTopOf="@+id/tv_coupon_title"/>
        <ImageView
            android:id="@+id/iv_coupon_arrow"
            android:background="@drawable/ic_emotion_coupon_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp15"
            app:layout_constraintBottom_toBottomOf="@+id/tv_coupon_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_coupon_title"/>
        <View
            android:id="@+id/v_coupon_line"
            android:background="@color/color_efefef"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1dp"
            android:layout_marginTop="@dimen/dp14"
            app:layout_constraintTop_toBottomOf="@+id/tv_coupon_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_need_pay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:text="应付"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_coupon"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_24sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_need_pay_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:includeFontPadding="false"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_coin_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_need_pay_title"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475C"
        android:gravity="center_vertical"
        android:id="@+id/tv_coin_content"
        android:paddingLeft="@dimen/dp5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="珍爱币"
        app:layout_constraintLeft_toRightOf="@+id/tv_need_pay_amount"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_need_pay_title"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_9b9b9b"
        android:id="@+id/tv_remain_coin"
        android:paddingLeft="@dimen/dimen_4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp5"
        app:layout_constraintBottom_toTopOf="@+id/tv_book"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_book"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_42dp"
        android:layout_marginLeft="@dimen/dimen_10dp"
        android:layout_marginTop="@dimen/dimen_32dp"
        android:layout_marginRight="@dimen/dimen_10dp"
        android:text="立即支付"
        app:bg_colorGradientEnd="@color/color_8070f1"
        app:bg_colorGradientStart="@color/color_b06cef"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_5dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toTopOf="@+id/layout_zhenai_pay_protocol"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_zhenai_pay_protocol"
        android:paddingTop="@dimen/dimen_12dp"
        android:paddingBottom="@dimen/dimen_12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_b9b9b9"
            android:id="@+id/tv_pay_terms_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支付即同意"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_8b76f9"
            android:id="@+id/tv_pay_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="《珍爱币用户协议》"/>
    </LinearLayout>
    <com.zhenai.module_emotion.widget.EmotionPaySuccessView
        android:id="@+id/paySuccessView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_success"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_3dp"
        android:text="支付完成"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paySuccessView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
