<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/pay_daemon_dialog_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:orientation="vertical"
            android:background="@drawable/bg_ffffff_16_radius_rectangle"
            android:layout_width="279dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <com.zhenai.common.widget.RoundImageView
                android:id="@+id/dialog_pay_daemon_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/bg_page_top_v8"
                app:borderRadius="16dp"
                app:roundImageType="round"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#26273c"
                android:id="@+id/pay_daemon_introduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="120dp"
                android:text="成功开通一个月守护"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#6c6d75"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="已获得守护印象特权，快给Ta写个印象"
                android:layout_below="@+id/pay_daemon_introduction"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/pay_daemon_write_impression_btn"
                android:background="@drawable/bg_common_btn_full_767dff_22_radio"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/go2_write_impression"
                android:layout_below="@+id/tv_tips"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
        </RelativeLayout>
        <ImageView
            android:background="@drawable/img_pay_daemon_success_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_close_pay_success"
        android:background="@drawable/ic_close_v8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-13dp"
        android:layout_alignTop="@+id/pay_daemon_dialog_body"
        android:layout_marginEnd="-11dp"
        android:layout_alignEnd="@+id/pay_daemon_dialog_body"/>
</RelativeLayout>
