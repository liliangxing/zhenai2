<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:background="@drawable/ic_close_style_zhenai"
        android:visibility="gone"
        android:layout_width="@dimen/dp25"
        android:layout_height="@dimen/dp25"
        android:layout_marginTop="@dimen/dp150"
        android:layout_marginEnd="@dimen/dp40"
        android:layout_alignParentEnd="true"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svga_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:antiAlias="true"
        app:autoPlay="true"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_pay_star"
        android:background="@drawable/common_long_btn_normal_za7_without_shadow"
        android:visibility="gone"
        android:layout_width="285dp"
        android:layout_height="45dp"
        android:layout_marginTop="325dp"
        android:text="@string/repent_recommend_open_special"
        android:layout_below="@+id/iv_close"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
