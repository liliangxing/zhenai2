<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textStyle="bold"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_invite_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:text="@string/live_invite_settings"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/live_match_explain"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_invite_settings_title"
        app:layout_constraintStart_toEndOf="@+id/tv_invite_settings_title"
        app:layout_constraintTop_toTopOf="@+id/tv_invite_settings_title"/>
    <View
        android:id="@+id/line"
        android:background="@color/color_dedede"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_invite_settings_title"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_invite_settings_content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginBottom="18dp"
        android:text="@string/live_video_invite_settings_content_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_invite_settings_title"
        app:layout_constraintTop_toBottomOf="@+id/line"/>
    <Switch
        android:id="@+id/switch_invite_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_custom_thumb"
        android:track="@drawable/switch_custom_track_selector"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_invite_settings_content_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_invite_settings_content_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
