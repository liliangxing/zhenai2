<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_content"
        android:background="@drawable/bg_ffffff_top_radius_30"
        android:paddingBottom="34dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_top_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_page_top_v8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radius_left_up="30dp"
            app:radius_right_up="30dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#aeafb3"
            android:id="@+id/tv_top_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:text="@string/sincere_words_dialog_top_tips"
            android:layout_marginStart="28dp"
            app:layout_constraintRight_toLeftOf="@+id/btn_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_close"
            android:background="@drawable/icon_message_close_v2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#26273b"
            android:gravity="center"
            android:id="@+id/tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_top_tips"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_question"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#aeafb3"
            android:gravity="center"
            android:id="@+id/tv_bottom_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/only_after_answer_can_see_your_select"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_answer"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_bottom_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bottom_tips">
            <TextView
                android:textSize="16sp"
                android:textColor="#767dff"
                android:gravity="center"
                android:id="@+id/btn_change_question"
                android:background="@drawable/bg_ebecff_tectangle_40_radius"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:text="@string/sincere_words_change_one"
                android:layout_weight="1"
                android:layout_marginEnd="3.5dp"/>
            <TextView
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_send"
                android:background="@drawable/bg_767dff_aeb1b6_40_radius_btn_selecter"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:text="@string/send"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
