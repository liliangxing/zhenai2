<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/submit_wechat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_bg_view"
        android:background="@drawable/bg_common_dialog_corner_16dp"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="45dp"
        android:layout_marginHorizontal="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundCornerImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_bg_view"
        app:radius="16dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_submit_wechat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="填写微信号"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_bg_view"/>
    <ImageView
        android:id="@+id/iv_submit_wechat_eg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_12dp"
        android:layout_marginTop="63dp"
        android:layout_marginRight="@dimen/dimen_12dp"
        android:src="@drawable/submit_wechat_eg"
        android:layout_marginHorizontal="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_bg_view"/>
    <EditText
        android:textSize="18sp"
        android:textColor="@color/color_191c32"
        android:textColorHint="@color/color_aeafb3"
        android:id="@+id/et_wechat"
        android:background="@drawable/bg_f2f4f5_rectangle_22_radius"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/dimen_12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dimen_12dp"
        android:hint="输入微信号"
        android:lines="1"
        android:maxLength="20"
        android:textCursorDrawable="@drawable/bg_767dff_cursor_rectangle"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginHorizontal="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/iv_submit_wechat_eg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_fd5a67"
        android:id="@+id/tv_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="28dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/et_wechat"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/bg_btn_767dff_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="23dp"
        android:text="提交"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_bg_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <View
        android:id="@+id/bottom_space_view"
        android:layout_width="1dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_btn"/>
    <ImageView
        android:id="@+id/dialog_close_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_close_v8"
        android:layout_marginStart="265dp"
        app:layout_constraintStart_toStartOf="@+id/dialog_bg_view"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
