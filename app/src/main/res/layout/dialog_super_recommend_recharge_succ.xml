<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="279dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_page_top_v8"
            app:borderRadius="16dp"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="18sp"
            android:textColor="#26273c"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:text="@string/pay_success_toast"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/super_recommend_pay_success_text"
            android:layout_below="@+id/tv_title"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="23dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/btn_open_now"
            android:background="@drawable/bg_rectangle_767dff_22r_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/open_now"
            android:layout_below="@+id/tv_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/btn_reject"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="12dp"
            android:text="@string/cancel"
            android:layout_below="@+id/btn_open_now"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_banner"
        android:background="@drawable/bg_super_recommend_pay_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
