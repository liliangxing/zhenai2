<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.clip.ClipRadiusConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:clip_radius="16dp">
        <View
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="280dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.business.widget.autosrcoll_banner_listview.AutoScrollBanner
            android:id="@+id/auto_banner_reverse"
            android:layout_width="280dp"
            android:layout_height="280dp"
            app:indicatorBottomMargin="12dp"
            app:indicatorSelected="@drawable/bg_indicator_round_white"
            app:indicatorSpace="12dp"
            app:indicatorUnSelected="@drawable/bg_indicator_round_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273C"
            android:id="@+id/tv_content_reverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auto_banner_reverse"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_6c6d75"
            android:id="@+id/tv_sub_content_reverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content_reverse"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_buy_btn"
            android:background="@drawable/bg_common_btn_full_767dff_22_radio"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/become_vip"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sub_content_reverse"/>
    </com.zhenai.common.widget.clip.ClipRadiusConstraintLayout>
    <ImageView
        android:id="@+id/iv_close_reverse"
        android:background="@drawable/ic_close_v8"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="8dp"
        android:layout_above="@+id/cl_content"
        android:layout_marginEnd="-13dp"
        android:layout_alignEnd="@+id/cl_content"/>
</RelativeLayout>
