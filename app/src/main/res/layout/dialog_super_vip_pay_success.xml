<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="@dimen/dp295"
        android:layout_height="@dimen/dp289"
        android:src="@drawable/bg_dialog_super_vip_buy_success"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="@dimen/dp26"
        android:layout_height="@dimen/dp26"
        android:src="@drawable/icon_close_gray"
        android:layout_marginStart="-10dp"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintCircle="@+id/bg"
        app:layout_constraintCircleAngle="42"
        app:layout_constraintCircleRadius="@dimen/dp215"
        app:layout_constraintStart_toEndOf="@+id/bg"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textStyle="bold"
        android:textColor="#704900"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp31"
        android:text="@string/super_vip_pay_success_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="#704900"
        android:gravity="center"
        android:id="@+id/content_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp33"
        android:layout_marginStart="@dimen/dp45"
        android:layout_marginEnd="@dimen/dp45"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
