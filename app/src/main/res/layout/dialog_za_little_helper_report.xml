<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_parent"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:background="@drawable/bg_za_little_helper_report"
        android:layout_width="270dp"
        android:layout_height="318dp"
        android:layout_centerInParent="true">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_report"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/report"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_report"
            android:layout_marginStart="14dp"/>
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_avatar"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/default_avatar"
            app:roundImageType="circle"/>
        <TextView
            android:textSize="19sp"
            android:textColor="#43485d"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_b8b8b8"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_object_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_42475c"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff8162"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_za_little_helper_report_restricted"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/account_has_been_restricted"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"/>
        <android.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_has_known"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:text="@string/have_know"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/common_long_btn_style"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:src="@drawable/ic_common_dialog_close_btn"
        android:layout_alignTop="@+id/layout_content"
        android:layout_marginEnd="-16dp"
        android:layout_alignEnd="@+id/layout_content"/>
</RelativeLayout>
