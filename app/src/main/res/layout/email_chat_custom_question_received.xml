<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="12.5dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp">
        <com.zhenai.business.love_zone.widget.LovingImageView
            android:id="@+id/iv_chat_row_text_received_avatar"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7.5dp"
            android:layout_marginRight="54dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#bcbcbc"
                android:id="@+id/tv_chat_row_text_received_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:id="@+id/layout_content"
                android:background="@drawable/email_chat_row_other_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff666978"
                    android:gravity="center_vertical"
                    android:id="@+id/tvTip"
                    android:paddingLeft="9dp"
                    android:paddingTop="12dp"
                    android:paddingRight="9dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="回答了最关心的问题："
                    android:drawablePadding="7dp"
                    android:textIsSelectable="true"/>
                <View
                    android:id="@+id/view_cut_line"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_below="@+id/tvTip"
                    android:layout_alignStart="@+id/tvTip"
                    android:layout_alignEnd="@+id/tvTip"
                    style="@style/CutLineStyle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="9dp"
                    android:paddingTop="6dp"
                    android:paddingRight="9dp"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/view_cut_line"
                    android:layout_centerHorizontal="true">
                    <View
                        android:background="#bbbbbb"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffaaaaaa"
                        android:layout_gravity="center"
                        android:id="@+id/tvAnswer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tips_layout"
        android:background="@drawable/bg_chat_send_gift_tip"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#ffabacb2"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/concern_question_tips"/>
    </LinearLayout>
</LinearLayout>
