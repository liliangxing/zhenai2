<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="12.5dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_received_avatar"
        android:layout_width="49dp"
        android:layout_height="49dp"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7.5dp"
        android:layout_marginRight="54dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:id="@+id/tv_chat_row_text_received_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:id="@+id/layout_content"
            android:background="@drawable/email_chat_row_other_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="#ffbbbbbb"
                android:gravity="center_vertical"
                android:id="@+id/tvTip"
                android:paddingLeft="9dp"
                android:paddingTop="12dp"
                android:paddingRight="9dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="7dp"
                android:textIsSelectable="true"/>
            <View
                android:id="@+id/view_cut_line"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_below="@+id/tvTip"
                android:layout_alignStart="@+id/tvTip"
                android:layout_alignEnd="@+id/tvTip"
                style="@style/CutLineStyle"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff666978"
                android:id="@+id/tvQuestion"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="婚后是否想要小孩？"
                android:layout_below="@+id/view_cut_line"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tvAnwser"
                android:background="@drawable/say_hi_long_btn_selector"
                android:visibility="visible"
                android:layout_width="155dp"
                android:layout_height="32dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="16dp"
                android:text="回答"
                android:layout_below="@+id/tvQuestion"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
