<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ffffff_rectangle_16_radius"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <com.zhenai.common.widget.RoundImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_chat_helper_top_v2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <ImageView
        android:id="@+id/iv_avatar"
        android:background="@drawable/bg_round_8r_ffffff"
        android:padding="3dp"
        android:layout_width="83dp"
        android:layout_height="83dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/default_avatar"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="230dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"
        app:layout_constraintWidth_max="230dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#26273c"
            android:ellipsize="end"
            android:layout_gravity="top"
            android:id="@+id/tv_advantage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="220dp"
            android:maxLines="1"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/layout_photos"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_advantage"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_tips_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar">
        <ImageView
            android:background="@drawable/icon_767dff_circle_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:ellipsize="end"
            android:id="@+id/tv_tips_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="5dp"
            android:layout_marginStart="14dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_tips_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_tips_1">
        <ImageView
            android:background="@drawable/icon_767dff_circle_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:ellipsize="end"
            android:id="@+id/tv_tips_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="5dp"
            android:layout_marginStart="14dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
