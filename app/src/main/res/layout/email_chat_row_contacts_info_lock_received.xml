<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="12.5dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_received_avatar"
        android:layout_width="49dp"
        android:layout_height="49dp"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="7.5dp"
        android:layout_marginEnd="14dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:id="@+id/tv_chat_row_text_received_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:id="@+id/layout_message"
            android:background="@drawable/email_chat_row_other_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/layout_unlock"
                android:background="@drawable/email_chat_row_contacts_info_lock_bg"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/tv_chat_row_text_received_content"
                android:layout_alignBottom="@+id/tv_chat_row_text_received_content"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/icon_mail_click_to_unlock"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_unlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mail_click_to_unlock"/>
            </LinearLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bg_mail_contacts_safe_tips"
                android:layout_alignBottom="@+id/tv_chat_row_text_received_content"
                android:layout_marginEnd="1dp"
                android:layout_alignEnd="@+id/tv_chat_row_text_received_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff64a0f7"
                android:gravity="center_vertical"
                android:id="@+id/tv_chat_row_text_received_content"
                android:paddingLeft="9dp"
                android:paddingTop="15dp"
                android:paddingRight="9dp"
                android:paddingBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="62dp"
                android:text="@string/mail_contacts_safe_tips"
                android:drawablePadding="7dp"
                android:layout_toStartOf="@+id/layout_unlock"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
