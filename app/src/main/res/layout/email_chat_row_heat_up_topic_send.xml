<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_top_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_heat_up_topic_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radius_left_up="16dp"
            app:radius_right_up="16dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:gravity="center"
            android:id="@+id/tv_top_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toTopOf="@+id/iv_top_bg"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#26273b"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_top_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_top_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_top_tips"/>
        <ImageView
            android:id="@+id/iv_my_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_my_answer"
            android:background="@drawable/bg_9aa0ff_rectangle_16_radius"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="222dp"
            android:drawablePadding="4dp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_my_avatar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:layout_constraintWidth_max="260dp"/>
        <ImageView
            android:id="@+id/iv_object_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_my_answer"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#26273b"
            android:gravity="center"
            android:id="@+id/tv_object_answer"
            android:background="@drawable/bg_f2f4f5_rectangle_16_radius"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="222dp"
            android:drawableLeft="@drawable/icon_heat_up_topic_locked"
            android:drawablePadding="4dp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_object_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_my_answer"
            app:layout_constraintWidth_max="260dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#aeafb3"
            android:gravity="center"
            android:id="@+id/tv_bottom_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_object_answer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#6c6d75"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_send_fail"
        android:background="@drawable/bg_0d26273c_rectangle_16_radius"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/send_mail_fail_click_resend"
        android:drawableLeft="@drawable/chat_fail_icon"
        android:drawablePadding="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/iv_object_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_my_answer"/>
</LinearLayout>
