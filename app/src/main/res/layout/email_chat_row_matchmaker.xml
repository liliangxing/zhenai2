<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/img_avatar"
        android:layout_width="@dimen/dp52"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:src="@drawable/default_avatar"
        android:layout_marginStart="@dimen/dimen_9dp"
        app:borderRadius="@dimen/dimen_4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="round"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ff191c32"
        android:id="@+id/tv_matchmaker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_3dp"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ff191c32"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_matchmaker_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_matchmaker_title"
        app:layout_constraintTop_toTopOf="@+id/tv_matchmaker_title"/>
    <ImageView
        android:id="@+id/img_star"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/icon_email_chat_row_matchmaker_star"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
        app:layout_constraintStart_toStartOf="@+id/tv_matchmaker_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffff7598"
        android:id="@+id/tv_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_star"
        app:layout_constraintStart_toEndOf="@+id/img_star"
        app:layout_constraintTop_toTopOf="@+id/img_star"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff585783"
        android:gravity="start"
        android:id="@+id/tv_service_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_star"
        app:layout_constraintTop_toTopOf="@+id/tv_star"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ff585783"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:text="可以通过红娘老师帮你牵线哦~"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_btn"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_btn"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:layout_width="88dp"
        android:layout_height="32dp"
        android:text="帮我牵线"
        app:bg_colorNormal="#7e85ff"
        app:bg_radius="16dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</merge>
