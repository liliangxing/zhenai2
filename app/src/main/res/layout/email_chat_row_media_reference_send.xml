<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="horizontal"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_weight="1">
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:gravity="right"
            android:id="@+id/tv_chat_row_text_send_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/reference_root"
            android:background="@drawable/email_chat_row_mine_bg"
            android:layout_width="223dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/tv_chat_row_text_send_time"
            android:layout_alignParentRight="true">
            <com.zhenai.common.widget.RoundImageView
                android:id="@+id/album_imageview"
                android:layout_width="223dp"
                android:layout_height="223dp"
                android:scaleType="centerCrop"
                app:radius_left_up="8dp"
                app:roundImageType="round"/>
            <ImageView
                android:id="@+id/img_video_play"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_moments_video_play"
                android:scaleType="center"
                android:layout_alignTop="@+id/album_imageview"
                android:layout_alignBottom="@+id/album_imageview"
                android:layout_alignStart="@+id/album_imageview"
                android:layout_alignEnd="@+id/album_imageview"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:id="@+id/tv_chat_introduce_reference_send_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="15dp"
                android:layout_below="@+id/album_imageview"
                android:textIsSelectable="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_chat_row_text_send_status"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/chat_fail_icon"
            android:layout_toLeftOf="@+id/reference_root"
            android:layout_centerVertical="true"/>
        <ProgressBar
            android:id="@+id/pb_chat_row_text_send"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:layout_toLeftOf="@+id/reference_root"
            android:layout_centerVertical="true"
            style="android:style/Widget.ProgressBar.Small"/>
    </RelativeLayout>
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_send_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"/>
</LinearLayout>
