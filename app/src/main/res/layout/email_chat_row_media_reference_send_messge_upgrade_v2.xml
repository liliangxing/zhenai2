<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/media_send_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/fl_media_send_content"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#bdbec3"
        android:id="@+id/media_send_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/fl_media_send_content"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:padding="12dp"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/media_send_time"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/media_send_avatar">
        <FrameLayout
            android:id="@+id/media_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.RoundImageView
                android:id="@+id/media_send_picture"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:radius_left_down="8dp"
                app:radius_left_up="8dp"
                app:radius_right_down="8dp"
                app:radius_right_up="8dp"
                app:roundImageType="round"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_video_play"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_video_play_v8"
                android:scaleType="center"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/media_send_tag"
            android:background="@drawable/bg_99000000_rectangle_10_radius"
            android:paddingLeft="@dimen/dimen_6dp"
            android:paddingTop="@dimen/dp1"
            android:paddingRight="@dimen/dimen_6dp"
            android:paddingBottom="@dimen/dp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_alignBottom="@+id/media_layout"
            android:layout_marginEnd="8dp"
            android:layout_alignEnd="@+id/media_layout"
            android:paddingHorizontal="@dimen/dimen_6dp"
            android:paddingVertical="@dimen/dp1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#26273b"
            android:gravity="start"
            android:id="@+id/media_send_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/media_layout"
            android:lineSpacingMultiplier="1.2"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_chat_row_text_send_status"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/chat_fail_icon_v2"
        android:layout_centerVertical="true"
        android:layout_marginStart="-25dp"
        android:layout_alignStart="@+id/fl_media_send_content"/>
    <ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/pb_chat_row_text_send"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="-25dp"
        android:layout_alignStart="@+id/fl_media_send_content"
        style="android:style/Widget.ProgressBar.Small"/>
</merge>
