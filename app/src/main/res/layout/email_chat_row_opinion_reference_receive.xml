<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/opinion_receive_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_B9B9B9"
        android:gravity="end"
        android:id="@+id/opinion_receive_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/opinion_receive_avatar"
        app:layout_constraintTop_toTopOf="@+id/opinion_receive_avatar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opinion_container"
        android:background="@drawable/email_chat_row_other_bottom_left_0_bg"
        android:padding="@dimen/dp10"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/opinion_receive_avatar"
        app:layout_constraintTop_toBottomOf="@+id/opinion_receive_time">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/opinion_bg"
            android:background="@drawable/bg_basic_info_intro"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:textColor="@color/color_666978"
                android:ellipsize="end"
                android:id="@+id/tv_opinion_question_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_5dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textStyle="bold"
                android:textColor="@color/color_42475C"
                android:ellipsize="end"
                android:id="@+id/tv_opinion_answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_opinion_question_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/opinion_receive_tag"
        android:background="@drawable/email_chat_row_tag_bg"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingTop="@dimen/dp1"
        android:paddingRight="@dimen/dimen_6dp"
        android:paddingBottom="@dimen/dp1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"
        android:paddingHorizontal="@dimen/dimen_6dp"
        android:paddingVertical="@dimen/dp1"
        app:layout_constraintBottom_toBottomOf="@+id/opinion_container"
        app:layout_constraintEnd_toEndOf="@+id/opinion_container"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_747474"
        android:gravity="start"
        android:id="@+id/opinion_receive_content"
        android:background="@drawable/email_chat_row_other_bg"
        android:paddingLeft="@dimen/dimen_10dp"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dimen_10dp"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:maxWidth="@dimen/dp248"
        android:paddingHorizontal="@dimen/dimen_10dp"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/opinion_container"
        app:layout_constraintTop_toBottomOf="@+id/opinion_container"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_chat_row_text_receive_status"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/chat_fail_icon"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/opinion_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/opinion_container"
        app:layout_constraintTop_toTopOf="@+id/opinion_container"/>
    <ProgressBar
        android:id="@+id/pb_chat_row_text_receive"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/opinion_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/opinion_container"
        app:layout_constraintTop_toTopOf="@+id/opinion_container"
        style="android:style/Widget.ProgressBar.Small"/>
</merge>
