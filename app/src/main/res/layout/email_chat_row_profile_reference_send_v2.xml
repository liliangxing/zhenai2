<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/profile_send_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/profile_send_time"
        android:layout_alignTop="@+id/layout_mail"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/profile_send_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <RelativeLayout
        android:id="@+id/layout_mail"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/profile_send_time"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/profile_send_avatar">
        <RelativeLayout
            android:id="@+id/profile_container"
            android:background="@drawable/bg_f2f4f5_rectangle_8_radius"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#aeafb3"
                android:ellipsize="end"
                android:id="@+id/profile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minWidth="@dimen/dimen_50dp"
                android:maxLines="1"
                android:layout_alignTop="@+id/profile_avatar"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_marginEnd="@dimen/dimen_10dp"
                android:layout_toEndOf="@+id/profile_avatar"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#6c6d75"
                android:ellipsize="end"
                android:id="@+id/profile_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2dp"
                android:maxWidth="120dp"
                android:minWidth="@dimen/dimen_50dp"
                android:maxLines="1"
                android:layout_below="@+id/profile_title"
                android:layout_alignStart="@+id/profile_title"/>
            <ImageView
                android:id="@+id/profile_send_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/right_arrow_v2"
                android:layout_alignTop="@+id/profile_content"
                android:layout_alignBottom="@+id/profile_content"
                android:layout_toEndOf="@+id/profile_content"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#26273b"
            android:id="@+id/profile_send_content"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/profile_container"
            android:lineSpacingMultiplier="1.2"
            android:paddingVertical="@dimen/dp12"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_chat_row_text_send_status"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/chat_fail_icon_v2"
        android:layout_centerVertical="true"
        android:layout_marginStart="-35dp"
        android:layout_alignStart="@+id/layout_mail"/>
    <ProgressBar
        android:id="@+id/pb_chat_row_text_send"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="-30dp"
        android:layout_alignStart="@+id/layout_mail"
        style="android:style/Widget.ProgressBar.Small"/>
</merge>
