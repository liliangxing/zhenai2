<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_chat_row_text_send_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_12dp"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/layout_mail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_chat_row_text_send_time"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/iv_chat_row_text_send_avatar"
        app:alignItems="center"
        app:flexDirection="row_reverse"
        app:flexWrap="nowrap"
        app:justifyContent="flex_start">
        <RelativeLayout
            android:id="@+id/layout_content"
            android:background="@drawable/bg_9aa0ff_rectangle_16_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_flexShrink="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/tv_chat_row_text_send_content"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_chat_row_text_send_status"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/chat_fail_icon_v2"
            android:layout_marginEnd="8dp"
            app:layout_flexShrink="0"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/iv_chat_row_text_send_at"
            android:background="@drawable/bg_767dff_rectangle_40767dff_stroke_12_radius"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="38dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            app:layout_flexShrink="0"/>
        <ProgressBar
            android:id="@+id/pb_chat_row_text_send"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            app:layout_flexShrink="0"
            style="android:style/Widget.ProgressBar.Small"/>
    </com.google.android.flexbox.FlexboxLayout>
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_send_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/layout_mail"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
