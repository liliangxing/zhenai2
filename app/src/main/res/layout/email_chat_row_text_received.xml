<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="12.5dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_received_avatar"
        android:layout_width="49dp"
        android:layout_height="49dp"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7.5dp"
        android:layout_marginRight="54dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:id="@+id/tv_chat_row_text_received_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:id="@+id/layout_content"
            android:background="@drawable/email_chat_row_other_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#42475c"
                android:gravity="center_vertical"
                android:id="@+id/tv_chat_row_text_received_content"
                android:paddingLeft="9dp"
                android:paddingTop="12dp"
                android:paddingRight="9dp"
                android:paddingBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="7dp"
                android:textIsSelectable="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
