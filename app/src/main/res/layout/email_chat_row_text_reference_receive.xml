<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7.5dp"
    android:layout_marginBottom="7.5dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_received_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="54dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:id="@+id/tv_chat_row_text_received_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/reference_root"
            android:background="@drawable/email_chat_row_other_bg"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="7dp"
            android:paddingEnd="5dp">
            <View
                android:id="@+id/view_line"
                android:background="#cc747474"
                android:layout_width="1dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/reference_text_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/reference_text_content_top"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cc747474"
                android:ellipsize="end"
                android:id="@+id/reference_text_content_top"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textIsSelectable="false"
                android:paddingStart="7dp"
                android:paddingEnd="5dp"
                app:layout_constraintStart_toEndOf="@+id/view_line"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cc747474"
                android:ellipsize="end"
                android:id="@+id/reference_text_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textIsSelectable="false"
                android:paddingStart="7dp"
                android:paddingEnd="5dp"
                app:layout_constraintStart_toEndOf="@+id/view_line"
                app:layout_constraintTop_toBottomOf="@+id/reference_text_content_top"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#747474"
                android:id="@+id/tv_chat_introduce_reference_receive_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textIsSelectable="true"
                app:layout_constraintStart_toStartOf="@+id/reference_text_content"
                app:layout_constraintTop_toBottomOf="@+id/reference_text_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
