<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_received_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/layout_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_chat_row_text_received_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout
        android:id="@+id/layout_content"
        android:paddingLeft="16dp"
        android:paddingTop="18dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_chat_row_text_received_time"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="50dp"
        android:layout_toEndOf="@+id/iv_chat_row_text_received_avatar"
        android:paddingHorizontal="16dp"
        app:bg_colorNormal="@color/white"
        app:bg_radius="16dp"
        app:bg_shape="round">
        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273C"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/img_icon"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/img_icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center_vertical"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/tv_title"
            android:lineSpacingMultiplier="1.2"/>
        <View
            android:id="@+id/view_cut_line"
            android:background="@color/color_EBECFF"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/tv_content"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff767dff"
            android:gravity="center"
            android:id="@+id/tv_button"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_cut_line"/>
        <View
            android:id="@+id/view_space"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:layout_below="@+id/tv_content"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout>
</RelativeLayout>
