<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_voice_received_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/voice_layout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_chat_row_voice_received_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/voice_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/tv_chat_row_voice_received_time"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="100dp"
        android:layout_toEndOf="@+id/iv_chat_row_voice_received_avatar">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_chat_row_voice_received"
            android:background="@drawable/bg_ffffff_rectangle_16_radius"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_chat_row_voice_received_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/chat_voice_playing_anim_v2"
                app:tint="#26273c"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#26273c"
                android:gravity="end"
                android:id="@+id/tv_chat_row_voice_received_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:layout_toEndOf="@+id/iv_chat_row_voice_received_icon"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/iv_chat_row_voice_received_unread"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/red_dot_v2"
            android:layout_marginStart="-7dp"/>
        <ImageView
            android:id="@+id/iv_chat_row_voice_received_status"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/chat_fail_icon_v2"
            android:layout_marginStart="4dp"/>
        <ProgressBar
            android:id="@+id/pb_chat_row_voice_received"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            style="android:style/Widget.ProgressBar.Small"/>
    </LinearLayout>
</RelativeLayout>
