<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_chat_row_text_send_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/iv_chat_row_text_send_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/layout_content"
        android:layout_alignParentEnd="true"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout
        android:id="@+id/layout_content"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_chat_row_text_send_time"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/iv_chat_row_text_send_avatar"
        app:bg_colorNormal="#1a9395a4"
        app:bg_radius="16dp"
        app:bg_shape="round">
        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chat_row_group_send_txt_source"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff191c32"
            android:id="@+id/tv_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_item_come_from"
            android:layout_alignTop="@+id/img_icon"
            android:layout_alignBottom="@+id/img_icon"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/img_icon"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff191c32"
            android:id="@+id/tv_group_send_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_item_group_send_text"
            android:layout_alignTop="@+id/img_icon"
            android:layout_alignBottom="@+id/img_icon"
            android:layout_toEndOf="@+id/tv_from"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_ffffffff_rectangle_r8_shape"
            android:paddingLeft="8dp"
            android:paddingTop="10dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/img_icon"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ff191c32"
                android:gravity="center_vertical"
                android:id="@+id/tv_chat_row_text_send_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="7dp"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff6c6d75"
                android:gravity="center_vertical"
                android:id="@+id/tv_sub_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true"/>
        </LinearLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableRelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff707095"
        android:id="@+id/tv_discontent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/discontent_recommend_object"
        android:layout_below="@+id/layout_content"
        android:textAllCaps="false"
        android:layout_marginEnd="12dp"
        android:layout_alignEnd="@+id/layout_content"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="13sp"
        android:textColor="#ff6c6d75"
        android:id="@+id/tv_bottom_tips"
        android:paddingLeft="12dp"
        android:paddingTop="9dp"
        android:paddingRight="12dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/zhenxiaoai_housekeeper_message_item_bottom_tips"
        android:layout_below="@+id/tv_discontent"
        android:layout_centerHorizontal="true"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        app:bg_colorNormal="#0c26273b"
        app:bg_radius="16dp"
        app:bg_shape="round"/>
</RelativeLayout>
