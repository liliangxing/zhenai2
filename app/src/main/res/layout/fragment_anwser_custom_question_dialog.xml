<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:background="@drawable/bg_email_chat_dialog_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_content"
        android:paddingBottom="44dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_sub_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhenai.message.email_chat.widget.FloatingReferenceMessageLayout
                android:id="@+id/layout_floating_reference_tips"
                android:paddingTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_input"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <com.zhenai.business.widget.Listen2PasteEditText
                    android:textSize="14sp"
                    android:textColor="#42475c"
                    android:textColorHint="#a4a4a4"
                    android:id="@+id/et_message_input"
                    android:background="@drawable/chat_edit_text_bg"
                    android:padding="8dp"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="输入内容"
                    android:maxLines="3"
                    android:maxLength="1500"
                    android:layout_weight="1"/>
                <Button
                    android:enabled="false"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/btn_message_send"
                    android:background="@drawable/chat_send_email_btn_selector"
                    android:visibility="visible"
                    android:layout_width="53dp"
                    android:layout_height="34dp"
                    android:text="@string/send"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
