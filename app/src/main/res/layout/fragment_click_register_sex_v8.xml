<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/color_26273C"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/you_are"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/sex_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/sex_tip"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/iv_click_register_male"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="23dp"
        android:src="@drawable/icon_click_register_male_v8"
        android:layout_marginStart="17dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_click_register_female"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sex_tip"/>
    <ImageView
        android:id="@+id/iv_click_register_female"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:src="@drawable/icon_click_register_female_v8"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/iv_click_register_male"
        app:layout_constraintTop_toTopOf="@+id/iv_click_register_male"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/man"
        app:layout_constraintEnd_toStartOf="@+id/iv_click_register_female"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/iv_click_register_male"
        app:layout_constraintTop_toBottomOf="@+id/iv_click_register_male"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/woman"
        app:layout_constraintEnd_toEndOf="@+id/iv_click_register_female"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/iv_click_register_male"
        app:layout_constraintTop_toBottomOf="@+id/iv_click_register_female"/>
</androidx.constraintlayout.widget.ConstraintLayout>
