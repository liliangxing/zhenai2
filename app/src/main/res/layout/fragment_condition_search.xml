<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.search.widget.BasicSearchLayout
                android:orientation="vertical"
                android:id="@+id/basicSearch"
                android:background="@drawable/bg_rectangle_ffffff_16r_shape"
                android:paddingLeft="@dimen/dimen_16dp"
                android:paddingTop="@dimen/dimen_24dp"
                android:paddingRight="@dimen/dimen_16dp"
                android:paddingBottom="@dimen/dimen_24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dimen_32dp"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"
                android:paddingHorizontal="@dimen/dimen_16dp"
                android:paddingVertical="@dimen/dimen_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.search.widget.SearchVipBanner
                android:id="@+id/vip_guide"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dimen_12dp"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="@+id/advanceSearch"
                app:layout_constraintTop_toBottomOf="@+id/basicSearch"
                app:layout_constraintVertical_bias="0"/>
            <com.zhenai.search.widget.AdvanceSearchLayout
                android:orientation="vertical"
                android:id="@+id/advanceSearch"
                android:background="@drawable/bg_rectangle_ffffff_16r_shape"
                android:paddingLeft="@dimen/dimen_16dp"
                android:paddingTop="@dimen/dimen_24dp"
                android:paddingRight="@dimen/dimen_16dp"
                android:paddingBottom="@dimen/dimen_24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dimen_12dp"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginBottom="113dp"
                android:layout_marginHorizontal="@dimen/dp12"
                android:paddingHorizontal="@dimen/dimen_16dp"
                android:paddingVertical="@dimen/dimen_24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vip_guide"
                app:layout_constraintVertical_bias="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:enabled="true"
        android:id="@+id/star_search"
        android:background="@drawable/common_long_btn_selector_blue_8"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="@dimen/dimen_24dp"
        android:text="@string/start_search"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="60dp"
        android:layout_marginVertical="@dimen/dimen_24dp"
        style="@style/common_long_btn_style_8.0_no_shadow"/>
</RelativeLayout>
