<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.module_emotion.widget.treeview.TreeView
        android:id="@+id/tree_view"
        android:paddingTop="@dimen/dp45"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cacheColorHint="@android:color/transparent"
        android:groupIndicator="@null"
        android:divider="@null"
        android:smoothScrollbar="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top"
        android:background="#26767dff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_767dff"
            android:id="@+id/tv_top_tips"
            android:paddingLeft="@dimen/dimen_15sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看更多咨询"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:background="@drawable/ic_emotion_course_arrow_v8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
