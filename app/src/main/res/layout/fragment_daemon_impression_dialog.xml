<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="300dp">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_load"
            android:layout_width="20dp"
            android:layout_height="20dp"
            style="@android:style/Widget.ProgressBar.Large"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_999999"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="@string/error_network_and_retry"
            android:drawableTop="@drawable/live_daemon_impress_empty"
            android:drawablePadding="14dp"
            android:lineSpacingExtra="6dp"/>
    </FrameLayout>
    <ScrollView
        android:id="@+id/sv_impression"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="300dp">
        <com.zhenai.business.widget.label_layout.LabelLayout
            android:id="@+id/label_impression"
            android:paddingTop="25dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="25dp"
            app:auto_select_effect="false"/>
    </ScrollView>
    <TextView
        android:textSize="16sp"
        android:textColor="#8b76f9"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_impression_btn"
        android:background="@drawable/btn_daemon_impression_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="15dp"/>
</LinearLayout>
