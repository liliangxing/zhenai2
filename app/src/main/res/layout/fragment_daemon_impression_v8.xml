<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.refresh.ZARefreshLayout
        android:orientation="vertical"
        android:id="@+id/refresh_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.zhenai.common.widget.refresh.ZARefreshLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="133dp"
        android:text="还没有人给你写印象，多开播就有啦"
        android:drawableTop="@drawable/guard_empty_default_icon"
        android:lineSpacingExtra="6dp"/>
    <FrameLayout
        android:id="@+id/layout_start_live"
        android:background="@drawable/rect_767dff_r40"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="72dp"
        android:layout_marginTop="360dp"
        android:layout_marginRight="72dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_open_daemon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_live_to_get_impression"/>
    </FrameLayout>
</FrameLayout>
