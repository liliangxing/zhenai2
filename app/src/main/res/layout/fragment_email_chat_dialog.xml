<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:background="@drawable/bg_email_chat_dialog_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#ff42475c"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tv_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_centerInParent="true"
            android:layout_marginStart="70dp"
            android:layout_marginEnd="70dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaaaaaa"
            android:gravity="start|bottom"
            android:id="@+id/tv_go_2_chat_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/go_2_email_chat_activity"
            android:layout_alignTop="@+id/tv_nick_name"
            android:layout_alignBottom="@+id/tv_nick_name"/>
        <ImageView
            android:id="@+id/img_close"
            android:paddingLeft="5dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_recommend7_close"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/layout_content"
        android:paddingBottom="44dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_sub_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zhenai.common.widget.refresh.ZARefreshLayout
                android:id="@+id/rv_chat_list"
                android:paddingTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
            </com.zhenai.common.widget.refresh.ZARefreshLayout>
            <com.zhenai.message.email_chat.widget.FloatingReferenceMessageLayout
                android:id="@+id/layout_floating_reference_tips"
                android:paddingTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_quick_message"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="14dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_input"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <com.zhenai.business.widget.Listen2PasteEditText
                    android:textSize="14sp"
                    android:textColor="#42475c"
                    android:textColorHint="#a4a4a4"
                    android:id="@+id/et_message_input"
                    android:background="@drawable/chat_edit_text_bg"
                    android:padding="8dp"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="输入内容"
                    android:maxLines="3"
                    android:maxLength="1500"
                    android:layout_weight="1"/>
                <Button
                    android:enabled="false"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/btn_message_send"
                    android:background="@drawable/chat_send_email_btn_selector"
                    android:visibility="visible"
                    android:layout_width="53dp"
                    android:layout_height="34dp"
                    android:text="@string/send"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <ViewStub
            android:id="@+id/forbidden_user_view_stub"
            android:layout="@layout/email_chat_dialog_forbidden_user"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
