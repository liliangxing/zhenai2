<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.refresh.ZARefreshLayout
        android:id="@+id/recycle_head"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_uncover"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.zhenai.common.widget.refresh.ZARefreshLayout>
    <FrameLayout
        android:id="@+id/layout_uncover"
        android:background="@color/white"
        android:paddingLeft="36dp"
        android:paddingTop="20dp"
        android:paddingRight="36dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="36dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_uncover"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/visit_all_visitor_record"
            app:bg_colorNormal="@color/color_191c32"
            app:bg_fillMode="color"
            app:bg_radius="@dimen/dimen_30dp"
            app:bg_shape="round"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
