<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="#ffe9e9e9"
        android:id="@+id/change_bg_title_tv"
        android:visibility="gone"
        android:layout_width="176dp"
        android:layout_height="14dp"
        android:layout_marginTop="18dp"
        android:text="@string/change_bg_second_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_title_line"
        android:background="@drawable/bg_live_change_bg_title_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/dimen_15dp"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/change_bg_title_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_view_photo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/market_icon_view"
            android:visibility="gone"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/img_bg_change_empty"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99ffffff"
            android:gravity="center"
            android:id="@+id/tv_no_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_live_change_dialog_no_photo"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
