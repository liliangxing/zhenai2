<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_send_gift_background"
        android:background="@color/color_f7f8fb"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_send_gift_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/send_to"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_send_gift_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_send_gift_background"/>
    <View
        android:id="@+id/layout_live_video_gift_receiver"
        android:background="@drawable/bg_live_video_gift_receiver"
        android:layout_width="130dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/dimen_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_send_gift_background"
        app:layout_constraintStart_toEndOf="@+id/tv_send_gift_title"
        app:layout_constraintTop_toTopOf="@+id/view_send_gift_background"/>
    <ImageView
        android:id="@+id/iv_live_video_gift_receiver"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/default_circle_avatar"
        android:layout_marginStart="@dimen/dimen_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_gift_receiver"
        app:layout_constraintStart_toStartOf="@+id/layout_live_video_gift_receiver"
        app:layout_constraintTop_toTopOf="@+id/layout_live_video_gift_receiver"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_42475c"
        android:ellipsize="end"
        android:id="@+id/tv_live_video_gift_receiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="75dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_gift_receiver"
        app:layout_constraintStart_toEndOf="@+id/iv_live_video_gift_receiver"
        app:layout_constraintTop_toTopOf="@+id/layout_live_video_gift_receiver"/>
    <ImageView
        android:id="@+id/iv_live_video_gift_receiver_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_live_video_gift_receiver_arrow"
        android:layout_marginEnd="@dimen/dimen_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_gift_receiver"
        app:layout_constraintEnd_toEndOf="@+id/layout_live_video_gift_receiver"
        app:layout_constraintTop_toTopOf="@+id/layout_live_video_gift_receiver"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_8b76f9"
        android:gravity="center"
        android:id="@+id/tv_recharge"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:text="@string/wallet_recharge"
        android:paddingStart="@dimen/dimen_10dp"
        android:paddingEnd="@dimen/dimen_10dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_send_gift_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_send_gift_background"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:id="@+id/tv_loading"
        android:layout_width="match_parent"
        android:layout_height="224dp"
        android:text="@string/loading_data_msg"
        app:layout_constraintTop_toBottomOf="@+id/view_send_gift_background"/>
    <com.zhenai.business.widget.view_pager.WrapContentHeightViewPager
        android:id="@+id/view_pager"
        android:paddingTop="@dimen/dimen_4dp"
        android:paddingBottom="@dimen/dimen_6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="224dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/tv_loading"/>
    <com.zhenai.business.widget.indicator.IndicatorLayout
        android:orientation="horizontal"
        android:id="@+id/indicator_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_image_margin="0dp"
        app:item_image_size="15dp"
        app:item_selected_image_res_id="@drawable/icon_live_video_gift_indicator_selected"
        app:item_unselected_image_res_id="@drawable/icon_live_video_gift_indicator_unselected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_pager"/>
    <View
        android:id="@+id/view_line"
        android:background="#d8d8d8"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintTop_toBottomOf="@+id/indicator_layout"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_gift_count_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginBottom="@dimen/dimen_18dp"
        android:text="@string/live_gift_count_title"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475e"
        android:gravity="center"
        android:id="@+id/tv_invite_gift"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:text="邀请男嘉宾送礼"
        android:paddingStart="27dp"
        android:paddingEnd="@dimen/dimen_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/tv_send_gift"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:text="@string/live_video_send_gift"
        android:layout_marginEnd="10dp"
        app:bg_colorNormal="@color/color_8b76f9"
        app:bg_fillMode="color"
        app:bg_shape="semicircle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_invite_gift"
        android:visibility="gone"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:text="@string/live_video_invite_gift"
        android:layout_marginEnd="10dp"
        app:bg_colorNormal="@color/color_8b76f9"
        app:bg_fillMode="color"
        app:bg_shape="semicircle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gift_count_recyclerView"
        android:background="@drawable/bg_gift_count_radio_button_not_selected"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_send_gift"
        app:layout_constraintStart_toEndOf="@+id/tv_gift_count_title"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_bcbcbc"
        android:gravity="center"
        android:id="@+id/gift_count_one_tv"
        android:background="@drawable/bg_gift_count_radio_button_not_selected"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="37dp"
        android:text="1"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_gift_count_title"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
</merge>
