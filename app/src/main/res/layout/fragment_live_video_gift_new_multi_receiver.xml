<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_18171f"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white_60"
        android:gravity="center"
        android:id="@+id/tv_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp240"
        android:text="@string/loading_data_msg"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp240">
        <ImageView
            android:background="@drawable/ic_back_pack_empty"
            android:layout_width="180dp"
            android:layout_height="180dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/live_gift_back_pack_empty"/>
    </LinearLayout>
    <com.zhenai.business.widget.view_pager.WrapContentHeightViewPager
        android:id="@+id/view_pager"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp240"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/tv_loading"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarThumbVertical="@drawable/shape_gift_scrollbar"
        android:id="@+id/rv_gift_list"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scrollbarFadeDuration="0"
        android:fadeScrollbars="false"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_loading"/>
    <com.zhenai.business.widget.indicator.IndicatorLayout
        android:orientation="horizontal"
        android:id="@+id/indicator_layout"
        android:paddingTop="@dimen/dp5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_image_margin="@dimen/dp5"
        app:item_image_size="6dp"
        app:item_selected_image_res_id="@drawable/bg_gift_panel_indicator_checked"
        app:item_unselected_image_res_id="@drawable/bg_gift_panel_indicator_unchecked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_pager"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/white_20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        app:layout_constraintTop_toBottomOf="@+id/indicator_layout"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_recharge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="55dp"
        android:text="@string/wallet_recharge"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_send_gift"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:text="@string/live_video_send_gift"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:bg_colorNormal="@color/color_8b76f9"
        app:bg_shape="semicircle"
        app:layout_constraintBottom_toBottomOf="@+id/tv_recharge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_recharge"/>
</merge>
