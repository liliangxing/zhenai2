<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.base.widget.recyclerview.xrecylerview.XRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <FrameLayout
        android:id="@+id/layout_live_video_list_refresh_tip"
        android:background="#ffd9a2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="13sp"
            android:textColor="#a64d12"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_list_refresh_tips"
            android:drawablePadding="5dp"
            android:drawableEnd="@drawable/icon_live_video_list_refresh"/>
    </FrameLayout>
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/app_bar_layout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_layout"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:collapsedTitleGravity="center"
            app:contentScrim="@color/white"
            app:expandedTitleGravity="center_horizontal"
            app:expandedTitleMarginBottom="64dp"
            app:expandedTitleTextAppearance="@style/LiveZoneExpandedTitleText"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:titleEnabled="true">
            <ImageView
                android:id="@+id/img_topic_cover"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_topic_content"
                android:fitsSystemWindows="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="43dp"
                android:maxLines="1"
                android:alpha="0.8"
                app:layout_collapseMode="parallax"/>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tool_bar"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_50dp"
                android:layout_marginTop="15dp"
                app:contentInsetEnd="8dp"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/iv_back"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/back_icon"
                    android:scaleType="centerInside"/>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/iv_about"
                    android:visibility="invisible"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/icon_classify_about"
                    android:scaleType="centerInside"
                    android:paddingEnd="-8dp"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_live_video_start_live"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="58dp"
        android:src="@drawable/icon_live_video_start_live"
        android:layout_marginEnd="10dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
