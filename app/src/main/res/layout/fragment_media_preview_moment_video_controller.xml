<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_top_bg"
        android:background="@drawable/bg_moments_media_preview_header"
        android:layout_width="match_parent"
        android:layout_height="105dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/tv_operation"
        android:background="@drawable/bg_727dff_rectangle_r15_shape"
        android:visibility="gone"
        android:layout_width="69dp"
        android:layout_height="31dp"
        android:layout_marginTop="32dp"
        android:text="@string/follow"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:id="@+id/tv_play_num"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_top_bg"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/img_praise"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dp32"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_praise_v8"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_praise_num"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:id="@+id/tv_praise_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/img_praise"
        app:layout_constraintStart_toStartOf="@+id/img_praise"/>
</androidx.constraintlayout.widget.ConstraintLayout>
