<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_top_bg"
        android:background="@drawable/bg_page_top_v8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/layout_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/layout_title_bar_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout_title_bar"/>
    <ImageView
        android:id="@+id/img_back"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/back_icon_black"
        android:scaleType="center"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_title_bar"
        app:layout_constraintStart_toStartOf="@+id/layout_title_bar"
        app:layout_constraintTop_toBottomOf="@+id/layout_title_bar_top"/>
    <TextView
        android:textSize="@dimen/dimen_22sp"
        android:textColor="#42475c"
        android:ellipsize="end"
        android:id="@+id/tv_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/layout_title_bar"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/img_back"
        app:layout_constraintTop_toBottomOf="@+id/layout_title_bar_top"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_follow,lottie_un_follow,tv_profile_edit_progress"
        app:layout_constraintEnd_toStartOf="@+id/tv_nick_name"/>
    <ImageView
        android:id="@+id/iv_follow"
        android:layout_width="@dimen/dp90"
        android:layout_height="@dimen/dp50"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_back"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center_vertical"
        android:id="@+id/lottie_un_follow"
        android:visibility="gone"
        android:layout_width="@dimen/dp90"
        android:layout_height="@dimen/dp50"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/recommend_profile7_unfollow.json"
        app:lottie_imageAssetsFolder="images/recommend_profile7_un_follow"
        app:lottie_loop="false"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svga_un_follow"
        android:visibility="gone"
        android:layout_width="@dimen/dp72"
        android:layout_height="@dimen/dp50"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/img_back"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_profile_edit_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mine_profile_progress"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nick_name"
        app:layout_constraintEnd_toStartOf="@+id/profile_progress"
        app:layout_constraintTop_toTopOf="@+id/tv_nick_name"
        app:layout_goneMarginEnd="15dp"/>
    <com.zhenai.business.widget.progress.RoundCircleProgress
        android:id="@+id/profile_progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        app:ballPeen="true"
        app:centerRadius="8.5dp"
        app:clockWise="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nick_name"
        app:layout_constraintEnd_toEndOf="@+id/layout_title_bar"
        app:layout_constraintTop_toTopOf="@+id/tv_nick_name"
        app:progress="95"
        app:ringRadius="1.5dp"
        app:startAngle="270"/>
    <com.zhenai.profile.recommend.widget.RecommendStyleView
        android:id="@+id/profile_view"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommendParentVerifyTipBanner"/>
    <com.zhenai.business.business.zhenxiaoai.main.ZhenxiaoaiView
        android:id="@+id/view_zhenxiaoai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/profile_view"
        app:layout_constraintTop_toTopOf="@+id/profile_view"/>
    <include
        android:id="@+id/wechat_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_title_bar"
        layout="@layout/layout_recommend_wechat_tip"/>
    <com.zhenai.profile.base_profile.widget.RecommendParentVerifyTipBanner
        android:id="@+id/recommendParentVerifyTipBanner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wechat_view"/>
    <com.zhenai.business.gift.view.LiteGiftLayout
        android:id="@+id/liteGiftLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/bottom_view_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/hn_view_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/edit_profile_layout"
        android:background="@drawable/bg_8b76f9_rectangle_26_radius"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginBottom="@dimen/dp30"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp60"
        android:layout_marginEnd="@dimen/dp60"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_edit_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile"/>
    </LinearLayout>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/say_hi_svga"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/not_complete_tips"
        android:background="@drawable/profile_not_complete_tips"
        android:visibility="gone"
        android:layout_width="170dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="@+id/profile_progress"
        app:layout_constraintTop_toBottomOf="@+id/profile_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
