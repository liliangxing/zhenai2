<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_mine_profile_chose_dialog"
    android:layout_width="match_parent"
    android:layout_height="468dp">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff6c6d75"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/profile_dialog_content_title_des"/>
    <LinearLayout
        android:id="@+id/input_group"
        android:background="@drawable/profile_option_unchoose_v8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="25dp"
        android:layout_marginHorizontal="25dp">
        <EditText
            android:textSize="15sp"
            android:textColor="#6c6d75"
            android:textColorHint="@color/color_a0a0a0"
            android:gravity="start|center_vertical"
            android:id="@+id/input_et"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/nickname_input_hint"
            android:lines="1"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/editext_cursor_shape_v2"
            android:paddingStart="15dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/input_et_clear"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close_profile_v8"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <Space
        android:id="@+id/edit_space"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ScrollView
        android:id="@+id/choice_options_container"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/choice_options"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="25dp"/>
    </ScrollView>
    <com.zhenai.login.login_intercept_guide.widget.No3dChoicePickerView
        android:id="@+id/wheelView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:id="@+id/first_chose_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设为首选"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（将优先为你推荐该地区的异性）"/>
        <Switch
            android:id="@+id/switch_set_first_chosen"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:checked="false"
            android:thumb="@drawable/switch_fashion_show_thumb"
            android:track="@drawable/switch_workcity_first_chose_selector"/>
    </LinearLayout>
    <com.zhenai.mine.widget.WorkCityChoseLayout
        android:id="@+id/work_city_chose_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/submit"
        android:background="@drawable/round_767dff_btn_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="16dp"
        android:text="@string/submit"
        android:layout_marginHorizontal="25dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#767dff"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="31dp"
        android:text="@string/guide_skip_title"
        android:layout_marginHorizontal="25dp"/>
</LinearLayout>
