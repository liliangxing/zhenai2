<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.module_emotion.course.widget.QualityCourseHeaderView
        android:id="@+id/v_course_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_46dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line_view"
        android:background="@color/color_dividing_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_line_height"
        app:layout_constraintTop_toBottomOf="@+id/v_course_header"/>
    <com.zhenai.base.widget.recyclerview.DragRecyclerView
        android:id="@+id/rv_course_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line_view"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_empty"
        android:background="@color/white"
        android:paddingTop="@dimen/dimen_40dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_46dp"
        app:layout_constraintTop_toBottomOf="@+id/v_course_header">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/load_fail_img_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_default_empty_page"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#666978"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/load_fail_tips_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/teacher_list_empty"
            android:lineSpacingExtra="5dp"/>
    </LinearLayout>
</LinearLayout>
