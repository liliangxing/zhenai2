<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:gravity="center"
        android:id="@+id/vs_recommend_empty"
        android:layout="@layout/fragment_recommend_7_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.profile.recommend.topguide.RecommendTopGuideView
        android:id="@+id/recommend_top_guide_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.card_stack_view.CardStackView
        android:id="@+id/card_stack_view"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_top_guide_view"/>
    <com.zhenai.business.business.zhenxiaoai.main.ZhenxiaoaiView
        android:id="@+id/view_zhenxiaoai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_stack_view"
        app:layout_constraintTop_toTopOf="@+id/card_stack_view"/>
    <com.zhenai.profile.recommend.widget.RecommendLimitView
        android:id="@+id/limit_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/loading_layout"
        android:clickable="true"
        android:layout="@layout/fragment_recommend_7_loading_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:background="@drawable/recommend_bottom_shade_shape"
        android:layout_width="match_parent"
        android:layout_height="133dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_view_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.zhenai.business.gift.view.LiteGiftLayout
        android:id="@+id/liteGiftLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/recommend7OfflineVipEntrance"
        android:visibility="gone"
        android:layout="@layout/layout_offline_vip_recommend_entrance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_top_guide_view"/>
    <com.zhenai.business.live.widget.hn_window.SuspensionWindowTips
        android:id="@+id/recommend7FocusTips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_stack_view"
        app:mode="oneLine"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/say_hi_svga"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_stack_view"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svga_live_tab_guide"
        android:visibility="gone"
        android:layout_width="204dp"
        android:layout_height="62dp"
        android:layout_marginBottom="50dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="7dp"
        app:antiAlias="true"
        app:autoPlay="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
