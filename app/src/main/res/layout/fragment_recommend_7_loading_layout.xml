<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recommend_loading_layout"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/guide_line">
    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_radar_view"
        android:layout_width="320dp"
        android:layout_height="310dp"
        android:layout_marginBottom="@dimen/dimen_50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.profile.recommend.widget.Recommend7RadarView
        android:layout_gravity="center"
        android:id="@+id/radar_view"
        android:layout_width="270dp"
        android:layout_height="350dp"
        android:layout_marginBottom="@dimen/dimen_50dp"
        app:flicker="1"
        app:headerWidth="78"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:raindropNum="2"
        app:speed="3"
        app:sweepColor="#ff63b2"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center"
        android:id="@+id/svga_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp15"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/tv_radar_tips"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在根据你的择偶要求\10搜寻匹配的人"
        android:lineSpacingExtra="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/svga_search"/>
</androidx.constraintlayout.widget.ConstraintLayout>
