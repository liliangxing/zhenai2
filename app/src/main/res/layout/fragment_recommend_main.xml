<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f2f4f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recommend_title_bar"
        android:paddingTop="25dp"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/recommend_title_group"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_repent_on_recommend_left"
                android:paddingTop="7dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_repent_on_recommend"
                android:paddingStart="@dimen/dimen_10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.lib.zaui.tablayout.ZTabLayout
                android:id="@+id/tab_layout_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/iv_repent_on_recommend_left"
                app:layout_constraintTop_toTopOf="parent"
                app:zIndicatorCornerRadius="3dp"
                app:zIndicatorEndColor="@color/transparent"
                app:zIndicatorHeight="8dp"
                app:zIndicatorMarginBottom="15dp"
                app:zIndicatorScrollScale="true"
                app:zIndicatorStartColor="@color/color_767dff"
                app:zIndicatorWidth="54dp"
                app:zRedDotFixed="false"
                app:zSelectedTextColor="@color/color_26273C"
                app:zSelectedTextSize="18sp"
                app:zTabMode="scrollable"
                app:zTabPaddingLeft="6dp"
                app:zTabPaddingRight="16dp"
                app:zTextBold="text_bold_when_select"
                app:zTitleScaleGradually="true"
                app:zUnSelectedTextColor="@color/color_6c6d75"
                app:zUnSelectedTextSize="16sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="23sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/recommend_title_nickname_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dimen_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="search_layout,iv_follow,lottie_un_follow,iv_cash_activity_enter"
            app:layout_constraintEnd_toStartOf="@+id/recommend_title_nickname_tv"/>
        <TextView
            android:textSize="13.5sp"
            android:textColor="#26273c"
            android:gravity="center_vertical"
            android:id="@+id/search_layout"
            android:paddingTop="@dimen/dp10"
            android:paddingBottom="@dimen/dp10"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_btn"
            android:drawablePadding="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingVertical="@dimen/dp10"
            app:drawableStartCompat="@drawable/recommend_profile7_search_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_cash_activity_enter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/search_layout"
            app:layout_constraintEnd_toStartOf="@+id/online_customer_service_layout"
            app:layout_constraintTop_toTopOf="@+id/search_layout"/>
        <TextView
            android:textSize="13.5sp"
            android:textColor="#26273c"
            android:gravity="center_vertical"
            android:id="@+id/online_customer_service_layout"
            android:paddingTop="@dimen/dp10"
            android:paddingBottom="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/online_customer_service"
            android:drawablePadding="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingVertical="@dimen/dp10"
            app:drawableStartCompat="@drawable/ic_recommend_online_customer_service"
            app:layout_constraintBottom_toBottomOf="@+id/search_layout"
            app:layout_constraintEnd_toStartOf="@+id/search_layout"
            app:layout_constraintTop_toTopOf="@+id/search_layout"/>
        <ImageView
            android:id="@+id/iv_follow"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center_vertical"
            android:id="@+id/lottie_un_follow"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="@dimen/dimen_50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svga_un_follow"
            android:visibility="gone"
            android:layout_width="@dimen/dp72"
            android:layout_height="@dimen/dp65"
            android:layout_marginEnd="@dimen/dp10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.login.widget.NoScrollHorizontalViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_title_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
