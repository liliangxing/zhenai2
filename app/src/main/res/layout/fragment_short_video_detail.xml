<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.business.short_video.widget.VideoDetailView
        android:id="@+id/layout_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clController"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/img_show_praise"
            android:visibility="gone"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_fileName="animation/short_video_praise_anim.json"/>
        <ImageView
            android:id="@+id/img_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/layout_labels"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.base.widget.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/layout_labels"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
            app:layout_constraintLeft_toRightOf="@+id/img_avatar"
            app:layout_constraintRight_toLeftOf="@+id/img_more"
            app:textViewMaxEms="6"
            app:type="radial"/>
        <com.zhenai.base.widget.FlowLayout
            android:id="@+id/layout_video_tag"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_marginTop="10dp"
            app:horizontalSpace="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/img_avatar"
            app:layout_constraintTop_toBottomOf="@+id/img_avatar"
            app:type="radial"/>
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:justifyContent="flex_start"
            app:layout_constraintLeft_toLeftOf="@+id/layout_labels"
            app:layout_constraintRight_toRightOf="@+id/layout_labels"
            app:layout_constraintTop_toTopOf="@+id/img_avatar">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"/>
            <com.zhenai.business.widget.FlagLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_verified_icons"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <ImageView
            android:id="@+id/img_more"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/sv_detail_more"
            android:layout_marginStart="5dp"
            android:layout_toStartOf="@+id/img_close"
            app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
            app:layout_constraintLeft_toRightOf="@+id/layout_labels"
            app:layout_constraintRight_toLeftOf="@+id/img_close"
            app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
        <ImageView
            android:id="@+id/img_close"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/sv_detail_close"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
            app:layout_constraintLeft_toRightOf="@+id/img_more"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tv_video_play_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:shadowColor="@color/semitransparent_black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_avatar"/>
        <FrameLayout
            android:id="@+id/layout_profile"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sv_profile_no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:shadowColor="@color/semitransparent_black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_comment"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_profile"
            app:layout_constraintRight_toRightOf="@+id/layout_profile">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sv_comment_no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/school_comment"
                android:shadowColor="@color/semitransparent_black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_praise"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_comment"
            app:layout_constraintRight_toRightOf="@+id/layout_profile">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_praise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sv_praise_no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_praise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_praise"
                android:shadowColor="@color/semitransparent_black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_follow"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_praise"
            app:layout_constraintRight_toRightOf="@+id/layout_profile">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sv_follow_no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/follow"
                android:shadowColor="@color/semitransparent_black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_follow"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_topic_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:shadowColor="@color/short_video_text_shadow_color"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/tv_moment_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxLines="3"
                android:shadowColor="@color/short_video_text_shadow_color"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:lineSpacingMultiplier="1.2"/>
            <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_video_music"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:bg_colorNormal="#4d000000"
                app:bg_colorStroke="#4d979797"
                app:bg_shape="semicircle"
                app:bg_strokeMode="solid"
                app:bg_strokeWidth="1dp">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/music_anim_view"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:lottie_autoPlay="true"
                    app:lottie_colorFilter="@color/white"
                    app:lottie_fileName="animation/short_video_music_play.json"
                    app:lottie_loop="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:ellipsize="marquee"
                    android:gravity="bottom"
                    android:id="@+id/tv_music_name"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:singleLine="true"
                    android:shadowColor="@color/short_video_text_shadow_color"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="6dp"/>
            </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
        </LinearLayout>
        <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/tv_goto_recommend_btn"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_marginBottom="15dp"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            app:bg_colorNormal="#66000000"
            app:bg_shape="semicircle"
            app:layout_constraintBottom_toTopOf="@+id/layout_question"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.zhenai.business.widget.TextViewLight
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="查看更多推荐视频"
                app:lightColor="@color/white"
                app:normalColor="#dddddd"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="33dp"
                android:layout_height="match_parent"
                android:layout_marginStart="-6dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="animation/short_video_detail_go_recommend_guide.json"
                app:lottie_loop="true"/>
        </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/layout_auditing"
            android:background="#66000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginBottom="@dimen/divider_size"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_state_name"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="@string/video_verifying"
                android:drawablePadding="10.5dp"
                android:drawableStart="@drawable/ic_album_auditing_state"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
