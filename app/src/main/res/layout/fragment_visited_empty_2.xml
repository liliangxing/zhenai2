<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="26dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/upload_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:gravity="center"
        android:id="@+id/empty_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/unlock_option_who_visited_to_understand_everyone_who_interest_me_in_any_time_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_title"/>
    <ImageView
        android:id="@+id/empty_btn"
        android:background="@drawable/rect_767dff_r40"
        android:layout_width="231dp"
        android:layout_height="45dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_desc"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/btn_tv"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/upload_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/empty_btn"
        app:layout_constraintEnd_toStartOf="@+id/btn_loading"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/empty_btn"
        app:layout_constraintTop_toTopOf="@+id/empty_btn"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/btn_loading"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="30dp"
        android:layout_height="15dp"
        app:antiAlias="true"
        app:layout_constraintBottom_toBottomOf="@+id/empty_btn"
        app:layout_constraintEnd_toEndOf="@+id/empty_btn"
        app:layout_constraintStart_toEndOf="@+id/btn_tv"
        app:layout_constraintTop_toTopOf="@+id/empty_btn"
        app:loopCount="-1"
        app:source="loading.svga"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_767dff"
        android:id="@+id/empty_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cert_will_spend_some_times_please_wait"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
