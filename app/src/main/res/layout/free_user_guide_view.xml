<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/avatar_img"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="circle"/>
    <com.zhenai.common.widget.RedDotView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:text="1"
        android:layout_marginStart="12dp"
        app:backgroundColor="@color/red_dot_color"
        app:cornerRadius="10dp"
        app:isWidthHeightEqual="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/red_dot_stroke_color"
        app:strokeWidth="4dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_lottie"
        android:layout_width="10dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_sub_title"
        app:layout_constraintStart_toEndOf="@+id/avatar_img"
        app:layout_constraintTop_toTopOf="@+id/avatar_img"
        app:layout_constraintVertical_chainStyle="packed"
        app:lottie_fileName="animation/live_video_free_user_tip.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_lottie"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toEndOf="@+id/iv_lottie"
        app:layout_constraintTop_toTopOf="@+id/iv_lottie"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#99ffffff"
        android:ellipsize="end"
        android:id="@+id/tv_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_img"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="@+id/iv_lottie"
        app:layout_constraintTop_toBottomOf="@+id/iv_lottie"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="6dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
