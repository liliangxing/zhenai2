<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/getting_data_fail_root_layout"
    android:background="@color/color_f2f4f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/getting_data_fail_default_icon"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/bg_limited_person_error"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/getting_data_fail_default_tv"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="30dp"
        android:lineSpacingMultiplier="1.2"/>
</LinearLayout>
