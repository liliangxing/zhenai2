<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/hn_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/hn_info"
        android:background="@drawable/hn_match_vip_user_info_bg"
        android:visibility="gone"
        android:layout_width="94dp"
        android:layout_height="22dp"
        android:layout_marginLeft="@dimen/dimen_2dp"
        android:layout_marginTop="3dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/hn_avatar"
            android:layout_width="@dimen/dimen_16dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/hn_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/user_info"
        android:background="@drawable/hn_match_vip_user_info_bg"
        android:visibility="gone"
        android:layout_width="122dp"
        android:layout_height="37dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="3dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/user_avatar"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_margin="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/user_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"/>
    </LinearLayout>
    <com.zhenai.live.voice.widget.CircleSpreadView
        android:layout_gravity="bottom|right"
        android:id="@+id/v_circle_spread"
        android:visibility="gone"
        android:layout_width="49dp"
        android:layout_height="49dp"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/img_voice_switch"
        android:visibility="gone"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_marginBottom="9dp"
        android:src="@drawable/hn_match_vip_got_in"
        android:layout_marginEnd="9dp"/>
</FrameLayout>
