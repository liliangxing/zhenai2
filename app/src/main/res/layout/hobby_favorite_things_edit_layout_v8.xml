<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#767dff"
            android:gravity="center_vertical"
            android:id="@+id/add_hobby_tv"
            android:paddingLeft="13dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="添加爱好标签"
            android:drawableLeft="@drawable/hobby_add_icon"
            android:drawablePadding="@dimen/dimen_4dp"
            android:layout_marginEnd="4dp"/>
        <View
            android:id="@+id/line_view"
            android:background="#0d26273b"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/add_hobby_tv"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <com.zhenai.business.widget.label_layout.LabelLayout
            android:id="@+id/hobby_label_lay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/line_view"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:auto_select_effect="false"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hobby_nothing_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:layout_below="@+id/line_view"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_same_hobby"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/color_666978"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="找到志趣相投的TA"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
