<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_layout"
    android:background="#f3f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/edit_top_layout"
            android:background="@drawable/bg_custom_answer_edit_text_v8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.business.widget.label_layout.LabelLayout
                android:orientation="horizontal"
                android:id="@+id/hobby_label_lay"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8dp"
                android:layout_marginBottom="@dimen/dimen_8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="@dimen/dimen_5dp"
                app:auto_select_effect="false"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaeafb3"
            android:gravity="right"
            android:id="@+id/hobby_tab_count_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:text="@string/add_hobby_count_text"
            android:layout_below="@+id/edit_top_layout"
            android:layout_marginEnd="12dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hobby_hint_list_view"
            android:background="@drawable/hobby_thing_rv_bg"
            android:paddingTop="@dimen/dimen_6dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/edit_top_layout"/>
        <View
            android:id="@+id/left_black_line"
            android:background="#bdbec4"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_alignBottom="@+id/edit_top_layout"/>
        <View
            android:id="@+id/right_black_line"
            android:background="#bdbec4"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_alignBottom="@+id/edit_top_layout"
            android:layout_alignEnd="@+id/edit_top_layout"/>
        <View
            android:id="@+id/top_white_line"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="0dp"
            android:layout_below="@+id/right_black_line"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_alignStart="@+id/left_black_line"
            android:layout_alignEnd="@+id/right_black_line"/>
    </RelativeLayout>
</FrameLayout>
