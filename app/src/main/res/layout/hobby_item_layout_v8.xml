<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_layout"
    android:background="@drawable/rectangle_ffffff_radius_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginRight="12dp"
    android:minHeight="80dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:layout_marginHorizontal="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff6c6d75"
            android:gravity="center"
            android:id="@+id/hobby_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff767dff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/hobby_content"
            android:background="@drawable/shape_ebecff_rounf_8"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <com.zhenai.business.widget.label_layout.LabelLayout
            android:id="@+id/hobby_label_lay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="48dp"
            app:auto_select_effect="false"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffff7599"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/hobby_warning"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:drawablePadding="5dp"
            android:layout_below="@+id/hobby_label_lay"
            android:layout_alignParentBottom="true"
            android:drawableStart="@drawable/hobby_not_pass"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hobby_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff767dff"
            android:layout_gravity="center_vertical"
            android:id="@+id/hobby_edit_txt"
            android:paddingTop="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未填写"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/hobby_edit_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_enter"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</RelativeLayout>
