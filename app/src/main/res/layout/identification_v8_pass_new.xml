<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/name_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/credit_upload_id_cards_name_1"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="16sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/real_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/name_tips"
        app:layout_constraintStart_toEndOf="@+id/name_tips"
        app:layout_constraintTop_toTopOf="@+id/name_tips"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/id_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="@string/credit_upload_id_cards_no_1"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_tips"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="16sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/real_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/id_tips"
        app:layout_constraintStart_toEndOf="@+id/id_tips"
        app:layout_constraintTop_toTopOf="@+id/id_tips"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/identify_btn"
        android:background="@drawable/bg_767dff_rectangle_40_radius"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp60"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/dp60"
        android:text="@string/continue_certification"
        android:layout_marginHorizontal="@dimen/dp60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/real_id"/>
    <ImageView
        android:id="@+id/invite_header"
        android:background="@drawable/icon_invite_cert_header"
        android:visibility="gone"
        android:layout_width="17dp"
        android:layout_height="7dp"
        app:layout_constraintBottom_toTopOf="@+id/invite_group"
        app:layout_constraintEnd_toEndOf="@+id/identify_btn"
        app:layout_constraintStart_toStartOf="@+id/identify_btn"
        app:layout_constraintTop_toBottomOf="@+id/identify_btn"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/invite_group"
        android:background="@drawable/rect_46485b_r14"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invite_header">
        <com.zhenai.business.widget.AvatarListView
            android:id="@+id/invite_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:avatarWidth="24dp"
            app:borderColor="@color/white"
            app:borderWidth="1dp"
            app:centerCross="-2dp"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:id="@+id/invite_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp8"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/identify_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="@string/identify_id_card_and_face_both"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invite_group"
        app:layout_goneMarginTop="@dimen/dp10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
