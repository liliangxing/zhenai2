<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tips1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/income_certify_tips1"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tips2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/income_certify_tips2"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tips1"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/income_certification_btn"
        android:background="@drawable/bg_767dff_rectangle_40_radius"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp60"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/dp60"
        android:layout_marginHorizontal="@dimen/dp60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tips2"/>
    <ImageView
        android:id="@+id/invite_header"
        android:background="@drawable/icon_invite_cert_header"
        android:visibility="gone"
        android:layout_width="17dp"
        android:layout_height="7dp"
        app:layout_constraintEnd_toEndOf="@+id/income_certification_btn"
        app:layout_constraintStart_toStartOf="@+id/income_certification_btn"
        app:layout_constraintTop_toBottomOf="@+id/income_certification_btn"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/invite_group"
        android:background="@drawable/rect_46485b_r200"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invite_header">
        <com.zhenai.business.widget.AvatarListView
            android:id="@+id/invite_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:avatarWidth="24dp"
            app:borderColor="@color/white"
            app:borderWidth="1dp"
            app:centerCross="-2dp"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/invite_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="9dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:gravity="center"
        android:id="@+id/income_certify_show_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/income_certify_show_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invite_group"
        app:layout_goneMarginTop="@dimen/dp8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
