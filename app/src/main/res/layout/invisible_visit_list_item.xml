<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_5dp">
    <ImageView
        android:id="@+id/iv_interaction_item_avatar"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/dimen_15dp"
        android:layout_marginEnd="8dp"/>
    <ImageView
        android:id="@+id/iv_interaction_item_new_mark"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/interaction_new_mark"
        android:layout_alignTop="@+id/iv_interaction_item_avatar"
        android:layout_alignStart="@+id/iv_interaction_item_avatar"/>
    <View
        android:id="@+id/divider_horizontal"
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_size_small"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/iv_interaction_item_avatar"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_21dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#666978"
        android:ellipsize="end"
        android:id="@+id/tv_interaction_item_content"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:maxLines="1"
        android:layout_above="@+id/divider_horizontal"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@+id/iv_interaction_item_avatar"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_interaction_item_content"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/dimen_10dp"
        android:layout_toEndOf="@+id/iv_interaction_item_avatar">
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_interaction_item_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:layout_marginEnd="@dimen/dimen_50dp"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="nowrap">
            <TextView
                android:textSize="15sp"
                android:textColor="#42475c"
                android:ellipsize="end"
                android:id="@+id/tv_interaction_item_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_flexShrink="1"/>
            <com.zhenai.business.widget.FlagLayout
                android:id="@+id/layout_interaction_item_flags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <com.zhenai.base.widget.FlowLayout
            android:id="@+id/layout_interaction_item_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="20dp"
            android:layout_below="@+id/layout_interaction_item_nickname"
            app:horizontalSpace="5dp"
            app:type="radial"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layout_cancel_invisible_visit"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_below="@+id/divider_horizontal">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_cancel_invisible_visit"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_666978"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_invisible_visit"/>
    </LinearLayout>
</RelativeLayout>
