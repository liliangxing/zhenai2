<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/line_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_1"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_2"
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_3"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_1"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_3"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="40dp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_2"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_avatar_4"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_avatar_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line_1"
        app:roundImageType="circle"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_avatar_5"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar_4"
        app:layout_constraintTop_toBottomOf="@+id/line_1"
        app:roundImageType="circle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
