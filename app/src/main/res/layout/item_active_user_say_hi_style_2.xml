<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/line_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_1"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_2"
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_3"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_1"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_3"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="40dp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_2"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/line_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_5"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_6"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_4"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_6"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_5"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/line_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_7"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_8"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_avatar_9"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_7"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar_9"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar_8"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
