<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_audience_list_0"
    android:paddingTop="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp84">
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:avatar_height="@dimen/dp48"
        app:avatar_width="@dimen/dp48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:setSvgaDimen="true"
        app:svga_height="@dimen/dp72"
        app:svga_width="@dimen/dp72"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/nickNameTextView"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp3"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toStartOf="@+id/zhenxinMember"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_goneMarginBottom="@dimen/dp15"/>
    <ImageView
        android:id="@+id/zhenxinMember"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_live_v8_audience_item_zhenxin_member"
        android:layout_marginEnd="@dimen/dp3"
        app:layout_constraintBottom_toBottomOf="@+id/nickNameTextView"
        app:layout_constraintEnd_toStartOf="@+id/iconGuard"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/nickNameTextView"
        app:layout_constraintTop_toTopOf="@+id/nickNameTextView"/>
    <ImageView
        android:id="@+id/iconGuard"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/live_icon_guard"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/nickNameTextView"
        app:layout_constraintEnd_toStartOf="@+id/rankTv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/zhenxinMember"
        app:layout_constraintTop_toTopOf="@+id/nickNameTextView"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/rankTv"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/nickNameTextView"
        app:layout_constraintEnd_toStartOf="@+id/pokeButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iconGuard"
        app:layout_constraintTop_toTopOf="@+id/nickNameTextView"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_99_fff"
        android:ellipsize="end"
        android:id="@+id/description"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp15"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pokeButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/nickNameTextView"
        app:layout_constraintTop_toBottomOf="@+id/nickNameTextView"/>
    <TextView
        android:gravity="center"
        android:id="@+id/pokeButton"
        android:tag="binding_6"
        android:visibility="gone"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp28"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
