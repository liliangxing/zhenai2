<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp">
    <ImageView
        android:id="@+id/iv_chat_card_user_avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/tv_chat_card_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="110dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/iv_chat_card_user_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_chat_card_identified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_already_real_name_identify_v9"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_chat_card_user_name"
        app:layout_constraintStart_toEndOf="@+id/tv_chat_card_user_name"
        app:layout_constraintTop_toTopOf="@+id/tv_chat_card_user_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/tv_chat_card_user_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_chat_card_user_avatar"
        app:layout_constraintStart_toEndOf="@+id/iv_chat_card_user_avatar"/>
    <ImageView
        android:id="@+id/cb_chat_card_user_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/chat_card_user_check_selector"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_AEAFB3"
        android:id="@+id/tv_chat_card_user_last_mail_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_chat_card_user_name"
        app:layout_constraintEnd_toStartOf="@+id/cb_chat_card_user_check"/>
</androidx.constraintlayout.widget.ConstraintLayout>
