<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingRight="@dimen/dimen_10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cl_content"
        android:layout_width="145dp"
        android:layout_height="150dp">
        <ImageView
            android:id="@+id/iv_pic"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_79dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/dimen_6dp"
            android:paddingTop="@dimen/dimen_4dp"
            android:paddingRight="@dimen/dimen_6dp"
            android:paddingBottom="@dimen/dimen_4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintTop_toBottomOf="@+id/iv_pic"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_coin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <ImageView
                android:id="@+id/iv_coin"
                android:background="@drawable/icon_zhenai_coin"
                android:paddingRight="@dimen/dimen_4dp"
                android:layout_width="@dimen/dimen_14dp"
                android:layout_height="@dimen/dimen_14dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_price"
                app:layout_constraintRight_toLeftOf="@+id/tv_price"
                app:layout_constraintTop_toTopOf="@+id/tv_price"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_666978"
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/iv_coin"/>
            <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                android:textSize="@dimen/dimen_10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_tag"
                android:padding="@dimen/dimen_2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dimen_6dp"
                android:text="限时免费"
                app:bg_colorGradientEnd="@color/color_f5a623"
                app:bg_colorGradientStart="@color/color_f5a623"
                app:bg_fillMode="linearGradient"
                app:bg_radius="@dimen/dimen_2dp"
                app:bg_shape="round"
                app:layout_constraintBottom_toBottomOf="@+id/tv_price"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_price"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
