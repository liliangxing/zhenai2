<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_666978"
        android:ellipsize="end"
        android:id="@+id/tv_classify_search"
        android:background="@color/color_f2f2f2"
        android:paddingLeft="@dimen/dimen_7dp"
        android:paddingTop="@dimen/dimen_3dp"
        android:paddingRight="@dimen/dimen_7dp"
        android:paddingBottom="@dimen/dimen_3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_7dp"
        android:singleLine="true"
        app:bg_colorGradientEnd="@color/color_f2f2f2"
        app:bg_colorGradientStart="@color/color_f2f2f2"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_13dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_7dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_classify_search">
        <ImageView
            android:id="@+id/iv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_result_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_result_title"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_666978"
            android:ellipsize="end"
            android:id="@+id/tv_result_title"
            android:paddingTop="@dimen/dimen_3dp"
            android:paddingRight="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_4dp"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            android:singleLine="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toRightOf="@+id/iv_type"
            app:layout_constraintRight_toLeftOf="@+id/tv_teacher_name"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_999999"
            android:id="@+id/tv_teacher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_result_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_result_title"/>
        <View
            android:background="@color/color_dividing_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_line_height"
            android:layout_marginTop="@dimen/dimen_5dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_result_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
