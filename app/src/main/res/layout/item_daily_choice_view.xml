<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:paddingLeft="@dimen/dimen_15dp"
    android:paddingTop="@dimen/dimen_11dp"
    android:paddingRight="@dimen/dimen_15dp"
    android:paddingBottom="@dimen/dimen_5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/ll_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_12dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/v_line"
            android:background="@color/color_ebebeb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_line_height"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/ll_line"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_day"
        android:paddingTop="@dimen/dimen_3dp"
        android:paddingBottom="@dimen/dimen_3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_year"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_month"
        android:paddingLeft="@dimen/dimen_4dp"
        android:paddingTop="@dimen/dimen_3dp"
        android:paddingBottom="@dimen/dimen_3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/tv_day"
        app:layout_constraintTop_toBottomOf="@+id/tv_year"/>
    <ImageView
        android:id="@+id/iv_poster"
        android:layout_width="@dimen/dimen_60dp"
        android:layout_height="@dimen/dimen_60dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_day"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:layout_width="@dimen/dimen_17dp"
        android:layout_height="@dimen/dimen_14dp"
        app:bg_colorGradientEnd="@color/color_80_000"
        app:bg_colorGradientStart="@color/color_80_000"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_5dp"
        app:bg_radiusLeftTop="8dp"
        app:bg_radiusRightBottom="8dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/iv_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
    <ImageView
        android:id="@+id/iv_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_3dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_9dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/tv_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_9dp"
        android:layout_marginTop="@dimen/dimen_3dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_sub_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_9dp"
        android:layout_marginTop="@dimen/dimen_7dp"
        android:drawableLeft="@drawable/ic_tag_qinggan"
        android:drawablePadding="@dimen/dimen_1dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_play_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_9dp"
        android:layout_marginTop="@dimen/dimen_7dp"
        android:drawableLeft="@drawable/ic_daily_choice_look"
        android:drawablePadding="@dimen/dimen_1dp"
        app:layout_constraintLeft_toRightOf="@+id/tv_sub_des"
        app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
</androidx.constraintlayout.widget.ConstraintLayout>
