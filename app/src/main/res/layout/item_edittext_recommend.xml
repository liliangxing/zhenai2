<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_aeafb3_stroke_8_shape"
    android:paddingTop="@dimen/dp8"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp83"
    android:paddingVertical="@dimen/dp8">
    <com.zhenai.common.widget.ScrollEditText
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#26273b"
        android:textColorHint="@color/color_aeafb3"
        android:gravity="start|top"
        android:id="@+id/reason_edit_text"
        android:background="@color/transparent"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:hint="@string/please_write_other_reason"
        android:maxLines="3"
        android:layout_weight="1"
        android:textCursorDrawable="@drawable/editext_cursor_shape_v2"
        android:paddingHorizontal="@dimen/dp8"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_aeafb3"
        android:layout_gravity="end"
        android:id="@+id/text_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp8"/>
</LinearLayout>
