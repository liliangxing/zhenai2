<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="#26273b"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:background="@drawable/bg_ffffff_stroke_6c6d75_40_radius"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_right_avatar"
        android:background="@drawable/bg_cricle_ffffff"
        android:padding="1.5dp"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/default_circle_avatar"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="@+id/iv_left_avatar"/>
    <ImageView
        android:id="@+id/iv_left_avatar"
        android:background="@drawable/bg_cricle_ffffff"
        android:padding="1.5dp"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/default_circle_avatar"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
