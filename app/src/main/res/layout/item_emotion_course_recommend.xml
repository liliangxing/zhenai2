<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_f2f2f2_3r3r4r4r"
    android:layout_width="@dimen/dp302"
    android:layout_height="@dimen/dp314"
    android:layout_marginEnd="@dimen/dp10">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/sdv_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp81"
        android:scaleType="fitXY"
        app:borderRadius="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="round"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/v_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp81"
        app:bg_colorGradientEnd="#ff81a3bb"
        app:bg_colorGradientStart="#ff6d889f"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_4dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/sdv_bg"
        app:layout_constraintEnd_toEndOf="@+id/sdv_bg"
        app:layout_constraintStart_toStartOf="@+id/sdv_bg"
        app:layout_constraintTop_toTopOf="@+id/sdv_bg"/>
    <com.zhenai.common.widget.BoldTextView
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_course_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp15"
        android:layout_marginEnd="@dimen/dp15"
        app:layout_constraintEnd_toEndOf="@+id/sdv_bg"
        app:layout_constraintStart_toStartOf="@+id/sdv_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#fff5a623"
        android:id="@+id/tv_current_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp14"
        android:layout_marginStart="@dimen/dp15"
        app:layout_constraintBottom_toBottomOf="@+id/sdv_bg"
        app:layout_constraintStart_toStartOf="@+id/sdv_bg"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_99_fff"
        android:id="@+id/tv_original_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_current_price"
        app:layout_constraintStart_toEndOf="@+id/tv_current_price"
        app:layout_constraintTop_toTopOf="@+id/tv_current_price"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_99_fff"
        android:id="@+id/tv_learn_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp14"
        app:layout_constraintBottom_toBottomOf="@+id/tv_current_price"
        app:layout_constraintEnd_toEndOf="@+id/sdv_bg"
        app:layout_constraintTop_toTopOf="@+id/tv_current_price"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/course_list_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_9dp"
        app:layout_constraintEnd_toEndOf="@+id/sdv_bg"
        app:layout_constraintStart_toStartOf="@+id/sdv_bg"
        app:layout_constraintTop_toBottomOf="@+id/sdv_bg"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#8042475c"
        android:id="@+id/course_total_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:layout_marginBottom="@dimen/dimen_12dp"
        android:text="@string/emotion_course_look_all_course"
        android:drawablePadding="@dimen/dimen_6dp"
        android:drawableEnd="@drawable/ic_emotion_right_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/sdv_bg"
        app:layout_constraintStart_toStartOf="@+id/sdv_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
