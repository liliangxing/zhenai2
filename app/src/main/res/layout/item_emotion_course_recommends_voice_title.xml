<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dimen_15dp"
    android:paddingTop="@dimen/dimen_20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="19sp"
        android:textColor="@color/color_42475C"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_item_title"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingBottom="@dimen/dimen_4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="音频课程"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_8b76f9"
        android:gravity="center"
        android:id="@+id/tv_more"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/more"
        android:drawableRight="@drawable/ic_emotion_right_arrow_purple"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
