<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_5dp"
    android:layout_marginBottom="@dimen/dimen_5dp"
    android:layout_marginStart="@dimen/dp14"
    android:layout_marginEnd="@dimen/dp14">
    <ImageView
        android:id="@+id/iv_picture"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:paddingLeft="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/iv_picture"
        app:layout_constraintRight_toLeftOf="@+id/tv_new_tag"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_new_tag"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_tips"
        android:layout_marginStart="@dimen/dimen_4dp"
        android:layout_marginEnd="@dimen/dp17"
        app:bg_colorGradientEnd="@color/color_f94139"
        app:bg_colorGradientStart="@color/color_ff9070"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintLeft_toRightOf="@+id/tv_title"
        app:layout_constraintRight_toLeftOf="@+id/iv_play_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <ImageView
        android:id="@+id/iv_play_icon"
        android:background="@drawable/ic_emotion_daily_choice_play"
        android:layout_width="@dimen/dp26"
        android:layout_height="@dimen/dp26"
        android:layout_marginStart="@dimen/dimen_13dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:layout_width="@dimen/dp17"
        android:layout_height="@dimen/dp14"
        app:bg_colorGradientEnd="@color/color_80_000"
        app:bg_colorGradientStart="@color/color_80_000"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_5dp"
        app:bg_radiusLeftTop="8dp"
        app:bg_radiusRightBottom="8dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/iv_picture"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <ImageView
        android:id="@+id/iv_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_3dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
