<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/bg_view"
        android:background="@drawable/selector_emotion_recharge_item"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:button="@null"
        android:layout_marginStart="@dimen/dimen_3dp"
        android:layout_marginEnd="@dimen/dimen_3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_save_money"
        android:background="@drawable/shape_emotion_recharge_save"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:text="省22元"
        android:paddingStart="@dimen/dimen_3dp"
        android:paddingEnd="@dimen/dimen_3dp"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ff757785"
        android:gravity="center_vertical"
        android:id="@+id/tv_coin_num"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_new_num"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toStartOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffb9b9b9"
        android:gravity="end"
        android:id="@+id/tv_old_num"
        android:paddingTop="@dimen/dimen_1dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="300元"
        android:layout_marginEnd="@dimen/dimen_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_new_num"
        app:layout_constraintEnd_toStartOf="@+id/tv_new_num"
        app:layout_constraintStart_toStartOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="@+id/tv_new_num"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffb9b9b9"
        android:id="@+id/tv_new_num"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintStart_toEndOf="@+id/tv_old_num"
        app:layout_constraintTop_toBottomOf="@+id/tv_coin_num"/>
</androidx.constraintlayout.widget.ConstraintLayout>
