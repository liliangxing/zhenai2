<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_empty_my_follow_guide_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/guide_data"
        android:background="@color/color_f2f4f5"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp36"
            android:text="@string/me_followed_empty_tips"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@drawable/bg_rectangle_ffffff_16r_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_12dp"
            android:layout_marginTop="@dimen/dp36"
            android:layout_marginRight="@dimen/dimen_12dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="@dimen/dimen_12dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_26273C"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp26"
                    android:text="@string/live_main_list_for_you_recommend"
                    android:layout_marginStart="@dimen/dimen_16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/color_767dff"
                    android:id="@+id/change"
                    android:tag="binding_1"
                    android:padding="@dimen/dimen_10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_batch"
                    android:layout_marginEnd="@dimen/dimen_16dp"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.zhenai.mine.interaction.followed.widget.FollowRecyclerView
                android:id="@+id/recyclerview"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dimen_16dp"
                android:layout_marginTop="@dimen/dp22"
                android:layout_marginRight="@dimen/dimen_16dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/dimen_16dp"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_follow"
                android:tag="binding_2"
                android:background="@drawable/common_btn_v8"
                android:layout_width="231dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:layout_marginBottom="@dimen/dp24"
                android:text="@string/follow"
                style="?android:attr/borderlessButtonStyle"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:id="@+id/empty_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
