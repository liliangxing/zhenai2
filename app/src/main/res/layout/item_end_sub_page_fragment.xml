<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:tag="layout/item_end_sub_page_fragment_0"
    android:paddingTop="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <CheckBox
        android:id="@+id/check_box"
        android:tag="binding_1"
        android:background="@null"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:button="@drawable/live_checkbox_item_selector"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_avatar"
        android:tag="binding_2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toEndOf="@+id/check_box"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white_90"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nickname"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_chat"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/tv_tag"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lines="1"
        app:layout_constraintEnd_toStartOf="@+id/tv_chat"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ff767dff"
        android:gravity="center"
        android:id="@+id/tv_chat"
        android:tag="binding_5"
        android:background="@drawable/bg_7f7dff_r14_rectangle_stroke_1dp"
        android:layout_width="46dp"
        android:layout_height="27dp"
        android:layout_marginTop="10dp"
        android:text="@string/live_secret_send_message"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_follow"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:gravity="center"
        android:id="@+id/btn_follow"
        android:tag="binding_6"
        android:layout_width="58dp"
        android:layout_height="27dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_40"
        android:id="@+id/tv_content"
        android:tag="binding_7"
        android:background="@drawable/bg_a1ffffff_r15_rectangle"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/img_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
