<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rect_white_r16"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="12dp">
    <FrameLayout
        android:id="@+id/avatar_group"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/follow_tips"
            android:background="@color/color_767dff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_26273c"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_group"
        app:layout_constraintTop_toTopOf="@+id/avatar_group"/>
    <com.zhenai.business.emotion.view.CustomTagListView
        android:orientation="horizontal"
        android:id="@+id/advantage_tags"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="11dp"
        app:horizontalSpacing="@dimen/dimen_5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_group"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:type="radial"
        app:verticalSpacing="@dimen/dimen_5dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_aeafb3"
        android:ellipsize="end"
        android:id="@+id/media_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:lines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar_group"
        app:layout_constraintTop_toBottomOf="@+id/advantage_tags"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/intro_desc"
        android:background="@drawable/rect_f2f4f5_r8"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
