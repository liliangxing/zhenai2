<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_grid_empty_my_follow_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar"
        android:tag="binding_1"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/checkbox"
        android:tag="binding_2"
        android:layout_width="24dp"
        android:layout_height="@dimen/dimen_24dp"
        android:layout_marginTop="@dimen/dp36"
        android:button="@drawable/selecter_my_follow_check"
        android:layout_marginStart="@dimen/dp36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/nickname"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-5dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginRight="-5dp"
        android:maxLines="1"
        android:layout_marginHorizontal="-5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/labels"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="@dimen/dimen_7dp"
        android:layout_marginRight="-10dp"
        android:maxLines="1"
        android:layout_marginHorizontal="-10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nickname"/>
</androidx.constraintlayout.widget.ConstraintLayout>
