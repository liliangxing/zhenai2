<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    android:layout_marginVertical="7dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llQuestionStyle"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center_vertical"
            android:id="@+id/cb_reason_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/say_hi_tips"
            android:layout_weight="1"/>
        <CheckBox
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#737583"
            android:gravity="center_vertical"
            android:id="@+id/cb_reason"
            android:padding="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/selecter_2"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_fe8062"
            android:layout_gravity="top"
            android:id="@+id/under_review"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/under_review"
            android:layout_marginStart="25dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llAddCustomQuestionStyle"
        android:background="@drawable/rect_767dff_stroke_1_r200"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/icon_add_concern"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/concern_issue_add_2"/>
    </LinearLayout>
</FrameLayout>
