<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_guard_group_list_0"
    android:paddingTop="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp84">
    <ImageView
        android:id="@+id/rankImageView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_aeafb3"
        android:id="@+id/rankTextView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp38"
        app:avatar_height="@dimen/dp48"
        app:avatar_width="@dimen/dp48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:setSvgaDimen="true"
        app:svga_height="@dimen/dp72"
        app:svga_width="@dimen/dp72"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/nickName"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintEnd_toStartOf="@+id/guardLayout"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <FrameLayout
        android:id="@+id/guardLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp14"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatar">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="end|center_vertical"
            android:id="@+id/guard_month_tv"
            android:tag="binding_2"
            android:background="@drawable/icon_guard_me_month_light_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guardLayout"
        app:layout_constraintStart_toStartOf="@+id/nickName"
        app:layout_constraintTop_toBottomOf="@+id/nickName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
