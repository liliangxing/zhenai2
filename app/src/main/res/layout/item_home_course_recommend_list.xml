<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_home_recommend_course"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp26"
    android:layout_marginStart="@dimen/dimen_15dp"
    android:layout_marginEnd="@dimen/dimen_15dp">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_20dp"
        android:textColor="@color/color_333333"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_pay_title"
        android:paddingLeft="@dimen/dimen_12dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:text="@string/emotion_home_recommend"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_8b76f9"
        android:layout_gravity="right"
        android:id="@+id/tv_more"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingRight="@dimen/dimen_12dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more"
        android:drawableRight="@drawable/ic_emotion_right_arrow_purple"
        android:layout_toRightOf="@+id/tv_pay_title"
        android:layout_alignBottom="@+id/tv_pay_title"
        android:layout_alignParentRight="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_pay_title"/>
    <com.zhenai.business.widget.discretescrollview.DiscreteScrollView
        android:id="@+id/ds_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_18dp"
        android:layout_marginBottom="@dimen/dimen_30dp"
        app:curViewShowInLeft="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
