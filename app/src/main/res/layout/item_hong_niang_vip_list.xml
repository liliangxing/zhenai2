<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.zhenai.business.widget.live.BevelSplitLayout
        android:id="@+id/avatar_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:BevelSplitLayout_cornerRadius="4dp"
        app:BevelSplitLayout_splitRegionWidth="30dp"
        app:layout_constraintDimensionRatio="355:170"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.business.widget.live.RoundTrapezoidImageView
            android:layout_gravity="start"
            android:id="@+id/iv_live_video_list_item_avatar_left"
            android:layout_width="174dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.zhenai.business.widget.live.RoundTrapezoidImageView
            android:layout_gravity="end"
            android:id="@+id/iv_live_video_list_item_avatar_right"
            android:layout_width="174dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </com.zhenai.business.widget.live.BevelSplitLayout>
    <View
        android:background="@drawable/bg_live_video_live_list_item_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
    <View
        android:background="@drawable/bg_live_video_live_list_item_gradient"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_item_seat"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_vip_offline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_live_video_list_item_seat"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="虚位以待"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_inviter_offline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_live_video_list_item_seat"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="虚位以待"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_live_video_linking"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_live_video_linking2"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintEnd_toEndOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/tv_vip_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxWidth="250dp"
        android:lines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintEnd_toStartOf="@+id/iv_live_video_linking"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/tv_inviter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxWidth="250dp"
        android:lines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintEnd_toEndOf="@+id/avatar_layout"
        app:layout_constraintStart_toEndOf="@+id/iv_live_video_linking"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ff42475c"
        android:id="@+id/tv_status_meeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:text="见面情况："
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff666978"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_status_detail"
        android:background="@drawable/bg_1a8b76f5_rectangle_r5_shape"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="17dp"
        android:maxLines="1"
        android:paddingStart="@dimen/dimen_10dp"
        android:paddingEnd="@dimen/dimen_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_status_meeting"/>
</androidx.constraintlayout.widget.ConstraintLayout>
