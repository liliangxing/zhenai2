<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_ktv_pannel_ranking_list_0"
    android:paddingTop="@dimen/dp20"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp84">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/living_lottie"
        android:visibility="gone"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginTop="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/zhibo.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp46"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/collect"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_21sp"
        android:textColor="@color/color_acaebf"
        android:id="@+id/tv_index"
        android:tag="binding_2"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_60_white"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp15"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintEnd_toStartOf="@+id/tv_add"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_add"
        android:tag="binding_4"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp28"
        android:layout_marginTop="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/collect"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ktv_collect_selector"
        android:layout_marginEnd="92dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
