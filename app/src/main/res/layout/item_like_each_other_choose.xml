<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_like_each_other_choose_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_like_each_other"
        android:tag="binding_1"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/like_choose"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/nickname"
            android:tag="binding_3"
            android:background="@drawable/bg_black00_black56_rectangle_shape"
            android:paddingLeft="@dimen/dimen_10dp"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingRight="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dimen_10dp"
            android:paddingVertical="@dimen/dimen_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/like_choose"
            app:layout_constraintEnd_toEndOf="@+id/like_choose"
            app:layout_constraintStart_toStartOf="@+id/like_choose"/>
        <com.zhenai.business.widget.label_layout.MaxLineLabelLayout
            android:id="@+id/label_base_info"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginLeft="@dimen/dimen_10dp"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dimen_10dp"
            android:layout_marginHorizontal="@dimen/dimen_10dp"
            app:auto_select_effect="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/like_choose"
            app:layout_constraintStart_toStartOf="@+id/like_choose"
            app:layout_constraintTop_toBottomOf="@+id/like_choose"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/mail_layout"
        android:tag="binding_4"
        android:layout_width="@dimen/dimen_80dp"
        android:layout_height="@dimen/dimen_80dp"
        android:layout_marginTop="@dimen/dimen_40dp"
        android:src="@drawable/like_each_other_close"
        app:layout_constraintEnd_toStartOf="@+id/say_hi_layout"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/root_like_each_other"/>
    <ImageView
        android:id="@+id/say_hi_layout"
        android:tag="binding_5"
        android:layout_width="@dimen/dimen_80dp"
        android:layout_height="@dimen/dimen_80dp"
        android:src="@drawable/recommend_profile_say_hi_icon_v8"
        android:layout_marginStart="@dimen/dimen_40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mail_layout"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mail_layout,say_hi_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
