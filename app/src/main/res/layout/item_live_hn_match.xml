<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_hn_banner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:borderRadius="4dp"
        app:layout_constraintDimensionRatio="355:170"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="round"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/iv_list_item_official_tag"
        android:paddingTop="4dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        app:layout_constraintStart_toStartOf="@+id/iv_hn_banner"
        app:layout_constraintTop_toTopOf="@+id/iv_hn_banner"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_live_video_list_item_left_name"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:lines="1"
        android:paddingStart="10dp"
        android:paddingEnd="100dp"
        app:bg_colorNormal="#80000000"
        app:bg_radiusLeftBottom="4dp"
        app:bg_radiusRightBottom="4dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_hn_banner"/>
    <FrameLayout
        android:id="@+id/avatar_right_layout"
        android:background="@drawable/bg_circle_white"
        android:padding="1dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_hn_banner"
        app:layout_constraintEnd_toEndOf="@+id/iv_hn_banner">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/avatar_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_zalive_qianxianlist_empty"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/avatar_left_layout"
        android:background="@drawable/bg_circle_white"
        android:padding="1dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_right_layout"
        app:layout_constraintEnd_toStartOf="@+id/avatar_right_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_right_layout">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/avatar_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_zalive_qianxianlist_empty"/>
    </FrameLayout>
    <com.zhenai.common.widget.RoundImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/icon_zalive_qianxian_coverlink_purple"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_right_layout"
        app:layout_constraintEnd_toEndOf="@+id/avatar_right_layout"
        app:layout_constraintStart_toStartOf="@+id/avatar_left_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_right_layout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_video_list_item_audience_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
