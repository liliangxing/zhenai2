<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dimen_15dp"
    android:paddingRight="@dimen/dimen_15dp"
    android:layout_width="match_parent"
    android:layout_height="75dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_index"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/txt_index"
            android:background="@drawable/gift_ranking_list_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/txt_index_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_6dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layout_head_info"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginLeft="3dp"
        android:layout_toRightOf="@+id/layout_index"
        android:layout_centerVertical="true">
        <com.zhenai.live_common.widget.AvatarFrameLayout
            android:id="@+id/gift_ranking_avatar_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:avatar_height="45dp"
            app:avatar_width="45dp"
            app:setSvgaDimen="true"
            app:svga_height="70dp"
            app:svga_width="70dp"/>
        <View
            android:id="@+id/view_header_bg"
            android:background="@drawable/bg_live_hn_match_gift_ranking_list_1"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_toLeftOf="@+id/layout_end_info"
        android:layout_toRightOf="@+id/layout_head_info"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475e"
            android:ellipsize="end"
            android:id="@+id/tv_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_60_42475e"
            android:ellipsize="end"
            android:id="@+id/tv_user_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:maxLines="1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layout_end_info"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <ImageView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/iv_flower_icon"
            android:padding="@dimen/dimen_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_8dp"
            android:src="@drawable/gift_rose_big"
            android:layout_toLeftOf="@+id/tv_current_num"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_current_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_line_bottom"
        android:background="@color/color_e5e5e5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
