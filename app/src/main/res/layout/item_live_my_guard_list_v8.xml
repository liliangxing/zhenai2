<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/my_guard_item_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <TextView
        android:textSize="16sp"
        android:textColor="#6c6d75"
        android:gravity="bottom"
        android:id="@+id/show_title_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/translucent"
        android:layout_width="match_parent"
        android:layout_height="76dp">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/my_gurad_item_button"
            android:background="@drawable/bg_767dff_r14_rectangle"
            android:layout_width="88dp"
            android:layout_height="28dp"
            android:text="私聊"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#42475e"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/my_gurad_item_button"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="end|center_vertical"
            android:id="@+id/guard_month_tv"
            android:background="@drawable/icon_guard_me_day_light_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9999天"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff7599"
            android:id="@+id/remain_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/guard_month_tv"
            app:layout_constraintStart_toEndOf="@+id/guard_month_tv"
            app:layout_constraintTop_toTopOf="@+id/guard_month_tv"/>
        <View
            android:id="@+id/bottom_line_view"
            android:background="#0d26273b"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
