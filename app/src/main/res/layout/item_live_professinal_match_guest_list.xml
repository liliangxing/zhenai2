<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_guest_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="75dp">
    <ImageView
        android:id="@+id/img_header"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_mask"
        app:layout_constraintEnd_toEndOf="@+id/iv_header_mask"
        app:layout_constraintStart_toStartOf="@+id/iv_header_mask"
        app:layout_constraintTop_toTopOf="@+id/iv_header_mask"/>
    <ImageView
        android:id="@+id/img_header_linking"
        android:background="@drawable/bg_live_video_professional_match_dialog_guest_hide"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/bg_zalive_qian_xian_dialog_guest_tab_guest"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_mask"
        app:layout_constraintEnd_toEndOf="@+id/iv_header_mask"
        app:layout_constraintStart_toStartOf="@+id/iv_header_mask"
        app:layout_constraintTop_toTopOf="@+id/iv_header_mask"/>
    <ImageView
        android:id="@+id/iv_header_mask"
        android:background="@drawable/ic_live_hn_host_vip_mask"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_user_warn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/live_link_mic_warn"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_mask"
        app:layout_constraintEnd_toEndOf="@+id/iv_header_mask"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475e"
        android:ellipsize="end"
        android:id="@+id/tv_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_user_msg"
        app:layout_constraintEnd_toStartOf="@+id/guide_line"
        app:layout_constraintStart_toEndOf="@+id/iv_header_mask"
        app:layout_constraintTop_toTopOf="@+id/iv_header_mask"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_60_42475e"
        android:ellipsize="end"
        android:id="@+id/tv_user_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_mask"
        app:layout_constraintEnd_toEndOf="@+id/tv_user_name"
        app:layout_constraintStart_toStartOf="@+id/tv_user_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="100dp"/>
    <ImageView
        android:id="@+id/img_top_tips"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_zalive_ktv_channel_top"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_8b76f5"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_label_content"
        android:padding="@dimen/dimen_5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_8b76f5"
        android:id="@+id/tv_current_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/professional_match_current_host_user"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/ic_live_hn_fast_link"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
