<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="88dp"
    android:layout_height="122dp">
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/sofa_avatar_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:avatar_height="56dp"
        app:avatar_width="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:stroke_size="62dp"
        app:svga_height="80dp"
        app:svga_width="80dp"/>
    <androidx.legacy.widget.Space
        android:id="@+id/sofa_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/sofa_avatar_frame_layout"
        app:layout_constraintEnd_toEndOf="@+id/sofa_avatar_frame_layout"
        app:layout_constraintStart_toStartOf="@+id/sofa_avatar_frame_layout"
        app:layout_constraintTop_toTopOf="@+id/sofa_avatar_frame_layout"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/link_tv"
        android:background="@drawable/rect_767dff_r40"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/on_link_mic"
        android:paddingStart="15dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sofa_guide_line"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/link_lottie"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_tv"
        app:layout_constraintStart_toStartOf="@+id/link_tv"
        app:layout_constraintTop_toTopOf="@+id/link_tv"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/zhibo.json"
        app:lottie_loop="true"/>
    <ImageView
        android:id="@+id/iv_medal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintEnd_toStartOf="@+id/tv_nickname"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_medal"
        app:layout_constraintTop_toBottomOf="@+id/sofa_guide_line"/>
    <ImageView
        android:id="@+id/iv_warn"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/live_link_mic_warn_2"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_checked"
        android:background="@drawable/icon_live_sofa_checked_2"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
