<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/audience_avatar_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:autoRelease="false"
        app:avatar_height="@dimen/audience_avatar_dimen"
        app:avatar_width="@dimen/audience_avatar_dimen"
        app:setSvgaDimen="true"
        app:stroke_size="33dp"
        app:svga_height="@dimen/audience_svga_dimen"
        app:svga_width="@dimen/audience_svga_dimen"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_rank"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_live_video_gift_score_rank_0"
        android:scaleType="center"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/vip_icon_img"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="5dp"/>
    <TextView
        android:textSize="8sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/iv_rank_point"
        android:background="@drawable/bg_live_video_gift_score_rank_point_0"
        android:visibility="invisible"
        android:layout_width="25dp"
        android:layout_height="10dp"/>
</FrameLayout>
