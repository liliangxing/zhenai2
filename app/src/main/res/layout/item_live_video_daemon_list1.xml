<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <ImageView
        android:id="@+id/rank_iv"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_30dp"
        android:layout_height="@dimen/dimen_30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_15dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_42475e"
        android:id="@+id/rank_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="25dp"/>
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/guard_avatar_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="41.5dp"
        app:avatar_height="40dp"
        app:avatar_width="40dp"
        app:svga_height="63dp"
        app:svga_width="63dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_42475e"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_toStartOf="@+id/layout_daemon"
        android:layout_toEndOf="@+id/guard_avatar_frame_layout"/>
    <FrameLayout
        android:id="@+id/layout_daemon"
        android:background="@drawable/live_video_missile_guard_bg_pink"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="@dimen/dimen_90dp"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/icon_live_dialog_daemon"
            android:layout_width="29dp"
            android:layout_height="21dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#fe7979"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_daemon_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <View
        android:background="@color/color_eaeaea"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"/>
</RelativeLayout>
