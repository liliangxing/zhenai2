<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingTop="12dp"
        android:paddingRight="15dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#42475e"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:maxLines="1"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/layout_daemon"
            android:background="@drawable/live_video_missile_guard_bg_pink"
            android:paddingLeft="10dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="12dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/icon_live_dialog_daemon"
                android:layout_width="29dp"
                android:layout_height="21dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#fe7979"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_daemon_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="10dp"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="#e4e7ea"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"/>
</LinearLayout>
