<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="74dp"
    android:layout_height="wrap_content">
    <com.zhenai.live.voice.widget.CircleSpreadView3
        android:id="@+id/avatar"
        android:layout_width="74dp"
        android:layout_height="74dp"
        app:allTime="150"
        app:delayTime="10"
        app:imageDiameter="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:minDiameter="52dp"
        app:spreadColor="@color/color_ff7599"
        app:spreadTimes="3"
        app:spreadWidth="2dp"
        app:strokeColor="@color/color_ff7599"
        app:strokeRadius="31dp"
        app:strokeWidth="2dp"
        app:waveTime="20"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/live_tag_tv"
        android:background="@drawable/rect_ff7599_round_white_stroke_1"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="3dp"
        android:text="@string/living"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live_lottie"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/live_tag_tv"
        app:layout_constraintStart_toStartOf="@+id/live_tag_tv"
        app:layout_constraintTop_toTopOf="@+id/live_tag_tv"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
