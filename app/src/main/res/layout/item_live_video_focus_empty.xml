<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="74dp"
    android:layout_height="wrap_content">
    <ImageView
        android:textSize="25sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/avatar"
        android:background="@drawable/live_list_concern_more"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:id="@+id/person_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatar"
        app:layout_constraintEnd_toEndOf="@+id/avatar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/living_tag_tv"
        android:background="@drawable/rect_ff7599_round_white_stroke_1"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="53dp"
        android:text="@string/living"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live_lottie"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/living_tag_tv"
        app:layout_constraintStart_toStartOf="@+id/living_tag_tv"
        app:layout_constraintTop_toTopOf="@+id/living_tag_tv"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/zhibo.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:id="@+id/nick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:text="@string/more"
        android:lines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
