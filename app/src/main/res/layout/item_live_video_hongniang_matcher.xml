<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_hongniang_matcher_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_5dp"
    android:layout_marginStart="@dimen/dimen_3dp"
    android:layout_marginEnd="@dimen/dimen_3dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_living"
        android:background="@drawable/bg_live_hongniang_macher_living"
        android:layout_width="59dp"
        android:layout_height="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_living"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_6dp"
            android:layout_marginBottom="@dimen/dimen_6dp"
            android:layout_marginStart="8dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/recommend_living_animation.json"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimen_3dp"
            android:layout_marginBottom="@dimen/dimen_4dp"
            android:text="@string/hongnian_matcher_living"
            android:layout_marginStart="19dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_avatar_bg"
        android:background="@drawable/bg_live_list_voice_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_living">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_margin="4dp"
            android:src="@drawable/icon_video_hn_list_avatar_default"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rl_name_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_avatar_bg">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:maxLines="1"
            android:maxEms="5"/>
        <com.zhenai.business.widget.FlagLayout
            android:id="@+id/layout_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:layout_toEndOf="@+id/tv_nickname"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_666978"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/basic_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_name_zone"/>
    <View
        android:background="#ffe3ebf1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basic_text"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_hongniang_avatar"
        android:layout_width="@dimen/dimen_30dp"
        android:layout_height="@dimen/dimen_30dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:src="@drawable/default_avatar"
        android:layout_marginStart="10dp"
        app:borderRadius="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basic_text"
        app:roundImageType="round"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_666978"
        android:ellipsize="end"
        android:id="@+id/tv_hongniang_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="红娘小狐狸"
        android:singleLine="true"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="@dimen/dimen_30dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_hongniang_avatar"
        app:layout_constraintTop_toBottomOf="@+id/basic_text"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/tv_live_video_room_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="红娘小狐狸相亲群"
        android:singleLine="true"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="@dimen/dimen_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
