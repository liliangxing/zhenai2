<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_del"
            android:background="#ccff8162"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginBottom="1dp"
            android:scaleType="centerInside"
            android:text="@string/delete"/>
        <FrameLayout
            android:id="@+id/layout_operate"
            android:background="#c7c7cc"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="70dp"
            android:layout_marginBottom="1dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_operate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp">
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/default_circle_avatar"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#42475e"
                android:gravity="center_vertical"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:drawablePadding="7dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b5b8c7"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/live_daemon_impression_like_normal"
                android:drawablePadding="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="#666978"
            android:id="@+id/tv_impression"
            android:background="@drawable/bg_live_daemon_impression_tag_item"
            android:paddingLeft="15dp"
            android:paddingTop="4dp"
            android:paddingRight="15dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:drawablePadding="10dp"
            android:lineSpacingExtra="5dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="#e4e7ea"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"/>
</FrameLayout>
