<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.business.widget.CustomClippedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <FrameLayout
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_del"
            android:background="#fb5c6a"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:text="@string/delete"/>
        <FrameLayout
            android:id="@+id/layout_operate"
            android:background="#d9d9d9"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="55dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#6c6d75"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_operate"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:drawablePadding="3dp"/>
        </FrameLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:background="@color/white"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#26273b"
            android:gravity="center_vertical"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#6c6d75"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/icon_praise_grey_v8"
            android:layout_marginEnd="23dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
        <ImageView
            android:id="@+id/triangle_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:src="@drawable/icon_guard_triangle"
            android:layout_marginStart="17dp"
            app:layout_constraintStart_toStartOf="@+id/tv_nickname"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_nickname"
            app:layout_constraintTop_toBottomOf="@+id/triangle_view">
            <TextView
                android:textSize="13sp"
                android:textColor="#11111a"
                android:ellipsize="end"
                android:id="@+id/tv_impression"
                android:background="@drawable/bg_live_daemon_impression_tag_item_v8"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:drawablePadding="5dp"
                android:lineSpacingExtra="5dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/bottom_line_view"
        android:background="#0d26273b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"/>
</com.zhenai.business.widget.CustomClippedFrameLayout>
