<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/layout_root_view"
    android:layout_width="match_parent"
    android:layout_height="55dp">
    <TextView
        android:textSize="14sp"
        android:textColor="#ff8a76f9"
        android:id="@+id/tv_go_to_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="去点播更多歌曲"
        android:layout_centerInParent="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:src="@drawable/icon_live_video_music_go_to_select"
        android:layout_toRightOf="@+id/tv_go_to_select"
        android:layout_centerVertical="true"/>
</RelativeLayout>
