<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_list_item"
    android:layout_width="match_parent"
    android:layout_height="55dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <TextView
            android:textColor="@color/color_a0a3ad"
            android:gravity="center"
            android:id="@+id/tv_index"
            android:layout_width="45dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_live_video_ktv_head_default"
            android:scaleType="centerCrop"
            android:layout_toRightOf="@+id/tv_index"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_42475c"
                android:ellipsize="end"
                android:id="@+id/tv_music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_a0a3ad"
                android:ellipsize="end"
                android:id="@+id/tv_music_anchor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_8b76f9"
            android:gravity="center"
            android:id="@+id/btn_play"
            android:background="@drawable/selector_live_video_ktv_music_item"
            android:layout_width="56dp"
            android:layout_height="25dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:text="@string/ktv_music_play"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/music_living_lottie"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/ktv_live.json"
            app:lottie_loop="true"/>
        <ProgressBar
            android:id="@+id/progress_bar_downloading"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="35dp"
            android:indeterminateDrawable="@anim/anim_live_video_ktv_music_list_loadding"
            android:indeterminateDuration="500"/>
    </LinearLayout>
    <View
        android:background="@color/color_f3eeee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="92dp"/>
</LinearLayout>
