<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.zhenai.business.widget.live.BevelSplitLayout
        android:id="@+id/avatar_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:BevelSplitLayout_cornerRadius="4dp"
        app:BevelSplitLayout_splitRegionWidth="30dp"
        app:layout_constraintDimensionRatio="355:170"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.business.widget.live.RoundTrapezoidImageView
            android:layout_gravity="start"
            android:id="@+id/iv_live_video_list_item_avatar_left"
            android:layout_width="174dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.zhenai.business.widget.live.RoundTrapezoidImageView
            android:layout_gravity="end"
            android:id="@+id/iv_live_video_list_item_avatar_right"
            android:layout_width="174dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </com.zhenai.business.widget.live.BevelSplitLayout>
    <View
        android:background="@drawable/bg_live_video_live_list_item_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
    <View
        android:background="@drawable/bg_live_video_live_list_item_gradient"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_live_video_list_item_seat"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout">
        <android.widget.Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_live_video_list_item_seat"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="虚位以待"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_live_video_linking"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_live_video_linking"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintEnd_toEndOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/iv_list_item_official_tag"
        android:paddingTop="4dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"
        app:layout_constraintTop_toTopOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/tv_live_video_list_item_left_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxWidth="250dp"
        android:lines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_live_video_list_item_same_city"
        android:background="@drawable/bg_live_video_list_item_same_city"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="6dp"
        android:text="同城"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toStartOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_anchor_address"
        android:background="@drawable/bg_live_list_item_address_shape"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="6dp"
        android:drawablePadding="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toEndOf="@+id/tv_live_video_list_item_same_city"
        app:layout_goneMarginStart="10dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_left_guard"
        android:background="@drawable/bg_live_video_list_item_guard"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="6dp"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/zalive_list_tag_guard"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toEndOf="@+id/tv_anchor_address"
        app:layout_goneMarginStart="10dp"/>
    <com.zhenai.live.widget.MultiLinkMicLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/third_mic_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_layout"
        app:layout_constraintEnd_toEndOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_video_list_item_audience_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
