<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root_view"
    android:layout_width="120dp"
    android:layout_height="85dp">
    <ImageView
        android:id="@+id/img_type"
        android:layout_width="50dp"
        android:layout_height="38dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/live_video_type_default"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#81838c"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_type"/>
    <com.zhenai.common.widget.RedDotView
        android:id="@+id/list_item_red_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        app:backgroundColor="@color/red_dot_color"
        app:isRadiusHalfHeight="true"
        app:isWidthHeightEqual="true"
        app:layout_constraintLeft_toRightOf="@+id/img_type"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
