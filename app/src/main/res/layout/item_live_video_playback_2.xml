<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    app:clip_radius="16dp">
    <View
        android:background="@drawable/rect_white_r16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundCornerImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_live_video_playback_pic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="16dp"
        app:showBottomRadius="false"
        app:showTopRadius="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_live_play_back"
        android:background="@drawable/rect_78191c32_r200"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:text="@string/play_back"
        android:paddingStart="19dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/iv_live_video_playback_pic"
        app:layout_constraintTop_toTopOf="@+id/iv_live_video_playback_pic"/>
    <ImageView
        android:background="@drawable/icon_school_play_back"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_live_play_back"
        app:layout_constraintStart_toStartOf="@+id/tv_live_play_back"
        app:layout_constraintTop_toTopOf="@+id/tv_live_play_back"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_42475c"
        android:ellipsize="end"
        android:id="@+id/tv_live_video_playback_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_live_video_playback_audience_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_live_video_playback_pic"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_aeafb3"
        android:id="@+id/tv_live_video_playback_audience_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_live_video_playback_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_live_video_playback_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
