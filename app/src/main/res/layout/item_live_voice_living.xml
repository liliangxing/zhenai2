<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_voice_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/live_list_voice_item_bg"
        android:scaleType="fitXY"
        app:borderRadius="4dp"
        app:layout_constraintDimensionRatio="355:170"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="round"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/iv_list_item_official_tag"
        android:paddingTop="4dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/avatar_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <ImageView
        android:id="@+id/iv_live_video_linking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/live_list_voice_item_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"
        app:layout_constraintEnd_toEndOf="@+id/avatar_guide_line"
        app:layout_constraintStart_toStartOf="@+id/avatar_guide_line"
        app:layout_constraintTop_toTopOf="@+id/iv_voice_bg"/>
    <FrameLayout
        android:background="@drawable/bg_live_list_voice_avatar"
        android:padding="4dp"
        android:layout_width="108dp"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"
        app:layout_constraintEnd_toEndOf="@+id/avatar_guide_line"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintStart_toStartOf="@+id/iv_voice_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_voice_bg">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_live_video_list_item_avatar_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_live_video_list_avatar_man"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_live_video_list_item_avatar_right"
        android:background="@drawable/bg_live_list_voice_avatar"
        android:padding="4dp"
        android:layout_width="108dp"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_voice_bg"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintStart_toStartOf="@+id/avatar_guide_line"
        app:layout_constraintTop_toTopOf="@+id/iv_voice_bg">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_live_video_list_item_avatar_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_live_video_list_avatar_man"/>
    </FrameLayout>
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_live_video_list_item_seat"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="108dp"
        app:bg_colorNormal="#66432b58"
        app:bg_shape="circle"
        app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_list_item_avatar_right"
        app:layout_constraintEnd_toEndOf="@+id/layout_live_video_list_item_avatar_right"
        app:layout_constraintStart_toStartOf="@+id/layout_live_video_list_item_avatar_right"
        app:layout_constraintTop_toTopOf="@+id/layout_live_video_list_item_avatar_right">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_live_video_list_item_seat"
            android:tint="@color/white"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="虚位以待"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    <me.yintaibing.universaldrawable.view.UniversalDrawableImageView
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        app:bg_colorGradientEnd="@color/transparent"
        app:bg_colorGradientStart="#8c000000"
        app:bg_fillMode="linearGradient"
        app:bg_linearGradientOrientation="bottom_top"
        app:bg_radiusLeftBottom="4dp"
        app:bg_radiusRightBottom="4dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_live_video_list_item_left_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxWidth="250dp"
        android:lines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_voice_bg"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_live_video_list_item_same_city"
        android:background="@drawable/bg_live_video_list_item_same_city"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_18dp"
        android:layout_marginBottom="6dp"
        android:text="同城"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toStartOf="@+id/iv_voice_bg"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_anchor_address"
        android:background="@drawable/bg_live_list_item_address_shape"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="6dp"
        android:drawablePadding="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toEndOf="@+id/tv_live_video_list_item_same_city"
        app:layout_goneMarginStart="10dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_left_guard"
        android:background="@drawable/bg_live_video_list_item_guard"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="6dp"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/zalive_list_tag_guard"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_live_video_list_item_left_name"
        app:layout_constraintStart_toEndOf="@+id/tv_anchor_address"
        app:layout_goneMarginStart="10dp"/>
    <com.zhenai.live.widget.MultiLinkMicLayout
        android:id="@+id/third_mic_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_voice_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_voice_bg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_video_list_item_audience_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
