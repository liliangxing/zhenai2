<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_course_content"
    android:paddingLeft="@dimen/dimen_10dp"
    android:paddingTop="@dimen/dimen_10dp"
    android:paddingRight="@dimen/dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_picture"
        android:layout_width="@dimen/dp58"
        android:layout_height="@dimen/dp58"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_8sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_label_type_name"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingTop="@dimen/dimen_2dp"
        android:paddingRight="@dimen/dimen_6dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bg_colorGradientEnd="@color/color_fe7979"
        app:bg_colorGradientStart="@color/color_fea679"
        app:bg_fillMode="linearGradient"
        app:bg_radiusLeftBottom="0dp"
        app:bg_radiusLeftTop="@dimen/dimen_8dp"
        app:bg_radiusRightBottom="@dimen/dimen_8dp"
        app:bg_radiusRightTop="0dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/iv_picture"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="@+id/iv_picture"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_26273C"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_ff7a9c"
        android:id="@+id/tv_e_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintLeft_toLeftOf="@+id/tv_desc"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_aeafb3"
        android:id="@+id/tv_lean_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_9dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_e_coin"
        app:layout_constraintLeft_toRightOf="@+id/tv_e_coin"/>
    <ImageView
        android:id="@+id/iv_new"
        android:background="@drawable/ic_emotion_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toLeftOf="@+id/iv_hot"/>
    <ImageView
        android:id="@+id/iv_hot"
        android:background="@drawable/ic_emotion_hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:background="@color/color_efefef"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_picture"/>
</androidx.constraintlayout.widget.ConstraintLayout>
