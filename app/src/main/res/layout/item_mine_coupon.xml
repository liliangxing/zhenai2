<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp96"
    android:layout_marginTop="@dimen/dimen_8dp"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/ic_coupon_able"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp96"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_17sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dimen_14dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_8b76f9"
            android:gravity="center"
            android:id="@+id/tv_tag"
            android:paddingLeft="@dimen/dimen_5dp"
            android:paddingTop="@dimen/dimen_1dp"
            android:paddingRight="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_2dp"
            app:bg_colorGradientEnd="@color/color_f4f2ff"
            app:bg_colorGradientStart="@color/color_f4f2ff"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_3dp"
            app:bg_shape="round"
            app:layout_constraintLeft_toLeftOf="@+id/tv_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_24sp"
            android:textColor="@color/color_8b76f9"
            android:id="@+id/tv_zhenai_coin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12dp"
            app:layout_constraintLeft_toLeftOf="@+id/tv_desc"
            app:layout_constraintRight_toLeftOf="@+id/tv_zhenai_coin_tips"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_zhenai_coin_tips"
            android:paddingLeft="@dimen/dimen_3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:layout_marginStart="@dimen/dimen_14dp"
            android:layout_marginEnd="@dimen/dimen_14dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_7f_666978"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_name"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_to_use"
            android:paddingLeft="@dimen/dimen_5dp"
            android:paddingTop="@dimen/dimen_1dp"
            android:paddingRight="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_1dp"
            android:layout_width="@dimen/dimen_60dp"
            android:layout_height="@dimen/dimen_23dp"
            android:text="去使用"
            android:layout_marginEnd="@dimen/dimen_14dp"
            app:bg_colorGradientEnd="@color/color_8b76f9"
            app:bg_colorGradientStart="@color/color_8b76f9"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_13dp"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="@+id/tv_date"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_date"/>
        <TextView
            android:background="@drawable/bg_coupon_line_dash_shape"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp3"
            android:layout_marginBottom="@dimen/dp31"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_status"
        android:background="@drawable/ic_coupon_overdue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp31"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
