<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_15dp"
    android:layout_marginStart="@dimen/dimen_15dp"
    android:layout_marginEnd="@dimen/dimen_15dp"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/iv_picture"
        android:layout_width="@dimen/dimen_100dp"
        android:layout_height="@dimen/dimen_100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tips_desc"
        android:paddingLeft="@dimen/dimen_13dp"
        android:paddingRight="@dimen/dimen_13dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_22dp"
        android:text="课程"
        app:layout_constraintLeft_toLeftOf="@+id/iv_picture"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="@+id/iv_picture"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:paddingTop="@dimen/dimen_1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_1dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingTop="@dimen/dimen_2dp"
        android:paddingRight="@dimen/dimen_6dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        app:bg_colorGradientEnd="@color/color_F4F4F4"
        app:bg_colorGradientStart="@color/color_F4F4F4"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/tv_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_e_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintLeft_toLeftOf="@+id/tv_desc"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#ffbfbfbf"
        android:id="@+id/tv_lean_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_e_coin"
        app:layout_constraintLeft_toRightOf="@+id/tv_e_coin"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/color_33_b1b1b1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_picture"/>
</androidx.constraintlayout.widget.ConstraintLayout>
