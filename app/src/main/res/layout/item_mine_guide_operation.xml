<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp86">
    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        android:layout_marginTop="@dimen/dp20"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_below="@+id/image"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_red_dot"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_8dp"
        android:layout_height="@dimen/dimen_8dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_alignTop="@+id/image"
        android:layout_toEndOf="@+id/image"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:id="@+id/red_text_entrance"
        android:background="@drawable/bg_red_text_entrance"
        android:paddingLeft="@dimen/dp6"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="@dimen/dp6"
        android:paddingBottom="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:paddingHorizontal="@dimen/dp6"
        android:paddingVertical="@dimen/dp2"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_red_dot"
        android:background="@drawable/reddot_with_num_r10_v8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:lines="1"
        android:layout_alignStart="@+id/image"/>
</merge>
