<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_20sp"
        android:textStyle="bold"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/tv_red_dot"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginBottom="13dp"
        android:layout_below="@+id/tv_value"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_red_dot"
        android:background="@drawable/red_dot_fb5c6a"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_8dp"
        android:layout_height="@dimen/dimen_8dp"
        android:layout_marginTop="-2dp"
        android:layout_alignTop="@+id/tv_value"
        android:layout_toEndOf="@+id/tv_value"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_red_dot"
        android:background="@drawable/reddot_with_num_r10_v8"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:lines="1"
        android:translationX="26dp"
        android:layout_toEndOf="@+id/tv_value"
        android:layout_alignStart="@+id/tv_title"/>
</merge>
