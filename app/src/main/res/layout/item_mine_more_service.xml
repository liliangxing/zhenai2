<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/dp28"
        android:layout_height="@dimen/dp28"
        android:layout_marginTop="@dimen/dp21"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp17"
        android:layout_below="@+id/image"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_red_dot"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_8dp"
        android:layout_height="@dimen/dimen_8dp"
        android:layout_alignTop="@+id/image"
        android:layout_toEndOf="@+id/image"/>
</RelativeLayout>
