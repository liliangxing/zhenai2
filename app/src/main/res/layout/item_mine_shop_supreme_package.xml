<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dimen_15dp"
    android:paddingRight="@dimen/dimen_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_left_choose"
        android:layout_width="@dimen/dimen_49dp"
        android:layout_height="@dimen/dimen_60dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintTop_toTopOf="@+id/iv_picture">
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sort_id"
            android:layout_width="@dimen/dimen_19dp"
            android:layout_height="@dimen/dimen_19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_picture"
        android:layout_width="@dimen/dimen_60dp"
        android:layout_height="@dimen/dimen_60dp"
        app:layout_constraintLeft_toRightOf="@+id/cl_left_choose"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="@+id/iv_picture"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:paddingTop="@dimen/dimen_1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_1dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingTop="@dimen/dimen_2dp"
        android:paddingRight="@dimen/dimen_6dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_F4F4F4"
        app:bg_colorGradientStart="@color/color_F4F4F4"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/tv_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_fd7979"
        android:id="@+id/tv_e_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintLeft_toLeftOf="@+id/tv_desc"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_bfbfbf"
        android:id="@+id/tv_lean_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_e_coin"
        app:layout_constraintLeft_toRightOf="@+id/tv_e_coin"/>
    <ImageView
        android:id="@+id/iv_new"
        android:background="@drawable/ic_emotion_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toLeftOf="@+id/iv_hot"/>
    <ImageView
        android:id="@+id/iv_hot"
        android:background="@drawable/ic_emotion_hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/v_bottom_line"
        android:background="@color/color_F4F4F4"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_picture"/>
</androidx.constraintlayout.widget.ConstraintLayout>
