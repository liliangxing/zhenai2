<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dimen_15dp"
    android:layout_marginEnd="@dimen/dimen_15dp">
    <ImageView
        android:id="@+id/iv_picture"
        android:layout_width="@dimen/dimen_100dp"
        android:layout_height="@dimen/dimen_100dp"
        android:layout_marginTop="@dimen/dimen_7dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tips_desc"
        android:paddingLeft="@dimen/dimen_13dp"
        android:paddingRight="@dimen/dimen_13dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_22dp"
        android:text="套课"
        app:layout_constraintLeft_toLeftOf="@+id/iv_picture"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="15sp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="挽救婚姻的10个关键因素挽救婚姻的10个关键因素"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_14dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_picture"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_picture"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginEnd="@dimen/dimen_14dp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_e_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_picture"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_fbfbfb"
        android:id="@+id/tv_lean_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_e_coin"
        app:layout_constraintLeft_toRightOf="@+id/tv_e_coin"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/color_33_b1b1b1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_picture"/>
</androidx.constraintlayout.widget.ConstraintLayout>
