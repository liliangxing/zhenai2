<?xml version="1.0" encoding="utf-8"?>
<me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:tag="layout/item_my_label_select_label_0"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    app:bg_colorNormal="@color/color_ebecff"
    app:bg_colorStroke="@color/color_767dff"
    app:bg_fillMode="color"
    app:bg_radius="15dp"
    app:bg_shape="round"
    app:bg_strokeMode="solid"
    app:bg_strokeWidth="0.5dp">
    <ImageView
        android:id="@+id/img_icon"
        android:tag="binding_1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="3dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_767dff"
        android:id="@+id/tv_label_name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/image_remove"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_label_remove_selected_label"
        android:layout_marginEnd="4dp"/>
</me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
