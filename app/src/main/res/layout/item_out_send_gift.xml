<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="91dp"
    android:paddingEnd="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item"
        android:background="@drawable/rect_white_r8"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_gift"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#26273b"
            android:id="@+id/tv_gift_name"
            android:paddingTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_gift"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#6c6d75"
            android:id="@+id/tv_gift_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_gift_name"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_send_gift"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="@string/click_to_send_gift"
            app:bg_colorNormal="@color/color_767dff"
            app:bg_fillMode="color"
            app:bg_radiusLeftBottom="8dp"
            app:bg_radiusRightBottom="8dp"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
