<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="101dp"
    android:layout_height="142dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/product_layout"
        android:background="@drawable/bg_f3f4f7_8r_2stroke_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_42475c"
            android:gravity="center"
            android:id="@+id/tv_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#92939d"
            android:gravity="center"
            android:id="@+id/tv_heightPrice"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="72dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_42475c"
            android:gravity="center"
            android:id="@+id/tv_realPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#26273c"
            android:gravity="center"
            android:id="@+id/tv_priceOfOneDay"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_marks"
        android:background="@drawable/bg_ff8f54_ff4949_rectangle_shape"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
