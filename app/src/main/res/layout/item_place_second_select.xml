<?xml version="1.0" encoding="utf-8"?>
<me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/item_place_second_select_0"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginTop="8dp"
    android:paddingStart="@dimen/dimen_16dp"
    android:layout_marginStart="@dimen/dimen_24dp"
    app:bg_colorNormal="@color/color_ebecff"
    app:bg_colorStroke="@color/color_ebecff"
    app:bg_radius="@dimen/dp8"
    app:bg_shape="round"
    app:bg_strokeMode="solid"
    app:bg_strokeWidth="1dp">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_767dff"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:tag="binding_2"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="4dp"
        android:paddingVertical="8dp">
        <ImageView
            android:id="@+id/title_tip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/search_place_close"/>
    </FrameLayout>
</me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
