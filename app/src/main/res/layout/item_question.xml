<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/question_avatar_iv"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="15sp"
        android:textColor="#42475c"
        android:id="@+id/question_nick_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/question_avatar_iv"
        app:layout_constraintTop_toTopOf="@+id/question_avatar_iv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#666978"
        android:id="@+id/description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/question_nick_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/question_nick_name_tv"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_audit_status"
        android:paddingLeft="@dimen/dimen_9dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_9dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp14"
        android:text="@string/emotion_auditing"
        app:bg_colorGradientEnd="@color/color_f2f2f2"
        app:bg_colorGradientStart="@color/color_f2f2f2"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dp12"
        app:bg_shape="round"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/question_avatar_iv"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_626978"
        android:ellipsize="end"
        android:id="@+id/question_detail_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question_avatar_iv"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#999999"
        android:id="@+id/date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/v_comment"
        app:layout_constraintStart_toStartOf="@+id/question_detail_tv"
        app:layout_constraintTop_toTopOf="@+id/v_comment"/>
    <com.zhenai.business.emotion.view.EmotionQuestionCommentView
        android:id="@+id/v_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question_detail_tv"/>
    <View
        android:id="@+id/item_line_view"
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dp25"
        app:layout_constraintTop_toBottomOf="@+id/date_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
