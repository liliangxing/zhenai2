<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingRight="@dimen/dimen_5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_praise"
        android:paddingTop="@dimen/dp6"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp62"
        android:paddingStart="@dimen/dp6"
        app:layout_constraintRight_toLeftOf="@+id/cl_comment">
        <ImageView
            android:id="@+id/iv_praise"
            android:background="@drawable/ic_praise"
            android:layout_width="@dimen/dp22"
            android:layout_height="@dimen/dp23"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_666978"
            android:gravity="center"
            android:id="@+id/tv_praise_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintLeft_toRightOf="@+id/iv_praise"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_666978"
            android:gravity="center"
            android:id="@+id/tv_praise_new_num"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            app:layout_constraintLeft_toLeftOf="@+id/tv_praise_num"
            app:layout_constraintTop_toBottomOf="@+id/tv_praise_num"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment"
        android:paddingTop="@dimen/dp6"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp62"
        android:paddingStart="@dimen/dp6"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/iv_comment"
            android:background="@drawable/ic_comment_reply"
            android:layout_width="@dimen/dp22"
            android:layout_height="@dimen/dp23"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_666978"
            android:layout_gravity="top"
            android:id="@+id/tv_comment_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dimen_2dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
