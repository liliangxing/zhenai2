<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/answer_avatar_iv"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="19dp"
        android:src="@drawable/default_avatar"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="15sp"
        android:textColor="#507daf"
        android:id="@+id/answer_nick_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="@dimen/dp15"
        app:layout_constraintStart_toEndOf="@+id/answer_avatar_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_12131a"
        android:id="@+id/reply_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="回复"
        app:layout_constraintStart_toEndOf="@+id/answer_nick_name_tv"
        app:layout_constraintTop_toTopOf="@+id/answer_nick_name_tv"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="15sp"
        android:textColor="#507daf"
        android:id="@+id/reply_user_name_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/reply_tv"
        app:layout_constraintTop_toTopOf="@+id/reply_tv"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_9dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_teacher_desc"
        android:paddingLeft="@dimen/dimen_5dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="情感专家"
        android:layout_marginStart="3dp"
        app:bg_colorGradientEnd="@color/color_fea679"
        app:bg_colorGradientStart="@color/color_fe7979"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_7dp"
        app:bg_shape="round"
        app:layout_constraintStart_toEndOf="@+id/answer_nick_name_tv"
        app:layout_constraintTop_toTopOf="@+id/answer_nick_name_tv"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#626978"
        android:id="@+id/answer_content_tv"
        android:paddingRight="@dimen/dp14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/answer_nick_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/answer_nick_name_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#9d9fa6"
        android:id="@+id/answer_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        app:layout_constraintStart_toStartOf="@+id/answer_content_tv"
        app:layout_constraintTop_toBottomOf="@+id/answer_content_tv"/>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/answer_date_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
