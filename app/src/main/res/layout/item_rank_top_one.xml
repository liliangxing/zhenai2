<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/continuousInfoView"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_continuous"
        android:background="@drawable/hour_top_image_bg"
        android:paddingTop="23dp"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:paddingStart="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/avatarItem"
            android:background="@drawable/shape_white_bg_yellow_stock"
            android:padding="1dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/default_circle_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLivingContinuous"
            android:layout_width="@dimen/dimen_18dp"
            android:layout_height="@dimen/dimen_18dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarItem"
            app:layout_constraintEnd_toEndOf="@+id/avatarItem"
            app:lottie_autoPlay="true"
            app:lottie_fileName="live_show_playing.json"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textStyle="bold"
            android:textColor="#ffb34500"
            android:id="@+id/nicknameItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="蒙娜丽莎桔子"
            android:layout_marginStart="@dimen/dimen_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatarItem"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ffb34500"
            android:gravity="center"
            android:id="@+id/total_top_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/charm_star_last_week"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/dimen_5dp"
            android:drawableStart="@drawable/clock_icon"
            android:layout_marginEnd="@dimen/dimen_15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/top_one_tag"
        android:background="@drawable/hour_top_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日小时榜霸主"
        android:paddingStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
