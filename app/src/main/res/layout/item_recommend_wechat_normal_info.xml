<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_layout"
    android:tag="layout/item_recommend_wechat_normal_info_0"
    android:background="@drawable/bg_rectangle_ffffff_16r_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dimen_12dp"
    android:layout_marginRight="@dimen/dimen_12dp"
    android:paddingStart="@dimen/dimen_16dp"
    android:paddingEnd="0dp"
    android:layout_marginHorizontal="@dimen/dimen_12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/iv_avatar"
        android:layout_width="76.5dp"
        android:layout_height="76.5dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:tag="binding_1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableView
            android:id="@+id/loving_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_16dp"
            app:bg_colorGradientEnd="@color/color_FF94AF"
            app:bg_colorGradientStart="@color/color_FFADBF"
            app:bg_fillMode="linearGradient"
            app:bg_linearGradientOrientation="left_right"
            app:bg_radiusLeftBottom="@dimen/dp16"
            app:bg_radiusRightBottom="@dimen/dp16"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:id="@+id/ic_loving"
            android:layout_width="9dp"
            android:layout_height="8dp"
            android:src="@drawable/search_loving"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/loving_bg"
            app:layout_constraintEnd_toStartOf="@+id/loving"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/loving_bg"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/white"
            android:id="@+id/loving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_loving"
            app:layout_constraintBottom_toBottomOf="@+id/loving_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ic_loving"
            app:layout_constraintTop_toTopOf="@+id/loving_bg"/>
        <androidx.constraintlayout.widget.Group
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="loving,loving_bg,ic_loving"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/search_living"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_16dp"
            app:bg_colorGradientEnd="@color/color_FF94AF"
            app:bg_colorGradientStart="@color/color_FFADBF"
            app:bg_fillMode="linearGradient"
            app:bg_linearGradientOrientation="left_right"
            app:bg_radiusLeftBottom="@dimen/dp16"
            app:bg_radiusRightBottom="@dimen/dp16"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/living_lottie"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="animation/zhibo.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/avatar_tag_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/living"/>
        </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:alignItems="center"
        app:flexDirection="row"
        app:flexWrap="nowrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273C"
            android:ellipsize="end"
            android:id="@+id/tvNickName"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_flexShrink="1"/>
        <com.zhenai.business.widget.FlagLayout
            android:id="@+id/flagLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_flexShrink="0"/>
    </com.google.android.flexbox.FlexboxLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_AEAFB3"
        android:ellipsize="end"
        android:id="@+id/tvUserInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_7dp"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/flexInfo"/>
    <com.zhenai.business.widget.label_layout.LabelLayout
        android:id="@+id/label_base_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        app:auto_select_effect="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:src="@drawable/bg_search_result_intro"
        android:scaleType="fitStart"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintTop_toBottomOf="@+id/label_base_info"
        app:radius_left_up="@dimen/dp15"
        app:radius_right_up="@dimen/dp15"
        app:roundImageType="round"/>
    <com.zhenai.common.widget.ReadMoreTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:gravity="top"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tvReadMore"
        android:tag="binding_5"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:lineSpacingExtra="6dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="31dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"
        app:layout_constraintVertical_bias="0"
        app:showMaxLine="4"
        app:tipColor="@color/color_AEAFB3"/>
    <ImageView
        android:background="@drawable/ic_recommend_intro_top"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_base_info"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/img_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="58dp"
        android:src="@drawable/bg_search_result_intro"
        android:scaleType="fitStart"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvReadMore"
        app:radius_left_up="@dimen/dp15"
        app:radius_right_up="@dimen/dp15"
        app:roundImageType="round"/>
    <ImageView
        android:id="@+id/img_tip"
        android:background="@drawable/search_tip_icon"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="@+id/img_bg"
        app:layout_constraintTop_toTopOf="@+id/img_bg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_search_ext_result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvReadMore">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_result_options"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.zhenai.common.widget.BoldTextView
                android:textSize="16sp"
                android:textColor="@color/color_26273C"
                android:id="@+id/tv_option_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#6c6d75"
                android:ellipsize="end"
                android:id="@+id/tv_intro_question"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lines="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="37dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_option_title"/>
            <com.zhenai.common.widget.ReadMoreBoldTextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/color_26273C"
                android:gravity="top"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:id="@+id/tv_option_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:lineSpacingExtra="5dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_intro_question"
                app:layout_constraintVertical_bias="0"
                app:showMaxLine="3"
                app:tipColor="@color/color_AEAFB3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_result_moment"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.zhenai.common.widget.BoldTextView
                android:textSize="16sp"
                android:textColor="#26273c"
                android:id="@+id/tv_moment_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.business.widget.VisitedMeExpandableTextView
                android:textSize="16sp"
                android:textColor="#26273c"
                android:orientation="vertical"
                android:id="@+id/tv_moment_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="15dp"
                android:maxLines="3"
                android:lineSpacingExtra="5dp"
                android:layout_marginHorizontal="15dp"
                app:etv_EllipsisHint="..."
                app:etv_EnableToggle="false"
                app:etv_MaxLinesOnShrink="3"
                app:etv_ToExpandHint="更多 &gt;"
                app:etv_ToExpandHintColor="#aeafb3"
                app:etv_ToExpandHintColorBgPressed="@color/transparent"
                app:etv_ToExpandHintSize="16sp"
                app:etv_ToShrinkHintSize="16sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_moment_title"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/photo_layout_moment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="15dp"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_moment_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_result_album"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginHorizontal="@dimen/dimen_15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/search_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="19sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:tag="binding_6"
        android:background="@drawable/recommend_wechat_item_btn_selector"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:layout_width="204dp"
        android:layout_height="60dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="5dp"
        android:drawablePadding="12.5dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_btn_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_search_ext_result_container"
        app:layout_goneMarginBottom="@dimen/dimen_18dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_fd5a67"
        android:gravity="center"
        android:id="@+id/tv_btn_tips"
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_btn"/>
    <ImageView
        android:id="@+id/img_bubble"
        android:tag="binding_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_recommend_wechat_item_btn_bubble"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_btn"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/mail_layout"
        android:tag="binding_9"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/recommend_profile_mail_icon_v8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fl_say_hi_layout"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_search_ext_result_container"/>
    <FrameLayout
        android:id="@+id/fl_say_hi_layout"
        android:tag="binding_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mail_layout"
        app:layout_constraintTop_toBottomOf="@+id/fl_search_ext_result_container">
        <ImageView
            android:id="@+id/say_hi_layout"
            android:tag="binding_11"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/recommend_profile_say_hi_icon_v8"/>
        <ImageView
            android:id="@+id/have_say_hi_layout"
            android:tag="binding_12"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/recommend_profile_have_say_hi_icon_v8"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
