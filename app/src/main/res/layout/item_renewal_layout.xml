<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_mail_renewal_manage"
    android:background="@drawable/bg_white_16dp_radius"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="11dp"
    android:layout_marginRight="12dp"
    android:layout_marginHorizontal="12dp">
    <ImageView
        android:id="@+id/iv_icon_renewal"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/icon_renewal"
        android:layout_weight="0"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/tv_title_renewal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mail_renewal_manage"
        android:layout_weight="1"
        android:layout_marginStart="8dp"/>
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/renewal_manage_enter_icon"
        android:layout_weight="0"
        android:layout_marginEnd="12dp"/>
</LinearLayout>
