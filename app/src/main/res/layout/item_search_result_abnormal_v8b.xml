<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_search_result_abnormal_v8b_0"
    android:background="@drawable/bg_rectangle_ffffff_16r_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dimen_12dp"
    android:layout_marginRight="@dimen/dimen_12dp"
    android:paddingStart="@dimen/dimen_16dp"
    android:paddingEnd="16dp"
    android:layout_marginHorizontal="@dimen/dimen_12dp">
    <ImageView
        android:id="@+id/iv_avatar"
        android:tag="binding_1"
        android:visibility="visible"
        android:layout_width="76.5dp"
        android:layout_height="76.5dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:alignItems="center"
        app:flexDirection="row"
        app:flexWrap="nowrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273C"
            android:ellipsize="end"
            android:id="@+id/tvNickName"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_flexShrink="1"/>
    </com.google.android.flexbox.FlexboxLayout>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_AEAFB3"
        android:ellipsize="end"
        android:id="@+id/tvUserInfo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_7dp"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/flexInfo"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/abnormal_text"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/flexInfo"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
    <ImageView
        android:id="@+id/mail_layout"
        android:tag="binding_3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/recommend_profile_mail_icon_v8"
        app:layout_constraintEnd_toStartOf="@+id/fl_say_hi_layout"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abnormal_text"/>
    <FrameLayout
        android:id="@+id/fl_say_hi_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/dimen_40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mail_layout"
        app:layout_constraintTop_toBottomOf="@+id/abnormal_text">
        <ImageView
            android:id="@+id/say_hi_layout"
            android:tag="binding_4"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/recommend_profile_say_hi_icon_v8"/>
        <ImageView
            android:id="@+id/have_say_hi_layout"
            android:tag="binding_5"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/recommend_profile_have_say_hi_icon_v8"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
