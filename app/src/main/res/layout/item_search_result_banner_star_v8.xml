<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_search_result_banner_star_v8_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/dimen_12dp"
    android:layout_marginTop="@dimen/viewpager2_pageMarginAndOffset"
    android:layout_marginRight="@dimen/dimen_12dp"
    android:layout_marginBottom="@dimen/viewpager2_pageMarginAndOffset"
    android:layout_marginHorizontal="@dimen/dimen_12dp"
    android:layout_marginVertical="@dimen/viewpager2_pageMarginAndOffset">
    <ImageView
        android:id="@+id/search_banner_bg"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/search_banner"
        android:tag="binding_2"
        android:layout_width="256dp"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
