<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_service_page_hongniang_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="116dp">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/img_avatar"
        android:tag="binding_1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:borderRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundImageType="round"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#26273c"
        android:id="@+id/tv_nickname"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
    <ImageView
        android:id="@+id/img_icon_star"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@drawable/icon_service_fragment_star"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffff7598"
        android:id="@+id/tv_score"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintStart_toEndOf="@+id/img_icon_star"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff6c6d75"
        android:id="@+id/tv_service_num"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/img_icon_collect"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"/>
    <ImageView
        android:id="@+id/img_icon_collect"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/icon_service_fragment_hongniang_collect"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff191c32"
        android:id="@+id/tv_collect_num"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_collect"
        app:layout_constraintStart_toEndOf="@+id/img_icon_collect"
        app:layout_constraintTop_toTopOf="@+id/img_icon_collect"/>
    <ImageView
        android:id="@+id/img_icon_comment"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/icon_service_fragment_hongniang_comment"
        android:layout_marginStart="65.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff191c32"
        android:id="@+id/tv_comment_num"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_collect"
        app:layout_constraintStart_toEndOf="@+id/img_icon_comment"
        app:layout_constraintTop_toTopOf="@+id/img_icon_collect"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:layout_marginBottom="16dp"
        android:text="@string/go_to_subscribe"
        android:layout_marginEnd="16dp"
        app:bg_colorNormal="@color/color_767dff"
        app:bg_fillMode="color"
        app:bg_radius="25dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:background="#f2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
