<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.short_video.recommend.widget.RecommendListItemVideoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ShortVideoItemCardLayoutStyle">
    <com.zhenai.short_video.recommend.widget.AutoPlayVideoView
        android:id="@+id/layout_video"
        android:background="#e0e0e0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/imageview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.zhenai.base.widget.FlowLayout
        android:id="@+id/layout_video_tag"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_toStartOf="@+id/tv_praise_num"
        app:horizontalSpace="9dp"
        app:type="radial"
        app:verticalSpace="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_praise_num"
        android:background="@drawable/shortvideo_list_praise_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="5dp"
        android:drawablePadding="3dp"
        android:drawableStart="@drawable/sv_item_praise_tag"
        android:layout_marginEnd="9dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/view_avatar_bg"
        android:background="@drawable/bg_short_video_list_item_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="-9dp"
        android:layout_below="@+id/layout_video"
        android:layout_marginStart="5dp"/>
    <ImageView
        android:id="@+id/img_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/default_circle_avatar"
        android:layout_alignTop="@+id/view_avatar_bg"
        android:layout_marginStart="2dp"
        android:layout_alignStart="@+id/view_avatar_bg"/>
    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_alignBottom="@+id/img_avatar"
        android:layout_marginStart="7dp"
        android:layout_toEndOf="@+id/img_avatar"
        app:justifyContent="flex_start">
        <TextView
            android:textSize="15sp"
            android:textColor="#494857"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <com.zhenai.business.widget.FlagLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/layout_verified_icons"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:layout_flexShrink="0"/>
    </com.google.android.flexbox.FlexboxLayout>
    <com.zhenai.base.widget.FlowLayout
        android:orientation="horizontal"
        android:id="@+id/layout_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@+id/img_avatar"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:textViewMaxEms="7"
        app:type="radial"/>
</com.zhenai.short_video.recommend.widget.RecommendListItemVideoView>
