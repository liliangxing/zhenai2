<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_125dp"
    android:layout_marginLeft="@dimen/dimen_15dp"
    android:layout_marginRight="@dimen/dimen_15dp"
    android:layout_marginBottom="@dimen/dimen_11dp">
    <ImageView
        android:paddingRight="@dimen/dimen_1dp"
        android:layout_width="81dp"
        android:layout_height="match_parent"
        android:src="@drawable/bg_superme_item_poster_shape"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_poster"
        android:layout_width="66dp"
        android:layout_height="95dp"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:src="@drawable/default_img"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/bg_superme_list_poster"
        android:layout_width="@dimen/dimen_14dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_poster"
        app:layout_constraintRight_toRightOf="@+id/iv_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="#8b76f9"
        android:gravity="center"
        android:id="@+id/tv_number"
        android:background="@drawable/bg_superme_item_shape"
        android:layout_width="@dimen/dimen_23dp"
        android:layout_height="@dimen/dimen_23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="#42475c"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_12dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:maxLines="2"
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#ff666978"
        android:ellipsize="end"
        android:id="@+id/tv_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#fd7979"
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_poster"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#666978"
        android:id="@+id/tv_buy_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price"
        app:layout_constraintLeft_toRightOf="@+id/tv_price"
        app:layout_constraintTop_toTopOf="@+id/tv_price"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_look"
        android:layout_width="66dp"
        android:layout_height="@dimen/dimen_22dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:text="去查看"
        app:bg_colorGradientEnd="@color/color_8b76f9"
        app:bg_colorGradientStart="@color/color_8b76f9"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_11dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
