<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dimen_2dp"
    android:paddingBottom="@dimen/dimen_2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_10sp"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="@dimen/dimen_4dp"
        android:layout_height="@dimen/dimen_4dp"
        app:bg_colorGradientEnd="@color/color_d8d8d8"
        app:bg_colorGradientStart="@color/color_d8d8d8"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="circle"
        app:layout_constraintBottom_toBottomOf="@+id/tv_desc"
        app:layout_constraintTop_toTopOf="@+id/tv_desc"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_7dp"
        app:layout_constraintLeft_toRightOf="@+id/tv_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
