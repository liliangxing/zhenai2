<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#141629"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/blur_icon"
        android:background="@drawable/beauty_blur"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/color_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/blur_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/beauty_blur"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/blur_icon"
        app:layout_constraintStart_toEndOf="@+id/blur_icon"
        app:layout_constraintTop_toTopOf="@+id/blur_icon"/>
    <com.zhenai.common.widget.CustomSeekBar
        android:scrollbarAlwaysDrawHorizontalTrack="true"
        android:id="@+id/blur_progress"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:maxHeight="2dp"
        android:max="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/take_photo_seekbar_progress"
        android:minHeight="2dp"
        android:thumb="@drawable/take_photo_seekbar_thumb"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="@+id/blur_title"
        app:layout_constraintEnd_toStartOf="@+id/blur_temp"
        app:layout_constraintStart_toEndOf="@+id/blur_title"
        app:layout_constraintTop_toTopOf="@+id/blur_title"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/blur_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/blur_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blur_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/color_icon"
        android:background="@drawable/beauty_color"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/thin_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blur_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/color_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/beauty_color"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/color_icon"
        app:layout_constraintStart_toEndOf="@+id/color_icon"
        app:layout_constraintTop_toTopOf="@+id/color_icon"/>
    <com.zhenai.common.widget.CustomSeekBar
        android:scrollbarAlwaysDrawHorizontalTrack="true"
        android:id="@+id/color_progress"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:maxHeight="2dp"
        android:max="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/take_photo_seekbar_progress"
        android:minHeight="2dp"
        android:thumb="@drawable/take_photo_seekbar_thumb"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="@+id/color_icon"
        app:layout_constraintEnd_toStartOf="@+id/color_temp"
        app:layout_constraintStart_toEndOf="@+id/color_title"
        app:layout_constraintTop_toTopOf="@+id/color_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/color_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/color_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/color_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/thin_icon"
        android:background="@drawable/beauty_thin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/thin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/beauty_thin"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/thin_icon"
        app:layout_constraintStart_toEndOf="@+id/thin_icon"
        app:layout_constraintTop_toTopOf="@+id/thin_icon"/>
    <com.zhenai.common.widget.CustomSeekBar
        android:scrollbarAlwaysDrawHorizontalTrack="true"
        android:id="@+id/thin_progress"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:maxHeight="2dp"
        android:max="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/take_photo_seekbar_progress"
        android:minHeight="2dp"
        android:thumb="@drawable/take_photo_seekbar_thumb"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="@+id/thin_icon"
        app:layout_constraintEnd_toStartOf="@+id/thin_temp"
        app:layout_constraintStart_toEndOf="@+id/thin_title"
        app:layout_constraintTop_toTopOf="@+id/thin_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/thin_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/thin_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/thin_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
