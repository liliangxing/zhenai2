<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingTop="1dp"
        android:paddingRight="10dp"
        android:paddingBottom="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.live_common.widget.AvatarFrameLayout
            android:id="@+id/visitant_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            app:avatar_height="40dp"
            app:avatar_width="40dp"
            app:setSvgaDimen="true"
            app:svga_height="63dp"
            app:svga_width="63dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#42475e"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/icon_visitant"
            android:layout_width="77dp"
            android:layout_height="26dp"
            android:layout_marginEnd="@dimen/dimen_10dp"/>
    </LinearLayout>
    <View
        android:background="#e4e7ea"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"/>
</LinearLayout>
