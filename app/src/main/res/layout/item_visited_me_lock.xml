<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_visit_lock_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_top_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_top_bg"
        android:background="@drawable/rect_white_r16_top"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_line"/>
    <View
        android:id="@+id/view_middle_bg"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <View
        android:id="@+id/view_bottom_bg"
        android:background="@drawable/rect_white_r16_bottom"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_middle_bg"/>
    <com.zhenai.common.widget.RoundCornerImageView
        android:id="@+id/image_avatar"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_bg"
        app:radius="16dp"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="14sp"
        android:textColor="@color/color_191c32"
        android:gravity="center"
        android:id="@+id/tv_uncover"
        android:layout_width="68dp"
        android:layout_height="28dp"
        android:text="@string/visit_uncover"
        android:layout_marginEnd="16dp"
        app:bg_colorStroke="@color/color_191c32"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dimen_18dp"
        app:bg_shape="round"
        app:bg_strokeMode="solid"
        app:bg_strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_visit"
        android:visibility="gone"
        android:layout_width="68dp"
        android:layout_height="28dp"
        android:text="@string/check"
        android:layout_marginEnd="16dp"
        app:bg_colorNormal="@color/color_191c32"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dimen_18dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintEnd_toStartOf="@+id/tv_uncover"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_191c32"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_visit"
        app:layout_constraintStart_toEndOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="@+id/image_avatar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffaeafb3"
        android:ellipsize="end"
        android:id="@+id/tv_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/image_avatar"
        app:layout_constraintEnd_toEndOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/tv_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintEnd_toEndOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
