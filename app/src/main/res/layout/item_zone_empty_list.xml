<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <ImageView
        android:id="@+id/empty_zone_avatar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginLeft="@dimen/dimen_10dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/empty_zone_nick_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_10dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:layout_marginRight="85dp"
        android:lines="1"
        android:layout_toRightOf="@+id/empty_zone_avatar"
        android:layout_alignTop="@+id/empty_zone_avatar"/>
    <LinearLayout
        android:textSize="@dimen/dimen_12sp"
        android:orientation="horizontal"
        android:id="@+id/empty_zone_sub_title"
        android:paddingRight="80dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_10dp"
        android:layout_marginBottom="@dimen/dimen_3dp"
        android:layout_toRightOf="@+id/empty_zone_avatar"
        android:layout_alignBottom="@+id/empty_zone_avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_96989e"
        android:gravity="center"
        android:id="@+id/empty_zone_followed"
        android:background="@drawable/bg_zhenai_class_stroke"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="@dimen/dimen_10dp"
        android:text="已关注"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_8b76f9"
        android:gravity="center"
        android:id="@+id/empty_zone_follow"
        android:background="@drawable/bg_zhenai_class_solid"
        android:paddingLeft="@dimen/dimen_18dp"
        android:paddingRight="@dimen/dimen_18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_10dp"
        android:text="关注"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:background="@color/color_e8e8e8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginLeft="@dimen/dimen_10dp"
        android:layout_toRightOf="@+id/empty_zone_avatar"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
