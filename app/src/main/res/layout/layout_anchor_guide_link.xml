<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/header_avatar_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:avatar_height="29dp"
        app:avatar_width="29dp"
        app:svga_height="44dp"
        app:svga_width="44dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_guide_link_bg"
        android:background="@drawable/bg_live_video_danmaku_link_guide_night"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/header_avatar_frame_layout">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_guide_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="10dp"/>
        <com.zhenai.live.widget.ShowAllGridView
            android:id="@+id/gv_avatars"
            android:layout_width="232dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:verticalSpacing="8dp"
            android:stretchMode="columnWidth"
            android:numColumns="3"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_link_guide"
            android:background="@drawable/round_767dff_btn_bg"
            android:layout_width="232dp"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="13dp"
            android:text=""
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <View
        android:id="@+id/click_view"
        android:layout_width="252dp"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/item_guide_link_bg"
        android:layout_alignBottom="@+id/item_guide_link_bg"
        android:layout_toEndOf="@+id/header_avatar_frame_layout"/>
</RelativeLayout>
