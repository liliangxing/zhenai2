<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="89dp"
        android:layout_height="89dp">
        <FrameLayout
            android:layout_gravity="center"
            android:background="#ffffff"
            android:layout_width="89dp"
            android:layout_height="89dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/outside_bg"
            android:background="@drawable/bg_marriage_avatar_female_outside"
            android:layout_width="89dp"
            android:layout_height="89dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/inside_bg"
            android:background="@drawable/bg_marriage_avatar_female_inside"
            android:layout_width="65dp"
            android:layout_height="65dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="54.33dp"
            android:layout_height="54.33dp"
            android:layout_marginTop="0.7dp"
            android:src="@drawable/shadow_avatar"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/marriage_img_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/point1"
        android:background="@drawable/bg_marriage_point_female_1"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginLeft="7.5dp"
        android:layout_marginTop="12.7dp"/>
    <FrameLayout
        android:id="@+id/point2"
        android:background="@drawable/bg_marriage_point_female_1"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="71.6dp"
        android:layout_marginTop="29.2dp"/>
    <FrameLayout
        android:id="@+id/point3"
        android:background="@drawable/bg_marriage_point_female_1"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="41.7dp"
        android:layout_marginTop="74.5dp"/>
</FrameLayout>
