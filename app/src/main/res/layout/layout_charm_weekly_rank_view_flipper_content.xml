<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/weekRankViewFlipper1"
        android:background="@drawable/bg_91000000_8dp_radius_retangle"
        android:visibility="gone"
        android:layout_width="83dp"
        android:layout_height="@dimen/dimen_16dp">
        <FrameLayout
            android:id="@+id/rankLayout"
            android:background="@drawable/icon_charm_weekly_rank"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weekly_rank"/>
        </FrameLayout>
        <ViewFlipper
            android:id="@+id/viewFlipperInner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/arrowRight"
            app:layout_constraintStart_toEndOf="@+id/rankLayout"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/arrowRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_arrow_right"
            android:layout_marginEnd="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/weekRankViewFlipper2"
        android:background="@drawable/bg_week_rank_mid_v8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_16dp">
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/rankLayout2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/weekly_rank"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewFlipper
            android:id="@+id/viewFlipperInner2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            app:layout_constraintStart_toEndOf="@+id/rankLayout2"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/arrowRight2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_arrow_right"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginEnd="@dimen/dimen_9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/viewFlipperInner2"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
