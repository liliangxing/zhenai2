<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_cover_lay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/header_layout">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/screen_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/cover_left"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/img_live_closewindow_curtain_left"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/anchor_group"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp">
                <com.zhenai.common.widget.RoundImageView
                    android:id="@+id/anchor_avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>
                <ImageView
                    android:background="@drawable/rect_white_stroke_1_r200"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/cover_right"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/img_live_closewindow_curtain_right"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/vice_group"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp">
                <com.zhenai.common.widget.RoundImageView
                    android:id="@+id/vice_avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>
                <ImageView
                    android:background="@drawable/rect_white_stroke_1_r200"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
    <com.zhenai.live.widget.count_down.CountDownView2
        android:id="@+id/count_down_audience"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_alignTop="@+id/screen_cover"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_40"
        android:id="@+id/tv_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/secret_talk_count_down"
        android:layout_below="@+id/count_down_audience"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/iv_play"
        android:background="@drawable/rect_767dff_r40"
        android:visibility="gone"
        android:layout_width="231dp"
        android:layout_height="44dp"
        android:layout_marginBottom="30dp"
        android:text="@string/wanna_play_secret_chat_too"
        android:layout_alignBottom="@+id/screen_cover"
        android:layout_centerHorizontal="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/chat_anm"
        android:visibility="visible"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@+id/iv_play"
        android:layout_below="@+id/count_down_audience"
        android:layout_centerHorizontal="true"
        app:lottie_loop="true"/>
</RelativeLayout>
