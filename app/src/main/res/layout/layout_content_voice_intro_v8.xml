<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_voice_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_voice_progress"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_voice_btn"
            android:background="@drawable/icon_recommend_voice_play_btn_v8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/voice_play_svga"
            android:visibility="invisible"
            android:layout_width="@dimen/dp86"
            android:layout_height="@dimen/dp18"
            android:layout_marginStart="@dimen/dp15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_voice_btn"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_26273c"
            android:id="@+id/tv_voice_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp55"
            android:text="00:00"
            android:layout_centerVertical="true"
            android:paddingStart="0dp"
            android:layout_marginStart="@dimen/dp115"
            android:layout_marginEnd="@dimen/dp25"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_voice_btn"
            app:layout_constraintStart_toEndOf="@+id/iv_voice_btn"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
