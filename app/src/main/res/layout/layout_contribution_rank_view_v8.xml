<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/layout_my_profile"
        android:background="#282c4a"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/btn_send_gift"
        android:background="@drawable/bg_767dff_r18_rectangle"
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:text="@string/go_to_send_gift"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/layout_my_profile"
        app:layout_constraintTop_toTopOf="@+id/layout_my_profile"/>
    <com.zhenai.live_common.widget.AvatarFrameLayout
        android:id="@+id/rank_avatar_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="42dp"
        app:avatar_height="46dp"
        app:avatar_width="46dp"
        app:layout_constraintStart_toStartOf="@+id/layout_my_profile"
        app:layout_constraintTop_toTopOf="@+id/layout_my_profile"
        app:setSvgaDimen="true"
        app:svga_height="66dp"
        app:svga_width="66dp"/>
    <ImageView
        android:id="@+id/iv_rank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_my_profile"
        app:layout_constraintStart_toStartOf="@+id/layout_my_profile"
        app:layout_constraintTop_toTopOf="@+id/layout_my_profile"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white_60"
        android:gravity="center"
        android:id="@+id/tv_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="28dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_my_profile"
        app:layout_constraintStart_toStartOf="@+id/layout_my_profile"
        app:layout_constraintTop_toTopOf="@+id/layout_my_profile"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white_90"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:maxLines="1"
        android:layout_marginStart="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv_contribution"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/rank_avatar_frame_layout"
        app:layout_constraintTop_toTopOf="@+id/layout_my_profile"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white_60"
        android:gravity="center"
        android:id="@+id/tv_contribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="5dp"
        android:layout_toEndOf="@+id/tv_nickname"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintEnd_toStartOf="@+id/btn_send_gift"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <View
        android:id="@+id/view_point"
        android:background="@drawable/bg_9affffff_circle"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:layout_marginTop="10.5dp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_send_gift_tips"
        android:background="@drawable/bg_66000000_r10_rectangle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="7dp"
        android:singleLine="true"
        android:drawableLeft="@drawable/ic_contribution_rank_tips"
        android:drawablePadding="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/btn_send_gift"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <View
        android:id="@+id/view_tv_send_gift_tips_line"
        android:background="@color/white_60"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_send_gift_tips"
        app:layout_constraintStart_toStartOf="@+id/tv_send_gift_tips"
        app:layout_constraintTop_toTopOf="@+id/tv_send_gift_tips"/>
    <com.zhenai.base.widget.recyclerview.xrecylerview.XRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_my_profile"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
