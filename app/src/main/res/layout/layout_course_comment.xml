<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingRight="@dimen/dimen_10dp"
    android:paddingBottom="@dimen/dimen_23dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@color/color_f4f2ff"
        android:paddingLeft="@dimen/dimen_17dp"
        android:paddingTop="@dimen/dimen_24dp"
        android:paddingRight="@dimen/dimen_17dp"
        android:layout_width="319dp"
        android:layout_height="121dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_42475C"
            android:ellipsize="end"
            android:id="@+id/tv_comment_title"
            android:paddingRight="@dimen/dimen_5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_nickname"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_a0a0a0"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_comment_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_comment_title"/>
        <com.zhenai.module_emotion.widget.CourseStarBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/starBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_2dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_comment_title"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_a0a0a0"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/starBar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/starBar"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_666978"
            android:ellipsize="end"
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/starBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:background="@drawable/ic_course_comment"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginLeft="@dimen/dimen_12dp"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
