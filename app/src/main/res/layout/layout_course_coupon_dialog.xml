<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_view"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp304"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_ff42475c"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp53"
        android:text="@string/emotion_choose_coupon"
        android:drawableLeft="@drawable/icon_back_dark"
        android:drawablePadding="@dimen/dp10"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:paddingLeft="@dimen/dp14"
        android:paddingRight="@dimen/dp14"
        android:paddingBottom="@dimen/dp10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
