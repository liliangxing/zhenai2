<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp250"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@drawable/ic_teacher_detail_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_emotion_course_item"
        android:paddingBottom="@dimen/dp18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp192"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_25sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_teacher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp17"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="#ff42475c"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_teacher_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:singleLine="true"
            android:drawableLeft="@drawable/ic_teacher_title"
            android:drawablePadding="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_teacher_name"/>
        <View
            android:id="@+id/v_line"
            android:background="@color/color_f2f2f2"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="@dimen/dp19"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_teacher_intro"/>
        <TextView
            android:textSize="@dimen/dimen_11sp"
            android:textColor="@color/color_666978"
            android:id="@+id/tv_resume_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp18"
            app:layout_constraintLeft_toLeftOf="@+id/v_line"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
