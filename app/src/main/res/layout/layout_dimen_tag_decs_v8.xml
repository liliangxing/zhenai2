<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/pruple_point_tv"
        android:background="@drawable/shape_767dff_circle"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="24dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff26273c"
        android:id="@+id/decs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="26dp"
        android:layout_toEndOf="@+id/pruple_point_tv"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/decs_title"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"/>
</RelativeLayout>
