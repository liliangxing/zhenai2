<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="parent">
        <com.zhenai.message.recharge.EmailListAutoScrollBanner
            android:id="@+id/view_pager_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:indicatorBottomMargin="8dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content_product"
            android:background="#fff3f4f7"
            android:paddingTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/view_pager_banner">
            <Button
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/bg_rectangle_ffff9e1f_4r_shape"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="@dimen/dimen_18dp"
                android:text="确认购买"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_recharge_way"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginBottom="@dimen/dimen_18dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toTopOf="@+id/btn_sure">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_wechat"
                    android:background="@drawable/bg_rectangle_ffffff_4r_2stroke_shape"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dimen_6dp">
                    <ImageView
                        android:layout_width="@dimen/dimen_20dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_wechat"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:id="@+id/tv_pay_wechat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_wechat"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_alipay"
                    android:background="@drawable/bg_rectangle_ffffff_4r_shape"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_6dp"
                    android:layout_marginEnd="@dimen/dimen_6dp">
                    <ImageView
                        android:layout_width="@dimen/dimen_20dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_alipay"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_alipay"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layout_union"
                    android:background="@drawable/bg_rectangle_ffffff_4r_shape"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dimen_6dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pay_type_union"
                        android:layout_marginEnd="@dimen/dimen_5dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff666978"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_union"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff666978"
                android:id="@+id/tv_recharge_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_10dp"
                android:text="支付方式："
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toTopOf="@+id/layout_recharge_way"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recharge_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="23dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_recharge_way"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
