<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/content_view"
    android:background="@drawable/shape_bg_notify"
    android:layout_width="@dimen/dp283"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dimen_12dp"
    android:layout_marginTop="@dimen/dimen_12dp"
    android:layout_marginRight="@dimen/dimen_12dp"
    android:maxHeight="@dimen/dp385"
    android:minWidth="@dimen/dp283"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:paddingBottom="@dimen/dp70"
        android:layout_width="@dimen/dp254"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="@dimen/dimen_6dp"
        android:layout_marginRight="@dimen/dp15"
        android:maxHeight="@dimen/dp379"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_get_it_now"
        android:layout_width="@dimen/dp254"
        android:layout_height="@dimen/dimen_42dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:text="立即领取"
        app:bg_colorGradientEnd="@color/color_8070f1"
        app:bg_colorGradientStart="@color/color_b06cef"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_6dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
