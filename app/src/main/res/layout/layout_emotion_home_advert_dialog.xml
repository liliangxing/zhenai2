<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_view"
        android:background="@drawable/shape_bg_notify"
        android:layout_width="295dp"
        android:layout_height="234dp"
        android:layout_marginLeft="@dimen/dimen_12dp"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginRight="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/top_view"
            android:background="@drawable/ic_emotion_home_advert_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/tv_dialog_content"
            android:paddingLeft="@dimen/dimen_40dp"
            android:paddingTop="@dimen/dimen_15dp"
            android:paddingRight="@dimen/dimen_40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emotion_home_dialog_default_content"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_view"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_follow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="订阅"
            app:bg_colorGradientEnd="@color/color_8070f1"
            app:bg_colorGradientStart="@color/color_b06cef"
            app:bg_fillMode="linearGradient"
            app:bg_radius="@dimen/dimen_6dp"
            app:bg_shape="round"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tv_audition"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dimen_26dp"
        android:layout_height="@dimen/dimen_26dp"
        android:src="@drawable/ic_live_video_dialog_close"/>
</FrameLayout>
