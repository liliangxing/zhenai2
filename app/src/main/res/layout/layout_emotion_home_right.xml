<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_order"
        android:paddingTop="@dimen/dimen_2dp"
        android:paddingRight="@dimen/dimen_1dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_pic"
            android:background="@drawable/ic_emotion_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.common.widget.RedDotView
        android:layout_gravity="end"
        android:id="@+id/red_dot"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_6dp"
        android:layout_height="@dimen/dimen_6dp"
        app:backgroundColor="@color/red_dot_color"
        app:isRadiusHalfHeight="true"
        app:isWidthHeightEqual="true"
        app:layout_constraintRight_toRightOf="@+id/cl_order"
        app:layout_constraintTop_toTopOf="@+id/cl_order"/>
</androidx.constraintlayout.widget.ConstraintLayout>
