<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_emotion_clazz_recommend"
    android:paddingBottom="16dp"
    android:layout_width="280dp"
    android:layout_height="95dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <ImageView
        android:id="@+id/recommend_icon"
        android:background="@drawable/ic_emotion_clazz_recommend"
        android:layout_width="14dp"
        android:layout_height="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/recommend_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/recommend_tv"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#824be5"
        android:id="@+id/recommend_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/emotion_recommend"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dimen_4dp"
        app:layout_constraintStart_toEndOf="@+id/recommend_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/emotion_window_img"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_tv"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_30323c"
        android:ellipsize="end"
        android:id="@+id/clazz_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/emotion_window_img"
        app:layout_constraintTop_toTopOf="@+id/emotion_window_img"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#fd7979"
        android:id="@+id/clazz_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/emotion_window_img"
        app:layout_constraintStart_toEndOf="@+id/emotion_window_img"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_label_type_name"
        android:paddingLeft="@dimen/dimen_4dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_4dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_3dp"
        app:bg_colorGradientEnd="@color/color_ef886a"
        app:bg_colorGradientStart="@color/color_ef886a"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_3dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/clazz_price"
        app:layout_constraintStart_toEndOf="@+id/clazz_price"
        app:layout_constraintTop_toTopOf="@+id/clazz_price"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/emotion_window_sure"
        android:background="@drawable/bg_8b76f9_rectangle_r16_shape"
        android:layout_width="54dp"
        android:layout_height="24dp"
        android:text="@string/pay"
        app:layout_constraintBottom_toBottomOf="@+id/emotion_window_img"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/jump_click"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.304"/>
    <ImageView
        android:id="@+id/close_window"
        android:padding="3dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/del"
        app:layout_constraintBottom_toBottomOf="@+id/recommend_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/recommend_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
