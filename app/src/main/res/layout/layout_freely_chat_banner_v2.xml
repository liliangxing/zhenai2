<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffedbf"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#563f1b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/become_super_vip_freely_chat_banner_v2_title"
        android:layout_marginStart="14dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#563f1b"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/become_super_vip_freely_chat_banner_v2_content"
        android:maxLines="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="3dp"
        android:layout_toStartOf="@+id/btn_use"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#563f1b"
        android:gravity="center_vertical"
        android:id="@+id/btn_use"
        android:background="@drawable/bg_ffd062_rectangle_18_radius"
        android:padding="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enjoy_freely_chat"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
