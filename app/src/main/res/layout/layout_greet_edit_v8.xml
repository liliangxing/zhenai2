<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_white_16dp_radius"
                android:paddingTop="@dimen/dp23"
                android:paddingBottom="@dimen/dp23"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp23">
                <EditText
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/color_26273C"
                    android:textColorHint="@color/color_aeafb3"
                    android:gravity="start"
                    android:id="@+id/edt_message"
                    android:background="@null"
                    android:paddingLeft="@dimen/dp15"
                    android:paddingRight="@dimen/dp15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp139"
                    android:hint="@string/greet_up_57"
                    android:maxLines="9"
                    android:maxLength="300"
                    android:textCursorDrawable="@drawable/greet_edit_cursor_shape"
                    android:paddingStart="@dimen/dp15"
                    android:paddingHorizontal="@dimen/dp15"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="15dp">
                    <TextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/color_aeafb3"
                        android:layout_gravity="end"
                        android:id="@+id/text_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/300"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffadb1ff"
                        android:ellipsize="end"
                        android:id="@+id/tv_ai_content_tag"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/content_create_by_ai"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/text_count"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/text_count"/>
                    <TextView
                        android:textSize="@dimen/dimen_12sp"
                        android:textColor="@color/color_767dff"
                        android:ellipsize="end"
                        android:id="@+id/greet_count_over_limit"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/greet_count_over_limit_tips"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/text_count"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/text_count"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:background="@drawable/bg_white_16dp_radius"
                android:paddingLeft="@dimen/dp15"
                android:paddingTop="@dimen/dp23"
                android:paddingRight="@dimen/dp15"
                android:paddingBottom="@dimen/dp23"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp15"
                android:paddingVertical="@dimen/dp23">
                <com.zhenai.common.widget.BoldTextView
                    android:textColor="@color/color_26273c"
                    android:id="@+id/tv_advise_title"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/white_advise"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/color_767dff"
                    android:id="@+id/tv_watch_greet"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_greet_normal_v8"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_advise_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_advise_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_6c6d75"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="@string/greet_advise_info"
                    android:lineSpacingExtra="@dimen/dp5"
                    app:layout_constraintTop_toBottomOf="@+id/tv_advise_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_import_monologue"
                android:visibility="gone"
                android:layout_width="@dimen/dp222"
                android:layout_height="@dimen/dp42"
                android:layout_marginTop="@dimen/dp23"
                android:text="@string/import_my_monologue"
                app:bg_colorNormal="@color/color_767dff"
                app:bg_fillMode="color"
                app:bg_radius="@dimen/dp22"
                app:bg_shape="round"/>
        </LinearLayout>
    </ScrollView>
    <com.zhenai.business.business.zhenxiaoai.main.ZhenxiaoaiView
        android:id="@+id/view_zhenxiaoai"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
