<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/greet_guide"
            android:background="@drawable/bg_common_dialog_corner_16dp"
            android:paddingBottom="@dimen/dp23"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp12">
            <com.zhenai.common.widget.BoldTextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/color_26273c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp23"
                android:text="@string/add_greet"
                android:layout_marginStart="15dp"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/color_6c6d75"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/greet_up_57"
                android:layout_marginStart="15dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/rect_f2f4f5_r8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp15"
                android:layout_marginHorizontal="@dimen/dp15">
                <ImageView
                    android:id="@+id/mine_avatar"
                    android:layout_width="@dimen/dp29"
                    android:layout_height="@dimen/dp29"
                    android:layout_marginTop="@dimen/dp22"
                    android:layout_marginEnd="@dimen/dp12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_chat_row_text_send_content"
                    android:background="@drawable/email_chat_row_mine_bg"
                    android:paddingLeft="11dp"
                    android:paddingTop="7dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp19"
                    android:textIsSelectable="false"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="9dp"
                    app:bg_colorNormal="@color/color_9aa9ff"
                    app:bg_fillMode="color"
                    app:bg_radius="@dimen/dp15"
                    app:bg_shape="round"
                    app:layout_constraintEnd_toStartOf="@+id/mine_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/other_avatar"
                    android:layout_width="@dimen/dp29"
                    android:layout_height="@dimen/dp29"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp22"
                    android:layout_marginStart="@dimen/dp12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_chat_row_text_send_content"/>
                <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                    android:textSize="12sp"
                    android:textColor="#42475c"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_chat_row_text_received_content"
                    android:background="@drawable/rect_white_bottom_r12"
                    android:paddingLeft="9dp"
                    android:paddingTop="7dp"
                    android:paddingRight="9dp"
                    android:paddingBottom="7dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nice_to_meet_you"
                    android:drawablePadding="7dp"
                    android:textIsSelectable="false"
                    android:layout_marginStart="9dp"
                    app:bg_colorNormal="@color/white"
                    app:bg_fillMode="color"
                    app:bg_radius="@dimen/dp12"
                    app:bg_shape="round"
                    app:layout_constraintStart_toEndOf="@+id/other_avatar"
                    app:layout_constraintTop_toTopOf="@+id/other_avatar"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/go_2_add_greet"
                android:background="@drawable/common_long_btn_normal_za7"
                android:visibility="gone"
                android:layout_width="@dimen/dp222"
                android:layout_height="@dimen/dp42"
                android:text="@string/go_2_add_greet"
                app:bg_colorNormal="@color/color_767dff"
                app:bg_fillMode="color"
                app:bg_radius="@dimen/dp22"
                app:bg_shape="round"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/cl_greet_content"
            android:background="@drawable/bg_common_dialog_corner_16dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textStyle="bold"
                android:textColor="@color/color_26273c"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp23"
                android:text="@string/my_greetings"
                android:layout_marginStart="@dimen/dp15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_767dff"
                android:id="@+id/tv_delete"
                android:padding="@dimen/dp5"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/delete"
                android:layout_alignParentRight="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title"/>
            <TextView
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/greet_content_text"
                android:background="@drawable/rect_f2f4f5_r8"
                android:padding="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp15"
                android:layout_marginVertical="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:textColor="@color/color_ff7599"
                android:id="@+id/donot_verify_and_edit"
                android:paddingBottom="@dimen/dp3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/donot_verify_and_edit"
                android:drawablePadding="4dp"
                android:layout_marginStart="@dimen/dp17"
                app:drawableStartCompat="@drawable/ic_opinion_unpass"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/greet_content_text"/>
            <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_edit"
                android:visibility="visible"
                android:layout_width="@dimen/dp222"
                android:layout_height="@dimen/dp42"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/edit"
                app:bg_colorNormal="@color/color_767dff"
                app:bg_fillMode="color"
                app:bg_radius="@dimen/dp22"
                app:bg_shape="round"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/donot_verify_and_edit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_aeafb3"
            android:id="@+id/greet_intro_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
