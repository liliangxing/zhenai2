<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/root_layout"
    android:background="@drawable/bg_ffffff_top_radius_30"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_heat_up_topic_top"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="30dp"
        app:radius_right_up="30dp"
        app:roundImageType="round"/>
    <ImageView
        android:id="@+id/btn_back"
        android:background="@drawable/go_back_v8"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:background="@drawable/icon_message_close_v2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#aeafb3"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="@string/heat_up_topic_edit_tips"
        android:layout_marginStart="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#26273b"
        android:gravity="start|top"
        android:id="@+id/et_edit_question"
        android:background="@drawable/bg_f2f4f5_rectangle_15_radius"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="174dp"
        android:layout_marginTop="8dp"
        android:maxLength="60"
        android:lineSpacingMultiplier="1.2"
        android:textCursorDrawable="@drawable/message_footer_editext_cursor_shape_v2"
        android:paddingStart="16dp"
        android:paddingEnd="9dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <TextView
        android:enabled="true"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_sure"
        android:background="@drawable/bg_767dff_aeb1b6_40_radius_btn_selecter"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:text="@string/sure"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/et_edit_question"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#26273b"
        android:id="@+id/tv_question"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:layout_marginTop="24dp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="21dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_bottom_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_question">
        <TextView
            android:textSize="16sp"
            android:textColor="#767dff"
            android:gravity="center"
            android:id="@+id/btn_change_question"
            android:background="@drawable/bg_ebecff_tectangle_40_radius"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="@string/change_question"
            android:layout_weight="1"
            android:layout_marginEnd="3.5dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_add_answer"
            android:background="@drawable/bg_767dff_rectangle_40_radius"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="@string/add_my_answer"
            android:layout_weight="1"
            android:layout_marginStart="3.5dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
