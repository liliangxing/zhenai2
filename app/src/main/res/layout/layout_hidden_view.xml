<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_close"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="50dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_expandable_tv_btn_more"
        android:scaleType="fitCenter"
        android:layout_alignParentBottom="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <ScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/img_close">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.InfoCardTitleLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:title="URL"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="-10dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <EditText
                    android:textSize="16sp"
                    android:textColor="#42475c"
                    android:textColorHint="#88666978"
                    android:id="@+id/edt_url"
                    android:background="@drawable/chat_edit_text_bg"
                    android:padding="8dp"
                    android:paddingLeft="15dp"
                    android:paddingTop="2dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="2dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:hint="input url"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <Button
                    android:id="@+id/btn_go2_web_view"
                    android:layout_width="65dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:text="go"
                    android:layout_marginStart="5dp"
                    style="@style/CommonMiddleStrokeBtnStyle"/>
            </LinearLayout>
            <View style="@style/CutLineStyle"/>
            <com.zhenai.common.widget.InfoCardTitleLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:title="Http"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="-10dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture Http"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="0dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_capture_http"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View style="@style/CutLineStyle"/>
            <com.zhenai.common.widget.InfoCardTitleLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:title="Info"/>
            <com.zhenai.base.widget.textview.ExpandableTextView
                android:id="@+id/expandable_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="16dp"
                app:animDuration="200"
                app:auto_select_effect="false"
                app:maxCollapsedLines="4"
                app:showEllipsize="false">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#666978"
                    android:id="@+id/expandable_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/expand_collapse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#99714ead"
                        android:id="@+id/tv_btn_expandable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expand"/>
                    <ImageView
                        android:id="@+id/img_btn_expandable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_expandable_tv_btn_more"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </com.zhenai.base.widget.textview.ExpandableTextView>
            <View style="@style/CutLineStyle"/>
            <com.zhenai.common.widget.InfoCardTitleLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:title="直播"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="im开关"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="0dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_live_im"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="直播美颜帧率开关"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="0dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_live_beauty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="直播时装秀点击区域开关"
                    android:layout_weight="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="0dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_live_user_show"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <RelativeLayout
                android:id="@+id/layout_switch_live_proxy_log"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="直播引擎日志"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="0dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_live_proxy_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View style="@style/CutLineStyle"/>
            <RelativeLayout
                android:id="@+id/layout_za_kit"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="70dp">
                <com.zhenai.common.widget.InfoCardTitleLayout
                    android:id="@+id/layout_za_kit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:title="工具信息条"/>
                <TextView
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示"
                    android:layout_below="@+id/layout_za_kit_title"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    style="@style/InfoCardHeadTitleTextStyle"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_za_kit_info_bar_showing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:paddingEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View style="@style/CutLineStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_http_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.zhenai.common.widget.InfoCardTitleLayout
                    android:id="@+id/layout_http_dns_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:title="HttpDns"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/tv_http_dns_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_above="@+id/img_close"
        style="@style/CutLineStyle"/>
</RelativeLayout>
