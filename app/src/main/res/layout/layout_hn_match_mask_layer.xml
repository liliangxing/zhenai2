<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zhenai.live.professional_match.widget.LeftClippedConstraintLayout
            android:id="@+id/layout_wait_mir_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_zalive_qianxian_empty_video_bg"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/white"
                android:id="@+id/tag_wait_mir_1"
                android:background="@drawable/bg_right_down_round_gray"
                android:paddingLeft="7dp"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingRight="7dp"
                android:paddingBottom="@dimen/dimen_5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/honor"/>
            <ImageView
                android:id="@+id/iv_wait_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:src="@drawable/live_video_sofa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_wait_tip_1"
                android:background="@drawable/rect_stroke_white_w1_r20"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/apply_mic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_wait_1"/>
            <com.zhenai.live.widget.AvatarsLineView
                android:id="@+id/alv_apply_list_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wait_tip_1"/>
        </com.zhenai.live.professional_match.widget.LeftClippedConstraintLayout>
        <com.zhenai.live.professional_match.widget.RightClippedConstraintLayout
            android:id="@+id/layout_wait_mir_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_zalive_qianxian_empty_mask"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/white"
                android:id="@+id/tag_wait_mir_2"
                android:background="@drawable/bg_right_down_round_gray"
                android:paddingLeft="7dp"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingRight="7dp"
                android:paddingBottom="@dimen/dimen_5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qianxian"/>
            <ImageView
                android:id="@+id/iv_wait_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:src="@drawable/live_video_sofa"
                android:alpha="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_wait_tip_2"
                android:background="@drawable/rect_stroke_white_w1_r20"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/apply_mic"
                android:alpha="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_wait_2"/>
            <com.zhenai.live.widget.AvatarsLineView
                android:id="@+id/alv_apply_list_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wait_tip_2"/>
        </com.zhenai.live.professional_match.widget.RightClippedConstraintLayout>
    </LinearLayout>
</FrameLayout>
