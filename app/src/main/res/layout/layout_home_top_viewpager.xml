<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.business.widget.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/color_e8e8e8"
    android:layout_width="match_parent"
    android:layout_height="@dimen/viewpager_height"
    app:ratio="0.452">
    <com.zhenai.business.widget.BannerViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/indicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_back_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/default_img"/>
</com.zhenai.business.widget.RatioFrameLayout>
