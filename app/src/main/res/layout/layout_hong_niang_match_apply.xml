<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.common.widget.refresh.ZARefreshLayout
        android:id="@+id/layout_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/root_recycle_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.zhenai.common.widget.refresh.ZARefreshLayout>
    <RelativeLayout
        android:id="@+id/layout_network_retry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/img_network_error"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/icon_live_video_live_list_net_broken"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/color_a0a3ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/failed_to_connect_rtc_server"
            android:layout_below="@+id/img_network_error"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/color_a0a3ad"
        android:id="@+id/tv_null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hn_match_apply_null_tips"
        android:drawableTop="@drawable/getting_data_fail_default_icon"
        android:drawablePadding="@dimen/dimen_10dp"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
