<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_card_container"
        android:background="@drawable/bg_id_card_view"
        android:layout_width="152dp"
        android:layout_height="176dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_id_card_tips">
        <ImageView
            android:id="@+id/id_card_tips"
            android:background="@drawable/id_card_front"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:scaleType="centerCrop"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.common.widget.RoundCornerImageView
            android:id="@+id/id_card"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="124dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@+id/id_card_desc"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:radius="16dp"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="#26273c"
            android:gravity="center"
            android:id="@+id/id_card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_9dp"
            android:layout_marginBottom="20dp"
            android:text="@string/credit_upload_id_cards_font"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/id_card_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/id_card_close"
        android:layout_alignTop="@+id/id_card_container"
        android:layout_marginEnd="4dp"
        android:layout_alignEnd="@+id/id_card_container"/>
</merge>
