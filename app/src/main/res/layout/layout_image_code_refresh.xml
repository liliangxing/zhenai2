<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switch_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/code_image"
        android:background="@drawable/bg_rectangle_e4d3d3_21r_shape"
        android:layout_width="100dp"
        android:layout_height="42dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/code_image_progressbar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/code_image"
        app:layout_constraintEnd_toEndOf="@+id/code_image"
        app:layout_constraintStart_toStartOf="@+id/code_image"
        app:layout_constraintTop_toTopOf="@+id/code_image"/>
    <ImageView
        android:id="@+id/switch_image"
        android:layout_width="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_16dp"
        android:src="@drawable/image_code_switch"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/dimen_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/code_image"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
