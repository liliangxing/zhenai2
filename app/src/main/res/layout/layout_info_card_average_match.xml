<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#26273c"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/ic_info_card_title_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.business.widget.VisitedMeExpandableTextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:ellipsize="end"
        android:orientation="vertical"
        android:id="@+id/tv_content"
        android:background="@drawable/bg_ff8f7fc_stroke_f5f5f5_9r"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        app:etv_EllipsisHint="..."
        app:etv_EnableToggle="true"
        app:etv_MaxLinesOnShrink="4"
        app:etv_ToExpandHint="展开 &gt;"
        app:etv_ToExpandHintColor="#aeafb3"
        app:etv_ToExpandHintColorBgPressed="@color/transparent"
        app:etv_ToExpandHintSize="14sp"
        app:etv_ToShrinkHintColor="@color/color_AEAFB3"
        app:etv_ToShrinkHintSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
