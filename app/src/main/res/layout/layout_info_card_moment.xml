<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#26273c"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/ic_info_card_title_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.business.widget.VisitedMeExpandableTextView
        android:textSize="14sp"
        android:textColor="#26273c"
        android:orientation="vertical"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="5dp"
        app:etv_EllipsisHint="..."
        app:etv_EnableToggle="true"
        app:etv_MaxLinesOnShrink="3"
        app:etv_ToExpandHint="展开 &gt;"
        app:etv_ToExpandHintColor="#aeafb3"
        app:etv_ToExpandHintColorBgPressed="@color/transparent"
        app:etv_ToExpandHintSize="14sp"
        app:etv_ToShrinkHintColor="@color/color_AEAFB3"
        app:etv_ToShrinkHintSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/photo_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_layout"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/moment_click_guide"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:antiAlias="true"
        app:autoPlay="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:source="finger_guide.svga"/>
</androidx.constraintlayout.widget.ConstraintLayout>
