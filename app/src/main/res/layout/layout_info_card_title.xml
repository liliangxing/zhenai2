<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_card_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View style="@style/InfoCardHeadCubeStyle"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        style="@style/InfoCardHeadTitleTextStyle"/>
    <ImageView
        android:id="@+id/iv_title_icon"
        android:visibility="gone"
        android:layout_toRightOf="@+id/tv_title"
        style="@style/InfoCardLeftImgStyle"/>
    <TextView
        android:id="@+id/tv_second_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_toRightOf="@+id/tv_title"
        style="@style/InfoCardHeadSecondTitleTextStyle"/>
    <View
        android:id="@+id/view_cut_line_gift"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tv_title"
        style="@style/InfoCardHeadCutLineStyle"/>
    <ImageView
        android:id="@+id/iv_enter_icon"
        android:visibility="gone"
        style="@style/InfoCardRightImgStyle"/>
    <TextView
        android:id="@+id/tv_right"
        android:visibility="visible"
        android:layout_marginRight="5dp"
        android:layout_toLeftOf="@+id/iv_enter_icon"
        style="@style/InfoCardHeadSecondTitleTextStyle"/>
</RelativeLayout>
