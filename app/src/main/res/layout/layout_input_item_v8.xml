<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_input_item_v8_0"
    android:background="@drawable/bg_rectangle_ffffff_40r_shape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="21sp"
        android:textColor="@color/list_item_content_color_v8"
        android:textColorHint="@color/list_item_hint_color_v8"
        android:gravity="center_vertical"
        android:id="@+id/item_input"
        android:tag="binding_1"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/editext_cursor_shape_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cl_right_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_right_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_input"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/img_close"
            android:tag="binding_2"
            android:padding="8dp"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:layout_marginEnd="@dimen/dimen_16dp"
            app:drawableEndCompat="@drawable/img_close_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
