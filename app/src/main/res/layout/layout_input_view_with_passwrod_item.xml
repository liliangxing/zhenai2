<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/right_layout"
    android:layout_width="wrap_content"
    android:layout_height="42dp">
    <ImageView
        android:id="@+id/right_icon"
        android:paddingTop="@dimen/dimen_13dp"
        android:paddingBottom="@dimen/dimen_13dp"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_input_item_close"
        android:scaleType="centerCrop"
        android:paddingStart="@dimen/dimen_8dp"
        android:paddingEnd="@dimen/dimen_8dp"/>
    <ImageView
        android:id="@+id/right_show"
        android:paddingTop="@dimen/dimen_12dp"
        android:paddingBottom="@dimen/dimen_12dp"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_input_item_password_close"
        android:scaleType="centerCrop"
        android:paddingStart="@dimen/dimen_6dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="@dimen/dimen_6dp"/>
</LinearLayout>
