<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp">
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="@dimen/dp68"
        android:layout_height="@dimen/dp68"
        android:src="@drawable/photo_loading"
        android:scaleType="centerCrop"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_image_v2"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/photo_loading"
        android:scaleType="centerCrop"
        app:borderRadius="8dp"
        app:roundImageType="round"/>
</FrameLayout>
