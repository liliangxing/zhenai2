<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_tag_top"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <ImageView
        android:id="@+id/iv_tag_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"/>
    <ImageView
        android:id="@+id/iv_bg_fashion_selected"
        android:background="@drawable/bg_fashion_selected_v8"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_fashion_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_bg"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableFrameLayout
        android:id="@+id/layout_coin_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:minWidth="52dp"
        app:bg_colorNormal="#f3f4f7"
        app:bg_fillMode="color"
        app:bg_shape="semicircle"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_fashion_name">
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/icon_zhenai_coin"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#7f818d"
            android:gravity="center"
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="10dp"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableFrameLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#7f818d"
        android:gravity="center"
        android:id="@+id/tv_has_owned"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/has_owned"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_fashion_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
