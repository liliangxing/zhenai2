<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_live_change_bg_dialog_v8"
    android:layout_width="match_parent"
    android:layout_height="536dp">
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:id="@+id/title_tab"
        android:paddingLeft="80dp"
        android:paddingRight="80dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:paddingHorizontal="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:zIndicatorCornerRadius="2dp"
        app:zIndicatorEndColor="@color/white"
        app:zIndicatorHeight="4dp"
        app:zIndicatorScrollScale="true"
        app:zIndicatorStartColor="@color/white"
        app:zIndicatorWidth="16dp"
        app:zSelectedTextColor="#e6ffffff"
        app:zSelectedTextSize="16sp"
        app:zUnSelectedTextColor="#99ffffff"
        app:zUnSelectedTextSize="16sp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_market"
        android:background="@drawable/bg_767dff_r14_shape"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:text="@string/market"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line_view"
        android:background="#26ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tab"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tab"/>
</androidx.constraintlayout.widget.ConstraintLayout>
