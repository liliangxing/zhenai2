<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live_common.gift.widget.CoupleCertificationWidget xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/topbar_love_bg"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/live_annunciation_marquee.json"
        app:lottie_imageAssetsFolder="images/live_annunciation"
        app:lottie_loop="true"/>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/iv_rob_in_castle"
        android:layout_width="82dp"
        android:layout_height="32dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_annunciation"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.MarqueeText
        android:textSize="15sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:id="@+id/tv_annunciation"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_rob_in_castle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.zhenai.live_common.gift.widget.CoupleCertificationWidget>
