<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="12dp"
        app:bg_colorNormal="@color/white"
        app:bg_radius="9dp"
        app:bg_shape="round">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_666978"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="20dp"
            android:text="@string/invite_random_link_mic_focus"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_8b76f9"
                android:gravity="center"
                android:id="@+id/btn_exit"
                android:background="@drawable/live_video_apply_bg"
                android:layout_width="125dp"
                android:layout_height="44dp"
                android:text="退 出"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_focus"
                android:background="@drawable/bg_live_rectangle_purple_corner"
                android:layout_width="125dp"
                android:layout_height="44dp"
                android:layout_marginLeft="15dp"
                android:text="@string/close_and_focus"/>
        </LinearLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_live_video_dialog_close"/>
</FrameLayout>
