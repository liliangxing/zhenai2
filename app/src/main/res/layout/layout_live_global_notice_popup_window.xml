<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_10dp"
    android:layout_marginBottom="@dimen/dimen_10dp"
    android:layout_marginStart="@dimen/dimen_10dp"
    android:layout_marginEnd="@dimen/dimen_10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dimen_10dp"
    app:cardElevation="@dimen/dimen_10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/dimen_15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/dimen_40dp"
            android:layout_height="@dimen/dimen_40dp"
            android:src="@drawable/default_circle_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundImageType="circle"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_42475e"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_8b76f9"
            android:id="@+id/tv_living"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_lottie"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/dimen_1dp"
            android:layout_marginStart="@dimen/dimen_6dp"
            app:layout_constraintStart_toEndOf="@+id/tv_living"
            app:layout_constraintTop_toTopOf="@+id/tv_living"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/living_purple_hn_match.json"
            app:lottie_loop="true"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableButton
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:minWidth="@dimen/dimen_80dp"
            app:bg_colorGradientEnd="@color/color_825ff6"
            app:bg_colorGradientStart="@color/color_a46ff5"
            app:bg_fillMode="linearGradient"
            app:bg_shape="semicircle"
            app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_80_42475c"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_detail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:maxLines="1"
            android:drawablePadding="@dimen/dimen_3dp"
            android:drawableStart="@drawable/icon_live_horn_bg"
            android:paddingStart="@dimen/dimen_8dp"
            android:paddingEnd="@dimen/dimen_8dp"
            app:bg_colorNormal="#1a8b76f9"
            app:bg_radius="@dimen/dimen_5dp"
            app:bg_shape="round"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
