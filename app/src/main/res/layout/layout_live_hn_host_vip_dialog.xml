<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_quit"
        android:background="@drawable/bg_live_video_ktv_game_quit_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true">
        <me.yintaibing.universaldrawable.view.UniversalDrawableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            app:bg_bitmap="@drawable/bg_hn_host_vip_dialog"
            app:bg_fillMode="bitmap"
            app:bg_radiusLeftTop="6dp"
            app:bg_radiusRightTop="6dp"
            app:bg_shape="round"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="251dp"
            android:layout_height="65dp"
            android:layout_marginTop="72dp"
            android:layout_centerHorizontal="true"/>
        <com.zhenai.business.widget.indicator.PagerIndicatorView
            android:id="@+id/indicator_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/recycler_view"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#9942475e"
            android:gravity="center"
            android:id="@+id/tv_price_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/professional_match_upgrade_to_vip_price_tips"
            android:layout_below="@+id/image"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_upgrade"
            android:background="@drawable/btn_live_hn_host_vip_dialog"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:text="@string/professional_match_upgrade_vip_right_now"
            android:shadowColor="#66e9a94f"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5"
            android:layout_below="@+id/tv_price_tips"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/img_quit"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-13dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_alignTop="@+id/layout_quit"
        android:layout_alignRight="@+id/layout_quit"/>
</RelativeLayout>
