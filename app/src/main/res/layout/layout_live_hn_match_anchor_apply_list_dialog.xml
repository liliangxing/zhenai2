<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hn_match_apply_dialog_shape"
        android:layout_width="match_parent"
        android:layout_height="550dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tab_root_layout"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.zhenai.lib.zaui.tablayout.ZTabLayout
                android:id="@+id/tab_layout_title"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginEnd="64dp"
                app:layout_constraintTop_toTopOf="parent"
                app:zIndicatorColorOrientation="left_right"
                app:zIndicatorEndColor="@color/color_8b76f5"
                app:zIndicatorHeight="2dp"
                app:zIndicatorMarginBottom="4dp"
                app:zIndicatorScrollScale="true"
                app:zIndicatorStartColor="@color/color_8b76f5"
                app:zIndicatorWidth="30dp"
                app:zSelectedTextColor="@color/color_8b76f5"
                app:zSelectedTextSize="15sp"
                app:zTabMode="fixed"
                app:zUnSelectedTextColor="@color/color_666666"
                app:zUnSelectedTextSize="15sp"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tab_visitant_red_dot_view"
                android:background="@drawable/reddot_with_num"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                android:layout_marginEnd="55dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_add_visitant"
                android:padding="@dimen/dimen_5dp"
                android:visibility="gone"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:src="@drawable/icon_add_visitant"
                android:layout_marginEnd="@dimen/dimen_15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_line_view_pager"
                android:background="#ffeeeeee"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager_hong_niang_match"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_root_layout"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff866ff0"
            android:gravity="center_vertical"
            android:id="@+id/tv_description"
            android:paddingLeft="@dimen/dimen_20dp"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hn_match_select_all_description"
            app:layout_constraintBottom_toTopOf="@+id/btn_select_not_in_room"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <CheckBox
            android:textColor="@color/black"
            android:id="@+id/btn_select_not_in_room"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_20dp"
            android:text="@string/hn_match_select_all_not_in_room"
            app:layout_constraintBottom_toTopOf="@+id/btn_select_all_in_room"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/MomentDeleteCheckbox"/>
        <CheckBox
            android:textColor="@color/black"
            android:id="@+id/btn_select_all_in_room"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_20dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/hn_match_select_all_men_in_room"
            app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/MomentDeleteCheckbox"/>
        <Button
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_8b76f9"
            android:id="@+id/btn_cancel"
            android:background="@drawable/btn_daemon_impression_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/hn_match_dialog_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/btn_apply_go_mic"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_apply_go_mic"
            android:background="@drawable/bg_live_rectangle_purple_corner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/hn_match_go_mic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/btn_cancel"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
