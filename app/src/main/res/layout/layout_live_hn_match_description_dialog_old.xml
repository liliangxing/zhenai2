<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_quit"
        android:background="@drawable/bg_live_video_ktv_game_quit_shape"
        android:paddingLeft="@dimen/dimen_20dp"
        android:paddingRight="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_8770f1"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/professional_match_description"
            android:layout_centerHorizontal="true"/>
        <View
            android:id="@+id/view_line_1"
            android:background="@color/color_e1e1e1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_below="@+id/view_line_1">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_channel_line_up_item_index"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff42475c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_9dp"
                android:text="@string/professional_match_description_title_1"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff42475c"
            android:id="@+id/tv_content_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:text="@string/professional_match_description_content_1_old"
            android:layout_below="@+id/layout_1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/tv_content_1">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_channel_line_up_item_index"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff42475c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_9dp"
                android:text="@string/professional_match_description_title_2"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff42475c"
            android:id="@+id/tv_content_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:text="@string/professional_match_description_content_2_old"
            android:layout_below="@+id/layout_2"
            android:lineSpacingExtra="@dimen/dimen_5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/tv_content_2">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_channel_line_up_item_index"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="3"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff42475c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_9dp"
                android:text="@string/professional_match_description_title_3"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff42475c"
            android:id="@+id/tv_content_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:text="@string/professional_match_description_content_3_old"
            android:layout_below="@+id/layout_3"
            android:lineSpacingExtra="@dimen/dimen_5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/tv_content_3">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_channel_line_up_item_index"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="4"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff42475c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_9dp"
                android:text="@string/professional_match_description_title_4"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff42475c"
            android:id="@+id/tv_content_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:text="@string/professional_match_description_content_4_old"
            android:layout_below="@+id/layout_4"
            android:lineSpacingExtra="@dimen/dimen_5dp"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/img_quit"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-13dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_alignTop="@+id/layout_quit"
        android:layout_alignRight="@+id/layout_quit"/>
</RelativeLayout>
