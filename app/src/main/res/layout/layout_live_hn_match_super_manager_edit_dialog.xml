<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_quit"
        android:background="@drawable/bg_live_video_professional_match_super_manager_edit"
        android:padding="@dimen/dimen_15dp"
        android:layout_width="match_parent"
        android:layout_height="201dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_live_video_professional_match_super_manager_edit_bg"
            android:paddingLeft="@dimen/dimen_10dp"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingRight="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="112dp">
            <EditText
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/color_42475e"
                android:textColorHint="#8042475e"
                android:gravity="start"
                android:id="@+id/et_announcement"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="79dp"
                android:hint="编辑公告"
                android:maxLength="100"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#8042475e"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_announcement_num"
                android:layout_width="match_parent"
                android:layout_height="23dp"
                android:text="100"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_submit_announce"
                android:background="@drawable/bg_live_video_professional_match_guest_apply_shape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/dimen_15dp"
                android:text="@string/professional_match_submit_announce"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_cancel_announce"
                android:background="@drawable/bg_live_video_professional_match_guest_apply_shape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/professional_match_cancel_announce"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/img_quit"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-13dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_alignTop="@+id/layout_quit"
        android:layout_alignRight="@+id/layout_quit"/>
</RelativeLayout>
