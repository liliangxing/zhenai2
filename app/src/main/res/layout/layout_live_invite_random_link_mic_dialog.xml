<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_content"
        android:background="@drawable/icon_live_invite_random_link_mic_bg"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_user_header"/>
    <ImageView
        android:id="@+id/img_user_header"
        android:background="@drawable/bg_live_invite_random_linkmic_header_shape"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:src="@drawable/default_circle_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#ffffffff"
        android:gravity="center_vertical"
        android:id="@+id/tv_header_living"
        android:background="@drawable/bg_live_invite_random_linkmic_header_lottie_shape"
        android:layout_width="48dp"
        android:layout_height="14dp"
        android:text="@string/invite_random_link_mic_living"
        android:paddingStart="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_user_header"
        app:layout_constraintEnd_toEndOf="@+id/img_user_header"
        app:layout_constraintStart_toStartOf="@+id/img_user_header"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_living"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_header_living"
        app:layout_constraintStart_toStartOf="@+id/tv_header_living"
        app:layout_constraintTop_toTopOf="@+id/tv_header_living"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/recommend_living_animation.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ff8470f1"
        android:id="@+id/tv_header_invite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_5dp"
        android:text="@string/invite_random_link_mic_title"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_user_header"
        app:layout_constraintStart_toEndOf="@+id/img_user_header"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffb9b9b9"
        android:id="@+id/tv_random_link_hint"
        android:layout_width="51dp"
        android:layout_height="15dp"
        android:text="@string/invite_random_link_mic"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_header_invite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_header_invite"/>
    <View
        android:background="@drawable/bg_live_invite_random_linkmic_hint_shape"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_random_link_hint"
        app:layout_constraintEnd_toStartOf="@+id/tv_random_link_hint"
        app:layout_constraintTop_toTopOf="@+id/tv_random_link_hint"/>
    <View
        android:id="@+id/view_line"
        android:background="#eeeeee"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_header_living"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff666978"
        android:ellipsize="end"
        android:id="@+id/tv_random_link_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/invite_random_link_content"
        android:maxLines="1"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ff8b76f9"
        android:gravity="center"
        android:id="@+id/btn_no"
        android:background="@drawable/bg_live_invite_random_linkmic_not_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="35dp"
        android:text="@string/invite_random_link_no"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_content"
        app:layout_constraintEnd_toStartOf="@+id/btn_yes"
        app:layout_constraintStart_toStartOf="@+id/view_content"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_yes"
        android:background="@drawable/bg_live_invite_random_linkmic_yes_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="35dp"
        android:text="@string/invite_random_link_yes"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_content"
        app:layout_constraintEnd_toEndOf="@+id/view_content"
        app:layout_constraintStart_toEndOf="@+id/btn_no"/>
</androidx.constraintlayout.widget.ConstraintLayout>
