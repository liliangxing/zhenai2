<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_141629_rectangle_t30_shape"
    android:paddingBottom="58dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Switch
        android:id="@+id/switch_link_mic_remind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_custom_thumb_3"
        android:track="@drawable/switch_custom_track_selector_3"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_link_mic_remind_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_link_mic_remind_content"/>
    <Switch
        android:id="@+id/switch_link_mic_remind_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_custom_thumb_3"
        android:track="@drawable/switch_custom_track_selector_3"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_link_mic_remind_comment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_link_mic_remind_comment"/>
    <Switch
        android:id="@+id/switch_new_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/switch_custom_thumb_3"
        android:track="@drawable/switch_custom_track_selector_3"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_new_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_new_message"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/link_mic_remind_setting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:id="@+id/tv_zhen_ai_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/link_mic_remind_zhen_ai_open"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_link_mic_remind_content"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="2dp"
        android:text="@string/link_mic_remind_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_zhen_ai_open"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_link_mic_remind_comment"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/link_mic_remind_comment"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_line2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:id="@+id/tv_zhen_ai_not_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/link_mic_remind_zhen_ai_not_open"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_link_mic_remind_comment"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_new_message"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="2dp"
        android:text="@string/link_mic_remind_new_message"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_zhen_ai_not_open"/>
    <View
        android:id="@+id/tv_title_line2"
        android:background="@color/white_10"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_link_mic_remind_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
