<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffd9a2"
    android:layout_width="match_parent"
    android:layout_height="30dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#a64d12"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/live_list_start_broadcasting_tips"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_start_live"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#876ff1"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/tv_btn_start_live"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/live_list_start_broadcasting"
        app:layout_constraintEnd_toStartOf="@+id/img_close"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/img_close"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/icon_live_video_start_hint_close"
        android:paddingStart="@dimen/dimen_10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
