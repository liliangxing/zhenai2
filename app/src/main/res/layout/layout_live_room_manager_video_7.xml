<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live_common.room_manager.RoomManagerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="25dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:id="@+id/group_live_video_room_manager_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/icon_live_video_room_manager"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"/>
        <com.zhenai.live_common.room_manager.RoomManagerMarqueeView
            android:id="@+id/tv_live_video_room_manager_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            app:marqueeview_isclickalbe_stop="false"
            app:marqueeview_repet_type="repet_continuous"
            app:marqueeview_text_color="@color/white"
            app:marqueeview_text_size="12"
            app:marqueeview_text_speed="2"
            marqueeview_sleep_time="0"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.zhenai.live_common.room_manager.RoomManagerLayout>
