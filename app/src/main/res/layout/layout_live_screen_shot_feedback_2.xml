<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/btn_exit"
        android:background="@drawable/ic_close_v8"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/rank_top_info"
        app:layout_constraintEnd_toEndOf="@+id/rank_top_info"
        app:layout_constraintStart_toEndOf="@+id/rank_top_info"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/rank_top_info"
        android:background="@drawable/bg_link_white_corner_9_bg"
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/bg_dialog_v8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_26273c"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/screen_shot_already"
            app:layout_constraintBottom_toTopOf="@+id/img_screen_shot"
            app:layout_constraintEnd_toEndOf="@+id/rank_top_info"
            app:layout_constraintStart_toStartOf="@+id/rank_top_info"
            app:layout_constraintTop_toTopOf="@+id/rank_top_info"/>
        <ImageView
            android:id="@+id/img_screen_shot"
            android:layout_width="153dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/white_default_image"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_quit"
            app:layout_constraintEnd_toEndOf="@+id/rank_top_info"
            app:layout_constraintStart_toStartOf="@+id/rank_top_info"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/tv_quit"
            android:background="@drawable/rect_767dff_stroke_1_r200"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="24dp"
            android:text="@string/screen_shot_feedback_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rank_top_info"
            app:layout_constraintStart_toStartOf="@+id/rank_top_info"
            app:layout_constraintTop_toBottomOf="@+id/img_screen_shot"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
