<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:bg_colorNormal="#80000000"
        app:bg_radiusLeftTop="@dimen/dp8"
        app:bg_radiusRightBottom="@dimen/dimen_8dp"
        app:bg_scaleType="centerCrop"
        app:bg_shape="round"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_left_time"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:bg_colorNormal="#9942475c"
        app:bg_fillMode="color"
        app:bg_radius="4dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_bg">
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/white"
            android:id="@+id/tv_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp4"/>
        <TextView
            android:textSize="@dimen/dimen_8sp"
            android:textColor="@color/white"
            android:id="@+id/tv_day"
            android:paddingRight="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/day"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_goods_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_bg"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_translucent_white"
        android:gravity="center_vertical"
        android:id="@+id/tv_price_or_status"
        android:paddingBottom="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_goods_name"/>
    <TextView
        android:id="@+id/tv_selected_bg"
        android:background="@drawable/shape_live_send_decoration_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
