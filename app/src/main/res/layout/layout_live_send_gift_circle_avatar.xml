<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dimen_7dp"
    android:paddingEnd="@dimen/dimen_7dp">
    <TextView
        android:id="@+id/tv_bg"
        android:background="@drawable/bg_send_gift_live_circle_avatar"
        android:layout_width="@dimen/dp31"
        android:layout_height="@dimen/dp31"
        android:layout_marginBottom="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/dp27"
        android:layout_height="@dimen/dp27"
        android:layout_marginBottom="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_8sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:paddingTop="@dimen/dp1"
        android:paddingBottom="@dimen/dp1"
        android:layout_width="21dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp21"
        app:bg_colorGradientEnd="@color/color_767dff"
        app:bg_colorGradientStart="@color/color_767dff"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_6dp"
        app:bg_shape="round"
        app:layout_constraintEnd_toEndOf="@+id/iv_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
