<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/rootPrivilegeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/privilegeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp8"
        android:drawableStart="@drawable/icon_buy_guard_dialog_left"
        android:drawableEnd="@drawable/icon_buy_guard_dialog_right"/>
    <GridLayout
        android:id="@+id/privilegeGridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:rowCount="2"
        android:columnCount="4"
        android:layout_marginStart="@dimen/dp7"
        android:layout_marginEnd="@dimen/dp7"/>
</LinearLayout>
