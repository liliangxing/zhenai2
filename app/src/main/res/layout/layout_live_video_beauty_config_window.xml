<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_beauty_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="美颜"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <SeekBar
        android:id="@+id/sb_beauty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="10"
        android:progressDrawable="@drawable/shortvideo_seekbar_progress"
        android:thumb="@drawable/shortvideo_seekbar_thumb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_beauty_label"
        app:layout_constraintEnd_toStartOf="@+id/tv_beauty_value"
        app:layout_constraintStart_toEndOf="@+id/tv_beauty_label"
        app:layout_constraintTop_toTopOf="@+id/tv_beauty_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_beauty_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_beauty_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_beauty_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_face_lift_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="瘦脸"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_beauty_label"/>
    <SeekBar
        android:id="@+id/sb_face_lift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="10"
        android:progressDrawable="@drawable/shortvideo_seekbar_progress"
        android:thumb="@drawable/shortvideo_seekbar_thumb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_face_lift_label"
        app:layout_constraintEnd_toStartOf="@+id/tv_face_lift_value"
        app:layout_constraintStart_toEndOf="@+id/tv_face_lift_label"
        app:layout_constraintTop_toTopOf="@+id/tv_face_lift_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_face_lift_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_face_lift_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_face_lift_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_eye_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="大眼"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_face_lift_label"/>
    <SeekBar
        android:id="@+id/sb_eye"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="10"
        android:progressDrawable="@drawable/shortvideo_seekbar_progress"
        android:thumb="@drawable/shortvideo_seekbar_thumb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_eye_label"
        app:layout_constraintEnd_toStartOf="@+id/tv_eye_value"
        app:layout_constraintStart_toEndOf="@+id/tv_eye_label"
        app:layout_constraintTop_toTopOf="@+id/tv_eye_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_eye_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_eye_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_eye_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_face_shape_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="美型"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_eye_label"/>
    <SeekBar
        android:id="@+id/sb_face_shape"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="8dp"
        android:max="10"
        android:progressDrawable="@drawable/shortvideo_seekbar_progress"
        android:thumb="@drawable/shortvideo_seekbar_thumb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_face_shape_label"
        app:layout_constraintEnd_toStartOf="@+id/tv_face_shape_value"
        app:layout_constraintStart_toEndOf="@+id/tv_face_shape_label"
        app:layout_constraintTop_toTopOf="@+id/tv_face_shape_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_face_shape_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_face_shape_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_face_shape_label"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_face_shape_type_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="脸型"
        app:layout_constraintBottom_toBottomOf="@+id/rg_face_shape_type"
        app:layout_constraintEnd_toStartOf="@+id/rg_face_shape_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rg_face_shape_type"/>
    <RadioGroup
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rg_face_shape_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_face_shape_type_label"
        app:layout_constraintTop_toBottomOf="@+id/tv_face_shape_label">
        <RadioButton
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/rb_face_type_0"
            android:tag="0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="女神"/>
        <RadioButton
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/rb_face_type_1"
            android:tag="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="网红"
            android:layout_marginStart="8dp"/>
        <RadioButton
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/rb_face_type_2"
            android:tag="2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自然"
            android:layout_marginStart="8dp"/>
        <RadioButton
            android:textSize="16sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/rb_face_type_3"
            android:tag="3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认"
            android:layout_marginStart="8dp"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
