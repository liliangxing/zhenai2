<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_video_end_feedback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feedback_for_live_video"/>
    <ImageView
        android:id="@+id/img_live_video_end_feedback_edit_impression"
        android:paddingBottom="10dp"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_white_arrow_right"
        android:paddingStart="10dp"
        android:paddingEnd="2dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/view_live_video_end_feedback_line"
        android:background="@color/white_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_below="@+id/tv_live_video_end_feedback_title"/>
</RelativeLayout>
