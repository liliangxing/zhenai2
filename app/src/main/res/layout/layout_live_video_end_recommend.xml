<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:id="@+id/tv_live_video_end_recommend_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_video_end_recommend_title"/>
    <View
        android:id="@+id/view_live_video_end_recommend_line"
        android:background="@color/white_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_below="@+id/tv_live_video_end_recommend_title"/>
    <com.zhenai.live.widget.EndRecommendUserLayout
        android:id="@+id/view_live_video_end_recommend_users"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/view_live_video_end_recommend_line"/>
</RelativeLayout>
