<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shape_26273c_radius16_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white_90"
        android:id="@+id/tv_live_video_end_recommend_prime_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:text="@string/live_video_end_recommend_prime_title"
        android:layout_marginStart="@dimen/dimen_12dp"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white_60"
        android:id="@+id/tv_live_video_end_recommend_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_video_end_recommend_subtitle"
        android:layout_alignTop="@+id/tv_live_video_end_recommend_prime_title"
        android:layout_alignBottom="@+id/tv_live_video_end_recommend_prime_title"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/tv_live_video_end_recommend_prime_title"/>
    <com.zhenai.live.widget.EndRecommendUserLayoutV8
        android:id="@+id/view_live_video_end_recommend_users"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/dimen_24dp"
        android:layout_below="@+id/tv_live_video_end_recommend_prime_title"
        android:layout_marginStart="@dimen/dimen_12dp"/>
</RelativeLayout>
