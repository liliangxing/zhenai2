<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live_common.gift.widget.GiftBannerWidget xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_live_video_gift_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_live_video_romantic_banner"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="21dp">
        <com.zhenai.business.widget.AvatarListView
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_double"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            app:avatarWidth="25dp"
            app:borderColor="@color/white"
            app:borderWidth="1dp"
            app:centerCross="6dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/marquee_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:ellipsize="marquee"
                android:id="@+id/tv_live_video_gift_banner"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:layout_weight="1"
                android:marqueeRepeatLimit="marquee_forever"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_live_video_gift_banner_enter"
                android:background="@drawable/bg_live_video_romantic_banner_btn"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.zhenai.live_common.gift.widget.GiftBannerWidget>
