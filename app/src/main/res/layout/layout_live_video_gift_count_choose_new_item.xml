<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp10"
    android:paddingTop="@dimen/dimen_7dp"
    android:paddingBottom="@dimen/dimen_7dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dp131">
    <ImageView
        android:id="@+id/iv_gift"
        android:layout_width="@dimen/dp29"
        android:layout_height="@dimen/dp29"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_42475C"
        android:gravity="center"
        android:id="@+id/tv_gift_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp2"
        android:layout_marginStart="@dimen/dp3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_gift"
        app:layout_constraintEnd_toStartOf="@+id/tv_gift_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_gift"
        app:layout_constraintTop_toTopOf="@+id/iv_gift"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:id="@+id/tv_gift_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp2"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/iv_gift"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_gift"/>
</androidx.constraintlayout.widget.ConstraintLayout>
