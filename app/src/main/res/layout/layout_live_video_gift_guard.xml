<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/layout_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="29dp">
        <com.zhenai.live_common.widget.AvatarFrameLayout
            android:id="@+id/guard_left_avatar_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:avatar_height="65dp"
            app:avatar_width="65dp"
            app:setSvgaDimen="true"
            app:svga_height="105dp"
            app:svga_width="105dp"/>
        <com.zhenai.live_common.widget.AvatarFrameLayout
            android:id="@+id/guard_right_avatar_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="88.5dp"
            app:avatar_height="65dp"
            app:avatar_width="65dp"
            app:setSvgaDimen="true"
            app:svga_height="105dp"
            app:svga_width="105dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_center_guard"
            android:background="@drawable/circle_white_shape"
            android:padding="5dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_live_dialog_daemon"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/tv_guard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/tv_guard_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_guard_title"/>
    <Button
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/white"
        android:id="@+id/btn_guard"
        android:background="@drawable/common_long_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_marginStart="@dimen/dimen_40dp"
        android:layout_marginEnd="@dimen/dimen_40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_guard_tip"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_42475e"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_guard"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_guard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_6e6e6e"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_net_error"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:text="@string/loading_data_msg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
