<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/gift_dialog_top"
        android:layout_width="match_parent"
        android:layout_height="64dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/first_discount_ll"
        android:background="#ffffd8a1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="#ffb86b18"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/first_recharge_discount_txt"
            android:drawablePadding="@dimen/dimen_5dp"
            android:drawableEnd="@drawable/yellow_end_arr"
            android:paddingEnd="@dimen/dimen_10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gift_bg"
        android:background="@drawable/bg_hn_match_apply_dialog_shape"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40dp">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"/>
            <com.google.android.material.tabs.TabLayout
                android:layout_gravity="bottom"
                android:id="@+id/tab_layout_indicator"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_2dp"
                android:layout_marginBottom="@dimen/dimen_4dp"
                app:tabIndicatorColor="@color/color_767dff"
                app:tabIndicatorHeight="2dp"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_42475c"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/tv_free_coin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dimen_15dp"
                android:paddingEnd="@dimen/dimen_10dp"/>
        </FrameLayout>
        <View
            android:background="#d8d8d8"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <com.zhenai.business.widget.view_pager.WrapContentHeightViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
