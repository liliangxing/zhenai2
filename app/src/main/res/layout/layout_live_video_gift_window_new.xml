<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/gift_dialog_top"
            android:layout_width="match_parent"
            android:layout_height="64dp"/>
        <FrameLayout
            android:id="@+id/fl_gift_banner"
            android:layout_width="match_parent"
            android:layout_height="92dp">
            <com.zhenai.business.widget.autosrcoll_banner_listview.AutoScrollBanner
                android:id="@+id/gift_global_scroll_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:indicatorBottomMargin="8dp"
                app:indicatorSelected="@drawable/bg_round_80_white"
                app:indicatorSpace="4dp"
                app:indicatorUnSelected="@drawable/bg_round_40_white"/>
            <ImageView
                android:id="@+id/iv_gift_banner"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="8dp"
                android:scaleType="fitCenter"
                android:layout_marginHorizontal="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_gift_tips"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:maxWidth="224dp"
                android:maxLines="1"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="60dp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/gift_bg"
            android:background="@drawable/bg_hn_match_apply_dialog_shape_new"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.live_common.gift.widget.LiveSendGiftReceiverView
                android:id="@+id/v_send_gift_receiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.lib.zaui.tablayout.ZTabLayout
                android:layout_gravity="center"
                android:id="@+id/z_tab_layout"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp40"
                android:layout_marginBottom="3dp"
                android:paddingStart="@dimen/dp6"
                android:paddingEnd="6dp"
                android:layout_marginEnd="@dimen/dp6"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_send_gift_receiver"
                app:zIndicatorEndColor="@color/white"
                app:zIndicatorEqualTitle="true"
                app:zIndicatorHeight="2dp"
                app:zIndicatorMarginBottom="0dp"
                app:zIndicatorScrollScale="false"
                app:zIndicatorStartColor="@color/white"
                app:zIndicatorStyle="line"
                app:zRedDotFixed="false"
                app:zSelectedTextColor="@color/white"
                app:zSelectedTextSize="@dimen/dimen_14sp"
                app:zTabMode="scrollable"
                app:zTabPaddingLeft="@dimen/dp8"
                app:zTabPaddingRight="@dimen/dp8"
                app:zTextBold="text_bold_when_select"
                app:zTitleScaleGradually="true"
                app:zUnSelectedTextColor="@color/color_translucent_white"
                app:zUnSelectedTextSize="@dimen/dimen_14sp"/>
            <View
                android:id="@+id/v_tab_layout_line"
                android:background="@color/color_gift_panel_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/z_tab_layout"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="tv_guard,tv_free_coin"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_translucent_white"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/tv_free_coin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dimen_15dp"
                android:paddingEnd="@dimen/dimen_10dp"
                app:layout_constraintBottom_toBottomOf="@+id/z_tab_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="@+id/z_tab_layout"/>
            <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/tv_guard"
                android:paddingTop="@dimen/dimen_3dp"
                android:paddingBottom="@dimen/dimen_3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp6"
                android:drawableStart="@drawable/live_video_seat_guard"
                android:paddingStart="@dimen/dimen_8dp"
                android:paddingEnd="@dimen/dimen_8dp"
                android:layout_marginEnd="@dimen/dp14"
                app:bg_colorGradientEnd="@color/color_3f_ff6e9b"
                app:bg_colorGradientStart="@color/color_3f_ff6e9b"
                app:bg_fillMode="linearGradient"
                app:bg_radius="@dimen/dimen_13dp"
                app:bg_shape="round"
                app:layout_constraintBottom_toBottomOf="@+id/z_tab_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="@+id/z_tab_layout"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/color_translucent_white"
                android:gravity="center"
                android:id="@+id/tv_loading"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp240"
                android:text="@string/loading_data_msg"
                app:layout_constraintTop_toBottomOf="@+id/v_tab_layout_line"/>
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="246dp"
                android:layout_marginTop="@dimen/dp8"
                app:layout_constraintTop_toBottomOf="@+id/tv_loading"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/color_18171f"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp55"
                app:layout_constraintTop_toBottomOf="@+id/view_pager">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white_50"
                    android:gravity="center"
                    android:id="@+id/tv_coin_num"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="0.00"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/icon_gift_dialog_coin"
                    android:layout_marginStart="15dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_send_gift"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_send_gift"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_recharge"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/wallet_recharge"
                    android:drawableRight="@drawable/ic_white_arrow_right"
                    android:drawablePadding="@dimen/dp8"
                    android:paddingStart="@dimen/dp14"
                    android:paddingEnd="@dimen/dimen_10dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_send_gift"
                    app:layout_constraintStart_toEndOf="@+id/tv_coin_num"
                    app:layout_constraintTop_toTopOf="@+id/tv_send_gift"/>
                <TextView
                    android:textSize="@dimen/dimen_14sp"
                    android:textColor="@color/color_translucent_white"
                    android:gravity="center"
                    android:id="@+id/tv_invite_gift"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="邀请男嘉宾送礼"
                    android:paddingStart="@dimen/dp14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dimen_12sp"
                    android:textColor="@color/color_translucent_white"
                    android:gravity="center"
                    android:id="@+id/tv_decoration_market"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_gift_need_decoration"
                    android:layout_marginEnd="@dimen/dp19"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_send_gift"
                    app:layout_constraintEnd_toStartOf="@+id/tv_send_gift"
                    app:layout_constraintTop_toTopOf="@+id/tv_send_gift"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_gift_count"
                    android:background="@color/color_26_fff"
                    android:paddingRight="@dimen/dp66"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp35"
                    android:layout_marginBottom="@dimen/dp9"
                    android:minWidth="@dimen/dp125"
                    android:layout_marginEnd="@dimen/dp14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/dimen_15sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_gift_count"
                        android:paddingRight="@dimen/dp3"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp35"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"/>
                    <ImageView
                        android:id="@+id/iv_arrow"
                        android:background="@drawable/ic_arrow_up_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/tv_send_gift"
                    android:layout_width="@dimen/dp58"
                    android:layout_height="@dimen/dp35"
                    android:layout_marginBottom="@dimen/dp9"
                    android:text="@string/live_video_send_gift"
                    android:layout_marginEnd="@dimen/dp14"
                    app:bg_colorNormal="@color/color_767dff"
                    app:bg_fillMode="color"
                    app:bg_shape="semicircle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/btn_invite_gift"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp58"
                    android:layout_height="@dimen/dp35"
                    android:layout_marginBottom="@dimen/dp9"
                    android:text="@string/live_video_invite_gift"
                    android:layout_marginEnd="@dimen/dp14"
                    app:bg_colorNormal="@color/color_767dff"
                    app:bg_fillMode="color"
                    app:bg_shape="semicircle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
