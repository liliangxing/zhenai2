<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bg"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginHorizontal="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/bg_dialog_v8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/avatar_bg"
        android:background="@drawable/rect_white_stroke_4_r200"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toTopOf="@+id/bg"/>
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="@string/avatar"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_bg"
        app:layout_constraintEnd_toEndOf="@+id/avatar_bg"
        app:layout_constraintStart_toStartOf="@+id/avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/avatar_bg"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_26273c"
        android:gravity="center_horizontal"
        android:id="@+id/tv_guard_content"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/guide_guard_content_2"
        android:lines="2"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/avatar_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_6c6d75"
        android:id="@+id/tv_guard_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/guide_guard_tip_2"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_guard_content"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_guard"
        android:background="@drawable/rect_767dff_r40"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:text="@string/to_be_daemon"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toStartOf="@+id/bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_guard_desc"/>
    <ImageView
        android:id="@+id/iv_close"
        android:visibility="visible"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_close_v8"
        android:contentDescription="@string/close_dialog"
        app:layout_constraintBottom_toTopOf="@+id/bg"
        app:layout_constraintEnd_toEndOf="@+id/bg"
        app:layout_constraintStart_toEndOf="@+id/bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
