<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dimen_20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bg_colorNormal="@color/white"
        app:bg_radius="@dimen/dimen_10dp"
        app:bg_shape="round">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_lottie"
                android:layout_width="190dp"
                android:layout_height="@dimen/dimen_90dp"
                app:lottie_fileName="animation/live_video_interactive_invited.json"
                app:lottie_imageAssetsFolder="images/live_video_interactive_invited"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_live_video_interactive_inviter"
                android:visibility="invisible"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_marginLeft="@dimen/dimen_4dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_live_video_interactive_self"
                android:visibility="invisible"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_marginRight="@dimen/dimen_4dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_42475c"
            android:id="@+id/tv_live_video_interactive_invitation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="21sp"
            android:textColor="@color/color_ffb541"
            android:id="@+id/tv_live_video_interactive_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginTop="@dimen/dimen_18dp">
            <me.yintaibing.universaldrawable.view.UniversalDrawableButton
                android:textSize="16sp"
                android:textColor="@color/color_ffb541"
                android:gravity="center"
                android:id="@+id/btn_live_video_interactive_refuse"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:text="@string/interactive_refuse"
                app:bg_colorStroke="@color/color_ffb541"
                app:bg_shape="semicircle"
                app:bg_strokeMode="solid"
                app:bg_strokeWidth="2dp"/>
            <me.yintaibing.universaldrawable.view.UniversalDrawableButton
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_live_video_interactive_accept"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:text="@string/interactive_accept"
                app:bg_colorNormal="@color/color_ffb541"
                app:bg_colorPressed="@color/color_ff9420"
                app:bg_shape="semicircle"
                app:bg_stateMode="clickable"/>
        </LinearLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
</FrameLayout>
