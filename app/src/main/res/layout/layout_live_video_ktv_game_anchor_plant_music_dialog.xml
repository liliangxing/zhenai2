<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/bg_live_video_ktv_game_quit_shape"
        android:layout_width="match_parent"
        android:layout_height="224dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/img_hint"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:src="@drawable/icon_live_video_ktv_anchor_first_plant"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff42475c"
            android:gravity="center"
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="@string/ktv_music_anchor_plant_tips"
            android:layout_above="@+id/tv_sure"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="4dp"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sure"
            android:background="@drawable/bg_live_rectangle_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_15dp"
            android:text="好的"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
