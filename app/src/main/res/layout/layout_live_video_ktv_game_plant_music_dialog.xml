<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/bg_live_video_ktv_game_quit_shape"
        android:layout_width="match_parent"
        android:layout_height="267dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/img_hint"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:src="@drawable/icon_live_video_ktv_quit_dialog"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff42475c"
            android:gravity="center"
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:text="@string/ktv_music_plant_tips"
            android:layout_below="@+id/img_hint"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="4dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_tip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="5dp"
            android:layout_above="@+id/layout_btn"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/img_tip"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/bg_live_video_ktv_plant_music_tip_circle_gray"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_bcbcbc"
                android:gravity="center"
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="以后不再提示"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="15dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/color_8570f1"
                android:gravity="center"
                android:id="@+id/tv_no"
                android:background="@drawable/btn_daemon_impression_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_15dp"
                android:layout_marginRight="@dimen/dimen_8dp"
                android:text="再考虑下"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/dimen_16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_sure"
                android:background="@drawable/bg_live_rectangle_purple_corner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_8dp"
                android:layout_marginRight="@dimen/dimen_15dp"
                android:text="好的"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
