<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_lrc_window"
        android:layout_width="match_parent"
        android:layout_height="180dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/layout_live_video_lrc_quit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:src="@drawable/ic_live_video_lrc_quit"
            android:scaleType="center"
            android:layout_alignParentRight="true"
            app:roundImageType="circle"/>
        <View
            android:background="@drawable/bg_live_video_lrc_window_shape"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_alignParentBottom="true"/>
        <com.zhenai.live.interactive.widget.LrcView
            android:id="@+id/lrc_view"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_lrc_download_false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/lrc_download_false"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_game_over"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/game_over"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:background="@drawable/bg_ktv_game_over_again_shape"
                android:layout_width="86dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:text="@string/play_again"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_audience_game_over"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/audience_game_over"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_gravity="right"
        android:id="@+id/view_scroll_indicator"
        android:background="@drawable/bg_live_video_ktv_lrc_indicator_shape"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="13dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/layout_cd"
        android:layout_width="110dp"
        android:layout_height="56dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_view_cd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/live_video_ktv_cd_music.json"
            app:lottie_imageAssetsFolder="images/live_video_ktv_img"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/img_play"
            android:background="@drawable/icon_live_video_ktv_game_cd"
            android:padding="@dimen/dimen_8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
