<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_42475c"
        android:gravity="center"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/music_list_dialog_title"
        android:layout_above="@+id/view_line_tab"/>
    <View
        android:id="@+id/view_line_tab"
        android:background="#ffeeeeee"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/tab_layout_title"/>
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:id="@+id/tab_layout_title"
        android:background="@color/white"
        android:paddingLeft="38dp"
        android:paddingRight="38dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_above="@+id/view_line_view_pager"
        android:paddingHorizontal="38dp"
        app:zIndicatorColorOrientation="left_right"
        app:zIndicatorCornerRadius="1dp"
        app:zIndicatorEndColor="@color/color_8a76f9"
        app:zIndicatorHeight="2dp"
        app:zIndicatorScrollScale="true"
        app:zIndicatorStartColor="@color/color_8a76f9"
        app:zIndicatorWidth="60dp"
        app:zSelectedTextColor="@color/color_8a76f9"
        app:zSelectedTextSize="15sp"
        app:zUnSelectedTextColor="@color/color_42475c"
        app:zUnSelectedTextSize="15sp"/>
    <View
        android:id="@+id/view_line_view_pager"
        android:background="@color/color_f3eeee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@+id/view_pager"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
