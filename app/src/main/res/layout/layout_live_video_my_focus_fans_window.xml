<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/black_40"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="367dp">
        <com.zhenai.lib.zaui.tablayout.ZTabLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:zIndicatorCornerRadius="2dp"
            app:zIndicatorEndColor="@color/color_b677f1"
            app:zIndicatorEqualTitle="true"
            app:zIndicatorHeight="3dp"
            app:zIndicatorScrollScale="true"
            app:zIndicatorStartColor="@color/color_8070f1"
            app:zRedDotFixed="false"
            app:zSelectedTextColor="@color/color_42475c"
            app:zSelectedTextSize="15sp"
            app:zTextBold="text_bold_none"
            app:zUnSelectedTextColor="@color/color_42475c"
            app:zUnSelectedTextSize="15sp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_divide"
            android:background="@color/color_e4e7ea"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <View
        android:id="@+id/view_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
