<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/color_f3f5f7"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="95dp">
    <View
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/zhenai_teacher_avatar"
        android:layout_width="90dp"
        android:layout_height="75dp"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/zhenai_teacher_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_toRightOf="@+id/zhenai_teacher_avatar"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_bcbcbc"
        android:id="@+id/zhenai_teacher_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_toRightOf="@+id/zhenai_teacher_avatar"
        android:layout_below="@+id/zhenai_teacher_title"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_96989e"
        android:gravity="center"
        android:id="@+id/followed"
        android:background="@drawable/bg_zhenai_class_stroke"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="@dimen/dimen_20dp"
        android:text="已预约"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/follow_teacher"
        android:background="@drawable/zalive_class_bg_unfollow"
        android:paddingLeft="@dimen/dimen_18dp"
        android:paddingRight="@dimen/dimen_18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_20dp"
        android:text="预约"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
