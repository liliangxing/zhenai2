<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/rect_ffffff_transparent_top_r16"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/group_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="5.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/group_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:layout_marginStart="5.5dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/center"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/school_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/group_1"
        app:layout_constraintTop_toTopOf="@+id/group_1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/school_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/school_icon"
        app:layout_constraintStart_toEndOf="@+id/school_icon"
        app:layout_constraintTop_toTopOf="@+id/school_icon"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/school_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/school_icon"
        app:layout_constraintTop_toBottomOf="@+id/school_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/school_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@+id/school_icon"
        app:layout_constraintTop_toBottomOf="@+id/school_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/school_btn"
        android:background="@drawable/rect_767dff_r40"
        android:layout_width="63dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/school_icon"
        app:layout_constraintTop_toBottomOf="@+id/school_time"/>
    <androidx.legacy.widget.Space
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/group_2"
        app:layout_constraintStart_toEndOf="@+id/group_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/emotion_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/group_2"
        app:layout_constraintTop_toTopOf="@+id/group_2"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/emotion_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/emotion_icon"
        app:layout_constraintStart_toEndOf="@+id/emotion_icon"
        app:layout_constraintTop_toTopOf="@+id/emotion_icon"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/emotion_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/emotion_icon"
        app:layout_constraintTop_toBottomOf="@+id/emotion_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_191c32"
        android:id="@+id/emotion_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@+id/emotion_icon"
        app:layout_constraintTop_toBottomOf="@+id/emotion_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/emotion_btn"
        android:background="@drawable/rect_767dff_r40"
        android:layout_width="63dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/emotion_icon"
        app:layout_constraintTop_toBottomOf="@+id/emotion_time"/>
</androidx.constraintlayout.widget.ConstraintLayout>
