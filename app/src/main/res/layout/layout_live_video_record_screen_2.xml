<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_live_video_record_screen_tip"
        android:background="@drawable/record_screen_tips"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="118dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_live_video_record_screen_bar"
        android:background="@drawable/bg_141629_rectangle_t30_shape"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="114dp">
        <FrameLayout
            android:id="@+id/layout_live_video_record_screen_btn"
            android:background="@drawable/record_screen_start"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:id="@+id/tv_live_video_record_screen_time_dot"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_5dp"
            android:layout_height="@dimen/dimen_5dp"
            android:layout_marginStart="15dp"
            app:bg_colorNormal="@color/color_fd8c7e"
            app:bg_shape="circle"
            app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_record_screen_btn"
            app:layout_constraintStart_toEndOf="@+id/layout_live_video_record_screen_btn"
            app:layout_constraintTop_toTopOf="@+id/layout_live_video_record_screen_btn"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_live_video_record_screen_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_record_screen_btn"
            app:layout_constraintStart_toEndOf="@+id/tv_live_video_record_screen_time_dot"
            app:layout_constraintTop_toTopOf="@+id/layout_live_video_record_screen_btn"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_live_video_record_screen_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quit"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_live_video_record_screen_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_live_video_record_screen_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
