<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/layout_content"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_red_envelope_bg"
        android:layout_width="320dp"
        android:layout_height="420dp"
        android:src="@drawable/live_red_envelope_normal_bg"
        android:scaleType="centerInside"
        android:layout_centerHorizontal="true"
        app:radius_left_down="10dp"
        app:radius_left_up="10dp"
        app:radius_right_down="10dp"
        app:radius_right_up="10dp"
        app:roundImageType="round"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableFrameLayout
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        app:bg_colorNormal="#f9cf76"
        app:bg_fillMode="color"
        app:bg_shape="circle">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/iv_avatar"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/default_circle_avatar"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableFrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="115dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="159dp"
        android:layout_centerHorizontal="true"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="16sp"
        android:textColor="@color/color_f75f79"
        android:gravity="center"
        android:id="@+id/tv_add_sub"
        android:paddingLeft="25dp"
        android:paddingTop="5dp"
        android:paddingRight="25dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:text="+ 关注"
        android:layout_centerHorizontal="true"
        app:bg_colorNormal="@color/color_ffe278"
        app:bg_shape="semicircle"/>
    <ImageView
        android:id="@+id/iv_rob"
        android:visibility="visible"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:src="@drawable/icon_rob_0"
        android:scaleType="centerInside"
        android:layout_centerHorizontal="true"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/envelop_gray_bg"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_marginTop="210dp"
        android:src="@drawable/bg_6677_alpha_black"
        android:layout_centerHorizontal="true"/>
    <com.zhenai.live_common.red_envelope.AvatarProgressView
        android:id="@+id/progress_bar_envelop"
        android:layout_width="94dp"
        android:layout_height="94dp"
        android:layout_marginTop="210dp"
        android:layout_centerHorizontal="true"
        app:progressView_direction="anticlockwise"
        app:progressView_progressStrokeCap="round"
        app:progressView_ringBgColor="@color/transparent"
        app:progressView_ringDimen="6dp"
        app:progressView_ringEndColor="@color/color_ffe4a8"
        app:progressView_ringStartColor="@color/color_f9ba71"/>
    <com.zhenai.live_common.red_envelope.CountDownMsTextView
        android:textSize="34sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/count_down_tv_envelop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="230dp"
        android:layout_centerHorizontal="true"
        app:textAllCaps="false"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/white"
        android:id="@+id/tv_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_5dp"
        android:text="s"
        android:layout_toRightOf="@+id/count_down_tv_envelop"
        android:layout_alignBottom="@+id/count_down_tv_envelop"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_rob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rob"
        android:layout_below="@+id/count_down_tv_envelop"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_detail"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="查看领取详情 &gt;"
        android:layout_alignBottom="@+id/iv_red_envelope_bg"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
