<?xml version="1.0" encoding="utf-8"?>
<com.zhenai.live.widget.ZhenxinValueLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_live_video_zhenxin_value_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon_zhenxin_value"
            android:visibility="gone"
            android:layout_width="@dimen/dp12"
            android:layout_height="@dimen/dp12"
            android:src="@drawable/icon_live_zhenxin_left"
            android:layout_marginEnd="@dimen/dp4"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_zhenxin_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="珍心值"/>
        <com.zhenai.common.widget.RollingNumberView
            android:layout_gravity="center_vertical"
            android:id="@+id/rolling_number_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_2dp"
            app:rollingNumber_rollingUnit="2dp"
            app:rollingNumber_textColor="@color/white"
            app:rollingNumber_textSize="11sp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_zhenxin_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icon_arrow_right_2"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</com.zhenai.live.widget.ZhenxinValueLayout>
