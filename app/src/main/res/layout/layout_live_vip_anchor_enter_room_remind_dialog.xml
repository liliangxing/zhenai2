<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="wrap_content"
        android:layout_height="160dp"
        app:bg_colorNormal="@color/white"
        app:bg_radius="4dp"
        app:bg_shape="round">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff42475c"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_40dp"
            android:text="确认进入该直播间吗？\10进入后会自动上麦"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_8b76f9"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/live_video_apply_bg"
                android:layout_width="125dp"
                android:layout_height="44dp"
                android:text="取 消"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/bg_ff8570f1_rectangle_r6_shape"
                android:layout_width="125dp"
                android:layout_height="44dp"
                android:layout_marginLeft="15dp"
                android:text="确 认"/>
        </LinearLayout>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
</FrameLayout>
