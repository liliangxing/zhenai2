<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="top|right"
        android:id="@+id/layout_operate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="172dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_operate"
            android:background="@drawable/live_voice_missile_random_mic_bg"
            android:paddingLeft="9dp"
            android:paddingTop="7dp"
            android:paddingRight="9dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-2dp"
            android:text="@string/random_mic"
            android:drawableLeft="@drawable/live_video_random_random"
            android:drawablePadding="5.5dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/layout_matching"
            android:background="@drawable/live_voice_circle_bg"
            android:visibility="gone"
            android:layout_width="71dp"
            android:layout_height="71dp"
            android:layout_marginTop="90dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_matching"
                android:background="@drawable/live_voice_random_search_bg"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_voice_random_search"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <com.opensource.svgaplayer.SVGAImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/layout_matching_svga"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/dp22"
            app:antiAlias="true"
            app:autoPlay="true"
            app:loopCount="-1"
            app:source="live_v8_voice_random_link_mir.svga"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_matching"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/matching_one"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/layout_cancel_match"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp16">
            <TextView
                android:textSize="12sp"
                android:textColor="#b3ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_cancel_match"
                android:background="@drawable/live_video_missile_bg_black_voice_night"
                android:paddingLeft="17dp"
                android:paddingTop="7dp"
                android:paddingRight="17dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_matching"/>
        </FrameLayout>
    </LinearLayout>
</merge>
