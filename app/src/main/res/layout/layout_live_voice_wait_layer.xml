<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_wait_mir"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/layout_wait"
        android:background="@drawable/live_voice_circle_bg"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="92.5dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_voice_apply"
            android:scaleType="centerInside"/>
        <com.opensource.svgaplayer.SVGAImageView
            android:layout_gravity="center"
            android:id="@+id/wait_svga"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:antiAlias="true"
            app:autoPlay="true"
            app:loopCount="3"
            app:source="live_v8_invite_link_mir.svga"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="#cdffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_wait_tip"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="182dp"
        android:text="@string/apply_mic_free_2"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_ex_layout_voice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="92.5dp">
        <FrameLayout
            android:id="@+id/layout_self_avatar_voice"
            android:background="@drawable/circle_white_shape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_self_avatar_voice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="1dp"
                android:src="@drawable/default_circle_avatar"
                android:contentDescription="@string/avatar"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="“"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_self_tips_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="gggggggggggggaaaaaaaaagggggggggggggggggggggggggggggggg"
                android:lines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="”"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_self_apply_voice"
            android:background="@drawable/rect_stroke_white_w1_r20"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:text="@string/apply_mic_free_2"/>
    </LinearLayout>
    <com.zhenai.live.widget.AvatarsLineView
        android:layout_gravity="center_horizontal"
        android:id="@+id/alv_apply_list"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="212dp"/>
</merge>
