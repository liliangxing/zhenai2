<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="end|bottom"
        android:id="@+id/advice_shrink_view"
        android:background="@drawable/bg_market_advice_shrink_tips_shape"
        android:paddingTop="7.5dp"
        android:paddingBottom="7.5dp"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:text="@string/your_advice"
        android:lineSpacingMultiplier="0.92"/>
    <FrameLayout
        android:id="@+id/spread_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/market_text_view"
            android:background="@drawable/bg_market_advice_tips_shape"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/market_advice_tips"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/close_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_market_advice_close"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_market_advice_go"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
</FrameLayout>
