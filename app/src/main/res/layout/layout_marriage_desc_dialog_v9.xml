<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_marriage_desc_dialog"
    android:tag="layout/layout_marriage_desc_dialog_v9_0"
    android:paddingTop="@dimen/dp8"
    android:paddingBottom="@dimen/dimen_12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="@color/color_11111A"
        android:ellipsize="end"
        android:id="@+id/marriage_desc_title"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_919299"
        android:id="@+id/marriage_desc_content"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:lineSpacingExtra="@dimen/dp5"/>
</LinearLayout>
