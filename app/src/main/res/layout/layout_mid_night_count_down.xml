<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_count_down"
        android:background="@drawable/bg_count_down"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingRight="@dimen/dimen_6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dimen_6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svga_player"
        android:layout_width="84dp"
        android:layout_height="76dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:scaleType="fitCenter"
        app:antiAlias="true"
        app:autoPlay="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_count_down"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_rank"
        android:background="@drawable/bg_rank"
        android:paddingLeft="@dimen/dimen_9dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_9dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_2dp"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dimen_9dp"
        android:paddingVertical="@dimen/dimen_1dp"
        app:layout_constraintBottom_toBottomOf="@+id/svga_player"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
