<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:background="@color/white"
    android:paddingTop="80dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/load_fail_img_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_empty_v8_paper"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/load_fail_tips_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/moments_empty_follow"
        android:lineSpacingExtra="3dp"/>
    <Button
        android:enabled="true"
        android:layout_gravity="center_horizontal"
        android:id="@+id/moments_watch_more_hot"
        android:background="@drawable/common_long_btn_selector_blue_8"
        android:layout_width="@dimen/dp231"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_24dp"
        android:text="@string/moments_watch_more_hot"
        android:layout_marginVertical="@dimen/dimen_24dp"
        style="@style/common_long_btn_style_8.0_no_shadow"/>
</LinearLayout>
