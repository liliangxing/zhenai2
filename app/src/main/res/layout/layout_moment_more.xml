<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:paddingBottom="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:bg_colorNormal="@color/color_f7f8ff"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp15"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/fl_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RadioRoundImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp135"
        android:src="@drawable/bg_moment_detail_more"
        android:scaleType="fitStart"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_down="@dimen/dp15"
        app:radius_left_up="@dimen/dp15"
        app:radius_right_down="@dimen/dp15"
        app:radius_right_up="@dimen/dp15"
        app:roundImageType="round"/>
    <ImageView
        android:id="@+id/iv_go_more"
        android:background="@drawable/ic_moment_detail_arrow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp15"
        app:layout_constraintBottom_toBottomOf="@+id/tv_moment_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_moment_tips"/>
    <TextView
        android:textColor="@color/color_26273b"
        android:id="@+id/tv_moment_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp19"
        android:text="他的更多动态"
        android:drawablePadding="@dimen/dp8"
        android:drawableStart="@drawable/ic_moments_detail_more"
        android:layout_marginStart="@dimen/dp15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:paddingBottom="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:layout_marginStart="@dimen/dp13"
        android:layout_marginEnd="@dimen/dp13"
        app:layout_constraintTop_toBottomOf="@+id/tv_moment_tips"/>
</merge>
