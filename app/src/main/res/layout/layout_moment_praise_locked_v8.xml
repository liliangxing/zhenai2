<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_lock_view"
    android:background="@drawable/other_moment_praise_locked_v8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_767dff"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp60"
        android:text="@string/unlock_and_view_praise"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/moment_comment_locked_icon_v8"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_open_member"
        android:layout_width="@dimen/dp222"
        android:layout_height="@dimen/dp42"
        android:layout_marginTop="@dimen/dimen_15sp"
        android:text="@string/open_member"
        app:bg_colorNormal="@color/color_767dff"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dp26"
        app:bg_shape="round"/>
</LinearLayout>
