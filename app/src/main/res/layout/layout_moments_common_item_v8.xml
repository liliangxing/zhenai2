<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@color/white"
    android:paddingLeft="12dp"
    android:paddingTop="24dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/left_avatar_view"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/default_circle_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/right_avatar_view"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/default_circle_avatar"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintStart_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <View
            android:id="@+id/online_status"
            android:background="@drawable/online_bg_yellow"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            app:layout_constraintEnd_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <ImageView
            android:id="@+id/lover_binding"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/lover_binding"
            android:layout_marginStart="33dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintStart_toStartOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <ImageView
            android:id="@+id/in_love_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:src="@drawable/in_love_icon_v8"
            app:layout_constraintEnd_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <com.zhenai.moments.widget.MomentLivingView
            android:id="@+id/lottie_living"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"
            app:lottie_autoPlay="false"
            app:lottie_fileName="animation/zhibo.json"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_follow"
            android:background="@drawable/bg_btn_767dff_shape"
            android:layout_width="@dimen/dp58"
            android:layout_height="@dimen/dp31"
            android:text="@string/follow"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#767dff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_chat"
            android:background="@drawable/moment_chat_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp58"
            android:layout_height="@dimen/dp31"
            android:text="私聊"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_item_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="68dp"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="nowrap"
            app:layout_constraintBottom_toTopOf="@+id/tv_base_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/right_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#26273b"
                android:ellipsize="end"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_flexShrink="1"/>
            <com.zhenai.business.widget.FlagLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/flag_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#aeafb3"
            android:id="@+id/tv_base_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="3dp"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="68dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/right_avatar_view"
            app:layout_constraintTop_toBottomOf="@+id/layout_item_nickname"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.zhenai.moments.widget.moment.MomentSubLayoutV8
        android:id="@+id/sub_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="#0d26273b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
</LinearLayout>
