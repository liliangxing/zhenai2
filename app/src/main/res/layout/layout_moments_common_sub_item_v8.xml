<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="right"
        android:id="@+id/operation_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="#ffff5a31"
            android:gravity="center"
            android:id="@+id/publish_state"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resend"
            android:drawablePadding="5dp"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/moment_resend_icon"
            android:paddingStart="@dimen/dimen_12dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/publish_progress_image"
            android:visibility="visible"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/publish_state"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.business.widget.progress.CircleProgressBar
            android:id="@+id/publish_progress_video"
            android:visibility="visible"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:circleColor="#ffe0e0e0"
            app:circleProgressColor="#ff8b8b8c"
            app:circleWidth="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/publish_state"
            app:layout_constraintTop_toTopOf="parent"
            app:max="100"
            app:shapeType="STROKE"
            app:textIsDisplayable="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#aeafb3"
        android:gravity="center"
        android:id="@+id/tv_deleted_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="179dp"
        android:text="@string/moment_is_deleted_tips"/>
    <com.zhenai.business.moments.widget.MomentLabelLayout
        android:id="@+id/layout_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:flexWrap="nowrap"
        app:new_moment_style="true"/>
    <com.zhenai.common.widget.ReadMoreTextView
        android:textSize="@dimen/dimen_15sp"
        android:id="@+id/read_more_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:lineSpacingExtra="2dp"
        app:showMaxLine="3"/>
    <FrameLayout
        android:id="@+id/layout_middle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_hot_topic"
            android:background="@drawable/bg_moment_location_shape"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingStart="10dp"
            android:paddingEnd="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_6C6D75"
                android:ellipsize="end"
                android:id="@+id/hot_topic_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热门推荐"
                android:lines="1"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_location"
            android:background="@drawable/bg_moment_location_shape"
            android:paddingTop="@dimen/dp5"
            android:paddingBottom="@dimen/dp5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dimen_10dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_6C6D75"
                android:ellipsize="end"
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/layout_operate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_aeafb3"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff5974ac"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:text="@string/delete"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintStart_toEndOf="@+id/tv_time"
            app:layout_constraintTop_toTopOf="@+id/tv_time"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_comment_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_time">
            <ImageView
                android:id="@+id/img_comment"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:src="@drawable/momeng_comment_ic_v8"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#aeafb3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/layout_praise_icon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp36"
            android:layout_marginEnd="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_comment_icon"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lav_praise"
                android:layout_width="@dimen/dp36"
                android:layout_height="@dimen/dp36"
                android:src="@drawable/moment_ic_praise_v8"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#aeafb3"
                android:id="@+id/tv_praise_num"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/layout_praise_icon"
                app:layout_constraintStart_toStartOf="@+id/layout_praise_icon"
                app:layout_constraintTop_toTopOf="@+id/layout_praise_icon"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/comment_after_praised"
        android:background="@drawable/bg_f2f4f5_rectangle_r22_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="@dimen/dp10">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/momeng_comment_ic_grey_v8"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaeafb3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moments_chat_and_meet"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
