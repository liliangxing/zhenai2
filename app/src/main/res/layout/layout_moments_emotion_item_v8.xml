<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@color/white"
    android:paddingLeft="20dp"
    android:paddingTop="24dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/left_avatar_view"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/default_circle_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_follow"
            android:background="@drawable/bg_btn_767dff_shape"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:text="@string/follow"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#26273b"
            android:ellipsize="end"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="128dp"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_base_info"
            app:layout_constraintStart_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toTopOf="@+id/left_avatar_view"/>
        <com.zhenai.business.widget.FlagLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/flag_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
            app:layout_constraintEnd_toStartOf="@+id/tv_follow"
            app:layout_constraintStart_toEndOf="@+id/tv_nickname"
            app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#aeafb3"
            android:ellipsize="end"
            android:id="@+id/tv_base_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="3dp"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="68dp"
            app:layout_constraintBottom_toBottomOf="@+id/left_avatar_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/left_avatar_view"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475c"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        android:lineSpacingExtra="6dp"/>
    <FrameLayout
        android:id="@+id/layout_middle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_location"
        android:background="@drawable/bg_moment_location_shape"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="@dimen/dimen_10dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_6C6D75"
            android:ellipsize="end"
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_operate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_aeafb3"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff5974ac"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:text="@string/delete"
            android:layout_centerVertical="true"
            android:layout_marginStart="23dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintStart_toEndOf="@+id/tv_time"
            app:layout_constraintTop_toTopOf="@+id/tv_time"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_comment_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_time">
            <ImageView
                android:id="@+id/img_comment"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:src="@drawable/momeng_comment_ic_v8"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#aeafb3"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_praise_icon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp38"
            android:layout_marginEnd="@dimen/dp15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_comment_icon"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lav_praise"
                android:layout_width="@dimen/dp38"
                android:layout_height="@dimen/dp38"
                android:src="@drawable/moment_ic_praise_v8"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#aeafb3"
                android:id="@+id/tv_praise_num"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/layout_praise_icon"
                app:layout_constraintStart_toStartOf="@+id/layout_praise_icon"
                app:layout_constraintTop_toTopOf="@+id/layout_praise_icon"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/comment_after_praised"
        android:background="@drawable/bg_f2f4f5_rectangle_r22_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/momeng_comment_ic_grey_v8"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffaeafb3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moments_chat_and_meet"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View
        android:background="#0d26273b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"/>
</LinearLayout>
