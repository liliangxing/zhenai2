<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/layout_empty"
    android:background="@color/white"
    android:paddingBottom="@dimen/dimen_15dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:id="@+id/empty_tips"
        android:layout_marginTop="28dp"
        android:text="@string/moments_follow_list_empty_tips"
        style="@style/DefaultPageTextStyle"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_mass_layer_multi_dash_line"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:layerType="software"
            android:layout_marginStart="40dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#b1b1b1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/you_may_like"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_mass_layer_multi_dash_line"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:layerType="software"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_empty_follow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_batch_follow"
        android:background="@drawable/btn_start_group"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/follow"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
