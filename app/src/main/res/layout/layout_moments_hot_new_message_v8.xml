<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_item"
    android:background="@color/white"
    android:paddingTop="@dimen/moment_layout_new_message_padding_bottom_normal_v8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_new_message"
        android:background="@drawable/bg_moments_hot_new_message_v8"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/img_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/default_circle_avatar"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#767dff"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:drawableEnd="@drawable/ic_moment_new_message"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="11dp"/>
    </LinearLayout>
    <View
        android:background="#0d26273b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"/>
</LinearLayout>
