<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rectangle_ffffff_radius_16"
    android:layout_width="152dp"
    android:layout_height="56dp">
    <com.zhenai.common.widget.RoundImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/topic_entrance_emotion_bg"
        android:scaleType="fitXY"
        app:borderRadius="@dimen/dimen_16dp"
        app:roundImageType="round"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="14sp"
        android:textColor="#26273b"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_topic_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_topic_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#aeafb3"
        android:ellipsize="end"
        android:id="@+id/tv_topic_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_below="@+id/tv_topic_title"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_topic_title"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
