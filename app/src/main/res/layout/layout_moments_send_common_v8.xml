<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <Button
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/btn_send"
        android:background="@drawable/bg_rectangle_aeb1b6_40r_shape"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="32dp"
        android:layout_marginBottom="6dp"
        android:text="@string/send"
        android:layout_alignBottom="@+id/comment_after_praised"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/img_emoji_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_input_emoji_v8"
        android:layout_alignBottom="@+id/comment_after_praised"
        android:layout_marginStart="8dp"
        android:layout_toStartOf="@+id/btn_send"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/comment_after_praised"
        android:background="@drawable/bg_rectangle_ffffff_25r_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@+id/img_emoji_icon">
        <ImageView
            android:id="@+id/moment_ic_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/momeng_comment_ic_grey_v8"/>
        <EditText
            android:textSize="14sp"
            android:textColor="#26273b"
            android:textColorHint="#aeafb3"
            android:id="@+id/edt_input"
            android:background="@null"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="5"
            android:maxLength="100"
            android:textCursorDrawable="@drawable/editext_cursor_shape_v2"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</merge>
