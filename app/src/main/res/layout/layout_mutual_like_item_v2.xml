<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="5dp"
    android:paddingEnd="@dimen/dimen_5dp">
    <ImageView
        android:id="@+id/img_bg"
        android:background="@drawable/bg_mutual_like_avatar_v2"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_header"
        android:background="@drawable/bg_cricle_ffffff"
        android:padding="2dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/default_circle_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_view_like"
        android:visibility="invisible"
        android:layout_width="51dp"
        android:layout_height="30dp"
        android:layout_marginTop="51dp"
        app:layout_constraintEnd_toEndOf="@+id/img_bg"
        app:layout_constraintStart_toStartOf="@+id/img_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="animation/mutual_like_v2.json"
        app:lottie_imageAssetsFolder="images/mutual_like_v2_img"
        app:lottie_loop="false"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/layout_living"
        android:background="@drawable/bg_ff7599_rectangle_10_radius"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="15dp"
        android:layout_marginTop="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_bg">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/living"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/iv_living"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_living"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/message_living_play_white.json"
            app:lottie_loop="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
