<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_15dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="#1affffff"
        app:cardCornerRadius="8dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_msg_bubble"
            android:paddingTop="@dimen/dimen_15dp"
            android:paddingBottom="@dimen/dimen_15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dimen_15dp">
            <ImageView
                android:id="@+id/avatar_bg"
                android:background="@drawable/rect_white_r8"
                android:layout_width="93dp"
                android:layout_height="93dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.zhenai.common.widget.RoundCornerImageView
                android:id="@+id/iv_avatar"
                android:layout_width="89dp"
                android:layout_height="89dp"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_bg"
                app:layout_constraintEnd_toEndOf="@+id/avatar_bg"
                app:layout_constraintStart_toStartOf="@+id/avatar_bg"
                app:layout_constraintTop_toTopOf="@+id/avatar_bg"
                app:radius="8dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_767dff"
                android:ellipsize="end"
                android:id="@+id/title_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/titleTips"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toTopOf="@+id/avatar_bg"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_42475e"
                android:id="@+id/titleTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/title_content"
                app:layout_constraintTop_toTopOf="@+id/title_content"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_6c6d75"
                android:ellipsize="end"
                android:id="@+id/tv_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="缘分不等人，赶紧去回复对方吧"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                app:layout_constraintTop_toBottomOf="@+id/title_content"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginTop="0dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="start|bottom"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/avatar_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/avatar_bg">
                <FrameLayout
                    android:id="@+id/photos_group"
                    android:visibility="gone"
                    android:layout_width="92dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/photos_list"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn"
                    android:background="@drawable/rect_767dff_r40"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="去回复"
                    android:layout_marginStart="8dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</merge>
