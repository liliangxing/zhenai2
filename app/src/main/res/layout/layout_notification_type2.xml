<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification2_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/notification2_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_alignBottom="@+id/notification2_content"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/notification2_fist_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"/>
    <TextView
        android:id="@+id/notification2_title"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/notification2_fist_icon"
        style="@style/TextAppearance.Compat.Notification.Title"/>
    <ImageView
        android:id="@+id/notification2_info_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_below="@+id/notification2_title"
        android:layout_marginEnd="12dp"
        android:layout_alignStart="@+id/notification2_title"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/notification2_content"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_below="@+id/notification2_info_icon"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@+id/notification2_fist_icon"
        android:layout_alignParentEnd="true"
        style="@style/TextAppearance.Compat.Notification.Info"/>
</RelativeLayout>
