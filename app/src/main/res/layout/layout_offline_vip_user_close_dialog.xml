<?xml version="1.0" encoding="utf-8"?>
<me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/content_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginStart="13dp"
    android:layout_marginEnd="13dp"
    app:bg_colorNormal="@color/white"
    app:bg_radius="9dp"
    app:bg_shape="round">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="39dp"
        android:text="@string/dialog_offline_vip_user_close_title"
        android:layout_marginStart="5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_8b76f9"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/live_video_apply_bg"
            android:layout_width="125dp"
            android:layout_height="44dp"
            android:text="@string/cancel"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_sure"
            android:background="@drawable/bg_live_rectangle_purple_corner"
            android:layout_width="125dp"
            android:layout_height="44dp"
            android:text="@string/confirm"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
</me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
