<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_privilege_icon_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/save_marriage_intro_icon_top_line"
        android:background="#fff2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#26273b"
        android:gravity="start"
        android:id="@+id/save_marriage_icon_title"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/save_marriage_intro_icon_top_line"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:id="@+id/tv_vip_safe_tips"
        android:paddingTop="10dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/save_marriage_icon_title"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
</RelativeLayout>
