<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatarBackground"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:layout_marginStart="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/zhenxinTabLayout"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/dimen_48dp"
        android:layout_height="@dimen/dimen_48dp"
        android:src="@drawable/default_circle_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/avatarBackground"
        app:layout_constraintEnd_toEndOf="@+id/avatarBackground"
        app:layout_constraintStart_toStartOf="@+id/avatarBackground"
        app:layout_constraintTop_toTopOf="@+id/avatarBackground"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:id="@+id/nickName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_13dp"
        app:layout_constraintStart_toEndOf="@+id/avatarBackground"
        app:layout_constraintTop_toTopOf="@+id/avatarBackground"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:id="@+id/zhenxinMemberDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/nickName"
        app:layout_constraintTop_toBottomOf="@+id/nickName"/>
    <TextView
        android:textSize="@dimen/dimen_11sp"
        android:id="@+id/superVipDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/nickName"
        app:layout_constraintTop_toBottomOf="@+id/zhenxinMemberDate"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/zhenxinTabLayout"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.528">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_5dp">
            <ImageView
                android:id="@+id/zhenxinTabIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/zhenxinTabIcon"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/dimen_13sp"
                    android:gravity="center"
                    android:id="@+id/zhenxinTabTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/zhenxin_member"/>
                <TextView
                    android:textSize="10sp"
                    android:gravity="center"
                    android:id="@+id/zhenxinTabSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="3dp"
                    android:text="@string/pay_mail_activity_v2_zhenxin_member_subtitle"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/superVipTabLayout"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.528">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/superVipTabIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp">
            <TextView
                android:textSize="@dimen/dimen_13sp"
                android:gravity="center"
                android:id="@+id/superVipTabTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/super_vip"/>
            <TextView
                android:textSize="10sp"
                android:gravity="center"
                android:id="@+id/superVipTabSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="3dp"
                android:text="@string/pay_mail_activity_v2_super_vip_subtitle"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
