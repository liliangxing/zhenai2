<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_privilege_icon_list"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/privilege_icon_top_line"
        android:background="#f2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ff42475c"
        android:gravity="start"
        android:id="@+id/super_vip_privilege_icon_title"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/privilege_icon_top_line"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff1cf9d"
        android:gravity="center"
        android:id="@+id/tv_privilege_icon_save_tips_mask"
        android:background="@drawable/icon_super_vip_sale_logo"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/super_vip_privilege_icon_title"
        android:paddingStart="13dp"
        android:paddingEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_privilege_icon"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/super_vip_privilege_icon_title"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"/>
</RelativeLayout>
