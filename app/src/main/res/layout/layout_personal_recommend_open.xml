<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_fddfb5"
    android:paddingTop="@dimen/dp8"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_e39a4d"
        android:ellipsize="end"
        android:id="@+id/open_recommend_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="你已关闭个性化推荐，如需优化推荐结果可点此修改"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/open_recommend_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/open_recommend_button"
        android:background="@drawable/personal_recommend_setting_v8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
