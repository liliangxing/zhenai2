<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_place_scroll_select_picker_0"
    android:background="@drawable/bg_rectangle_ffffff_30r_top_shape"
    android:layout_width="match_parent"
    android:layout_height="428dp">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:layout_marginBottom="@dimen/dimen_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_6C6D75"
        android:id="@+id/title_tip"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_767dff"
        android:tag="binding_3"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/complete"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.zhenai.login.login_intercept_guide.widget.No3dChoicePickerView
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/wheelView"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/dimen_13dp"
        app:layout_constraintBottom_toTopOf="@+id/sure_button"
        app:layout_constraintTop_toBottomOf="@+id/title_tip"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginBottom="26dp"/>
    <Button
        android:enabled="true"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sure_button"
        android:tag="binding_5"
        android:background="@drawable/common_long_btn_selector_blue_8"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginLeft="@dimen/dimen_24dp"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginRight="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_32dp"
        android:text="@string/sure"
        android:layout_marginHorizontal="@dimen/dimen_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/common_long_btn_style_8.0_no_shadow"/>
    <com.zhenai.search.widget.SecondSelectView
        android:id="@+id/secondSelectView"
        android:tag="binding_6"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tip"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
