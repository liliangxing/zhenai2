<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.BoldTextView
        android:id="@+id/tv_title_detail_info"
        android:text="@string/personality_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/recommendProfile9TitleTextViewStyle"/>
    <com.zhenai.business.widget.label_layout.LabelLayout
        android:id="@+id/label_layout_personality_labels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:auto_select_effect="false"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_detail_info"/>
</merge>
