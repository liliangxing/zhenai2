<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:background="@drawable/bg_profile_new_user_chat_count_down"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginHorizontal="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_profile_new_user_chat_count_down_left_icon"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="14sp"
        android:textColor="#26273c"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="【新人限时福利】"
        android:lines="1"
        android:layout_marginStart="42dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#191c32"
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_hour"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_second"
        android:background="@drawable/bg_profile_new_user_chat_count_down_time"
        android:layout_width="21.5dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_middle_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_profile_new_user_chat_count_down_time_middle"
        android:layout_marginEnd="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_second"
        app:layout_constraintEnd_toStartOf="@+id/tv_second"
        app:layout_constraintTop_toTopOf="@+id/tv_second"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_minutes"
        android:background="@drawable/bg_profile_new_user_chat_count_down_time"
        android:layout_width="21.5dp"
        android:layout_height="24dp"
        android:layout_marginEnd="2.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_middle_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_middle_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_profile_new_user_chat_count_down_time_middle"
        android:layout_marginEnd="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_second"
        app:layout_constraintEnd_toStartOf="@+id/tv_minutes"
        app:layout_constraintTop_toTopOf="@+id/tv_second"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_hour"
        android:background="@drawable/bg_profile_new_user_chat_count_down_time"
        android:layout_width="21.5dp"
        android:layout_height="24dp"
        android:layout_marginEnd="2.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_middle_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_second,img_middle_1,tv_minutes,img_middle_2,tv_hour"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/btn_to_be_vip"
        android:paddingLeft="12dp"
        android:paddingTop="2dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="10dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        app:bg_colorNormal="@color/color_191C32"
        app:bg_fillMode="color"
        app:bg_radius="25dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="成为会员"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="随时发消息"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
