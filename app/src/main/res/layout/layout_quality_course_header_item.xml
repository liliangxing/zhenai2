<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="47dp">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_appraise"
        android:paddingTop="@dimen/dimen_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/appraise_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_course"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_appraise_line"
        android:layout_width="@dimen/dimen_19dp"
        android:layout_height="@dimen/dimen_3dp"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_appraise"
        app:layout_constraintRight_toRightOf="@+id/tv_appraise"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_course"
        android:paddingTop="@dimen/dimen_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/course_detail_course_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_appraise"
        app:layout_constraintRight_toLeftOf="@+id/tv_des"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_course_line"
        android:visibility="invisible"
        android:layout_width="@dimen/dimen_19dp"
        android:layout_height="@dimen/dimen_3dp"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_course"
        app:layout_constraintRight_toRightOf="@+id/tv_course"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:id="@+id/tv_des"
        android:paddingTop="@dimen/dimen_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/course_detail_intro_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_course"
        app:layout_constraintRight_toRightOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_des_line"
        android:visibility="invisible"
        android:layout_width="@dimen/dimen_19dp"
        android:layout_height="@dimen/dimen_3dp"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_des"
        app:layout_constraintRight_toRightOf="@+id/tv_des"/>
</androidx.constraintlayout.widget.ConstraintLayout>
