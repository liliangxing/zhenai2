<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:background="@color/black_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/first_discount_ll"
        android:background="#ffffd8a1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="#ffb86b18"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/first_recharge_discount_txt"
            android:drawablePadding="@dimen/dimen_5dp"
            android:drawableEnd="@drawable/yellow_end_arr"
            android:paddingEnd="@dimen/dimen_10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_dialog"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/viewstub_guide_banner"
            android:visibility="gone"
            android:layout="@layout/layout_zhenai_coin_dialog_guide_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content"
            android:background="@drawable/bg_white_up_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/dimen_15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/live_video_recharge_btn_shape"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/live_sure_pay"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                app:layout_constraintTop_toBottomOf="@+id/recharge_way"/>
            <ImageView
                android:id="@+id/img_zhen_ai_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_zhen_ai_coin_new"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/tv_zhen_ai_value_title"
                app:layout_constraintStart_toEndOf="@+id/tv_zhen_ai_value_title"
                app:layout_constraintTop_toTopOf="@+id/tv_zhen_ai_value_title"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_zhen_ai_pay_protocol"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_sure">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#9395a4"
                    android:id="@+id/tv_pay_terms_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支付即同意"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_8B76F9"
                    android:id="@+id/tv_pay_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《珍爱币用户协议》"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/recharge_way"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:layout_marginEnd="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_recharge_way">
                <com.zhenai.business.widget.pay.PayTypeLayout
                    android:id="@+id/livePayTypeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="#26273c"
                android:gravity="center"
                android:id="@+id/tv_zhen_ai_value_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="当前余额："
                android:layout_marginStart="@dimen/dimen_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="#26273c"
                android:id="@+id/tv_zhen_ai_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_2dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_zhen_ai_icon"
                app:layout_constraintStart_toEndOf="@+id/img_zhen_ai_icon"
                app:layout_constraintTop_toTopOf="@+id/img_zhen_ai_icon"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#26273c"
                android:id="@+id/tv_recharge_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="支付方式："
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_recharge_num"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/paySubTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp17"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="@dimen/dp17"
                android:layout_marginHorizontal="@dimen/dp17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhen_ai_value_title"/>
            <View
                android:id="@+id/view_line"
                android:background="#0d26273c"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_1dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/paySubTitle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recharge_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="@dimen/dimen_13dp"
                android:layout_marginEnd="@dimen/dimen_13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
