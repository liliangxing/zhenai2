<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/limit_img_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_26273C"
        android:id="@+id/limit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/limit_img_icon"
        app:layout_constraintStart_toEndOf="@+id/limit_img_icon"
        app:layout_constraintTop_toTopOf="@+id/limit_img_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/limit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/limit_img_icon"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_767DFF"
        android:gravity="center"
        android:id="@+id/limit_click_button"
        android:layout_width="89dp"
        android:layout_height="32dp"
        android:text="点击查看"
        android:layout_marginEnd="16dp"
        app:bg_colorStroke="@color/color_767DFF"
        app:bg_radius="@dimen/dp32"
        app:bg_shape="round"
        app:bg_strokeMode="solid"
        app:bg_strokeWidth="@dimen/dp1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
