<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_intro"
        android:background="@drawable/rectangle_ffffff_radius_15"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_intro_bg"
        android:background="@drawable/bg_recommend_intro"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp100"
        android:layout_marginBottom="18dp"
        android:scaleType="fitStart"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintTop_toTopOf="@+id/cl_intro_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_intro_content"
        android:paddingTop="23dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginBottom="18dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <com.zhenai.common.widget.ReadMoreTextView
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tvReadMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:minHeight="@dimen/dp30"
            android:lineSpacingExtra="2dp"
            app:tipColor="#b9b9b9"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:background="@drawable/ic_recommend_intro_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
