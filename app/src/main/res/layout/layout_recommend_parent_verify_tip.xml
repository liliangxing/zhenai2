<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_26273c_rectangle_16_radius"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/shape_recommend_parent_verify_tip_dot"
            android:layout_width="@dimen/dimen_6dp"
            android:layout_height="@dimen/dimen_6dp"/>
        <TextView
            android:textSize="12.5sp"
            android:textColor="#d5d7ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recommend_parent_verify_tip"
            android:layout_marginStart="@dimen/dimen_6dp"/>
    </LinearLayout>
</merge>
