<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_margin="4dp"
        android:src="@drawable/icon_profile_super_recommend_icon_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/superRecommendLayoutRightImage"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="@string/super_recommend_i_want_to_try_too"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="8dp"
        app:bg_colorNormal="#191c32"
        app:bg_fillMode="color"
        app:bg_radius="@dimen/dimen_13dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_icon"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="#26273c"
        android:id="@+id/superRecommendEntranceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/superRecommendLayoutRightImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/img_icon"
        app:layout_constraintTop_toTopOf="@+id/img_icon"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#9726273c"
        android:id="@+id/superRecommendEntranceSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon"
        app:layout_constraintEnd_toEndOf="@+id/superRecommendLayoutRightImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/superRecommendEntranceTitle"/>
</merge>
