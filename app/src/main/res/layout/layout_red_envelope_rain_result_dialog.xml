<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_root"
        android:background="@drawable/red_envelope_header_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="375:136"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="15dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/avatarBg"
            android:background="@drawable/red_envelope_header_bg_circle"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/tv_rank"
            android:layout_width="106dp"
            android:layout_height="27dp"
            android:src="@drawable/red_envelope_rain_rank1_img"
            android:layout_marginStart="7dp"
            app:layout_constraintBottom_toTopOf="@+id/rank_content"
            app:layout_constraintStart_toEndOf="@+id/avatarBg"
            app:layout_constraintTop_toTopOf="@+id/avatarBg"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageView
            android:id="@+id/red_envelope_rain_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:src="@drawable/red_envelope_rain_text"
            android:layout_marginStart="@dimen/dimen_20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/close"
            android:layout_width="@dimen/dimen_21dp"
            android:layout_height="@dimen/dimen_21dp"
            android:src="@drawable/red_envelope_header_close"
            android:layout_marginEnd="@dimen/dimen_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/red_envelope_rain_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/red_envelope_rain_text"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:id="@+id/rank_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="本场红包雨由 "
            android:layout_marginStart="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarBg"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/avatarBg"
            app:layout_constraintTop_toBottomOf="@+id/tv_rank"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/rank_content2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/rank_content"
            app:layout_constraintEnd_toStartOf="@+id/rank_content3"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/rank_content"
            app:layout_constraintTop_toTopOf="@+id/rank_content"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:id="@+id/rank_content3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 为房主助力召唤"
            android:layout_marginEnd="@dimen/dimen_8dp"
            app:layout_constraintBottom_toBottomOf="@+id/rank_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/rank_content2"
            app:layout_constraintTop_toTopOf="@+id/rank_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="#ff666978"
        android:gravity="start"
        android:id="@+id/red_envelope_title"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingBottom="@dimen/dimen_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_root"/>
    <com.zhenai.common.widget.refresh.ZARefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="272dp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/red_envelope_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_red_envelope_rain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.zhenai.common.widget.refresh.ZARefreshLayout>
    <Button
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:id="@+id/follow_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/refresh"
        style="@style/CommonMiddleFullBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
