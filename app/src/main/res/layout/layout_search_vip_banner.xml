<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/banner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textStyle="bold"
        android:textColor="@color/color_563f1b"
        android:id="@+id/vip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/vip_content"
        app:layout_constraintStart_toStartOf="@+id/banner_bg"
        app:layout_constraintTop_toTopOf="@+id/banner_bg"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_563f1b"
        android:id="@+id/vip_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/banner_bg"
        app:layout_constraintStart_toStartOf="@+id/banner_bg"
        app:layout_constraintTop_toBottomOf="@+id/vip_title"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/btn_bg"
        android:layout_width="@dimen/dp78"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/banner_bg"
        app:layout_constraintEnd_toEndOf="@+id/banner_bg"
        app:layout_constraintTop_toTopOf="@+id/banner_bg"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_563f1b"
        android:gravity="center"
        android:id="@+id/vip_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/btn_bg"
        app:layout_constraintEnd_toEndOf="@+id/btn_bg"
        app:layout_constraintStart_toStartOf="@+id/btn_bg"
        app:layout_constraintTop_toTopOf="@+id/btn_bg"/>
</merge>
