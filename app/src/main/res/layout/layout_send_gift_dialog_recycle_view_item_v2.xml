<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/layout_item"
    android:layout_width="match_parent"
    android:layout_height="118dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_gift"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#26273b"
            android:id="@+id/tv_gift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#6c6d75"
            android:id="@+id/tv_gift_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/tvGiftEffectType"
        android:background="@drawable/bg_ffa49f_to_ff72a2_rectangle_left_100_radius"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="94dp"
        android:lines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
</FrameLayout>
