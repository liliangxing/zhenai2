<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cl_root"
    android:paddingTop="@dimen/dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_translucent_white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp35"
        android:text="@string/live_gift_panel_send"
        android:paddingEnd="@dimen/dp5"
        android:layout_marginStart="@dimen/dp14"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_translucent_white"
        android:id="@+id/tv_choose_all"
        android:padding="@dimen/dp5"
        android:paddingLeft="@dimen/dimen_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_gift_send_all"
        android:drawableLeft="@drawable/ic_gift_send_normal"
        android:drawablePadding="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp9"/>
</LinearLayout>
