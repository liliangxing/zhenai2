<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_gravity="center"
        android:background="@drawable/rect_white_r16"
        android:paddingBottom="24dp"
        android:layout_width="279dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/dialog_content"
            android:layout_width="279dp"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.RoundImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/bg_dialog_v8"
                app:layout_constraintTop_toTopOf="parent"
                app:radius_left_up="16dp"
                app:radius_right_up="16dp"
                app:roundImageType="round"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_26273c"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/face_recognition_guide"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_line"
                android:background="#0d26273c"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/tv_sense_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="请在光线明亮的环境下，根据认证页面的提示进行操作"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@+id/view_line"/>
            <ImageView
                android:id="@+id/img_prepare_1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/icon_sense_prepare_1_2"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sense_hint"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/icon_sense_prepare_error_2"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_prepare_1"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_26273c"
                android:gravity="center"
                android:id="@+id/tv_prepare_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="光线过亮"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_1"
                app:layout_constraintStart_toStartOf="@+id/img_prepare_1"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_1"/>
            <ImageView
                android:id="@+id/img_prepare_2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/icon_sense_prepare_2_2"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sense_hint"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/icon_sense_prepare_error_2"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_prepare_2"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_26273c"
                android:gravity="center"
                android:id="@+id/tv_prepare_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="光线过暗"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_2"
                app:layout_constraintStart_toStartOf="@+id/img_prepare_2"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_2"/>
            <ImageView
                android:id="@+id/img_prepare_3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="37dp"
                android:src="@drawable/icon_sense_prepare_3_2"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_1"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/icon_sense_prepare_error_2"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_prepare_3"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_3"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_26273c"
                android:gravity="center"
                android:id="@+id/tv_prepare_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="动作幅度过大"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_3"
                app:layout_constraintStart_toStartOf="@+id/img_prepare_3"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_3"/>
            <ImageView
                android:id="@+id/img_prepare_4"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="37dp"
                android:src="@drawable/icon_sense_prepare_4_2"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_2"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/icon_sense_prepare_right_2"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_prepare_4"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_4"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_26273c"
                android:gravity="center"
                android:id="@+id/tv_prepare_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="人脸在检测框内"
                app:layout_constraintEnd_toEndOf="@+id/img_prepare_4"
                app:layout_constraintStart_toStartOf="@+id/img_prepare_4"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_4"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/btn_start_certificate"
                android:background="@drawable/bg_rectangle_767dff_40r_shape"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="42dp"
                android:text="@string/start_face_recognition"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_prepare_4"
                style="?android:attr/borderlessButtonStyle"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_6c6d75"
                android:id="@+id/tv_prepare_button_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/face_recognition_hint"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_start_certificate"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/protocol_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_start_certificate">
                <CheckBox
                    android:id="@+id/checkbox_agree"
                    android:background="@drawable/user_privacy_check_box_selector_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_999999"
                    android:gravity="start"
                    android:id="@+id/tv_protocol"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/certificate_protocol_tips_v8"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
