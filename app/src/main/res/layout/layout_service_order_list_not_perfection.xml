<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/white"
    android:paddingTop="@dimen/dimen_15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_666666"
        android:id="@+id/tv_order_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:text="订单时间：2018.12.12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_FE4A3A"
        android:id="@+id/tv_order_state"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已支付"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_poster"
        android:layout_width="@dimen/dimen_100dp"
        android:layout_height="@dimen/dimen_100dp"
        android:layout_marginLeft="@dimen/dimen_15dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:src="@drawable/default_img"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_time"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:paddingLeft="@dimen/dimen_11dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:maxLines="3"
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_time"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_total_pay_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_11dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:text="总金额："
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_total_pay_count"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_11dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_pay_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_11dp"
        android:layout_marginTop="@dimen/dimen_3dp"
        android:text="已支付："
        app:layout_constraintLeft_toRightOf="@+id/iv_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_pay_des"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_pay_count"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_11dp"
        android:layout_marginTop="@dimen/dimen_3dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_pay_des"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="#12131a"
        android:id="@+id/tv_to_be_paid"
        android:paddingTop="@dimen/dimen_20dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_count"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pay"
        android:background="@drawable/shape_order_un_perfect_bg"
        android:paddingLeft="@dimen/dimen_5dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginRight="@dimen/dimen_15dp"
        android:minWidth="73dp"
        android:minHeight="@dimen/dimen_17dp"
        android:text="合同未完善"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_to_be_paid"/>
    <View
        android:id="@+id/bottom_view"
        android:background="@color/color_dividing_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_line_height"
        android:layout_marginTop="@dimen/dimen_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay"/>
</androidx.constraintlayout.widget.ConstraintLayout>
