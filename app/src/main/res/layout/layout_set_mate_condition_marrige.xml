<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#ff414253"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="39dp"
        android:text="@string/set_mate_condition_marrige_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:layout_marginRight="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <RadioButton
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@drawable/guide_point_select_new_user_item_marry_text_color"
            android:id="@+id/rd_marry_unlimited"
            android:background="@drawable/guide_point_select_new_user_item_marry_bg"
            android:paddingLeft="@dimen/dimen_20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="11dp"
            android:button="@null"
            android:text="不限"/>
        <RadioButton
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@drawable/guide_point_select_new_user_item_marry_text_color"
            android:id="@+id/rd_unmarried"
            android:background="@drawable/guide_point_select_new_user_item_marry_bg"
            android:paddingLeft="@dimen/dimen_20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="11dp"
            android:button="@null"
            android:text="未婚"/>
        <RadioButton
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@drawable/guide_point_select_new_user_item_marry_text_color"
            android:id="@+id/rd_divorced"
            android:background="@drawable/guide_point_select_new_user_item_marry_bg"
            android:paddingLeft="@dimen/dimen_20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="11dp"
            android:button="@null"
            android:text="离异"/>
        <RadioButton
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@drawable/guide_point_select_new_user_item_marry_text_color"
            android:id="@+id/rd_widowed"
            android:background="@drawable/guide_point_select_new_user_item_marry_bg"
            android:paddingLeft="@dimen/dimen_20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="11dp"
            android:button="@null"
            android:text="丧偶"/>
    </RadioGroup>
    <Button
        android:textSize="@dimen/dimen_15sp"
        android:textColor="#ffffff"
        android:id="@+id/btn_continue"
        android:background="@drawable/common_long_btn_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="105dp"
        android:layout_marginRight="25dp"
        android:text="继续"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radio_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
