    android:id="@+id/shanyan_view_privacy_layout"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/shanyan_view_navigationbar_include"
        layout="@layout/layout_shanyan_navigationbar_item"/>
    <View
        android:background="#e8e8e8"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <WebView
        android:id="@+id/shanyan_view_baseweb_webview"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
