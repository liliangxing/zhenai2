<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/img_video_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"/>
    <View
        android:background="@drawable/shortvideo_titlebar_bg"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_mask"
        android:background="@drawable/shortvideo_bottom_stepping_color"
        android:layout_width="match_parent"
        android:layout_height="212dp"
        android:layout_alignParentBottom="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/video_loading_view"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentBottom="true"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/short_video_loading.json"
        app:lottie_loop="true"/>
    <ImageView
        android:id="@+id/img_play"
        android:background="@drawable/bg_video_circle_semitransparent_black"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:src="@drawable/ic_video_play"
        android:layout_centerInParent="true"
        android:paddingStart="20dp"
        android:paddingEnd="19dp"/>
    <ProgressBar
        android:theme="@style/AppTheme.WhiteAccent"
        android:id="@+id/progress_bar_loading"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/layout_video_fail"
        android:background="@color/color_42475c"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_error_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_play_video_no_network"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_retry_to_play_video"
                android:background="@drawable/lib_video_drawble_bg_stroke_white"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/click_and_retry"/>
        </LinearLayout>
    </RelativeLayout>
</merge>
