<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="#ff42475c"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/super_recommend_preview_desc"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/preview_viewPager"
        android:paddingLeft="43dp"
        android:paddingRight="43dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:paddingStart="43dp"
        android:paddingEnd="43dp"/>
    <Button
        android:textSize="17sp"
        android:textColor="#ffffffff"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_dress_now"
        android:background="@drawable/btn_start_group"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/super_recommend_preview_use"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_has_dress"
        android:background="@drawable/bg_has_dress_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="7dp"
        android:text="@string/super_recommend_preview_has_use"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"/>
</LinearLayout>
