<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="279dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_page_top_v8"
            app:borderRadius="16dp"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="#26273c"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="#6c6d75"
            android:id="@+id/content"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_accept"
            android:background="@drawable/bg_rectangle_767dff_22r_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/check"
            android:layout_below="@+id/content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/btn_reject"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="12dp"
            android:text="@string/refuse_txt"
            android:layout_below="@+id/btn_accept"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/top_icon"
        android:background="@drawable/super_remind_dialog_top_icon"
        android:layout_width="132dp"
        android:layout_height="132dp"/>
</FrameLayout>
