<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/supplement_root"
    android:background="@color/color_fddfb5"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_e39a4d"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/supplement_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recommend_supplement_profile_tip"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_profile_supplement_tip"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_profile_supplement_tip"
        android:background="@drawable/profile_supplement_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
