<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="43dp">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475C"
        android:gravity="center"
        android:id="@+id/tv_consultation"
        android:paddingTop="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/emotion_consultation_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_appraise"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_consultation_line"
        android:layout_width="@dimen/dp21"
        android:layout_height="@dimen/dp4"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_consultation"
        app:layout_constraintRight_toRightOf="@+id/tv_consultation"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:gravity="center"
        android:id="@+id/tv_appraise"
        android:paddingTop="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/appraise_tips"
        app:layout_constraintLeft_toRightOf="@+id/tv_consultation"
        app:layout_constraintRight_toLeftOf="@+id/tv_introduce"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_appraise_line"
        android:visibility="invisible"
        android:layout_width="@dimen/dp21"
        android:layout_height="@dimen/dp4"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_appraise"
        app:layout_constraintRight_toRightOf="@+id/tv_appraise"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:gravity="center"
        android:id="@+id/tv_introduce"
        android:paddingTop="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/emotion_intro_tips"
        app:layout_constraintLeft_toRightOf="@+id/tv_appraise"
        app:layout_constraintRight_toLeftOf="@+id/tv_moments"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_introduce_line"
        android:visibility="invisible"
        android:layout_width="@dimen/dp21"
        android:layout_height="@dimen/dp4"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_introduce"
        app:layout_constraintRight_toRightOf="@+id/tv_introduce"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:gravity="center"
        android:id="@+id/tv_moments"
        android:paddingTop="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/emotion_moments_tips"
        app:layout_constraintLeft_toRightOf="@+id/tv_introduce"
        app:layout_constraintRight_toRightOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:id="@+id/tv_moments_line"
        android:visibility="invisible"
        android:layout_width="@dimen/dp21"
        android:layout_height="@dimen/dp4"
        android:layout_marginBottom="@dimen/dimen_2dp"
        app:bg_colorGradientEnd="@color/color_7a00ff"
        app:bg_colorGradientStart="@color/color_ff5694"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_2dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_moments"
        app:layout_constraintRight_toRightOf="@+id/tv_moments"/>
</androidx.constraintlayout.widget.ConstraintLayout>
