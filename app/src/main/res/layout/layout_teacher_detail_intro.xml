<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_emotion_course_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp5"
    android:layout_marginStart="@dimen/dp10"
    android:layout_marginEnd="@dimen/dp10">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_20sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_intro_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:text="专家介绍"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_person_intro_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="个人简介"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_intro_title"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_teacher_intro_content"
        android:paddingBottom="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:lineSpacingExtra="@dimen/dp3"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_person_intro_tips"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_consulting_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="咨询风格"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_intro_content"/>
    <com.zhenai.business.emotion.view.CustomTagListView
        android:id="@+id/tag_teacher_consulting_type"
        android:paddingTop="@dimen/dp15"
        android:paddingBottom="@dimen/dimen_20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:emotion_orientation="horizontal"
        app:horizontalSpacing="@dimen/dimen_5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_consulting_type"
        app:verticalSpacing="@dimen/dimen_5dp"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_occupational_requirements_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="从业资质"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tag_teacher_consulting_type"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_teacher_occupational_requirements"
        android:paddingBottom="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_occupational_requirements_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_areas_expertise_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="擅长领域"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/ll_teacher_occupational_requirements"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_teacher_areas_expertise"
        android:paddingBottom="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_areas_expertise_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_good_method_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="擅长疗法"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/ll_teacher_areas_expertise"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:ellipsize="end"
        android:id="@+id/tv_teacher_good_method_content"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_good_method_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_work_experience_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="工作经验"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_good_method_content"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:id="@+id/tv_teacher_work_experience_content"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:lineSpacingExtra="@dimen/dp3"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_work_experience_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_tv_teacher_service_proces"
        android:paddingBottom="@dimen/dp30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_work_experience_content">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_17sp"
            android:textColor="@color/color_42475C"
            android:id="@+id/tv_teacher_service_proces_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp20"
            android:text="服务流程"
            app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_intro_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_teacher_work_experience_content"/>
        <include
            app:layout_constraintTop_toBottomOf="@+id/tv_teacher_service_proces_title"
            layout="@layout/item_major_flow"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
