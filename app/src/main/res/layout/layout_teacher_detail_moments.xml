<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_emotion_course_item"
    android:paddingBottom="@dimen/dp15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp5"
    android:layout_marginStart="@dimen/dp10"
    android:layout_marginEnd="@dimen/dp10">
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_20sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_moments_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:text="专家动态"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_video_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="推荐视频"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_moments_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_moments_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_teacher_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_moments_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_video_title"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_42475C"
        android:id="@+id/tv_teacher_question_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="问答"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_moments_title"
        app:layout_constraintTop_toBottomOf="@+id/rv_teacher_video"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_teacher_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/tv_teacher_moments_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_teacher_question_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
