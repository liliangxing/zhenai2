<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:paddingTop="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_read_only"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已体验"
        android:drawableLeft="@drawable/ic_teacher_detail_read_only"
        android:drawablePadding="@dimen/dimen_3dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_type"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_type"/>
    <ImageView
        android:id="@+id/iv_type"
        android:layout_width="@dimen/dp51"
        android:layout_height="@dimen/dp51"
        android:layout_marginBottom="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_42475C"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintLeft_toRightOf="@+id/iv_type"
        app:layout_constraintRight_toLeftOf="@+id/tv_subscribe"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag_desc"
        android:paddingLeft="@dimen/dimen_5dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:bg_colorGradientEnd="#fe4e4a"
        app:bg_colorGradientStart="#ff8c54"
        app:bg_fillMode="linearGradient"
        app:bg_radiusLeftTop="@dimen/dp4"
        app:bg_radiusRightBottom="@dimen/dp4"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cost"
        app:layout_constraintLeft_toRightOf="@+id/tv_cost"
        app:layout_constraintTop_toTopOf="@+id/tv_cost"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/color_8b76f9"
        android:gravity="center"
        android:id="@+id/tv_subscribe"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp29"
        android:text="@string/teacher_reservation"
        android:drawableLeft="@drawable/ic_teacher_phone"
        android:drawablePadding="@dimen/dimen_5dp"
        app:bg_colorStroke="@color/color_8b76f9"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dimen_15dp"
        app:bg_shape="round"
        app:bg_strokeWidth="@dimen/dimen_1dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_type"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_type"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_17sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_cost_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¥"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_type"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_8b76f9"
        android:id="@+id/tv_cost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp1"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_type"
        app:layout_constraintLeft_toRightOf="@+id/tv_cost_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
