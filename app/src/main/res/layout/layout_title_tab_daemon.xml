<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.lib.zaui.tablayout.ZTabLayout
        android:id="@+id/title_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zIndicatorCornerRadius="2dp"
        app:zIndicatorEndColor="@color/white"
        app:zIndicatorHeight="3dp"
        app:zIndicatorScrollScale="true"
        app:zIndicatorStartColor="@color/white"
        app:zSelectedTextColor="@color/white"
        app:zTabMode="fixed"
        app:zUnSelectedTextColor="@color/color_80FFFFFF"/>
</RelativeLayout>
