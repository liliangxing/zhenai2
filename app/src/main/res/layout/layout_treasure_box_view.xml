<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svga_player_box"
        android:layout_width="64dp"
        android:layout_height="84dp"
        app:antiAlias="true"
        app:autoPlay="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.live_common.widget.CountDownTextView
        android:textSize="12sp"
        android:textColor="@color/color_feedb4"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_count_down"
        android:background="@drawable/bg_live_treasure_box_count_down"
        android:paddingLeft="@dimen/dimen_7dp"
        android:paddingTop="3dp"
        android:paddingRight="@dimen/dimen_7dp"
        android:paddingBottom="3dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dimen_7dp"
        android:paddingVertical="3dp"/>
</FrameLayout>
