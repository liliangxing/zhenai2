<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_common_dialog_v8"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/gradientBg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/bg_dialog_v8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:text="@string/force_update_downloading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.mine.widget.HorizontalProgressView
        android:id="@+id/horizontalProgressView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_12dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="44dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_update_progressbar"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
