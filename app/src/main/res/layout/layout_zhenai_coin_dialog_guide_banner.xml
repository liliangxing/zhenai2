<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_live_zhenai_coin_guide_banner"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp48">
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="#704900"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp9"/>
    <TextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="#ffb5852d"
        android:gravity="center"
        android:id="@+id/btn_buy"
        android:background="@drawable/bg_white_4dp_radius"
        android:layout_width="63dp"
        android:layout_height="@dimen/dimen_24dp"
        android:text="@string/go_to_buy"
        android:layout_marginEnd="@dimen/dp8"/>
</LinearLayout>
