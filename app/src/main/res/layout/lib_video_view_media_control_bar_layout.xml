<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/lib_video_view_control_bar_bg"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/videoPlay"
        android:background="#00000000"
        android:padding="5dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/lib_video_view_icon_play"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:layout_gravity="center_vertical"
        android:id="@+id/videoCurrentProgress"
        android:background="#00000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"/>
    <SeekBar
        android:layout_gravity="center"
        android:id="@+id/videoPlayProgress"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:maxHeight="5dp"
        android:max="500"
        android:indeterminate="false"
        android:progressDrawable="@drawable/lib_video_view_seekbar_style"
        android:minHeight="5dp"
        android:thumb="@drawable/lib_video_view_seekbar_circle_white"
        android:layout_weight="1"
        android:splitTrack="false"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:layout_gravity="center_vertical"
        android:id="@+id/videototalTime"
        android:background="#00000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="00:00"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/videoFullScreen"
        android:background="#00000000"
        android:padding="5dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/lib_video_view_icon_fullscreen"/>
</LinearLayout>
