<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_new_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_bcbcbc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/below_is_newest_message"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/color_1a000000"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_little_assistant_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/layout_item"
        android:contentDescription="@string/zhenai_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_new_message"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_item"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:paddingLeft="12dp"
        android:paddingTop="15dp"
        android:paddingRight="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/tv_time"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@+id/iv_little_assistant_avatar"
        android:paddingHorizontal="12dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#26273c"
            android:layout_gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/reply_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:lineSpacingMultiplier="1.2"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/weChat_img"
            android:visibility="gone"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/add_wechat_qr_code"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/link_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#6c6d75"
                android:gravity="center_vertical"
                android:id="@+id/tv_look_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/is_this_reply_useful"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/useful_reply"
                android:background="@drawable/bg_feedbacl_reply_unclick"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="26dp"
                android:layout_toStartOf="@+id/useless_reply"
                android:paddingHorizontal="7dp">
                <ImageView
                    android:id="@+id/useful_reply_icon"
                    android:background="@drawable/ic_solved_unclick_v2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/this_answer_is_useful"
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#aeafb3"
                    android:id="@+id/useful_reply_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/solved"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/useless_reply"
                android:background="@drawable/bg_feedbacl_reply_unclick"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="26dp"
                android:layout_marginStart="7dp"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="7dp">
                <ImageView
                    android:id="@+id/useless_reply_icon"
                    android:background="@drawable/ic_unsolved_unclick_v2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/this_answer_is_useless"
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#aeafb3"
                    android:id="@+id/useless_reply_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unsolved"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
