<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_new_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="#0d26273b"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#bdbec3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/below_is_newest_message"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="#0d26273b"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_little_assistant_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/layout_item"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/layout_new_message"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_item"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/tv_time"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="60dp"
        android:layout_toEndOf="@+id/iv_little_assistant_avatar">
        <LinearLayout
            android:id="@+id/layout_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/layout_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_little_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#525566"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_moment_text"
                    android:background="#fff2f3f5"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:maxLines="3"/>
            </FrameLayout>
            <com.zhenai.common.widget.SpannableTouchTextView
                android:textSize="14sp"
                android:textColor="#26273c"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/link_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <View
                android:background="#0d26273b"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#767dff"
                android:gravity="center_vertical"
                android:id="@+id/tv_look_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/look_right_now"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
