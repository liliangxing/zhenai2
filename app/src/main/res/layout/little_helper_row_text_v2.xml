<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/layout_new_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="#0d26273b"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#bdbec3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/below_is_newest_message"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="#0d26273b"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_little_assistant_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/layout_item"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/layout_new_message"/>
    <FrameLayout
        android:id="@+id/layout_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_time"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="60dp"
        android:layout_toEndOf="@+id/iv_little_assistant_avatar">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_42475c"
            android:ellipsize="end"
            android:id="@+id/tv_content"
            android:background="@drawable/bg_ffffff_rectangle_16_radius"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </FrameLayout>
</RelativeLayout>
