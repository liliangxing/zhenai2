<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gift_count_root_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="349dp">
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_666978"
        android:id="@+id/dialog_gift_count_choose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:text="@string/live_dialog_gift_count_choose_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dialog_gift_count_choose_cut_line"
        android:background="@drawable/title_bar_gray_shawow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/dialog_gift_count_choose_title"/>
    <com.zhenai.business.widget.view_pager.WrapContentHeightViewPager
        android:id="@+id/dialog_gift_count_choose_view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="226dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/dialog_gift_count_choose_shadow"
        app:layout_constraintTop_toBottomOf="@+id/dialog_gift_count_choose_cut_line"/>
    <com.zhenai.business.widget.indicator.IndicatorLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_gift_count_choose_indicator_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_image_margin="0dp"
        app:item_image_size="15dp"
        app:item_selected_image_res_id="@drawable/icon_live_video_gift_indicator_selected"
        app:item_unselected_image_res_id="@drawable/icon_live_video_gift_indicator_unselected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_gift_count_choose_view_pager"/>
    <View
        android:id="@+id/dialog_gift_count_choose_shadow"
        android:background="@drawable/title_bar_gray_shawow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="17dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_gift_count_choose_cancel"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_8b76f9"
        android:gravity="center"
        android:id="@+id/dialog_gift_count_choose_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
