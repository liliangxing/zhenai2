<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/live_guide_bottom_dialog_for_new_user_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_live_guide_for_new_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp15"
        android:layout_marginStart="@dimen/dp15"
        android:layout_marginEnd="@dimen/dp15">
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="#26273c"
            android:gravity="center"
            android:id="@+id/title_tv"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:drawablePadding="@dimen/dp6"
            android:drawableStart="@drawable/icon_live_guide_left"
            android:drawableEnd="@drawable/icon_live_guide_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#6c6d75"
            android:id="@+id/desc_tv"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.5"/>
        <ImageView
            android:id="@+id/avatar_left"
            android:layout_width="@dimen/dp143"
            android:layout_height="@dimen/dp143"
            android:layout_marginTop="@dimen/dp25"
            app:layout_constraintEnd_toStartOf="@+id/guide_line"
            app:layout_constraintTop_toBottomOf="@+id/desc_tv"/>
        <ImageView
            android:id="@+id/avatar_right"
            android:layout_width="@dimen/dp143"
            android:layout_height="@dimen/dp143"
            app:layout_constraintStart_toEndOf="@+id/guide_line"
            app:layout_constraintTop_toTopOf="@+id/avatar_left"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_group_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="@+id/avatar_left"
            app:layout_constraintTop_toTopOf="@+id/avatar_left">
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_left_tag1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_left_tag2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <View
            android:background="@drawable/bg_b3000000_00000000_rectangle_bl_r6_shape"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp59"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_left"
            app:layout_constraintEnd_toEndOf="@+id/avatar_left"
            app:layout_constraintStart_toStartOf="@+id/avatar_left"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:id="@+id/nickname_left"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintBottom_toTopOf="@+id/left_provence_and_age"
            app:layout_constraintStart_toStartOf="@+id/avatar_left"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/left_provence_and_age"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_8dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_left"
            app:layout_constraintStart_toStartOf="@+id/avatar_left"/>
        <View
            android:background="@drawable/bg_b3000000_00000000_rectangle_br_r6_shape"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp59"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_right"
            app:layout_constraintEnd_toEndOf="@+id/avatar_right"
            app:layout_constraintStart_toStartOf="@+id/avatar_right"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:id="@+id/nickname_right"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintBottom_toTopOf="@+id/right_provence_and_age"
            app:layout_constraintStart_toStartOf="@+id/avatar_right"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/right_provence_and_age"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_8dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_right"
            app:layout_constraintStart_toStartOf="@+id/avatar_right"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_watch_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_left">
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dp13"
                android:layout_height="@dimen/dp13"
                android:src="@drawable/icon_live_guide_people"
                android:layout_marginStart="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_42475c"
                android:layout_gravity="center"
                android:id="@+id/tv_watch_live_num"
                android:tag="binding_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp3"
                android:layout_marginEnd="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="@color/color_42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/btn_not_interested_in"
            android:background="@drawable/live_guide_cancel_button_background"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp30"
            android:layout_marginBottom="@dimen/dimen_20dp"
            android:text="@string/not_interested_in"
            android:layout_marginStart="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_watch_now"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_watch_num"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_watch_now"
            android:background="@drawable/bg_ff767dff_rectangle_22_radius"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/live_guide_watch_now"
            android:layout_marginStart="@dimen/dp15"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/btn_not_interested_in"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_not_interested_in"
            app:layout_constraintTop_toTopOf="@+id/btn_not_interested_in"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
