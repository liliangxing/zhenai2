<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/live_guide_bottom_dialog_for_old_user_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:background="@drawable/bg_live_guide_for_old_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp15"
        android:layout_marginStart="@dimen/dp15"
        android:layout_marginEnd="@dimen/dp15">
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="#26273c"
            android:gravity="center"
            android:id="@+id/title_tv"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:drawablePadding="@dimen/dp6"
            android:drawableStart="@drawable/icon_live_guide_left"
            android:drawableEnd="@drawable/icon_live_guide_right"
            app:layout_constraintBottom_toTopOf="@+id/bg_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/bg_card"
            android:background="@drawable/bg_live_guide_card"
            android:paddingTop="@dimen/dp15"
            android:paddingBottom="@dimen/dp10"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginBottom="@dimen/dp30"
            android:paddingStart="@dimen/dp15"
            android:paddingEnd="@dimen/dp15"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toTopOf="@+id/btn_not_interested_in"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_tv"
            app:layout_constraintVertical_weight="1"/>
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/dp100"
            android:layout_height="@dimen/dp100"
            android:layout_marginTop="@dimen/dp15"
            android:layout_marginStart="@dimen/dp15"
            app:layout_constraintStart_toStartOf="@+id/bg_card"
            app:layout_constraintTop_toTopOf="@+id/bg_card"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_ff7599_rectangle_r11_shape"
            android:padding="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp5"
            android:layout_marginStart="@dimen/dp5"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintStart_toStartOf="@+id/avatar">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/living_lottie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:lottie_autoPlay="true"
                app:lottie_fileName="animation/live_guide_living.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="@dimen/dimen_10sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/living"
                android:layout_marginStart="@dimen/dp3"/>
        </LinearLayout>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="#26273c"
            android:ellipsize="end"
            android:id="@+id/nickname"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp15"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/provence_and_age"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"
            app:layout_constraintVertical_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_666978"
            android:ellipsize="end"
            android:id="@+id/provence_and_age"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/nickname"
            app:layout_constraintEnd_toEndOf="@+id/bg_card"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/nickname"
            app:layout_constraintTop_toTopOf="@+id/nickname"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/tag_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginEnd="@dimen/dp5"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/bg_card"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/nickname"
            app:layout_constraintTop_toBottomOf="@+id/nickname">
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_tag1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_tag2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_tag1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/view_line"
            android:background="@color/color_eaeaea"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginEnd="@dimen/dimen_15dp"
            app:layout_constraintEnd_toEndOf="@+id/bg_card"
            app:layout_constraintStart_toStartOf="@+id/nickname"
            app:layout_constraintTop_toBottomOf="@+id/tag_group"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="#26273c"
            android:id="@+id/live_title"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            app:layout_constraintStart_toStartOf="@+id/nickname"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#26273c"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/live_introduce"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginBottom="@dimen/dp40"
            android:maxLines="3"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="@dimen/dp35"
            android:layout_marginEnd="@dimen/dp35"
            app:layout_constraintBottom_toTopOf="@+id/btn_not_interested_in"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/btn_not_interested_in"
            android:background="@drawable/live_guide_cancel_button_background"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:layout_marginBottom="@dimen/dimen_20dp"
            android:text="@string/not_interested_in"
            android:layout_marginStart="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_watch_now"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bg_card"/>
        <TextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_watch_now"
            android:background="@drawable/bg_ff767dff_rectangle_22_radius"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/live_guide_chat_now"
            android:layout_marginStart="@dimen/dp15"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/btn_not_interested_in"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_not_interested_in"
            app:layout_constraintTop_toTopOf="@+id/btn_not_interested_in"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
