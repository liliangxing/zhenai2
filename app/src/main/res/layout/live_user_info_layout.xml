<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/bg_live_video_user_info_top"
        android:layout_width="match_parent"
        android:layout_height="70dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_super_love"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginBottom="@dimen/dimen_5dp"
        android:src="@drawable/ic_live_hn_guest_burst"
        android:layout_marginEnd="@dimen/dimen_5dp"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/iv_share_live_linking"
        android:background="@drawable/selector_share_live_linking_item_for_video"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/layout_live_video_onmic_info"
        android:background="@drawable/bg_live_video_user_info_bottom"
        android:paddingTop="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.live.hong_niang_match_vip.widget.VideoRankView
            android:id="@+id/audience_layout_labels"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_3dp"
            android:layout_marginStart="@dimen/dimen_8dp"/>
        <include
            android:id="@+id/tv_mir_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            layout="@layout/layout_live_video_zhenxin_value"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/live_v8_audienceRankLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp6"
        android:layout_marginEnd="@dimen/dp6">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/audience_content_imageView"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"/>
        <ImageView
            android:id="@+id/audience_first_imageView"
            android:background="@drawable/bg_live_user_info_zhenxin_value_first"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_5dp"
        android:layout_marginTop="@dimen/dimen_5dp">
        <ImageView
            android:id="@+id/iv_in_loving"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_live_love_tag"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tag_mir_idview"
            android:background="@drawable/bg_right_down_round_gray"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="@string/honor"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_mir_nickname"
            android:paddingTop="3dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:drawablePadding="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="5dp"
            android:layout_marginEnd="@dimen/dimen_5dp"/>
    </LinearLayout>
    <me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/live_v8_nickNameLayout"
        android:paddingTop="@dimen/dp3"
        android:paddingBottom="@dimen/dp3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        app:bg_colorNormal="@color/black_40"
        app:bg_radiusLeftBottom="@dimen/dp12"
        app:bg_radiusLeftTop="@dimen/dp12"
        app:bg_shape="round">
        <ImageView
            android:id="@+id/live_v8_guard"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_live_v8_user_info_view_guard"
            android:layout_marginEnd="@dimen/dp2"/>
        <TextView
            android:textSize="@dimen/dimen_10sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/live_v8_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="5"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/live_v8_follow"
            android:paddingTop="2dp"
            android:paddingBottom="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/follow"
            android:paddingStart="@dimen/dp3"
            android:paddingEnd="@dimen/dp3"
            android:layout_marginStart="@dimen/dp2"
            app:bg_colorNormal="@color/color_767dff"
            app:bg_radius="@dimen/dp9"
            app:bg_shape="round"/>
    </me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
    <ViewStub
        android:layout_gravity="start|top"
        android:id="@+id/charm_weekly_view_flipper"
        android:layout="@layout/layout_charm_weekly_rank_view_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6dp"
        android:layout_marginStart="@dimen/dimen_8dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/empty_seat_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/empty_seat_bg"
            android:background="@drawable/live_video_loading_mic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_wait"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_zalive_hn_match_apply_add"
            app:layout_constraintBottom_toTopOf="@+id/tv_wait_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tv_wait_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/wait_for_mic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_wait"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
