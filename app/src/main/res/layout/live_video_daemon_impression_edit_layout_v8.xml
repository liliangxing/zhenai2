<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_empty"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_impression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zhenai.common.widget.BoldTextView
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/color_26273C"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginTop="@dimen/dp23"
            android:layout_marginBottom="@dimen/dp10"
            android:text="@string/daemon_write_impression"/>
        <EditText
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/color_6C6D75"
            android:textColorHint="@color/color_aeafb3"
            android:gravity="top|left"
            android:id="@+id/edt_impression"
            android:background="@color/transparent"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp15"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp15"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15"
            android:hint="@string/write_impression_something"
            android:maxLines="4"
            android:paddingHorizontal="@dimen/dp12"
            android:paddingVertical="@dimen/dp15"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_767dff"
            android:id="@+id/tv_tip"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="@dimen/dp6"
            android:layout_marginBottom="@dimen/dp1"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableButton
            android:enabled="false"
            android:textSize="@dimen/dimen_15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_edit_complete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp42"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginBottom="@dimen/dp23"
            android:text="@string/edit_complete"
            android:layout_marginStart="@dimen/dp15"
            android:layout_marginEnd="@dimen/dp15"
            app:bg_colorDisabled="@color/color_30_26273c"
            app:bg_colorNormal="@color/color_767dff"
            app:bg_fillMode="color"
            app:bg_radius="@dimen/dp22"
            app:bg_shape="round"
            app:bg_stateMode="clickable"/>
    </LinearLayout>
</LinearLayout>
