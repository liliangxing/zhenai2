<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_round_real_white"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:src="@drawable/live_voice_switch_icon"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#42475c"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已进入语音直播时段\10立即为你切换至语音直播吗"
            android:drawablePadding="14dp"
            android:lineSpacingExtra="6dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="17dp"
            android:layout_marginBottom="15dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_8b76f9"
                android:gravity="center"
                android:id="@+id/btn_exit"
                android:background="@drawable/live_video_apply_bg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="结束直播"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_open"
                android:background="@drawable/bg_live_rectangle_purple_corner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:text="立即开启(15s)"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
