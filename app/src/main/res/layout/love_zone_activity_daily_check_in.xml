<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/checkInPageBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/love_zone_checkin_page"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/icon_secret_chat_close_float"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:id="@+id/checkin_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/my_avatar_layout"
                android:background="@drawable/white_circle_shape"
                android:visibility="gone"
                android:layout_width="69dp"
                android:layout_height="69dp"
                android:layout_marginTop="295dp"
                android:layout_marginStart="42dp">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/my_avatar_view"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/default_avatar"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/other_avatar_layout"
                android:background="@drawable/white_circle_shape"
                android:visibility="gone"
                android:layout_width="69dp"
                android:layout_height="69dp"
                android:layout_marginTop="295dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="42dp">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/other_avatar_view"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/default_avatar"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffff5f68"
                android:id="@+id/tips_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="382dp"
                android:text="@string/love_zone_press_heart_left_half"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/signin_box"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="163dp"
                android:layout_height="153dp"
                android:layout_marginTop="432dp"
                android:scaleType="fitXY"
                android:layout_centerHorizontal="true"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/heart_layout"
                android:background="@drawable/love_zone_bg_signin_love_normal"
                android:visibility="gone"
                android:layout_width="256dp"
                android:layout_height="198dp"
                android:layout_marginTop="118dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/left_heart_iv"
                    android:background="@drawable/love_zone_bg_signin_love_left"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/right_heart_iv"
                    android:background="@drawable/love_zone_bg_signin_love_right"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/full_heart_iv"
                    android:background="@drawable/love_zone_bg_signin_love_full"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"/>
                <com.zhenai.love_zone.checkin.widget.CheckInActionView
                    android:id="@+id/check_in_left_view"
                    android:layout_width="128dp"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/waiting_for_other_light"
                android:background="@drawable/love_zone_bg_signin_wait_tab"
                android:paddingTop="13dp"
                android:visibility="gone"
                android:layout_width="135dp"
                android:layout_height="50dp"
                android:layout_marginLeft="150dp"
                android:layout_marginTop="92dp"
                android:layout_alignLeft="@+id/heart_layout"
                android:alpha="0">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/love_zone_waiting_for_other_light"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/signin_light"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="164dp"
                android:layout_height="173dp"
                android:layout_marginTop="318dp"
                android:src="@drawable/love_zone_bg_signin_light"
                android:scaleType="fitXY"
                android:layout_centerHorizontal="true"
                android:alpha="0"/>
            <FrameLayout
                android:id="@+id/other_avatar_layout2"
                android:background="@drawable/white_circle_shape"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="82dp"
                android:alpha="0"
                android:layout_marginStart="74dp">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/other_avatar_view2"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/default_avatar"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/my_avatar_layout2"
                android:background="@drawable/white_circle_shape"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="82dp"
                android:alpha="0"
                android:layout_marginStart="23dp">
                <com.zhenai.common.widget.RoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/my_avatar_view2"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/default_avatar"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/checkin_days"
                android:background="@drawable/white_circle_shape"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="37dp"
                android:layout_marginTop="94dp"
                android:layout_alignParentRight="true"
                android:alpha="0"
                android:paddingStart="14dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="25dp">
                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/love_zone_bg_signin_love_full"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffff5f68"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/love_zone_already_collect"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ffff5f68"
                    android:id="@+id/collect_heart_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffff5f68"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/love_zone_heart_count"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/signin_box2"
                android:visibility="gone"
                android:layout_width="249dp"
                android:layout_height="249dp"
                android:layout_marginTop="185dp"
                android:scaleType="fitXY"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffff5f68"
                android:id="@+id/already_checkin_day"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="382dp"
                android:layout_centerHorizontal="true"
                android:alpha="0"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffec5e69"
                android:id="@+id/challenge_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_below="@+id/already_checkin_day"
                android:layout_centerHorizontal="true"
                android:alpha="0"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/challenge_btn"
                android:background="@drawable/love_zone_orange_circle_bg"
                android:visibility="gone"
                android:layout_width="187dp"
                android:layout_height="38dp"
                android:layout_marginTop="19dp"
                android:layout_below="@+id/challenge_text"
                android:layout_centerHorizontal="true"
                android:alpha="0"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/waiting_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center"
                android:id="@+id/fade_bg_view"
                android:background="@drawable/love_zone_white_circle_bg"
                android:layout_width="159dp"
                android:layout_height="159dp"
                android:layout_marginTop="138dp"
                android:layout_centerHorizontal="true"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/fade_bg_inner_view"
                android:background="@drawable/love_zone_white_circle_bg"
                android:layout_width="139dp"
                android:layout_height="139dp"
                android:layout_marginTop="148dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/other_avatar_view_waiting"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="160dp"
                android:src="@drawable/default_avatar"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#ffff5f68"
                android:id="@+id/nick_name_waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_below="@+id/fade_bg_view"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#ffff5f68"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/love_zone_waiting_for_other_checkin"
                android:layout_below="@+id/nick_name_waiting"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
