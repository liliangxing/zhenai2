<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/switch_item1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#666978"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/data_open_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/love_zone_data_open"
            android:layout_marginStart="19dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666978"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/data_open_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/love_zone_other_can_watch_data"
            android:layout_below="@+id/data_open_text"
            android:layout_marginStart="19dp"/>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_compat_data_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"/>
    </RelativeLayout>
    <View style="@style/CutLineStyle"/>
    <RelativeLayout
        android:id="@+id/switch_item2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#666978"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/lover_data_open_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/love_zone_lover_data_open"
            android:layout_marginStart="19dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666978"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/lover_data_open_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/love_zone_show_lover_in_profile"
            android:layout_below="@+id/lover_data_open_text"
            android:layout_marginStart="19dp"/>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_compat_lover_data_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"/>
    </RelativeLayout>
    <View style="@style/CutLineStyle"/>
</LinearLayout>
