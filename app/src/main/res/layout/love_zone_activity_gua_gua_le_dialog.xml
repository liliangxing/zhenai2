<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/love_zone_pic_popup_scratch_card"
        android:layout_width="342dp"
        android:layout_height="337dp"
        android:layout_centerInParent="true">
        <FrameLayout
            android:background="@drawable/love_zone_bg_popup_scratch_card_white"
            android:layout_width="300dp"
            android:layout_height="126dp"
            android:layout_marginTop="88dp">
            <com.zhenai.love_zone.widget.GuaGuaLeView
                android:layout_gravity="center"
                android:id="@+id/guaguale"
                android:background="#ffeeea"
                android:layout_width="282dp"
                android:layout_height="106dp"
                android:layout_centerInParent="true"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffff6a6a"
            android:gravity="center"
            android:id="@+id/task_finish_btn"
            android:background="@drawable/love_zone_task_white_btn_shape"
            android:visibility="gone"
            android:layout_width="158dp"
            android:layout_height="38dp"
            android:layout_marginTop="60dp"
            android:text="@string/love_zone_love_task_status_1"/>
    </LinearLayout>
    <com.zhenai.common.widget.CommonCloseImageView
        android:id="@+id/iv_close"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-3dp"
        android:layout_alignTop="@+id/evaluatelay"
        android:layout_alignRight="@+id/evaluatelay"
        app:close_color="@color/color_FF7272"/>
</RelativeLayout>
