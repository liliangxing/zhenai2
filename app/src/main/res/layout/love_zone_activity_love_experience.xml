                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/story_word_title1"
                    android:background="@drawable/love_zone_bg_story_us_title_frame"
                    android:paddingLeft="14dp"
                    android:paddingTop="2dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/love_zone_we_love_experience"
                    android:layout_centerHorizontal="true"/>
                <com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView
                    android:id="@+id/editTextScrollViewMiddleView1"
                    android:background="@drawable/love_zone_bg_love_experience_word"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="149dp"
                    android:layout_marginTop="14dp"
                    android:layout_below="@+id/story_word_title1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp">
                    <EditText
