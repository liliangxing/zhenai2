                    android:textColor="#ff292929"
                    android:id="@+id/text_word2_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="28dp"
                    android:layout_below="@+id/story_word_title2_show"
                    android:lineSpacingMultiplier="1.2"/>
                <ImageView
                    android:id="@+id/bg_story_us_shadow_second_show"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="77dp"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/love_zone_bg_story_us_shadow_second_show"
                    android:scaleType="fitXY"
                    android:layout_below="@+id/text_word2_show"/>
                <ImageView
                    android:id="@+id/img_story_us_4_show"
                    android:background="@drawable/love_zone_bg_love_experience_word"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="24dp"
                    android:layout_marginBottom="19dp"
                    android:scaleType="centerCrop"
                    android:layout_below="@+id/text_word2_show"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/story_word_title3"
                    android:background="@drawable/love_zone_bg_story_us_title_frame"
                    android:paddingLeft="14dp"
                    android:paddingTop="2dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:text="@string/love_zone_love_gift_get"
                    android:layout_below="@+id/img_story_us_4_show"/>
                <androidx.recyclerview.widget.RecyclerView
