<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.love_zone.love_experience.widget.LoverScrollView
        android:id="@+id/scrollView"
        android:background="#8554fe"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/story_bg_iv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/pic_story_us_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="67dp"
                android:src="@drawable/love_zone_pic_story_us_title"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/pic_story_us_subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="34dp"
                android:text="@string/love_zone_pic_story_us_subtitle"
                android:layout_below="@+id/pic_story_us_title"/>
            <RelativeLayout
                android:id="@+id/avatar_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_below="@+id/pic_story_us_subtitle">
                <View
                    android:id="@+id/center_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_centerInParent="true"/>
                <FrameLayout
                    android:id="@+id/right_avatar_layout"
                    android:background="@drawable/white_circle_shape"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginLeft="-4dp"
                    android:layout_toRightOf="@+id/center_view"
                    android:layout_centerHorizontal="true">
                    <com.zhenai.common.widget.RoundImageView
                        android:layout_gravity="center"
                        android:id="@+id/right_avatar_view"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/default_circle_avatar"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/left_avatar_layout"
                    android:background="@drawable/white_circle_shape"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="-4dp"
                    android:layout_toLeftOf="@+id/center_view">
                    <com.zhenai.common.widget.RoundImageView
                        android:layout_gravity="center"
                        android:id="@+id/left_avatar_view"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/default_circle_avatar"/>
                </FrameLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/left_nickname_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/left_avatar_layout"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/right_nickname_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_toRightOf="@+id/right_avatar_layout"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/bg_story_us_shadow_first"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/love_zone_bg_story_us_shadow_first"
                android:scaleType="fitXY"
                android:layout_below="@+id/avatar_layout"/>
            <com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView
                android:id="@+id/layout_story_us_upload1"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:layout_below="@+id/avatar_layout"
                app:cropper_height="2"
                app:cropper_width="4"
                app:upload_bg_path="@drawable/love_zone_bg_love_experience_edit_6dp"
                app:upload_img_path="@drawable/love_zone_icon_story_us_upload"
                app:upload_img_width="35dp"
                app:upload_padding_img="12dp"
                app:upload_radius="6"
                app:upload_text="@string/love_zone_story_us_upload"
                app:upload_text_size="14sp">
                <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                    android:id="@+id/not_pass_img1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:not_pass_img_path="@drawable/love_zone_icon_story_us_upload"
                    app:not_pass_img_width="35dp"
                    app:not_pass_padding_img="12dp"
                    app:not_pass_text="@string/love_zone_re_upload"
                    app:not_pass_text_size="14sp"/>
            </com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView>
