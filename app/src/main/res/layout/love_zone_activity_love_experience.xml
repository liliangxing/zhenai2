            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/love_zone_icon_wishlist_edit_dots_white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="39dp"
            android:layout_marginRight="50dp"
            android:maxLines="1"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/layout_save_and_commit"
        android:background="#e636277f"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff392885"
            android:gravity="center"
            android:id="@+id/btn_commit"
            android:background="@drawable/love_zone_bg_love_story_commit"
            android:layout_width="173dp"
            android:layout_height="38dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="提交"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@+id/upload_agree_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/upload_agree_ic_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/upload_agree_ic"
                    android:background="@drawable/agree_share_n"
                    android:layout_width="13dp"
                    android:layout_height="13dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i_wanna_share_our_experience_to_others"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffde67"
                android:id="@+id/upload_agree_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_2_participate"
                android:layout_marginStart="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/upload_agree_ic_group"
                app:layout_constraintStart_toEndOf="@+id/upload_agree_ic_group"
                app:layout_constraintTop_toTopOf="@+id/upload_agree_ic_group"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_60_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_wanna_share_our_love_experience_image_2_zhenai"
                app:layout_constraintEnd_toEndOf="@+id/upload_agree_tv"
                app:layout_constraintStart_toStartOf="@+id/upload_agree_ic_group"
                app:layout_constraintTop_toBottomOf="@+id/upload_agree_ic_group"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/layout_auditing"
        android:background="#e636277f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:text="审核中…"/>
    <FrameLayout
        android:id="@+id/layout_not_pass"
        android:background="#ffff6868"
        android:paddingTop="30dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="69dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_not_pass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="审核不通过：不通过内容已标红"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/love_zone_icon_story_us_audit_failed_white"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_back3"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_icon"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/share_experience_agree"
            android:background="@color/color_90_ff36277f"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/free_info"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_lover_shared_your_love_experience_img_2_zhenai_are_you_agree"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="5dp"
                android:paddingHorizontal="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffde67"
                android:id="@+id/change_agree"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mis_operation_click_here2modify_once"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/free_info"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_ff8db5"
                android:gravity="center"
                android:id="@+id/free_info_no"
                android:background="@drawable/love_zone_btn_no"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="@string/love_zone_no_le"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toStartOf="@+id/free_info_yes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/free_info"
                app:layout_goneMarginEnd="27dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/free_info_yes"
                android:background="@drawable/love_zone_btn_yes"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="@string/agree"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/free_info_no"
                app:layout_constraintTop_toBottomOf="@+id/free_info"
                app:layout_goneMarginStart="27dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/comment_and_gift_layout"
            android:background="#f2f4f5"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <EditText
                android:textSize="14sp"
                android:textColor="#26273b"
                android:textColorHint="#aeafb3"
                android:id="@+id/et_message_input"
                android:background="@drawable/love_zone_comment_edit_bg"
                android:padding="12dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:hint="留言"
                android:maxLines="4"
                android:maxLength="100"
                android:layout_centerVertical="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_send_and_gift"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/btn_send_and_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/et_message_input">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_message_send"
                    android:background="@drawable/love_zone_love_send_bg"
                    android:visibility="gone"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="2dp"
                    android:text="@string/love_zone_love_send"/>
                <ImageView
                    android:id="@+id/gift_btn"
                    android:visibility="visible"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/message_input_gift_icon_v2"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
