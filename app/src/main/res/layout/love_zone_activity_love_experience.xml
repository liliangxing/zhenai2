                    android:layout_marginLeft="28dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/love_zone_love_comment_area"
                    android:layout_below="@+id/gift_rv"/>
                <com.zhenai.common.widget.SoftInputListenSwipeRecyclerView
                    android:gravity="center"
                    android:id="@+id/comment_rv"
                    android:paddingTop="10dp"
