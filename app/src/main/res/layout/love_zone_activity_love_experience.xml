                        android:scrollbarThumbVertical="@drawable/infomation_scrollbar_bg"
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:textColorHint="#ccc6c6c6"
                        android:gravity="top|left"
                        android:id="@+id/edt_word1"
                        android:background="@color/transparent"
                        android:paddingLeft="12dp"
                        android:paddingTop="12dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="12dp"
                        android:focusable="true"
                        android:visibility="visible"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/love_zone_we_love_experience_word1"
                        android:maxLength="2000"/>
                    <TextView
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/edt_word1_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="0/2000"
                        android:layout_marginEnd="8dp"/>
                    <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                        android:id="@+id/not_pass_word1"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:not_pass_img_path="@drawable/love_zone_icon_story_us_reedit"
                        app:not_pass_img_width="32dp"
                        app:not_pass_padding_img="12dp"
                        app:not_pass_text="@string/love_zone_re_edit"
                        app:not_pass_text_size="14sp"/>
                </com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView>
                <com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView
                    android:id="@+id/layout_story_us_upload2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="24dp"
                    android:layout_below="@+id/editTextScrollViewMiddleView1"
                    app:upload_bg_path="@drawable/love_zone_bg_love_experience_word"
                    app:upload_img_path="@drawable/love_zone_icon_story_us_upload"
                    app:upload_img_width="24dp"
                    app:upload_padding_img="7dp"
                    app:upload_text="@string/love_zone_story_us_upload1"
                    app:upload_text_size="12sp">
                    <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                        android:id="@+id/not_pass_img2"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:not_pass_img_path="@drawable/love_zone_icon_story_us_upload"
                        app:not_pass_img_width="24dp"
                        app:not_pass_padding_img="7dp"
                        app:not_pass_text="@string/love_zone_re_upload"
                        app:not_pass_text_size="12sp"/>
                </com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView>
                <com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView
                    android:id="@+id/layout_story_us_upload3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="14dp"
                    android:layout_toRightOf="@+id/layout_story_us_upload2"
                    android:layout_below="@+id/editTextScrollViewMiddleView1"
                    app:upload_bg_path="@drawable/love_zone_bg_love_experience_word"
                    app:upload_img_path="@drawable/love_zone_icon_story_us_upload"
                    app:upload_img_width="24dp"
                    app:upload_padding_img="7dp"
                    app:upload_text="@string/love_zone_story_us_upload2"
                    app:upload_text_size="12sp">
                    <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                        android:id="@+id/not_pass_img3"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:not_pass_img_path="@drawable/love_zone_icon_story_us_upload"
                        app:not_pass_img_width="24dp"
                        app:not_pass_padding_img="7dp"
                        app:not_pass_text="@string/love_zone_re_upload"
                        app:not_pass_text_size="12sp"/>
                </com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/story_word_title2"
                    android:background="@drawable/love_zone_bg_story_us_title_frame"
                    android:paddingLeft="14dp"
                    android:paddingTop="2dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/love_zone_share_love_experience"
                    android:layout_below="@+id/layout_story_us_upload3"/>
                <com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView
                    android:id="@+id/editTextScrollViewMiddleView2"
                    android:background="@drawable/love_zone_bg_love_experience_word"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="149dp"
                    android:layout_marginTop="14dp"
                    android:layout_below="@+id/story_word_title2"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp">
                    <EditText
                        android:scrollbarSize="4dp"
                        android:scrollbarThumbVertical="@drawable/infomation_scrollbar_bg"
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:textColorHint="#ccc6c6c6"
                        android:gravity="top|left"
                        android:id="@+id/edt_word2"
                        android:background="@color/transparent"
                        android:paddingLeft="12dp"
                        android:paddingTop="12dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="12dp"
                        android:focusable="true"
                        android:visibility="visible"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/love_zone_we_love_experience_word2"
                        android:maxLength="2000"/>
                    <TextView
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/edt_word2_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="0/2000"
                        android:layout_marginEnd="8dp"/>
                    <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                        android:id="@+id/not_pass_word2"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:not_pass_img_path="@drawable/love_zone_icon_story_us_reedit"
                        app:not_pass_img_width="32dp"
                        app:not_pass_padding_img="12dp"
                        app:not_pass_text="@string/love_zone_re_edit"
                        app:not_pass_text_size="14sp"/>
                </com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView>
                <ImageView
                    android:id="@+id/bg_story_us_shadow_second"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="77dp"
                    android:layout_marginTop="28dp"
                    android:src="@drawable/love_zone_bg_story_us_shadow_second"
                    android:scaleType="fitXY"
                    android:layout_below="@+id/editTextScrollViewMiddleView2"/>
                <com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView
                    android:id="@+id/layout_story_us_upload4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="48dp"
                    android:layout_below="@+id/editTextScrollViewMiddleView2"
                    android:layout_centerHorizontal="true"
                    app:upload_bg_path="@drawable/love_zone_bg_love_experience_edit"
                    app:upload_img_path="@drawable/love_zone_icon_story_us_upload"
                    app:upload_img_width="35dp"
                    app:upload_padding_img="12dp"
                    app:upload_text="@string/love_zone_story_us_upload3"
                    app:upload_text_size="14sp">
                    <com.zhenai.love_zone.love_experience.widget.LoveExperienceNotPassView
                        android:id="@+id/not_pass_img4"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:not_pass_img_path="@drawable/love_zone_icon_story_us_upload"
                        app:not_pass_img_width="35dp"
                        app:not_pass_padding_img="12dp"
                        app:not_pass_text="@string/love_zone_re_upload"
                        app:not_pass_text_size="14sp"/>
                </com.zhenai.love_zone.love_experience.widget.LoveExperiencePhotoUploadView>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/show_layout"
                android:background="@drawable/love_zone_white_round_shape_6dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="86dp"
                android:layout_below="@+id/layout_story_us_upload1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/story_word_title1_show"
                    android:background="@drawable/love_zone_bg_story_us_title_frame"
                    android:paddingLeft="14dp"
                    android:paddingTop="2dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/love_zone_we_love_experience"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff292929"
                    android:id="@+id/text_word1_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="28dp"
                    android:layout_below="@+id/story_word_title1_show"
                    android:lineSpacingMultiplier="1.2"/>
                <ImageView
                    android:id="@+id/img_story_us_2_show"
                    android:background="@drawable/love_zone_bg_love_experience_word"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="14dp"
                    android:scaleType="centerCrop"
                    android:layout_below="@+id/text_word1_show"/>
                <ImageView
                    android:id="@+id/img_story_us_3_show"
                    android:background="@drawable/love_zone_bg_love_experience_word"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="24dp"
                    android:scaleType="centerCrop"
                    android:layout_toRightOf="@+id/img_story_us_2_show"
                    android:layout_below="@+id/text_word1_show"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/story_word_title2_show"
                    android:background="@drawable/love_zone_bg_story_us_title_frame"
                    android:paddingLeft="14dp"
                    android:paddingTop="2dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/love_zone_share_love_experience"
                    android:layout_below="@+id/img_story_us_3_show"/>
                <TextView
