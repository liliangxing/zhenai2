<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ff4a4a4a"
            android:id="@+id/upload_step_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="32dp"
            android:text="@string/love_zone_experience_tips_1"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ff4a4a4a"
            android:id="@+id/upload_step_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="11dp"
            android:layout_marginRight="32dp"
            android:text="@string/love_zone_experience_tips_2"
            android:lineSpacingExtra="5dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_step_1"/>
        <ImageView
            android:id="@+id/upload_step_2_img_1"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/love_zone_pic_story_us_1"
            app:layout_constraintEnd_toStartOf="@+id/upload_step_2_img_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_step_2"
            app:layout_goneMarginTop="15dp"/>
        <ImageView
            android:id="@+id/upload_step_2_img_2"
            android:layout_width="145dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/love_zone_pic_story_us_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/upload_step_2_img_1"
            app:layout_constraintTop_toBottomOf="@+id/upload_step_2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ff4a4a4a"
            android:id="@+id/upload_step_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="32dp"
            android:text="@string/love_zone_experience_tips_3"
            android:lineSpacingExtra="5dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_step_2_img_2"/>
        <ImageView
            android:id="@+id/pic_story_us_3"
            android:layout_width="223sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/love_zone_pic_story_us_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_step_3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
