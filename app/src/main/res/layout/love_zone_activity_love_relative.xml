<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/scrollview_child_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/bg_love_relative"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <FrameLayout
                android:id="@+id/qr_code_layout"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="19dp"
                    android:src="@mipmap/ic_launcher_corner"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#ff000000"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="53dp"
                    android:text="珍爱·情侣空间"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/qr_code"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="21dp"/>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/avatar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="81dp"
                android:layout_centerHorizontal="true">
                <RelativeLayout
                    android:id="@+id/left_avatar_layout"
                    android:background="@drawable/love_zone_relative_male_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/love_zone_bg_lovers_relationship_left"/>
                    <ImageView
                        android:id="@+id/my_avatar_view"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginTop="25dp"
                        android:src="@drawable/default_circle_avatar"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:id="@+id/my_avatar_cover_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:src="@drawable/love_zone_icon_lovers_relationship_headframe_man"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff2f2f2f"
                        android:id="@+id/my_nickname_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:layout_below="@+id/my_avatar_view"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/right_avatar_layout"
                    android:background="@drawable/love_zone_relative_female_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-4dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/love_zone_bg_lovers_relationship_right"
                        app:layout_constraintBottom_toBottomOf="@+id/right_avatar_layout"
                        app:layout_constraintEnd_toEndOf="@+id/right_avatar_layout"
                        app:layout_constraintStart_toStartOf="@+id/right_avatar_layout"
                        app:layout_constraintTop_toTopOf="@+id/right_avatar_layout"/>
                    <ImageView
                        android:id="@+id/other_avatar_view"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginLeft="1dp"
                        android:layout_marginTop="24dp"
                        android:src="@drawable/default_circle_avatar"
                        app:layout_constraintStart_toStartOf="@+id/other_avatar_cover_view"
                        app:layout_constraintTop_toTopOf="@+id/right_avatar_layout"/>
                    <ImageView
                        android:id="@+id/other_avatar_cover_view"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:src="@drawable/love_zone_icon_lovers_relationship_headframe_woman"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintEnd_toEndOf="@+id/right_avatar_layout"
                        app:layout_constraintStart_toStartOf="@+id/right_avatar_layout"
                        app:layout_constraintTop_toTopOf="@+id/right_avatar_layout"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ff2f2f2f"
                        android:id="@+id/other_nickname_view"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:layout_below="@+id/other_avatar_view"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintEnd_toEndOf="@+id/right_avatar_layout"
                        app:layout_constraintStart_toStartOf="@+id/right_avatar_layout"
                        app:layout_constraintTop_toBottomOf="@+id/other_avatar_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/love_zone_bg_lovers_relationship_calendar"
                android:layout_width="340dp"
                android:layout_height="397dp"
                android:layout_marginLeft="-7dp"
                android:layout_marginTop="-1dp"
                android:layout_below="@+id/avatar_layout"
                android:layout_alignLeft="@+id/avatar_layout"/>
            <TextView
                android:textSize="21sp"
                android:textColor="#ffff7b7b"
                android:id="@+id/binding_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="90dp"
                android:layout_below="@+id/avatar_layout"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ff741c4c"
                android:id="@+id/binding_date_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/binding_date"
                android:layout_centerHorizontal="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/item_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="66dp"
                android:layout_marginRight="40dp"
                android:layout_below="@+id/binding_date_title"
                android:layout_centerHorizontal="true"
                android:overScrollMode="never"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/bottom_item"
                android:background="@drawable/love_zone_relative_bottom_btn_shape"
                android:visibility="gone"
                android:layout_width="144dp"
                android:layout_height="43dp"
                android:layout_marginTop="25dp"
                android:layout_below="@+id/item_rv"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/bottom_item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/bottom_item_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="69dp">
        <ImageView
            android:id="@+id/img_back"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:src="@drawable/love_zone_icon_lovers_relationship_back"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/right_icon_more"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/love_zone_icon_lovers_relationship_more"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/right_icon_share"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:layout_marginRight="57dp"
            android:src="@drawable/love_zone_icon_lovers_relationship_share"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/right_icon_change_color"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:layout_marginRight="97dp"
            android:src="@drawable/love_zone_icon_lovers_relationship_theme"/>
        <View
            android:layout_gravity="right"
            android:id="@+id/color_selected_red_point_view"
            android:background="@drawable/red_more_dot"
            android:visibility="gone"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="100dp"/>
    </FrameLayout>
</FrameLayout>
