<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/landing_page_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/love_status_top_iv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/love_status_bottom_iv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_below="@+id/love_status_top_iv"
            android:layout_centerHorizontal="true"/>
        <com.zhenai.business.love_zone.widget.AutoPollRecyclerView
            android:id="@+id/rv_recycleView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="23dp"
            android:layout_below="@+id/love_status_bottom_iv"/>
        <TextView
            android:enabled="true"
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/btn_go"
            android:background="@drawable/love_zone_btn_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="200dp"
            android:layout_marginRight="36dp"
            android:layout_marginBottom="40dp"
            android:text="马上领取"
            android:layout_below="@+id/love_status_top_iv"/>
    </RelativeLayout>
    <include layout="@layout/love_zone_emotion_status_edit_default"/>
</RelativeLayout>
