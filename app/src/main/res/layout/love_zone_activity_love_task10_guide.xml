<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#ff6192ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="78dp"
                android:text="@string/love_zone_love_task_10_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff5a5f6e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="40dp"
                android:text="@string/love_zone_love_task_10_content"
                android:lineSpacingExtra="4dp"/>
            <ImageView
                android:id="@+id/love_zone_pic_tacit_test"
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:layout_marginTop="42dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_start_test"
                android:background="@drawable/love_zone_btn_tacit_test_open"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="@string/love_zone_love_task_10_btn_content"/>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/back_iv"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/love_zone_pic_tacit_test_back"/>
</FrameLayout>
