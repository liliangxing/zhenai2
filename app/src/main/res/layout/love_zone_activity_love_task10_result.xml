<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/love_zone_task_10_result_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/love_zone_bg_tacit_test_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.8"/>
        <ImageView
            android:id="@+id/img_back"
            android:paddingTop="34dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_icon"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"/>
        <ImageView
            android:id="@+id/result_header"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/result_footer"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-22dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/result_middle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/result_middle"
            android:background="@drawable/love_zone_bg_tacit_electronics"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="27dp"
            android:layout_marginRight="27dp"
            android:layout_below="@+id/result_header">
            <FrameLayout
                android:id="@+id/my_avatar_layout"
                android:background="@drawable/white_circle_shape"
                android:padding="2dp"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toStartOf="@+id/other_avatar_layout"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/my_avatar_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_circle_avatar"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/other_avatar_layout"
                android:background="@drawable/white_circle_shape"
                android:padding="2dp"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginLeft="74dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/my_avatar_layout"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/other_avatar_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_circle_avatar"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="已完成"
                app:layout_constraintLeft_toLeftOf="@+id/my_avatar_layout"
                app:layout_constraintRight_toRightOf="@+id/my_avatar_layout"
                app:layout_constraintTop_toBottomOf="@+id/my_avatar_layout"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:id="@+id/other_finish_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="@+id/other_avatar_layout"
                app:layout_constraintRight_toRightOf="@+id/other_avatar_layout"
                app:layout_constraintTop_toBottomOf="@+id/other_avatar_layout"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:id="@+id/love_zone_tacit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/love_zone_tacit_point"
                app:layout_constraintEnd_toStartOf="@+id/love_zone_tacit_point"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/other_finish_status_tv"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#ff1dffd5"
                android:id="@+id/love_zone_tacit_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/love_zone_tacit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/love_zone_tacit"
                app:layout_constraintTop_toTopOf="@+id/love_zone_tacit"/>
            <com.zhenai.love_zone.love_task.task10.widget.Task10ResultProgressBar
                android:id="@+id/love_zone_tacit_progress"
                android:background="#000"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="55dp"
                app:layout_constraintBottom_toTopOf="@+id/result_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/other_finish_status_tv"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:id="@+id/result_content"
                android:background="@drawable/love_zone_bg_tacit_information"
                android:paddingTop="29dp"
                android:paddingBottom="29dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/watch_other_result_btn"
                app:layout_constraintTop_toBottomOf="@+id/love_zone_tacit_progress"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff4e8cf8"
                android:gravity="center"
                android:id="@+id/watch_other_result_btn"
                android:background="@drawable/love_zone_btn_tacit_check"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="46dp"
                android:text="@string/love_zone_watch_other_result"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/result_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</ScrollView>
