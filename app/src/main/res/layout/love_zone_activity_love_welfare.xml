<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#fffff6e8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/love_zone_bg_lover_certificate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/lover_card_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="123dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/lover_card"
                    android:layout_width="331dp"
                    android:layout_height="278dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffff938e"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/button_card_status"
                    android:background="@drawable/love_zone_shape_not_get"
                    android:layout_width="127dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/love_zone_welfare_not_get"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/unlock_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_below="@+id/lover_card_layout"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_pic_lover_certificate_privilege_line_left"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffff938e"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginRight="11dp"
                    android:text="还可解锁以下特权"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_pic_lover_certificate_privilege_line_right"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/item_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/unlock_title_layout"
                android:layout_centerHorizontal="true"
                android:overScrollMode="never"/>
        </RelativeLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/love_zone_bg_lover_certificate_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="69dp">
            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:layout_marginTop="34dp"
                android:src="@drawable/back_icon"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/title_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="37dp"
                android:layout_marginRight="14dp"
                android:text="@string/love_zone_how_to_bind"/>
            <TextView
                android:textSize="19sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="34dp"
                android:text="@string/love_zone_love_welfare"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:id="@+id/header_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="77dp"
            android:layout_marginRight="30dp"
            android:lineSpacingExtra="3dp"/>
    </FrameLayout>
</FrameLayout>
