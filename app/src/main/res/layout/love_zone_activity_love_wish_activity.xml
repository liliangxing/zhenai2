<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#51b2df"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_live_video_castle_big_firework"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/love_zone_piaoliuping"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lighthouse"
        android:layout_width="70dp"
        android:layout_height="87dp"
        android:layout_marginLeft="39dp"/>
    <FrameLayout
        android:background="@drawable/love_zone_love_wish_header"
        android:layout_width="match_parent"
        android:layout_height="69dp">
        <ImageView
            android:id="@+id/img_back"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:src="@drawable/back_icon"
            android:paddingStart="21dp"
            android:paddingEnd="20dp"/>
        <TextView
            android:textSize="19sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="34dp"
            android:text="@string/love_zone_love_wish_list"/>
    </FrameLayout>
    <View
        android:layout_gravity="center"
        android:id="@+id/piaoliuping_click_area"
        android:layout_width="match_parent"
        android:layout_height="230dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/add_wish_btn"
        android:background="@drawable/love_zone_btn_wishlist_homepage_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="67dp">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:src="@drawable/love_zone_icon_wishlist_homepage_add_blue"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff009df0"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加愿望"/>
    </LinearLayout>
</FrameLayout>
