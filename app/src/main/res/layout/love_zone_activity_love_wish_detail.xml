<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/unBindMemoryLayout"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/wish_bg"
            android:background="@drawable/love_zone_love_wish_img_bg"
            android:padding="1dp"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginTop="70dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/finish_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/love_zone_icon_wishlist_label_finish_red"
            android:layout_alignTop="@+id/wish_bg"
            android:layout_alignRight="@+id/wish_bg"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/wish_bg">
            <TextView
                android:textSize="17sp"
                android:textColor="#ff000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff5d5d5d"
                android:layout_gravity="center_horizontal"
                android:id="@+id/desc_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="36dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/wish_achieve_btn"
                android:background="@drawable/love_zone_btn_wishlist_finish_orange"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:text="愿望实现啦！"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ffff9c9c"
                android:layout_gravity="center_horizontal"
                android:id="@+id/finish_time_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="33dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/add_memory_btn"
                android:background="@drawable/love_zone_btn_wishlist_add_memory_red"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/love_zone_icon_wishlist_memory_add"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记录回忆"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/bg_memory_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/bg_cover_memory_layout"
        android:background="#33000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ScrollView
        android:id="@+id/bindMemoryLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingLeft="19dp"
            android:paddingRight="19dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/bg_memory_avatar"
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_marginTop="70dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/love_zone_icon_wishlist_label_finish_red_small"
                android:layout_alignTop="@+id/bg_memory_avatar"
                android:layout_alignRight="@+id/bg_memory_avatar"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:id="@+id/memory_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="19dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/bg_memory_avatar"
                android:layout_alignTop="@+id/bg_memory_avatar"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:id="@+id/memory_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="19dp"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@+id/bg_memory_avatar"
                android:layout_below="@+id/memory_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:id="@+id/memory_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_below="@+id/bg_memory_avatar"/>
            <FrameLayout
                android:id="@+id/layout_middle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-4dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="-4dp"
                android:layout_below="@+id/memory_time"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffffff"
                android:id="@+id/memory_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="26dp"
                android:layout_below="@+id/layout_middle"/>
        </RelativeLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/img_more"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="30dp"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"/>
    </FrameLayout>
</FrameLayout>
