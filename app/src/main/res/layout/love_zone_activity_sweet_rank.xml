<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/love_zone_bg_sweetness_android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="@drawable/love_zone_pic_sweetness_top_crown_first_big"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:layout_width="139dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="103dp"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/other_avatar_layout"
            android:background="@drawable/love_zone_yellow_circle_shape"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginLeft="20dp">
            <com.zhenai.common.widget.RoundImageView
                android:layout_gravity="center"
                android:id="@+id/other_avatar_view"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/default_avatar"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="left"
            android:id="@+id/my_avatar_layout"
            android:background="@drawable/love_zone_yellow_circle_shape"
            android:layout_width="74dp"
            android:layout_height="74dp">
            <com.zhenai.common.widget.RoundImageView
                android:layout_gravity="center"
                android:id="@+id/my_avatar_view"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/default_avatar"/>
        </FrameLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/love_zone_pic_sweetness_top_ribbon"
        android:layout_width="285dp"
        android:layout_height="42dp"
        android:layout_marginTop="167dp"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:src="@drawable/love_zone_pic_sweetness_top_golden_love"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fffffbfc"
        android:id="@+id/rank_point_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="170dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:id="@+id/rank_desc_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="218dp"
        android:text="@string/love_zone_sweet_rank_desc_week"
        android:drawableLeft="@drawable/love_zone_icon_sweetness_explain_title"
        android:drawableRight="@drawable/love_zone_icon_sweetness_explain_title"
        android:drawablePadding="10dp"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/tab_layout_container"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="245dp"
        android:layout_marginRight="10dp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager_sweet_rank"
        android:background="@drawable/love_zone_white_round_bottom_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/tab_layout_container"/>
    <FrameLayout
        android:id="@+id/page_title"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="69dp">
        <ImageView
            android:id="@+id/img_back"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:src="@drawable/back_icon"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="39dp"
            android:layout_marginRight="50dp"
            android:text="排行榜"
            android:maxLines="1"/>
    </FrameLayout>
</RelativeLayout>
