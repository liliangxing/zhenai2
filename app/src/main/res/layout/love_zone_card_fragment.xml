<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/love_zone_bg_lover_certificate_exhibition"
        android:scaleType="fitXY"/>
    <com.zhenai.common.widget.RoundImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/love_zone_bg_lover_certificate_insidepages"
        android:layout_width="331dp"
        android:layout_height="406dp"
        android:layout_marginTop="73dp"
        android:layout_centerHorizontal="true"
        app:borderRadius="4dp"
        app:roundImageType="round"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="97dp"
        android:src="@drawable/love_zone_pic_lover_certificate_cover"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="240dp"
        android:src="@drawable/love_zone_pic_lover_certificate_cover_words"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/other_avatar_layout"
        android:background="@drawable/love_zone_card_avatar_shape"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="296dp"
        android:layout_toRightOf="@+id/mine_avatar_layout">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/other_avatar_view"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/default_avatar"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mine_avatar_layout"
        android:background="@drawable/love_zone_card_avatar_shape"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginLeft="31dp"
        android:layout_marginTop="296dp"
        android:layout_alignLeft="@+id/love_zone_bg_lover_certificate_insidepages">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/mine_avatar_view"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/default_avatar"/>
    </FrameLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="41dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/love_zone_bg_lover_certificate_insidepages_head_line"
        android:layout_below="@+id/other_avatar_layout"
        android:layout_alignLeft="@+id/love_zone_bg_lover_certificate_insidepages"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="315dp"
        android:layout_toRightOf="@+id/other_avatar_layout"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffc89385"
            android:id="@+id/card_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="14dp"
            android:layout_centerHorizontal="true"/>
        <View
            android:background="#ffc89385"
            android:layout_width="wrap_content"
            android:layout_height="0.5dp"
            android:layout_below="@+id/card_no"
            android:layout_alignLeft="@+id/card_no"
            android:layout_alignRight="@+id/card_no"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/heart_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="29dp"
        android:layout_marginRight="13dp"
        android:src="@drawable/love_zone_pic_lover_certificate_insidepages_love"
        android:layout_below="@+id/other_avatar_layout"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ff515151"
        android:id="@+id/my_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_toLeftOf="@+id/heart_iv"
        android:layout_below="@+id/other_avatar_layout"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ff515151"
        android:id="@+id/other_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_toRightOf="@+id/heart_iv"
        android:layout_below="@+id/other_avatar_layout"/>
    <View
        android:id="@+id/top_line"
        android:background="#ffc89385"
        android:layout_width="134dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="17dp"
        android:layout_below="@+id/heart_iv"
        android:layout_alignLeft="@+id/receive_date"
        android:layout_alignRight="@+id/receive_date"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffc89385"
        android:id="@+id/love_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/top_line"
        android:layout_alignLeft="@+id/love_zone_bg_lover_certificate_insidepages"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffc89385"
        android:id="@+id/receive_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/love_date"
        android:layout_alignLeft="@+id/love_zone_bg_lover_certificate_insidepages"/>
    <View
        android:id="@+id/bottom_line"
        android:background="#ffc89385"
        android:layout_width="134dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/receive_date"
        android:layout_alignLeft="@+id/receive_date"
        android:layout_alignRight="@+id/receive_date"/>
    <ImageView
        android:id="@+id/close_iv"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/love_zone_icon_lover_certificate_close_white"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
