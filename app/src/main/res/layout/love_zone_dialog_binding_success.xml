<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_centerInParent="true">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.RoundImageView
                android:layout_width="295dp"
                android:layout_height="160dp"
                android:src="@drawable/love_zone_bg_popup_binding_success"
                app:radius_left_up="4dp"
                app:radius_right_up="4dp"
                app:roundImageType="round"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="144dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="right"
                    android:id="@+id/blue_heart_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_icon_violet_love"
                    android:alpha="1"/>
                <ImageView
                    android:id="@+id/red_heart_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_icon_red_love"
                    android:alpha="1"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="144dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="right"
                    android:id="@+id/blue_heart_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_icon_violet_love"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/red_heart_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/love_zone_icon_red_love"
                    android:alpha="0"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/popup_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/love_zone_icon_popup_arrow"
                    android:alpha="0"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_binding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="19dp"
            android:layout_marginRight="14dp"/>
        <TextView
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/bg_pink_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="20dp"
            android:text="@string/love_zone_set_memorial_day"/>
    </LinearLayout>
</RelativeLayout>
