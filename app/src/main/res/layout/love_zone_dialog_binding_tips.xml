<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_centerInParent="true">
        <com.zhenai.common.widget.RoundImageView
            android:layout_width="280dp"
            android:layout_height="160dp"
            android:src="@drawable/love_zone_bg_popup_unbound"
            android:scaleType="centerCrop"
            app:radius_left_up="4dp"
            app:radius_right_up="4dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/love_zone_you_not_binding_lover"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff737583"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/love_zone_can_checkin_binding_lover"/>
        <TextView
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/bg_pink_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="20dp"
            android:text="@string/love_zone_go_binding"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-11dp"
        android:src="@drawable/ic_common_dialog_close_btn"
        android:layout_alignTop="@+id/evaluatelay"
        android:layout_alignRight="@+id/evaluatelay"/>
</RelativeLayout>
