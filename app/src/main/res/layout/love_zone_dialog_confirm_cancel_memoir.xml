<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="45dp"
            android:text="@string/memory_sure_delete"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/checkbox_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="30dp">
            <ImageView
                android:id="@+id/cancel_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/love_zone_circle_check_shape"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ff737583"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/memory_delete"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="14dp">
            <TextView
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="#8773ed"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/love_zone_shape_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <TextView
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/love_zone_shape_btn_sure"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="15dp"
                android:text="@string/upload_avatar_btn_upload"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
