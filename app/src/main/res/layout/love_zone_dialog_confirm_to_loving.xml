<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="283dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="14dp"
            android:text="@string/love_zone_change_to_single_will"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="15dp"
            android:text="@string/love_zone_change_to_single_will_1"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/icon_recommend_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp"
            android:text="@string/love_zone_change_to_single_will_2"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/icon_recommend_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp"
            android:text="@string/love_zone_change_to_single_will_3"
            android:drawablePadding="16dp"
            android:drawableStart="@drawable/icon_recommend_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="23dp"
            android:layout_marginRight="15dp"
            android:text="@string/love_zone_change_to_single_will_not_back"
            android:drawablePadding="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:layout_marginBottom="24dp">
            <Button
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_no"
                android:background="@drawable/common_long_btn_selector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/love_zone_no_le"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_revert_to_single"
                android:layout_width="0dp"
                android:text="@string/love_zone_revert_to_single"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="11dp"
                style="@style/CommonMiddleStrokeBtnStyle"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
