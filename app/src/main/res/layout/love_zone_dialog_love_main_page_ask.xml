<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/love_zone_bg_white_round_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="15dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="17sp"
            android:textColor="#ff3e3e3e"
            android:layout_gravity="left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="19dp"
            android:text="我想问… "/>
        <com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView
            android:id="@+id/editTextScrollViewMiddleView"
            android:background="@drawable/love_zone_bg_ask_edit_shape"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <com.zhenai.love_zone.widget.CustomEditTextView
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/infomation_scrollbar_bg"
                android:textSize="12sp"
                android:textColor="#ff3e3e3e"
                android:textColorHint="#ffc6c6c6"
                android:gravity="top|left"
                android:id="@+id/edt_word"
                android:background="@color/transparent"
                android:paddingLeft="12dp"
                android:paddingTop="12dp"
                android:paddingRight="5dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:visibility="visible"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/love_zone_lover_ask_hint"
                android:maxLength="100"/>
        </com.zhenai.common.widget.scroll_view.EditTextScrollViewMiddleView>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff434343"
            android:layout_gravity="right"
            android:id="@+id/text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="11dp"
            android:text="0/100"/>
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/ask_commit"
            android:background="@drawable/love_zone_ask_commit_disable"
            android:layout_width="158dp"
            android:layout_height="38dp"
            android:layout_marginBottom="21dp"
            android:text="提交"/>
    </LinearLayout>
    <com.zhenai.common.widget.CommonCloseImageView
        android:id="@+id/iv_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-15dp"
        android:layout_marginRight="-10dp"
        android:layout_alignTop="@+id/evaluatelay"
        android:layout_alignRight="@+id/evaluatelay"
        app:close_color="@color/color_FF7272"/>
</RelativeLayout>
