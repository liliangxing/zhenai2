<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_centerInParent="true">
        <com.zhenai.common.widget.RoundImageView
            android:id="@+id/unlock_banner"
            android:layout_width="280dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            app:radius_left_up="4dp"
            app:radius_right_up="4dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/love_zone_unlock_love_mode"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff737583"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/love_zone_share_your_sweet"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="14dp">
            <TextView
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="#ff8db5"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/love_zone_bg_pink_stoke_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/love_zone_no_le"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/btn_off_course"
                android:background="@drawable/bg_pink_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="14dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/love_zone_share_your_happiness"
                    android:drawablePadding="5dp"
                    android:drawableStart="@drawable/love_zone_icon_popup_btn_showlove"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
