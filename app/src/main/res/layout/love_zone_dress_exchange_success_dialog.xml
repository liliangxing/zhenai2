<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/evaluatelay"
        android:background="@drawable/bg_round_real_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/love_zone_exchange_success"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/love_zone_congratulation_get"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff737583"
            android:id="@+id/dress_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:enabled="true"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/love_zone_bg_save_btn_shape"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="14dp"
            android:text="@string/love_zone_use_now"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="-11dp"
        android:src="@drawable/ic_common_dialog_close_btn"
        android:layout_alignTop="@+id/evaluatelay"
        android:layout_alignRight="@+id/evaluatelay"/>
</RelativeLayout>
