<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="41dp"
        android:src="@drawable/love_zone_pic_costumes_comingsoon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff6e717f"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="41dp"
        android:text="@string/love_zone_personal_dress_coming"/>
    <View
        android:background="#13000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="19dp"
        android:layout_marginRight="19dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ff666978"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginTop="14dp"
        android:text="@string/love_zone_dress_intro_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff666978"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="19dp"
        android:layout_marginBottom="37dp"
        android:text="@string/love_zone_dress_intro"
        android:lineSpacingExtra="3dp"/>
</LinearLayout>
