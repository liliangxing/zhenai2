<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.love_zone.dress_store.DressStoreShowLayout
        android:id="@+id/dress_store_show_layout"
        android:background="@drawable/love_zone_dress_store_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/dress_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/dress_store_show_layout"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="13sp"
            android:textColor="#ff42475c"
            android:id="@+id/dress_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/dress_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/dress_title_layout"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/dress_instruction_icon"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ffb2b8c4"
            android:id="@+id/dress_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
