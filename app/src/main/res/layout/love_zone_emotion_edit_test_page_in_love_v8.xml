<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_inlove"
    android:background="@color/color_f2f4f5"
    android:paddingTop="@dimen/dp8"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/header_layout_inlove"
        android:background="@drawable/love_zone_bg_choice_inlove_pink_android_v8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp120"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp12"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp12"/>
    <View
        android:background="@drawable/bg_white_16dp_radius"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp90"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_layout_inlove"/>
    <FrameLayout
        android:id="@+id/mine_avatar_layout"
        android:background="@drawable/white_circle_shape"
        android:layout_width="@dimen/dp104"
        android:layout_height="@dimen/dp104"
        android:layout_marginTop="@dimen/dp38"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mine_avatar_view_in_love"
            android:layout_width="@dimen/dp99"
            android:layout_height="@dimen/dp99"
            android:src="@drawable/default_circle_avatar"/>
    </FrameLayout>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/header_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="当前情感状态：恋爱中"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_avatar_layout"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="- 恢复单身后将 -"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_tv"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_ff7599"
        android:gravity="center"
        android:id="@+id/tv_revert_single"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp53"
        android:layout_marginLeft="@dimen/dp35"
        android:layout_marginTop="@dimen/dp56"
        android:layout_marginRight="@dimen/dp35"
        android:text="恢复单身"
        android:layout_marginHorizontal="@dimen/dp35"
        app:bg_colorStroke="@color/color_ff7599"
        app:bg_radius="@dimen/dp38"
        app:bg_shape="semicircle"
        app:bg_strokeMode="solid"
        app:bg_strokeWidth="@dimen/dp1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/items_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
