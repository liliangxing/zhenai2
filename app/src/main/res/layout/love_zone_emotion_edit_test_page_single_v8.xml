<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_single"
    android:background="@color/color_f2f4f5"
    android:paddingTop="@dimen/dp8"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/header_layout_single"
        android:background="@drawable/love_zone_bg_choice_single_violet_android_v8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp120"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp12"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp12"/>
    <View
        android:background="@drawable/bg_white_16dp_radius"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp90"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_layout_single"/>
    <FrameLayout
        android:id="@+id/mine_avatar_layout"
        android:background="@drawable/white_circle_shape"
        android:layout_width="@dimen/dp104"
        android:layout_height="@dimen/dp104"
        android:layout_marginTop="@dimen/dp38"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header_layout_single">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/mine_avatar_view_single"
            android:layout_width="@dimen/dp99"
            android:layout_height="@dimen/dp99"
            android:src="@drawable/default_circle_avatar"/>
    </FrameLayout>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/header_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="当前感情状态：单身"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_avatar_layout"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_26273c"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="-  脱单且绑定情侣关系后即享有以下特权  -"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/privilege_item_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_centerHorizontal="true"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_no_single"
        android:background="@drawable/bg_rectangle_767dff_40r_shape"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp53"
        android:layout_marginLeft="@dimen/dp35"
        android:layout_marginTop="@dimen/dp56"
        android:layout_marginRight="@dimen/dp35"
        android:text="我已脱单"
        android:layout_marginHorizontal="@dimen/dp35"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privilege_item_rv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
