<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_patent"
    android:background="@color/white"
    android:paddingLeft="10dp"
    android:layout_width="match_parent"
    android:layout_height="58dp">
    <ImageView
        android:id="@+id/rank_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff8c8c8c"
        android:gravity="center"
        android:id="@+id/rank_tv"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_centerVertical="true"/>
    <FrameLayout
        android:id="@+id/other_avatar_layout"
        android:background="@drawable/love_zone_yellow_circle_shape"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="78dp"
        android:layout_centerVertical="true">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/other_avatar_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/default_avatar"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/my_avatar_layout"
        android:background="@drawable/love_zone_yellow_circle_shape"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="46dp"
        android:layout_centerVertical="true">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/my_avatar_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/default_avatar"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/rank_change_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginRight="19dp"
        android:src="@drawable/love_zone_icon_sweetness_arrow_up_red"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff4a4a4a"
        android:ellipsize="end"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="122dp"
        android:layout_marginTop="13dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/rank_change_iv"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ffff7577"
        android:id="@+id/sweet_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="122dp"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/title_tv"/>
</RelativeLayout>
