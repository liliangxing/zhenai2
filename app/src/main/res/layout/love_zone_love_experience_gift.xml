<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mine_avatar_layout"
        android:background="@drawable/white_circle_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="7dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/avatar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:src="@drawable/default_avatar"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/gift_count"
            android:background="@drawable/love_zone_love_experience_gift_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:id="@+id/gift_icon_layout"
        android:background="@drawable/love_zone_love_experience_gift_icon_bg"
        android:layout_width="27dp"
        android:layout_height="27dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/gift_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:scaleType="fitXY"/>
    </FrameLayout>
</FrameLayout>
