<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_patent"
    android:paddingTop="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatar_layout"
        android:background="@drawable/white_circle_shape"
        android:padding="2dp"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="15dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/avatar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/default_avatar"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#ff464646"
        android:id="@+id/sender_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_toRightOf="@+id/avatar_layout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff464646"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:layout_toRightOf="@+id/avatar_layout"
        android:layout_below="@+id/sender_nickname"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#ff464646"
        android:id="@+id/time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="9dp"
        android:layout_toRightOf="@+id/avatar_layout"
        android:layout_below="@+id/content"/>
    <ImageView
        android:id="@+id/gift_iv"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginRight="15dp"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="15dp"
        android:layout_below="@+id/time_tv"/>
</RelativeLayout>
