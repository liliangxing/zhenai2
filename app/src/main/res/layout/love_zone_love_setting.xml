<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.ListItemLayout
        android:id="@+id/layout_love_relative"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:arrowIcon="@drawable/icon_enter"
        app:contentColor="#ff8162"
        app:contentMarginRight="16dp"
        app:contentSize="15sp"
        app:lineMarginLeft="19dp"
        app:lineVisibility="true"
        app:paddingLeft="19dp"
        app:paddingRight="19dp"
        app:titleColor="@color/color_666978"
        app:titleSize="14sp"
        app:titleText="@string/love_zone_lover_relative"/>
    <com.zhenai.common.widget.ListItemLayout
        android:id="@+id/layout_data_watch_permission"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:arrowIcon="@drawable/icon_enter"
        app:contentColor="#ff8162"
        app:contentMarginRight="16dp"
        app:contentSize="15sp"
        app:lineMarginLeft="19dp"
        app:lineVisibility="true"
        app:paddingLeft="19dp"
        app:paddingRight="19dp"
        app:titleColor="@color/color_666978"
        app:titleSize="14sp"
        app:titleText="@string/love_zone_data_watch_permission"/>
    <com.zhenai.common.widget.ListItemLayout
        android:id="@+id/layout_callback"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:arrowIcon="@drawable/icon_enter"
        app:contentColor="#ff8162"
        app:contentMarginRight="16dp"
        app:contentSize="15sp"
        app:lineMarginLeft="19dp"
        app:lineVisibility="true"
        app:paddingLeft="19dp"
        app:paddingRight="19dp"
        app:titleColor="@color/color_666978"
        app:titleSize="14sp"
        app:titleText="@string/love_zone_love_opinion_feedback"/>
    <com.zhenai.common.widget.ListItemLayout
        android:id="@+id/layout_revert_single"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:arrowIcon="@drawable/icon_enter"
        app:contentColor="#ff8162"
        app:contentMarginRight="16dp"
        app:contentSize="15sp"
        app:lineMarginLeft="19dp"
        app:lineVisibility="true"
        app:paddingLeft="19dp"
        app:paddingRight="19dp"
        app:titleColor="@color/color_666978"
        app:titleSize="14sp"
        app:titleText="@string/love_zone_revert_single"/>
</LinearLayout>
