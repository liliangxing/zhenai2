<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/evaluatelay"
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginHorizontal="48dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            app:borderRadius="16dp"
            app:roundImageType="round"/>
        <com.zhenai.common.widget.BoldTextView
            android:textSize="18sp"
            android:textColor="#26273c"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/love_zone_you_cannot_edit_love_status"
            android:maxLines="1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6c6d75"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="24dp"
            android:text="@string/love_zone_you_can_go_on_by_manual_audit"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="24dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_continue"
            android:background="@drawable/bg_ff767dff_rectangle_22_radius"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="24dp"
            android:text="@string/love_zone_continue_goon"
            android:layout_below="@+id/tv_content"
            android:layout_marginHorizontal="24dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#767dff"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:text="@string/cancel"
            android:layout_below="@+id/btn_continue"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="14dp"/>
    </RelativeLayout>
</FrameLayout>
