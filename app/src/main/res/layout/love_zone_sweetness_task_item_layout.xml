<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="77dp"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">
    <ImageView
        android:id="@+id/icon_iv"
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/btn_tv"
        android:background="@drawable/love_zone_shape_binding_btn"
        android:layout_width="67dp"
        android:layout_height="29dp"
        android:text="完成"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="19sp"
        android:textColor="#ffff8284"
        android:id="@+id/add_point"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="23dp"
        android:layout_marginBottom="-10dp"
        android:layout_above="@+id/btn_tv"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/btn_tv"
        android:layout_toEndOf="@+id/icon_iv">
        <RelativeLayout
            android:id="@+id/item_layout1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff4a4a4a"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffa0a0a0"
                android:id="@+id/sub_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_below="@+id/title_tv"
                android:layout_alignStart="@+id/title_tv"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/item_layout2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff4a4a4a"
                android:id="@+id/title_tv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffa0a0a0"
                android:id="@+id/sub_title_tv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_below="@+id/title_tv2"
                android:layout_alignStart="@+id/title_tv2"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/line_view"
        android:background="#ffffd1d1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
