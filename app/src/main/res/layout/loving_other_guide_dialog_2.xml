<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_dialog_layout"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg_other_guide_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_guide_me_android"/>
    <FrameLayout
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/next_step"
        android:layout_width="270dp"
        android:layout_height="217dp"
        android:src="@drawable/pic_guide2"
        android:layout_alignBottom="@+id/bg_other_guide_2"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/next_step2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:src="@drawable/pic_guide3"
        android:layout_alignBottom="@+id/bg_other_guide_2"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/pic_guide_affective"
        android:background="@drawable/pic_guide_affective"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/next_step2"/>
</RelativeLayout>
