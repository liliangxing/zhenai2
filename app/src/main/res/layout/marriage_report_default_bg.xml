<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/marriage_report_area_parent"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/marriage_report_area_b"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="93.67dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="10dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="62dp"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_gravity="center"
                android:background="@drawable/bg_marriage_view_avatar"
                android:layout_width="39dp"
                android:layout_height="39dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/marriage_img_avatar_mine_b"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="19.5dp"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_gravity="center"
                android:background="@drawable/bg_marriage_view_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/marriage_img_avatar_other_b"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="109dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:id="@+id/marriage_btn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_how_match"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/marriage_btn_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/and_teacher_advise"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
