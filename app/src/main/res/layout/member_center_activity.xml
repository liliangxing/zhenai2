<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.business.widget.autosrcoll_banner_listview.ZAAutoScrollBanner
                android:id="@+id/view_banners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="8dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp">
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="50dp"
                        android:layout_height="50dp"/>
                    <ImageView
                        android:id="@+id/iv_member_flag"
                        android:visibility="gone"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/icon_zhenxin_member"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="13.9sp"
                        android:textColor="#42475c"
                        android:id="@+id/tv_service_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#666978"
                        android:id="@+id/tv_privilege_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/ll_open_member"
                    android:background="@drawable/btn_open_member_selector"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4.5dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/btn_open_member_icon"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_open_member"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="@string/open_member"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="4dp">
                <com.zhenai.common.widget.ListItemLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:arrowIconVisibility="false"
                    app:leftIcon="@drawable/info_card_title_left_image"
                    app:lineMarginLeft="8dp"
                    app:lineMarginRight="8dp"
                    app:paddingLeft="8dp"
                    app:titleColor="#42475c"
                    app:titleMarginLeft="7.5dp"
                    app:titleSize="16sp"
                    app:titleText="特权介绍"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_privileges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/love_welfare_layout"
                android:background="@drawable/bg_card_corner_all"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="4dp">
                <com.zhenai.common.widget.ListItemLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:arrowIconVisibility="false"
                    app:leftIcon="@drawable/info_card_title_left_image"
                    app:lineMarginLeft="8dp"
                    app:lineMarginRight="8dp"
                    app:lineVisibility="true"
                    app:paddingLeft="8dp"
                    app:titleColor="#42475c"
                    app:titleMarginLeft="7.5dp"
                    app:titleSize="16sp"
                    app:titleText="专属恋爱福利"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:src="@drawable/pic_lover_certificate"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
