<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="15dp">
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_attention_message_item_avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/default_avatar"
        android:scaleType="centerInside"
        app:radius_left_down="16dp"
        app:radius_left_up="16dp"
        app:radius_right_down="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_attention_unread_count"
        android:background="@drawable/bg_fd5a67_circle_white_stroke"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="50dp"
        android:layout_alignBottom="@+id/iv_attention_message_item_avatar"
        android:layout_marginStart="50dp"
        android:layout_alignStart="@+id/iv_attention_message_item_avatar"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#26273c"
        android:id="@+id/attention_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/iv_attention_message_item_avatar"
        app:layout_flexShrink="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#767dff"
        android:id="@+id/new_attention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:singleLine="true"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/attention_num"
        app:layout_flexShrink="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6c6d75"
        android:ellipsize="end"
        android:id="@+id/tv_attention_message_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:layout_below="@+id/attention_num"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/iv_attention_message_item_avatar"/>
</RelativeLayout>
