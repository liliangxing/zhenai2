<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.message.message.wigdet.RoundRectRingProgressView
        android:id="@+id/count_down_progress_reply"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/iv_message_item_avatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/default_avatar"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:radius_left_down="16dp"
        app:radius_left_up="16dp"
        app:radius_right_down="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"/>
    <ImageView
        android:id="@+id/iv_place_top"
        android:background="@drawable/icon_message_list_topping"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/layout_living"
        android:background="@drawable/bg_ff7599_rectangle_bottom_16_radius"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_message_item_avatar"
        app:layout_constraintEnd_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_message_item_avatar">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/living"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/iv_living"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_living"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginBottom="1dp"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_fileName="animation/message_living_play_white.json"
            app:lottie_loop="true"/>
    </RelativeLayout>
    <com.zhenai.common.widget.RoundImageView
        android:gravity="center"
        android:id="@+id/tv_freely_chat_icon"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="18dp"
        android:src="@drawable/icon_message_list_freely_chat_v2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_message_item_avatar"
        app:layout_constraintEnd_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_message_item_avatar"
        app:radius_left_down="16dp"
        app:radius_right_down="16dp"
        app:roundImageType="round"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_jingxuanzaixian"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="18dp"
        android:text="@string/sub_tab_text_jingxuanzaixian"
        app:bg_colorNormal="#09ca7d"
        app:bg_fillMode="color"
        app:bg_radiusLeftBottom="16dp"
        app:bg_radiusRightBottom="16dp"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_message_item_avatar"
        app:layout_constraintEnd_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_message_item_avatar"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_unread_count"
        android:background="@drawable/bg_fd5a67_circle_white_stroke"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="11dp"
        android:layout_marginStart="56dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/layout_name_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="78dp"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_message_item_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/tv_message_item_time"
            android:layout_alignParentStart="true"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="nowrap">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#26273c"
                android:ellipsize="end"
                android:id="@+id/tv_message_item_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                app:layout_flexShrink="1"/>
            <com.zhenai.business.widget.FlagLayout
                android:id="@+id/view_message_item_flags"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#bcbcbc"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_message_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            app:layout_flexGrow="1"
            app:layout_flexShrink="0"/>
    </RelativeLayout>
    <com.zhenai.business.widget.label_layout.LabelLayout
        android:id="@+id/label_layout_info"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:auto_select_effect="false"
        app:layout_constraintEnd_toStartOf="@+id/iv_message_item_lock"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/layout_name_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#6c6d75"
        android:ellipsize="end"
        android:id="@+id/tv_message_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="40dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/label_layout_info"/>
    <ImageView
        android:id="@+id/iv_message_item_lock"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_message_list_locked_v2"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_name_title"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_message_item_lovekey"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_message_item_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_message_item_content"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/lovekey_lock.json"
        app:lottie_imageAssetsFolder="images/lovekey_lock"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/supper_remind_tag"
        android:background="@drawable/bg_767dff_rectangle_3b767dff_stroke_9_radius"
        android:paddingLeft="@dimen/dimen_6dp"
        android:paddingRight="@dimen/dimen_6dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:text="@string/message_super_remind_tag_v2"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_message_item_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_message_item_content"
        app:layout_flexGrow="1"
        app:layout_flexShrink="0"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff7599"
        android:gravity="center_vertical"
        android:id="@+id/tv_send_gift"
        android:background="@drawable/bg_message_send_gift_conent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:drawableLeft="@drawable/ic_message_send_gift_content_left"
        android:drawablePadding="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_message_item_content"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_6c6d75"
        android:gravity="center_vertical"
        android:id="@+id/tv_distance"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:drawableLeft="@drawable/icon_location_gray"
        android:drawablePadding="0dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_message_item_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#b25a29"
        android:gravity="center_vertical"
        android:id="@+id/tv_chat_card_user"
        android:background="@drawable/bg_message_chat_card_conent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:drawableLeft="@drawable/icon_chat_card_tag"
        android:drawablePadding="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_message_item_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_message_item_content"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="9sp"
        android:textColor="#fffcfd"
        android:gravity="center"
        android:id="@+id/tv_reply_count_down_hour"
        android:background="@drawable/bg_message_avatar_count_down_time"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="22dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
