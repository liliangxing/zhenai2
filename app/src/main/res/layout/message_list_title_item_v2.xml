<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp52">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#6c6d75"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_list_str"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_chat_card_enter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:adjustViewBounds="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#767dff"
        android:id="@+id/tv_at_you"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_list_str_some_one_at_you"
        android:layout_marginStart="@dimen/dp9"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <ImageView
        android:id="@+id/iv_filter"
        android:background="@drawable/icon_message_list_filter_v2"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/filter_svga"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <com.opensource.svgaplayer.ManualRecycleSVGAImageView
        android:id="@+id/love_key_svga"
        android:visibility="gone"
        android:layout_width="@dimen/dp90"
        android:layout_height="@dimen/dp52"
        android:layout_marginEnd="@dimen/dp10"
        app:antiAlias="true"
        app:autoPlay="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:loopCount="-1"
        app:source="msg_title_love_key.svga"/>
</androidx.constraintlayout.widget.ConstraintLayout>
