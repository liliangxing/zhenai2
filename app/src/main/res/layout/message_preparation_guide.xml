<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_preparation_guide_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_message_preparation"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/icon_message_preparation"
        android:layout_marginEnd="@dimen/dimen_9dp"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_message_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="47dp"
        android:src="@drawable/icon_message_preparation_tips"
        android:layout_marginEnd="6dp"/>
</FrameLayout>
