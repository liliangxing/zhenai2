<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_f2f4f5"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/btn_change_voice_v2"
        android:layout_width="44dp"
        android:layout_height="37dp"
        android:layout_marginBottom="@dimen/dimen_3dp"
        android:src="@drawable/chat_to_voice_v2"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_message_input_v2"
        app:layout_constraintEnd_toStartOf="@+id/et_message_input_v2"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.zhenai.business.widget.Listen2PasteEditText
        android:textSize="15sp"
        android:textColor="#42475c"
        android:textColorHint="#a4a4a4"
        android:id="@+id/et_message_input_v2"
        android:background="@drawable/bg_ffffff_rectangle_24_radius"
        android:paddingTop="@dimen/dimen_9dp"
        android:paddingBottom="@dimen/dimen_9dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/no_super_remind_hint"
        android:maxLines="4"
        android:maxLength="1500"
        android:drawablePadding="@dimen/dimen_5dp"
        android:textCursorDrawable="@drawable/message_footer_editext_cursor_shape_v2"
        android:paddingStart="@dimen/dimen_15dp"
        android:paddingEnd="@dimen/dimen_15dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_switch_emoji_v2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_change_voice_v2"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zhenai.message.email_chat.widget.VoiceRecordButton
        android:textSize="15sp"
        android:textColor="#42475c"
        android:gravity="center"
        android:id="@+id/btn_voice_input_v2"
        android:background="@drawable/bg_ffffff_rectangle_24_radius"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/press_to_say"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_message_input_v2"
        app:layout_constraintEnd_toStartOf="@+id/btn_switch_emoji_v2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_change_voice_v2"/>
    <ImageView
        android:id="@+id/btn_switch_emoji_v2"
        android:visibility="visible"
        android:layout_width="44dp"
        android:layout_height="37dp"
        android:layout_marginBottom="@dimen/dimen_3dp"
        android:button="@null"
        android:src="@drawable/icon_moment_bottom_emoji"
        app:layout_constraintBottom_toBottomOf="@+id/et_message_input_v2"
        app:layout_constraintEnd_toStartOf="@+id/btn_message_send_layout_v2"
        app:layout_constraintStart_toEndOf="@+id/et_message_input_v2"/>
    <FrameLayout
        android:id="@+id/btn_message_send_layout_v2"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="@dimen/dimen_5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_message_input_v2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_switch_emoji_v2">
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/btn_message_send_v2"
            android:background="@drawable/bg_767dff_rectangle_16_radius"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:text="@string/send"
            style="?android:attr/borderlessButtonStyle"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_wechat_v2"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:src="@drawable/ic_message_chat_bottom_wechat_vip"
        app:layout_constraintEnd_toStartOf="@+id/iconHelper_v2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_message_input_v2"/>
    <ImageView
        android:id="@+id/iconHelper_v2"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:src="@drawable/icon_btn_email_chat_helper_v2_selector"
        app:layout_constraintEnd_toStartOf="@+id/icon_call"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/iv_wechat_v2"
        app:layout_constraintTop_toBottomOf="@+id/et_message_input_v2"/>
    <ImageView
        android:id="@+id/icon_call"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/message_input_call_icon"
        app:layout_constraintEnd_toStartOf="@+id/iconSendGift_v2"
        app:layout_constraintStart_toEndOf="@+id/iconHelper_v2"
        app:layout_constraintTop_toTopOf="@+id/iconSendGift_v2"/>
    <ImageView
        android:id="@+id/iconSendGift_v2"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/message_input_gift_icon_v2"
        app:layout_constraintEnd_toStartOf="@+id/iconAt_v2"
        app:layout_constraintStart_toEndOf="@+id/icon_call"
        app:layout_constraintTop_toTopOf="@+id/iconHelper_v2"/>
    <org.libpag.PAGView
        android:id="@+id/pag_icon_send_gift"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/iconSendGift_v2"
        app:layout_constraintEnd_toEndOf="@+id/iconSendGift_v2"
        app:layout_constraintStart_toStartOf="@+id/iconSendGift_v2"
        app:layout_constraintTop_toTopOf="@+id/iconSendGift_v2"/>
    <ImageView
        android:id="@+id/iconAt_v2"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/message_input_at_icon_v2"
        app:layout_constraintEnd_toStartOf="@+id/iconMore_v2"
        app:layout_constraintStart_toEndOf="@+id/iconSendGift_v2"
        app:layout_constraintTop_toTopOf="@+id/iconHelper_v2"/>
    <ImageView
        android:id="@+id/iconMore_v2"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/message_input_more_icon_v2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconAt_v2"
        app:layout_constraintTop_toTopOf="@+id/iconHelper_v2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
