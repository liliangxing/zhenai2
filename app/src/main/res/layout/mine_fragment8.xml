<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/mine_fragment8_0"
    android:background="#f2f4f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_page_top_v8"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ff26273c"
        android:gravity="center_vertical"
        android:id="@+id/mine_title"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/status_bar_height"
        android:text="@string/me_tab_txt"
        android:paddingStart="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/mine_tab_scrollview"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tv_help_and_feedback"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:contentDescription="@string/help_and_feedback"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/mine_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mine_title"/>
    <com.zhenai.common.widget.ScrollListenerBottomTopView
        android:id="@+id/mine_tab_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/top_tips"
                android:background="@drawable/mine_top_tips_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:drawablePadding="5dp"
                android:drawableEnd="@drawable/icon_mine_bottom_tips_arrow"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="26dp"
                app:layout_constraintBottom_toTopOf="@+id/emptyView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/mine_tips_tan"
                android:background="@drawable/mine_tips_tan"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:layout_constraintEnd_toEndOf="@+id/iv_mine_avatar"
                app:layout_constraintStart_toStartOf="@+id/iv_mine_avatar"
                app:layout_constraintTop_toTopOf="@+id/top_tips"/>
            <View
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_mine_avatar"
                app:layout_constraintTop_toBottomOf="@+id/top_tips"/>
            <com.zhenai.business.widget.LovingRoundImageView
                android:id="@+id/iv_mine_avatar"
                android:layout_width="@dimen/dp72"
                android:layout_height="@dimen/dp72"
                android:layout_marginTop="@dimen/dp18"
                android:scaleType="centerCrop"
                android:layout_marginStart="26dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_tips"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#26273c"
                android:ellipsize="end"
                android:id="@+id/tv_mine_nickname"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="11dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/layout_mine_flag"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/iv_mine_avatar"
                app:layout_constraintTop_toTopOf="@+id/iv_mine_avatar"
                app:layout_constraintVertical_weight="1"/>
            <com.zhenai.business.widget.FlagLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_mine_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_mine_nickname"
                app:layout_constraintEnd_toStartOf="@+id/iv_realName"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/tv_mine_nickname"
                app:layout_constraintTop_toTopOf="@+id/tv_mine_nickname"/>
            <ImageView
                android:id="@+id/iv_realName"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/dimen_15dp"
                app:layout_constraintBottom_toBottomOf="@+id/layout_mine_flag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/layout_mine_flag"
                app:layout_constraintTop_toTopOf="@+id/layout_mine_flag"/>
            <FrameLayout
                android:id="@+id/progressBarBg"
                android:background="@drawable/mine_progress_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="99dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_mine_nickname">
                <com.zhenai.mine.widget.ProfileProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="150dp"
                    android:layout_height="16dp"
                    app:indicatorPrimaryColor="#767dff"
                    app:indicatorSecondColor="@color/white"
                    app:progressBackground="@color/white"
                    app:progressBarWidth="16dp"
                    app:progressForeground="#767dff"
                    app:progressIsStyleV8="true"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/dimen_12sp"
                android:textColor="#26273c"
                android:gravity="center_vertical"
                android:id="@+id/tv_profile_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="立即完善"
                android:drawablePadding="@dimen/dp2"
                android:drawableEnd="@drawable/ic_emotion_right_arrow"
                android:layout_marginStart="10dp"
                android:drawableTint="#26273c"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarBg"
                app:layout_constraintStart_toEndOf="@+id/progressBarBg"
                app:layout_constraintTop_toTopOf="@+id/progressBarBg"/>
            <ImageView
                android:id="@+id/img_complete_profile_unread"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="13.5dp"
                android:src="@drawable/ic_mine_complete_profile_unread"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_profile_progress"
                app:layout_constraintEnd_toEndOf="@+id/tv_profile_progress"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                layout="@layout/mine_interaction_layout_v8"/>
            <include
                android:id="@+id/mine_hongniang_service_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/mine_hongnian_service_card_layout"/>
            <include
                android:id="@+id/view_stub_svip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintTop_toBottomOf="@+id/mine_hongniang_service_card_container"
                layout="@layout/layout_super_vip_view_v3"/>
            <include
                android:id="@+id/mine_guide_operation_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/mine_guide_operation_layout_v8"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mine_privilege_layout_v2"
                android:background="@drawable/rect_white_r16"
                android:paddingLeft="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toTopOf="@+id/ll_mine_items"
                app:layout_constraintTop_toBottomOf="@+id/mine_guide_operation_container"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mine_items"
                android:background="@drawable/rect_white_r16_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/mine_privilege_layout_v2"/>
            <com.zhenai.common.widget.ListItemLayout
                android:id="@+id/item_safety_center"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:arrowIcon="@drawable/icon_setting_next"
                app:arrowIconVisibility="true"
                app:contentColor="#fb5e6c"
                app:contentMarginRight="16dp"
                app:contentSize="12sp"
                app:contentVisibility="false"
                app:layout_constraintTop_toBottomOf="@+id/ll_mine_items"
                app:leftIcon="@drawable/safety_center_icon"
                app:leftIconVisible="true"
                app:lineMarginLeft="18dp"
                app:lineMarginRight="18dp"
                app:lineVisibility="true"
                app:paddingBottom="17dp"
                app:paddingLeft="31dp"
                app:paddingRight="15dp"
                app:paddingTop="17dp"
                app:rightIconVisibility="false"
                app:titleColor="@color/color_42475C"
                app:titleMarginLeft="9dp"
                app:titleSize="14sp"
                app:titleText="@string/security_center"/>
            <com.zhenai.common.widget.ListItemLayout
                android:id="@+id/item_setting"
                android:background="@drawable/rect_white_r16_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:arrowIcon="@drawable/icon_setting_next"
                app:arrowIconVisibility="true"
                app:contentColor="#fb5e6c"
                app:contentMarginRight="16dp"
                app:contentSize="12sp"
                app:contentVisibility="false"
                app:layout_constraintTop_toBottomOf="@+id/item_safety_center"
                app:leftIcon="@drawable/mine_setting_icon"
                app:leftIconVisible="true"
                app:lineVisibility="false"
                app:paddingBottom="17dp"
                app:paddingLeft="31dp"
                app:paddingRight="15dp"
                app:paddingTop="17dp"
                app:rightIconVisibility="false"
                app:titleColor="@color/color_42475C"
                app:titleMarginLeft="9dp"
                app:titleSize="14sp"
                app:titleText="@string/setting"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="62dp"
                app:layout_constraintTop_toBottomOf="@+id/item_setting"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.zhenai.common.widget.ScrollListenerBottomTopView>
    <com.zhenai.business.business.miniprogram.MiniProgramSubscribeBanner
        android:id="@+id/layout_mini_program_subscribe_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="62dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
