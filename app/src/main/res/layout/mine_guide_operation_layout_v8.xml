<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mine_guide_operation_container"
        android:tag="layout/mine_guide_operation_layout_v8_0"
        android:background="@color/white"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_stub_svip"
        app:layout_goneMarginTop="15dp">
        <ImageView
            android:id="@+id/banner_shadow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.mine.mine.widget.MineFragmentGuideOperationItemLayout
            android:id="@+id/moment_item"
            android:tag="binding_1"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp86"
            android:layout_marginTop="9dp"
            app:layout_constraintEnd_toStartOf="@+id/opinion_item"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.mine.mine.widget.MineFragmentGuideOperationItemLayout
            android:id="@+id/opinion_item"
            android:tag="binding_2"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp86"
            app:layout_constraintEnd_toStartOf="@+id/marriage_item"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/moment_item"
            app:layout_constraintTop_toTopOf="@+id/moment_item"/>
        <com.zhenai.mine.mine.widget.MineFragmentGuideOperationItemLayout
            android:id="@+id/marriage_item"
            android:tag="binding_3"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp86"
            app:layout_constraintEnd_toStartOf="@+id/concerned_question_item"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/opinion_item"
            app:layout_constraintTop_toTopOf="@+id/moment_item"/>
        <com.zhenai.mine.mine.widget.MineFragmentGuideOperationItemLayout
            android:id="@+id/concerned_question_item"
            android:tag="binding_4"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp86"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/marriage_item"
            app:layout_constraintTop_toTopOf="@+id/moment_item"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
