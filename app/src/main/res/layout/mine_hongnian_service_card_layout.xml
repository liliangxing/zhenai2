<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mine_hongniang_service_card_container"
        android:tag="layout/mine_hongnian_service_card_layout_0"
        android:background="@drawable/bg_mine_page_hongniang_service_card"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_visit_me">
        <TextView
            android:textSize="14sp"
            android:textColor="#191c32"
            android:id="@+id/txt_service_time_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/my_service_time"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#191c32"
            android:id="@+id/txt_service_time_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="3dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/txt_service_time_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#191c32"
            android:id="@+id/txt_meet_count_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/have_meet_peoples"
            app:layout_constraintStart_toStartOf="@+id/txt_service_time_title"
            app:layout_constraintTop_toBottomOf="@+id/txt_service_time_title"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#191c32"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/txt_meet_count_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_meet_count_title"
            app:layout_constraintEnd_toEndOf="@+id/img_meet_count_arrow"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/txt_meet_count_title"/>
        <ImageView
            android:id="@+id/img_meet_count_arrow"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_mine_page_hongniang_service_card_arrow"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_meet_count_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/txt_meet_count_content"
            app:layout_constraintTop_toTopOf="@+id/txt_meet_count_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#191c32"
            android:id="@+id/txt_service_hongniang_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/my_service_hongniang"
            app:layout_constraintStart_toStartOf="@+id/txt_service_time_title"
            app:layout_constraintTop_toBottomOf="@+id/txt_meet_count_title"/>
        <ImageView
            android:id="@+id/img_hongniang_avatar"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_service_hongniang_title"
            app:layout_constraintEnd_toStartOf="@+id/txt_hongniang_nickname"
            app:layout_constraintStart_toEndOf="@+id/txt_service_hongniang_title"
            app:layout_constraintTop_toTopOf="@+id/txt_service_hongniang_title"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#191c32"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/txt_hongniang_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_service_hongniang_title"
            app:layout_constraintEnd_toEndOf="@+id/img_service_hongniang_arrow"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/img_hongniang_avatar"/>
        <ImageView
            android:id="@+id/img_service_hongniang_arrow"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_mine_page_hongniang_service_card_arrow"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_service_hongniang_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/txt_hongniang_nickname"
            app:layout_constraintTop_toTopOf="@+id/txt_service_hongniang_title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_give_he_grades"
            android:background="@drawable/rectangle_11r_ffffff_stroke_1_33767dff"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_service_hongniang_title">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ff191c32"
                android:id="@+id/txt_give_he_grades_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#9395a4"
                android:id="@+id/txt_give_he_grades_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_give_he_grades_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_go_to_give_he_grades"
                android:background="@drawable/bg_767dff_rectangle_18_radius"
                android:layout_width="83dp"
                android:layout_height="33dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
