<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_left_choose"
        android:layout_width="@dimen/dimen_49dp"
        android:layout_height="@dimen/dimen_60dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar">
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sort_id"
            android:layout_width="@dimen/dimen_19dp"
            android:layout_height="@dimen/dimen_19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/dimen_60dp"
        android:layout_height="@dimen/dimen_60dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_below="@+id/tv_teacher_title"
        app:layout_constraintLeft_toRightOf="@+id/cl_left_choose"
        app:layout_constraintTop_toTopOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_label_type_name"
        android:paddingLeft="@dimen/dimen_3dp"
        android:paddingTop="@dimen/dimen_2dp"
        android:paddingRight="@dimen/dimen_3dp"
        android:paddingBottom="@dimen/dimen_2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bg_colorGradientEnd="@color/color_fe7979"
        app:bg_colorGradientStart="@color/color_fea679"
        app:bg_fillMode="linearGradient"
        app:bg_radiusLeftBottom="0dp"
        app:bg_radiusLeftTop="@dimen/dimen_4dp"
        app:bg_radiusRightBottom="@dimen/dimen_4dp"
        app:bg_radiusRightTop="0dp"
        app:bg_shape="round"
        app:layout_constraintLeft_toLeftOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_42475c"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:paddingLeft="@dimen/dimen_10dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/iv_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_introduce"
        android:paddingLeft="@dimen/dimen_10dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:paddingRight="@dimen/dimen_15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/tv_nickname"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <com.zhenai.business.emotion.view.CustomTagListView
        android:orientation="horizontal"
        android:id="@+id/tag_label"
        android:paddingLeft="@dimen/dimen_10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/teacher_label_margin_top"
        android:layout_marginRight="@dimen/home_inner_distance"
        app:horizontalSpacing="@dimen/dimen_5dp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_introduce"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_introduce"
        app:type="radial"
        app:verticalSpacing="@dimen/dimen_5dp"/>
    <TextView
        android:textSize="@dimen/teacher_basic_size"
        android:textColor="@color/color_999999"
        android:id="@+id/tv_basic_info"
        android:paddingLeft="@dimen/dimen_10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/home_inner_distance"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/teacher_basic_line_size"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/tag_label"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_fd7979"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_basic_info"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_basic_info"/>
    <View
        android:id="@+id/v_bottom_line"
        android:background="@color/color_dividing_line"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_line_height"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="15dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
