<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_message_item_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="15dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_message_item_avatar"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="100dp"
        android:layout_toEndOf="@+id/iv_message_item_avatar">
        <TextView
            android:textSize="15sp"
            android:textColor="#26273b"
            android:ellipsize="end"
            android:id="@+id/tv_message_item_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6c6d75"
            android:ellipsize="end"
            android:id="@+id/tv_message_item_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#aeafb3"
            android:ellipsize="end"
            android:id="@+id/tv_message_item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_detail"
        android:visibility="visible"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignTop="@+id/iv_message_item_avatar"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_message_item_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/iv_message_item_video_mark"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_video_play_v8"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#aeafb3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_message_item_text"
            android:background="@drawable/bg_f2f4f5_rectangle_r8_shape"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="3"/>
    </FrameLayout>
    <View
        android:background="#0c26273b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/layout_action"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</RelativeLayout>
