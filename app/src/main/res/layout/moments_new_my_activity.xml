<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_page_top_v8"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/back_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:src="@drawable/go_back_v8"
        android:layout_marginStart="@dimen/dimen_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dimen_18sp"
        android:textColor="@color/color_333333"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/back_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/back_iv"/>
    <TextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_follow"
        android:background="@drawable/bg_btn_767dff_shape"
        android:visibility="gone"
        android:layout_width="@dimen/dp69"
        android:layout_height="@dimen/dp31"
        android:text="@string/follow"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/back_iv">
        <com.zhenai.business.widget.LovingRoundImageView
            android:id="@+id/avatar_img"
            android:layout_width="@dimen/dimen_64dp"
            android:layout_height="@dimen/dimen_64dp"
            android:layout_marginTop="22dp"
            android:layout_marginStart="@dimen/dimen_20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="@color/color_222222"
            android:gravity="center"
            android:id="@+id/moments_count_tv"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/moments_tv"
            app:layout_constraintStart_toEndOf="@+id/avatar_img"
            app:layout_constraintTop_toTopOf="@+id/avatar_img"/>
        <View
            android:id="@+id/line"
            android:background="#0926273b"
            android:visibility="visible"
            android:layout_width="1dp"
            android:layout_height="49dp"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_img"
            app:layout_constraintEnd_toEndOf="@+id/moments_count_tv"
            app:layout_constraintTop_toTopOf="@+id/avatar_img"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="@color/color_222222"
            android:gravity="center"
            android:id="@+id/photo_count_tv"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="@+id/moments_count_tv"
            app:layout_constraintStart_toEndOf="@+id/moments_count_tv"
            app:layout_constraintTop_toTopOf="@+id/moments_count_tv"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="@color/color_222222"
            android:gravity="center"
            android:id="@+id/video_count_tv"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="@+id/photo_count_tv"
            app:layout_constraintEnd_toStartOf="@+id/txt_count_tv"
            app:layout_constraintStart_toEndOf="@+id/photo_count_tv"
            app:layout_constraintTop_toTopOf="@+id/photo_count_tv"/>
        <TextView
            android:textSize="@dimen/dimen_20sp"
            android:textStyle="bold"
            android:textColor="@color/color_222222"
            android:gravity="center"
            android:id="@+id/txt_count_tv"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginEnd="@dimen/dimen_20dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_count_tv"
            app:layout_constraintStart_toEndOf="@+id/video_count_tv"
            app:layout_constraintTop_toTopOf="@+id/video_count_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/moments_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/dynamics"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_img"
            app:layout_constraintEnd_toEndOf="@+id/moments_count_tv"
            app:layout_constraintStart_toStartOf="@+id/moments_count_tv"
            app:layout_constraintTop_toBottomOf="@+id/moments_count_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/photo_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/photo"
            app:layout_constraintBottom_toBottomOf="@+id/moments_tv"
            app:layout_constraintEnd_toStartOf="@+id/video_count_tv"
            app:layout_constraintStart_toEndOf="@+id/moments_tv"
            app:layout_constraintTop_toTopOf="@+id/moments_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/video_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/video"
            app:layout_constraintBottom_toBottomOf="@+id/photo_tv"
            app:layout_constraintEnd_toStartOf="@+id/txt_count_tv"
            app:layout_constraintStart_toEndOf="@+id/photo_tv"
            app:layout_constraintTop_toTopOf="@+id/photo_tv"/>
        <TextView
            android:textSize="@dimen/dimen_12sp"
            android:textColor="@color/color_26273C"
            android:gravity="center"
            android:id="@+id/txt_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text"
            app:layout_constraintBottom_toBottomOf="@+id/video_tv"
            app:layout_constraintEnd_toEndOf="@+id/txt_count_tv"
            app:layout_constraintStart_toEndOf="@+id/video_tv"
            app:layout_constraintTop_toTopOf="@+id/video_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:background="@drawable/bg_dialog_ffffff_30"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:paddingStart="@dimen/dp10"
        android:paddingEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_top_content">
        <com.zhenai.common.widget.recycler_view.SwipeRecyclerView
            android:id="@+id/my_moments_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/img_publish"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="63dp"
        android:src="@drawable/new_icon_publish_moment"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/follow_layout"
        android:background="@drawable/moments_follow_window_bg"
        android:visibility="gone"
        android:layout_width="351dp"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/window_avatar"
            android:background="@drawable/default_circle_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/dimen_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dimen_13sp"
            android:textColor="@color/white"
            android:id="@+id/note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="关注我，可以及时了解我的最新动态，要多多联系哦～"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/window_avatar"
            app:layout_constraintEnd_toStartOf="@+id/follow_tv"
            app:layout_constraintStart_toEndOf="@+id/window_avatar"
            app:layout_constraintTop_toTopOf="@+id/window_avatar"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/follow_tv"
            android:background="@drawable/bg_rectangle_ffffff_40r_shape"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:text="@string/follow"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/close_iv"
            app:layout_constraintStart_toEndOf="@+id/note"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/close_iv"
            android:padding="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/follow_window_close_icon"
            android:layout_marginEnd="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
