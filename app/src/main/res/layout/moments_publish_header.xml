<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="15sp"
        android:textColor="#ff12131a"
        android:textColorHint="#c9caca"
        android:gravity="start"
        android:id="@+id/content_et"
        android:background="@color/transparent"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/moments_publish_hint"
        android:lines="4"
        android:maxLength="300"
        android:textCursorDrawable="@drawable/editext_cursor_shape"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <TextView
        android:textColor="#ff96989e"
        android:id="@+id/content_limit_tip_tv"
        android:text="0/300"
        android:layout_below="@+id/content_et"
        android:layout_alignParentEnd="true"
        style="@style/CommonEditTextInputNumTextStyle"/>
</RelativeLayout>
