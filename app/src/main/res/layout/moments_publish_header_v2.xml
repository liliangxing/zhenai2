<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="15sp"
        android:textColor="#ff12131a"
        android:textColorHint="#c9caca"
        android:gravity="start"
        android:id="@+id/content_et"
        android:background="@color/transparent"
        android:paddingTop="2dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/moments_publish_hint"
        android:maxLines="8"
        android:minLines="2"
        android:maxLength="300"
        android:textCursorDrawable="@drawable/editext_cursor_shape_v2"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#aeafb3"
        android:id="@+id/content_limit_tip_tv"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="0/300"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
