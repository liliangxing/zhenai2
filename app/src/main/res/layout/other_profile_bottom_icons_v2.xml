<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon_hongniang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/recommend_profile_hongniang_icon_v8"
        app:layout_constraintBottom_toBottomOf="@+id/icon_hongniang_click_view"
        app:layout_constraintEnd_toEndOf="@+id/icon_hongniang_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_hongniang_click_view"
        app:layout_constraintTop_toTopOf="@+id/icon_hongniang_click_view"/>
    <View
        android:id="@+id/icon_hongniang_click_view"
        android:background="@null"
        android:paddingLeft="@dimen/dp18"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp18"
        android:paddingBottom="@dimen/dp22"
        android:layout_width="@dimen/dp77"
        android:layout_height="@dimen/dp77"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginRight="@dimen/dp15"
        android:layout_marginHorizontal="@dimen/dp15"
        android:paddingHorizontal="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon_mail_click_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon_mail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/recommend_profile_mail_icon_v8"
        app:layout_constraintBottom_toBottomOf="@+id/icon_mail_click_view"
        app:layout_constraintEnd_toEndOf="@+id/icon_mail_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_mail_click_view"
        app:layout_constraintTop_toTopOf="@+id/icon_mail_click_view"/>
    <View
        android:id="@+id/icon_mail_click_view"
        android:background="@null"
        android:paddingLeft="@dimen/dp18"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp18"
        android:paddingBottom="@dimen/dp22"
        android:layout_width="@dimen/dp77"
        android:layout_height="@dimen/dp77"
        android:layout_marginStart="@dimen/dp9"
        android:layout_marginEnd="@dimen/dp9"
        android:paddingHorizontal="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon_say_hi_click_view"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/icon_hongniang_click_view"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon_say_hi"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/recommend_profile_say_hi_icon_v8"
        app:layout_constraintBottom_toBottomOf="@+id/icon_say_hi_click_view"
        app:layout_constraintEnd_toEndOf="@+id/icon_say_hi_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_say_hi_click_view"
        app:layout_constraintTop_toTopOf="@+id/icon_say_hi_click_view"/>
    <View
        android:id="@+id/icon_say_hi_click_view"
        android:background="@null"
        android:paddingLeft="@dimen/dp18"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp18"
        android:paddingBottom="@dimen/dp22"
        android:visibility="gone"
        android:layout_width="@dimen/dp77"
        android:layout_height="@dimen/dp77"
        android:layout_marginStart="@dimen/dp9"
        android:layout_marginEnd="@dimen/dp9"
        android:paddingHorizontal="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/icon_send_gift_click_view"
        app:layout_constraintStart_toEndOf="@+id/icon_mail_click_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_new_member_say_hi_tips"
        android:background="@drawable/bg_recommend_bottom_say_hi_icon_tips"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/tips_say_hi_to_new_member"
        android:layout_marginStart="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_say_hi_click_view"
        app:layout_constraintEnd_toEndOf="@+id/icon_say_hi_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_say_hi_click_view"/>
    <ImageView
        android:id="@+id/say_hi_tips_arrow_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_26273c_arrow_down"
        app:layout_constraintEnd_toEndOf="@+id/icon_say_hi_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_say_hi_click_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_new_member_say_hi_tips"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon_send_gift"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/recommend_profile_send_gift_icon_v8"
        app:layout_constraintBottom_toBottomOf="@+id/icon_send_gift_click_view"
        app:layout_constraintEnd_toEndOf="@+id/icon_send_gift_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_send_gift_click_view"
        app:layout_constraintTop_toTopOf="@+id/icon_send_gift_click_view"/>
    <View
        android:id="@+id/icon_send_gift_click_view"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="@dimen/dp77"
        android:layout_height="@dimen/dp77"
        android:layout_marginStart="@dimen/dp9"
        android:layout_marginEnd="@dimen/dp9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_say_hi_click_view"
        app:layout_goneMarginEnd="@dimen/dp9"
        app:layout_goneMarginStart="@dimen/dp9"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_send_gift_tips"
        android:background="@drawable/bg_recommend_bottom_send_gift_item_tips"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="218dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_send_gift_click_view"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/view_arrow_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_26273c_arrow_down"
        app:layout_constraintEnd_toEndOf="@+id/icon_send_gift_click_view"
        app:layout_constraintStart_toStartOf="@+id/icon_send_gift_click_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_send_gift_tips"/>
</merge>
