<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="101dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <CheckBox
        android:id="@+id/bg_view"
        android:background="@drawable/selector_email_list_daemon_recharge_item_v8"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#26273c"
        android:gravity="bottom"
        android:id="@+id/tv_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#92939d"
        android:gravity="center"
        android:id="@+id/tv_heightPrice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_month"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_26273C"
        android:gravity="center"
        android:id="@+id/tv_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_heightPrice"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#26273b"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_every_day_money"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:minHeight="24dp"
        android:paddingStart="5.5dp"
        android:paddingEnd="5.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_view"
        app:layout_constraintEnd_toEndOf="@+id/bg_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/bg_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_money"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="12dp"/>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:gravity="center"
        android:id="@+id/tv_mark"
        android:background="@drawable/bg_ff8f54_ff4949_rectangle_shape"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        app:layout_constraintBottom_toTopOf="@+id/bg_view"
        app:layout_constraintStart_toStartOf="@+id/bg_view"
        app:layout_constraintTop_toTopOf="@+id/bg_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
