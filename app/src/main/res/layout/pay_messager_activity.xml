<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nested_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/pay_header_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/tv_coin_not_enough_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp">
                <View
                    android:background="#80ffffff"
                    android:layout_width="22dp"
                    android:layout_height="@dimen/divider_size_small"
                    android:layout_marginRight="10dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_coin_remain_txt"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tv_coin_remain_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#80ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zhenai_coin_unit"/>
                <View
                    android:background="#80ffffff"
                    android:layout_width="22dp"
                    android:layout_height="@dimen/divider_size_small"
                    android:layout_marginLeft="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/bg_card_corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="44dp"
                android:layout_marginRight="8dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_product_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
                <View
                    android:id="@+id/divider_horizontal"
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_size_small"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_recharge"
                    android:background="@drawable/common_long_btn_green_selector"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/pay_exchange_btn_text"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
