<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="15dp"
        android:src="@drawable/pay_zhenai_messager"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="20.8sp"
        android:textColor="#42475c"
        android:id="@+id/tv_item_messager_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#889296"
        android:id="@+id/tv_item_messager_unit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="@string/zhenai_messager_unit"
        android:layout_weight="1"/>
    <TextView
        android:textSize="21sp"
        android:textColor="#42475c"
        android:gravity="start"
        android:id="@+id/tv_item_coin_count"
        android:layout_width="44dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#889296"
        android:id="@+id/tv_item_coin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <CheckBox
        android:id="@+id/cb_item_check"
        android:background="@null"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="11dp"
        android:button="@drawable/pay_check_btn"/>
</LinearLayout>
