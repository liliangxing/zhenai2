<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/color_e4e7ea"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text="查看珍心会员的消息"/>
            <View
                android:textSize="14sp"
                android:textColor="#9c000000"
                android:textColorHint="#bbbbbb"
                android:gravity="center"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:imeOptions="actionNext"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="15dp">
                <CheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/cbZhenxinMember"
                    android:visibility="visible"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:button="@drawable/mass_layer_round_check_selector_green"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/viewZhenxinMember"
                    android:layout_width="31dp"
                    android:layout_height="31dp"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:background="#ffe5e5e5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text="查看有头像的用户消息"/>
            <View
                android:textSize="14sp"
                android:textColor="#9c000000"
                android:textColorHint="#bbbbbb"
                android:gravity="center"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:imeOptions="actionNext"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="15dp">
                <CheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/cbHeaderPhoto"
                    android:visibility="visible"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:button="@drawable/mass_layer_round_check_selector_green"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/viewHeaderPhoto"
                    android:layout_width="31dp"
                    android:layout_height="31dp"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:background="#ffe5e5e5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text="查看通过身份认证的用户消息"/>
            <View
                android:textSize="14sp"
                android:textColor="#9c000000"
                android:textColorHint="#bbbbbb"
                android:gravity="center"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:imeOptions="actionNext"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="15dp">
                <CheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/cbIdentity"
                    android:visibility="visible"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:button="@drawable/mass_layer_round_check_selector_green"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/viewIdentity"
                    android:layout_width="31dp"
                    android:layout_height="31dp"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:background="#ffe5e5e5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff42475c"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text="查看符合择偶条件的用户消息"/>
            <View
                android:textSize="14sp"
                android:textColor="#9c000000"
                android:textColorHint="#bbbbbb"
                android:gravity="center"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:imeOptions="actionNext"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="15dp">
                <CheckBox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/cbMatchZeou"
                    android:visibility="visible"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:button="@drawable/mass_layer_round_check_selector_green"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/viewMatchZeou"
                    android:layout_width="31dp"
                    android:layout_height="31dp"/>
            </FrameLayout>
        </LinearLayout>
        <View
            android:background="#ffe5e5e5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llZeouCondtion"
            android:background="#fff2f4f6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textColor="#ff666978"
                android:gravity=""
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="25dp"
                android:text="最多只筛选对方的年龄、收入、身高、工作地、婚况、学历   "/>
            <TextView
                android:textSize="11sp"
                android:textColor="#ff666978"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvZeou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="25dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
        <View
            android:background="#ffe5e5e5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnOk"
            android:background="@drawable/dialog_live_video_pay_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="46dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="46dp"
            android:text="确定"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#66000000"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="*仅筛选最近100个跟你发过消息的人"/>
    </LinearLayout>
    <View
        android:id="@+id/view_mask"
        android:background="@color/black_40"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
