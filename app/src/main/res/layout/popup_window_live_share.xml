<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_white_left_right_20_share"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="#221c33"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="分享到"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#626166"
            android:gravity="center_horizontal"
            android:id="@+id/tv_share_wet_chat"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/share_we_chat"
            android:drawableTop="@drawable/icon_share_wechat"
            android:drawablePadding="10dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#626166"
            android:gravity="center_horizontal"
            android:id="@+id/tv_share_moment"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/share_moment"
            android:drawableTop="@drawable/icon_share_moment"
            android:drawablePadding="10dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#626166"
            android:gravity="center_horizontal"
            android:id="@+id/tv_share_qq"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/share_qq"
            android:drawableTop="@drawable/icon_share_qq"
            android:drawablePadding="10dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#626166"
            android:gravity="center_horizontal"
            android:id="@+id/tv_share_qq_zone"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/share_qq_zone"
            android:drawableTop="@drawable/icon_share_qzone"
            android:drawablePadding="10dp"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
