<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.BoldTextView
        android:id="@+id/tv_zhenxiaoai_title"
        android:text="@string/profile_zhenxiaoai_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/recommendProfile9TitleTextViewStyle"/>
    <TextView
        android:id="@+id/tv_zhenxiaoai_sub_title"
        android:paddingTop="@dimen/dp5"
        android:paddingBottom="@dimen/dp5"
        android:text="@string/profile_zhenxiaoai_sub_title"
        android:drawablePadding="@dimen/dimen_3dp"
        android:paddingVertical="@dimen/dp5"
        app:drawableEndCompat="@drawable/ic_recommend_right_arrow_v8"
        app:layout_constraintBottom_toBottomOf="@+id/tv_marriage_opinion_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_marriage_opinion_title"
        style="@style/recommendProfile9TitleRightViewStyle"/>
    <com.zhenai.common.widget.RadioImageView
        android:id="@+id/img_zhenxiaoai_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_profile_zhenxiaoai_content"
        app:height_weight="198"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_zhenxiaoai_title"
        app:width_weight="957"/>
</merge>
