<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_card_corner_all"
    android:layout_width="match_parent"
    android:layout_height="152dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/first_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="12dp">
            <View
                android:background="#a088fa"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#42475c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/same_city_user_txt"
                android:layout_centerVertical="true"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/CutLineStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="112dp">
            <ImageView
                android:id="@+id/avatar"
                android:background="@drawable/default_avatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:scaleType="fitStart"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#42475c"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="26dp"
                android:layout_toRightOf="@+id/avatar"
                android:layout_alignTop="@+id/avatar"/>
            <com.zhenai.base.widget.FlowLayout
                android:id="@+id/flow_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="26dp"
                android:layout_toRightOf="@+id/avatar"
                android:layout_below="@+id/name"
                app:type="radial"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#666978"
                android:id="@+id/certify_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="26dp"
                android:layout_marginBottom="24dp"
                android:layout_toRightOf="@+id/avatar"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
