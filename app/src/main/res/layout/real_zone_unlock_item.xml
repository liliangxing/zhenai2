<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/unlock_layout"
    android:background="@drawable/bg_card_corner_all"
    android:layout_width="match_parent"
    android:layout_height="112dp">
    <Button
        android:id="@+id/unlock_btn"
        android:text="@string/unlock_certificate_btn_txt"
        style="@style/common_long_btn_style"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#42475c"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock_certificate_note"/>
</LinearLayout>
