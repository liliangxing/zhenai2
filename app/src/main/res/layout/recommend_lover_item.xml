<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="17dp"
    android:paddingRight="12dp"
    android:paddingBottom="14dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/right_avatar_layout"
        android:background="@drawable/love_pink_circle_shape"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_marginLeft="46dp"
        android:layout_marginTop="7dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/right_avatar_view"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/default_circle_avatar"
            app:borderRadius="50dp"/>
    </FrameLayout>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/left_avatar_view"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/default_circle_avatar"
        app:borderRadius="50dp"/>
    <ImageView
        android:id="@+id/icon_love_head_small"
        android:layout_width="62dp"
        android:layout_height="48dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/icon_love_head_small"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff12131a"
        android:ellipsize="end"
        android:id="@+id/user_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="84dp"
        android:maxLines="1"
        android:maxEms="8"
        android:drawableRight="@drawable/icon_data_page_lovespace_badge"
        android:drawablePadding="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff666978"
        android:ellipsize="end"
        android:id="@+id/object_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="84dp"
        android:layout_marginTop="19dp"
        android:maxLines="1"
        android:maxEms="8"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffff9ea3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="84dp"
        android:layout_marginTop="39dp"
        android:text="恋爱中"/>
</FrameLayout>
