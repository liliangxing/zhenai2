<?xml version="1.0" encoding="utf-8"?>
<me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/dp8"
    android:paddingRight="@dimen/dp8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp4"
    android:layout_marginStart="@dimen/dp4"
    android:paddingHorizontal="@dimen/dp8"
    app:bg_colorNormal="@color/color_f2f4f5"
    app:bg_fillMode="color"
    app:bg_radius="@dimen/dp8"
    app:bg_shape="round">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/leftIcon"
        android:layout_width="@dimen/dp18"
        android:layout_height="@dimen/dp14"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp4"
        android:src="@drawable/icon_recommend_profile_8_education"
        android:layout_marginEnd="@dimen/dp4"
        android:layout_marginVertical="@dimen/dp4"/>
    <TextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="#000019"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/education_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp4"
        android:layout_marginVertical="@dimen/dp4"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="@dimen/dimen_14sp"
        android:textColor="@color/color_767dff"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/click_to_see_school"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawablePadding="@dimen/dp5"
        android:drawableEnd="@drawable/icon_arrow_right_see_school"
        android:layout_marginStart="@dimen/dp4"/>
</me.yintaibing.universaldrawable.view.UniversalDrawableLinearLayout>
