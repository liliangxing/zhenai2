<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_141629"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_weight="1"
        android:layout_marginVertical="@dimen/dp24">
        <VideoView
            android:layout_gravity="center"
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/selectTimeTv"
        android:background="@drawable/bg_1affffff_rectangle_12_radius"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp4"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/has_select_time"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp4"/>
    <com.zhenai.short_video.widget.sliceseekbar.VideoSliceSeekBarLayout
        android:id="@+id/video_slice_seek_bar_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp20"
        android:layout_marginStart="@dimen/dp32"
        app:anchorSrc="@drawable/icon_video_slice_seek_bar_right_arrow"
        app:borderWidth="2dp"
        app:gradientColor="#80000000"
        app:gradientWidth="10dp"
        app:thumbColor="@color/color_767dff"
        app:thumbWidth="24dp"/>
    <FrameLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp61">
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="#fefffe"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/dp12"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableButton
            android:textSize="16sp"
            android:textColor="#fefffe"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/operate_btn"
            android:layout_width="88dp"
            android:layout_height="36dp"
            android:text="@string/done"
            android:layout_marginEnd="@dimen/dp12"
            app:bg_colorGradientEnd="@color/color_767dff"
            app:bg_colorGradientStart="@color/color_767dff"
            app:bg_fillMode="linearGradient"
            app:bg_shape="semicircle"/>
    </FrameLayout>
</LinearLayout>
