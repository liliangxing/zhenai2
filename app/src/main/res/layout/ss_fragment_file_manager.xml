<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:contentInsetStart="0dp">
        <ImageButton
            android:id="@+id/btnPageOpt"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ss_icon_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载管理"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#5285ec"
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/btnDataOpt"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="编辑"/>
    </androidx.appcompat.widget.Toolbar>
    <ListView
        android:id="@+id/dataFileList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/optArea"
        android:background="@color/SSColorPrimary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#ff4d4f"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="删除"
            android:drawableTop="@drawable/ss_icon_toolbar_delete"
            android:drawablePadding="5dp"/>
    </FrameLayout>
</FrameLayout>
