<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_super_link_entrance"
    android:layout_width="wrap_content"
    android:layout_height="24dp">
    <com.zhenai.live.widget.AvatarsLineView
        android:id="@+id/super_link_avatars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_super_link_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/red_dot"
        android:background="@drawable/red_dot_fd5a67"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="@+id/super_link_avatars"
        app:layout_constraintTop_toTopOf="@+id/super_link_avatars"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/tv_super_link_text"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:maxWidth="60dp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/super_link_arrow"
        app:layout_constraintStart_toEndOf="@+id/super_link_avatars"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/super_link_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_arrow_right_2"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_super_link_text"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
