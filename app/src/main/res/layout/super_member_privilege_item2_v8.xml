<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/color_line"
        android:background="#f2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_vip_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:src="@drawable/icon_super_vip_zi_liao_vip_logo"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_line"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="16sp"
        android:textColor="#26273b"
        android:id="@+id/tv_vip_title_v8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="资料页尊贵展示"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_vip_icon"
        app:layout_constraintStart_toEndOf="@+id/img_vip_icon"
        app:layout_constraintTop_toTopOf="@+id/img_vip_icon"/>
    <ImageView
        android:id="@+id/img_vip_icon_1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:src="@drawable/icon_super_vip_dui_gou"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_content_title"
        app:layout_constraintTop_toTopOf="@+id/tv_content_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff42475c"
        android:gravity="top"
        android:id="@+id/tv_content_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_vip_title_v8"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_title_v8"/>
    <com.zhenai.business.widget.autosrcoll_banner_listview.AutoScrollBanner
        android:id="@+id/member_banner"
        android:layout_width="match_parent"
        android:layout_height="209dp"
        android:layout_marginTop="14dp"
        app:indicatorBottomMargin="13dp"
        app:indicatorGravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5b3609"
        android:gravity="center"
        android:id="@+id/tv_vip_dress_up"
        android:background="@drawable/bg_edc993_rectangle_22_radius"
        android:visibility="visible"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:text="立即装扮"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/member_banner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
