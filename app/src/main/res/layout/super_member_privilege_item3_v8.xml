<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/color_line"
        android:background="#f2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_hide_invited_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:src="@drawable/icon_super_vip_hide_visited_logo"
        android:layout_marginStart="@dimen/dimen_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_line"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="16sp"
        android:textColor="#26273b"
        android:id="@+id/tv_hide_invited_title_v8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="隐身访问"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_hide_invited_icon"
        app:layout_constraintStart_toEndOf="@+id/img_hide_invited_icon"
        app:layout_constraintTop_toTopOf="@+id/img_hide_invited_icon"/>
    <ImageView
        android:id="@+id/img_hide_invited_icon_1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dimen_6dp"
        android:src="@drawable/icon_super_vip_dui_gou"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_invited_content_title"
        app:layout_constraintTop_toTopOf="@+id/tv_invited_content_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff42475c"
        android:gravity="top"
        android:id="@+id/tv_invited_content_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_hide_invited_title_v8"
        app:layout_constraintTop_toBottomOf="@+id/tv_hide_invited_title_v8"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5b3609"
        android:gravity="center"
        android:id="@+id/tv_hide_visited"
        android:background="@drawable/bg_edc993_rectangle_22_radius"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:text="隐身访问列表"
        android:layout_marginStart="@dimen/dimen_30dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_hide_visited_go_to_setting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_invited_content_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5b3609"
        android:gravity="center"
        android:id="@+id/tv_hide_visited_go_to_setting"
        android:background="@drawable/bg_edc993_1r_rectangle_shape"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:layout_marginBottom="24dp"
        android:text="去设置"
        android:layout_marginStart="33dp"
        android:layout_marginEnd="@dimen/dimen_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_hide_visited"
        app:layout_constraintTop_toBottomOf="@+id/tv_invited_content_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
