<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/color_line"
        android:background="#f2f4f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_super_remind_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:src="@drawable/icon_super_vip_super_remind_logo"
        android:layout_marginStart="@dimen/dimen_15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_line"/>
    <com.zhenai.common.widget.BoldTextView
        android:textSize="16sp"
        android:textColor="#26273b"
        android:id="@+id/tv_super_remind_title_v8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="超级提醒"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_super_remind_icon"
        app:layout_constraintStart_toEndOf="@+id/img_super_remind_icon"
        app:layout_constraintTop_toTopOf="@+id/img_super_remind_icon"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#949496"
        android:gravity="center_vertical"
        android:id="@+id/tv_super_remind_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_super_remind_title_v8"
        app:layout_constraintStart_toEndOf="@+id/tv_super_remind_title_v8"
        app:layout_constraintTop_toTopOf="@+id/tv_super_remind_title_v8"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff1cf9d"
        android:gravity="center"
        android:id="@+id/tv_super_remind_mask"
        android:background="@drawable/icon_super_vip_sale_logo"
        android:layout_width="83dp"
        android:layout_height="27dp"
        android:text="每月省80元"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_line"/>
    <ImageView
        android:id="@+id/img_super_remind_icon_1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:src="@drawable/icon_super_vip_dui_gou"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_super_remind_content_title"
        app:layout_constraintTop_toTopOf="@+id/tv_super_remind_content_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff42475c"
        android:gravity="top"
        android:id="@+id/tv_super_remind_content_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_15dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dimen_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_super_remind_title_v8"
        app:layout_constraintTop_toBottomOf="@+id/tv_super_remind_title_v8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_super_remind_content"
        android:background="@drawable/icon_super_vip_sale_msg_bg"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_super_remind_content_title">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff7e5119"
            android:id="@+id/tv_super_remind_content_detail"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/dimen_4dp"
            android:layout_marginStart="@dimen/dimen_20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tv_super_remind_get"
            android:layout_width="81dp"
            android:layout_height="60dp"
            android:text="@string/super_vip_super_remind_get"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
