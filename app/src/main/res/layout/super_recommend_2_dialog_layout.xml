<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_super_service_dialog"
        android:paddingBottom="12dp"
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="34dp"
        android:layout_marginRight="13dp"
        android:layout_marginHorizontal="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/bg_dialog_v8"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/tv_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_26273c"
            android:gravity="center"
            android:id="@+id/tv_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_6c6d75"
            android:gravity="center"
            android:id="@+id/tv_third_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_top"
            android:background="@drawable/bg_rectangle_767dff_40r_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="26dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/topLayout_primary_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:id="@+id/topLayout_secondary_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.legacy.widget.Space
            android:id="@+id/center_divide"
            android:layout_width="0dp"
            android:layout_height="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_bottom"
            android:background="@drawable/rect_767dff_stroke_1_r200"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="26dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_767dff"
                android:id="@+id/bottomLayout_primary_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_767dff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bottomLayout_secondary_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.legacy.widget.Space
            android:id="@+id/bottom_divide"
            android:layout_width="0dp"
            android:layout_height="12dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/iv_image"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/view_dialog_content"
        app:layout_constraintStart_toStartOf="@+id/view_dialog_content"
        app:layout_constraintTop_toTopOf="@+id/btn_close"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/btn_close"
        android:visibility="visible"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_close_v8"
        android:translationX="13dp"
        app:layout_constraintBottom_toTopOf="@+id/view_dialog_content"
        app:layout_constraintEnd_toEndOf="@+id/view_dialog_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
