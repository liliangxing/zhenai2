<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_super_service_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#42475c"
            android:gravity="center"
            android:id="@+id/tv_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#666978"
            android:gravity="center"
            android:id="@+id/tv_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#afafaf"
            android:gravity="center"
            android:id="@+id/tv_third_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/btn_top"
            android:background="@drawable/bg_super_service_top_btn_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginRight="@dimen/dimen_15dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/topLayout_primary_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/topLayout_secondary_content"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_4dp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/btn_bottom"
            android:background="@drawable/common_cancel_button_background"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dimen_15dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginRight="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/dimen_20dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dimen_15sp"
                    android:textColor="#8b76f9"
                    android:layout_gravity="center"
                    android:id="@+id/bottomLayout_primary_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#8b76f9"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/bottomLayout_secondary_content"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_4dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:src="@drawable/ic_common_dialog_close_btn"
        android:layout_alignTop="@+id/view_dialog_content"
        android:layout_marginEnd="-16dp"
        android:layout_alignEnd="@+id/view_dialog_content"
        android:elevation="10dp"/>
</RelativeLayout>
