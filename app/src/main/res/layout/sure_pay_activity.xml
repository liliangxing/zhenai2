<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="10dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_pay_info_view"
            android:background="@drawable/bg_card_corner_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.5dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="8.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sure_pay_check_product_label"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#666978"
                    android:ellipsize="end"
                    android:id="@+id/tv_check_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8.5dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="8.5dp"
                android:layout_marginBottom="25dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sure_pay_check_price_label"/>
                <TextView
                    android:textSize="21sp"
                    android:textColor="#ecad2a"
                    android:id="@+id/tv_check_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8.5dp"
                    android:src="@drawable/pay_price_label"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card_corner_all"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp">
            <com.zhenai.common.widget.ListItemLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:arrowIconVisibility="false"
                app:leftIcon="@drawable/info_card_title_left_image"
                app:lineMarginLeft="8dp"
                app:lineMarginRight="8dp"
                app:paddingBottom="12dp"
                app:paddingLeft="8dp"
                app:paddingTop="12dp"
                app:titleColor="#42475c"
                app:titleMarginLeft="7.5dp"
                app:titleSize="15sp"
                app:titleText="@string/sure_pay_select_pay_type"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sure_pay_type_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_size_small"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/btn_sure_pay"
                android:background="@drawable/common_long_btn_green_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/sure_pay_btn_text"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
