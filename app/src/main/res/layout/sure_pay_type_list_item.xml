<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_pay_type_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="17.7sp"
        android:textColor="#42475c"
        android:id="@+id/tv_pay_type_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.5dp"
        android:layout_toLeftOf="@+id/cb_pay_type_check"
        android:layout_toRightOf="@+id/iv_pay_type_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#889296"
        android:id="@+id/tv_pay_type_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="16dp"
        android:layout_toLeftOf="@+id/cb_pay_type_check"
        android:layout_toRightOf="@+id/iv_pay_type_icon"
        android:layout_below="@+id/tv_pay_type_title"/>
    <CheckBox
        android:id="@+id/cb_pay_type_check"
        android:background="@null"
        android:clickable="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="11dp"
        android:button="@drawable/pay_check_btn"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
