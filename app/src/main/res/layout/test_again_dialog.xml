<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="295dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:src="@drawable/test_again_dialog_banner"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/test_again_sure"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#666978"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="14dp"
                android:text="@string/warm_tips"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="30dp">
                <View
                    android:background="@drawable/purple_circle_point"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_again_dialog_detail1"
                    android:layout_marginStart="9dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="30dp">
                <View
                    android:background="@drawable/purple_circle_point"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_again_dialog_detail2"
                    android:layout_marginStart="9dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="30dp">
                <View
                    android:background="@drawable/purple_circle_point"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#666978"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_again_dialog_detail3"
                    android:layout_marginStart="9dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#afafaf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="6dp"
                android:text="@string/test_again_dialog_detail4"
                android:layout_marginStart="20dp"/>
            <FrameLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="63dp"
                android:layout_marginBottom="14dp"
                android:layout_alignParentBottom="true">
                <Button
                    android:id="@+id/go_to_test_again"
                    android:text="@string/sure"
                    style="@style/common_long_btn_style"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:layout_marginRight="-16dp"
        android:layout_alignTop="@+id/view_dialog_content"
        android:layout_alignRight="@+id/view_dialog_content"
        app:srcCompat="@drawable/ic_common_dialog_close_btn"/>
</RelativeLayout>
