<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_view"
        android:background="@drawable/rectangle_ffffff_radius_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="35dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">
        <com.zhenai.common.widget.RoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_v8"
            app:borderRadius="16dp"
            app:roundImageType="round"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ff26273c"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="是否确定重测"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/warm_tips"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/test_again_dialog_detail1"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/shape_767dff_circle"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/test_again_dialog_detail2"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/shape_767dff_circle"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff6c6d75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/test_again_dialog_detail3"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/shape_767dff_circle"
            android:layout_marginStart="24dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffaeafb3"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/test_again_dialog_detail4"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/go_to_test_again"
            android:background="@drawable/bg_btn_767dff_shape"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="24dp"
            android:text="确定"
            android:layout_marginHorizontal="24dp"/>
    </LinearLayout>
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp"
        android:src="@drawable/test_again_dialog_top"
        android:layout_alignTop="@+id/dialog_view"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/btn_close"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="-32dp"
        android:layout_marginRight="-10dp"
        android:layout_alignTop="@+id/dialog_view"
        android:layout_alignRight="@+id/dialog_view"
        app:srcCompat="@drawable/ic_close_v8"/>
</RelativeLayout>
