<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_image"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/bg_update_version_title"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_primary_text"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_secondary_text"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21.5dp"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#afafaf"
            android:gravity="left"
            android:layout_gravity="center"
            android:id="@+id/tv_third_text"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="15.5dp"
            android:layout_marginRight="40.5dp"
            android:lineSpacingExtra="6sp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:id="@+id/btn_bottom"
            android:background="@drawable/bg_live_rectangle_purple_corner"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="23.5dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="18.5dp"
            android:text="@string/force_upgrade_btn_txt"
            style="@style/common_long_btn_style"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/btn_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:layout_marginRight="-10dp"
        android:src="@drawable/ic_live_video_dialog_close"
        android:layout_alignTop="@+id/view_dialog_content"
        android:layout_alignRight="@+id/view_dialog_content"/>
</RelativeLayout>
