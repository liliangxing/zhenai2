<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#bdbec3"
        android:gravity="center"
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reference_root"
        android:background="@drawable/bg_ffffff_rectangle_16_radius"
        android:layout_width="186dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvTime"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/ivAvatar">
        <TextView
            android:textSize="16sp"
            android:textColor="#26273c"
            android:ellipsize="end"
            android:id="@+id/tvGiftName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#6c6d75"
            android:id="@+id/tvGiftPrize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintLeft_toLeftOf="@+id/tvGiftName"
            app:layout_constraintTop_toBottomOf="@+id/tvGiftName"/>
        <View
            android:id="@+id/viewDivider"
            android:background="#0d26273b"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvGiftPrize"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#767dff"
            android:id="@+id/tvRebate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/gift_in_return"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewDivider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivGiftIcon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_alignTop="@+id/reference_root"
        android:rotation="15"
        android:layout_marginStart="-35dp"
        android:layout_toEndOf="@+id/reference_root"/>
    <com.zhenai.business.love_zone.widget.LovingImageView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_alignTop="@+id/reference_root"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#6c6d75"
        android:gravity="center"
        android:id="@+id/llReceivedGiftTip"
        android:background="@drawable/bg_0d26273c_rectangle_16_radius"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/express_wall_have_yours_name_go_to_check"
        android:layout_below="@+id/reference_root"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
</RelativeLayout>
