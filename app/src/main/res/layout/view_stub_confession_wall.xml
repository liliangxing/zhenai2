<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/flConfessionWall"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="45dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_confession_wall"
        android:adjustViewBounds="true"
        android:layout_marginStart="15dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/flipLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivMailIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivfemailIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/default_circle_avatar"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.zhenai.common.widget.MarqueeText
            android:textSize="13sp"
            android:textColor="#ff666978"
            android:ellipsize="marquee"
            android:id="@+id/tvConfession"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="围观正在发生的表白"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivfemailIcon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
