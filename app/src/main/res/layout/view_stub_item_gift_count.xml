<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/flHolder"
        android:background="@drawable/bg_gift_count"
        android:layout_width="201dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="152dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivGiftIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toTopOf="@+id/tvGiftName"
        app:layout_constraintEnd_toEndOf="@+id/tvGiftName"
        app:layout_constraintStart_toStartOf="@+id/tvGiftName"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff8a747"
        android:layout_gravity="center"
        android:id="@+id/tvGiftName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/llSendInfo"
        app:layout_constraintEnd_toEndOf="@+id/flHolder"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llSendInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/flHolder"
        app:layout_constraintStart_toStartOf="@+id/flHolder"
        app:layout_constraintTop_toTopOf="@+id/flHolder">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffffff"
            android:ellipsize="marquee"
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="5"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="#fff8a747"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="送  "/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:ellipsize="marquee"
                android:id="@+id/tvReceiver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="5"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</merge>
