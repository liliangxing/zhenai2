<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rlRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llPermissionPanel"
            android:background="@drawable/bg_permission_style_white"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="14dp"/>
            <ListView
                android:id="@+id/lvConcretePermission"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="30dp"
                android:divider="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tvSubmit"
                android:background="@drawable/bg_btn_style_zhenai"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="14dp"
                android:text="一键开启"
                android:lineSpacingMultiplier="1.1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivClose"
            android:background="@drawable/ic_close_style_zhenai"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="-13dp"
            android:layout_marginRight="-11dp"
            android:layout_alignTop="@+id/llPermissionPanel"
            android:layout_alignRight="@+id/llPermissionPanel"/>
    </RelativeLayout>
</merge>
