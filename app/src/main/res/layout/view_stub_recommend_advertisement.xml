<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/color_f2f4f5"
    app:cardCornerRadius="@dimen/dp15"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">
    <com.zhenai.common.widget.ScrollListenerBottomTopView
        android:id="@+id/scrollview"
        android:paddingBottom="52dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="800dp"
        android:overScrollMode="never">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/scrollview_container"
            android:paddingBottom="119dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.zhenai.common.widget.RoundImageView
                android:id="@+id/img_banner"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:src="@drawable/bg_0d26273c_16dp_top_radius_retangle"
                app:radius_left_up="16dp"
                app:radius_right_up="16dp"
                app:roundImageType="round"/>
            <RelativeLayout
                android:id="@+id/rl_top_card"
                android:background="@drawable/rect_white_r16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:layout_below="@+id/img_banner">
                <com.zhenai.common.widget.RoundImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/default_circle_avatar"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:maxLines="1"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@+id/iv_avatar"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_age"
                    android:background="@drawable/bg_fff5f5f5_rectangle_8r_shape"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="20dp"
                    android:layout_toRightOf="@+id/iv_marks"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/tv_nickname"/>
                <com.zhenai.common.widget.BoldTextView
                    android:textSize="20sp"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:layout_below="@+id/tv_nickname"
                    android:layout_marginStart="16sp"
                    android:layout_toEndOf="@+id/iv_avatar"/>
                <ImageView
                    android:id="@+id/iv_marks"
                    android:background="@drawable/icon_recommend_advertisement_top_marks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:background="#0d26273c"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="19.5dp"
                    android:layout_below="@+id/tv_title"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="22dp"/>
                <org.libpag.PAGView
                    android:id="@+id/pag_view"
                    android:layout_width="284dp"
                    android:layout_height="172dp"
                    android:layout_marginTop="36dp"
                    android:layout_below="@+id/tv_title"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_times"
                    android:background="@drawable/bg_ff6189_rectangle_18_radius"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="28dp"
                    android:text="@string/vip_advertisement_time"
                    android:drawablePadding="8dp"
                    android:layout_below="@+id/pag_view"
                    android:layout_centerHorizontal="true"
                    android:drawableStart="@drawable/icon_advertisement_time_start"
                    android:paddingStart="7dp"
                    android:paddingEnd="15dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_content_card"
                android:background="@drawable/rect_white_r16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/rl_top_card">
                <com.zhenai.common.widget.RoundImageView
                    android:id="@+id/iv_back_ground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:borderRadius="16dp"
                    app:roundImageType="round"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/behavior_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="66dp"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.zhenai.common.widget.ScrollListenerBottomTopView>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_buy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_55dp"
            android:layout_marginBottom="82dp"
            android:src="@drawable/bg_0d26273c_rectangle_27_radius"
            android:layout_below="@+id/rl_content_card"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
