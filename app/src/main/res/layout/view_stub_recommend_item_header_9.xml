<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.RoundRadioImageView
        android:id="@+id/img_background"
        android:background="@drawable/bg_b8bccc_r16_radius_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:height_weight="200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"
        app:width_weight="351"/>
    <com.zhenai.common.widget.RoundRadioImageView
        android:background="@drawable/bg_white_alpha_0_to_100_rectangle_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:height_weight="61"
        app:layout_constraintBottom_toBottomOf="@+id/img_background"
        app:layout_constraintStart_toStartOf="parent"
        app:radius_left_up="16dp"
        app:radius_right_up="16dp"
        app:roundImageType="round"
        app:width_weight="351"/>
    <View
        android:id="@+id/img_avatar_bg"
        android:background="@drawable/circle_white_shape"
        android:layout_width="@dimen/dp84"
        android:layout_height="@dimen/dp84"
        android:layout_marginTop="@dimen/dp68"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="@+id/img_background"
        app:layout_constraintTop_toTopOf="@+id/img_background"
        app:roundImageType="circle"/>
    <com.zhenai.common.widget.RoundImageView
        android:id="@+id/img_avatar"
        android:layout_width="@dimen/dp80"
        android:layout_height="@dimen/dp80"
        android:src="@drawable/default_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar_bg"
        app:layout_constraintEnd_toEndOf="@+id/img_avatar_bg"
        app:layout_constraintStart_toStartOf="@+id/img_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/img_avatar_bg"
        app:roundImageType="circle"/>
    <ImageView
        android:id="@+id/img_avatar_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar_bg"
        app:layout_constraintEnd_toEndOf="@+id/img_avatar_bg"
        app:layout_constraintStart_toStartOf="@+id/img_avatar_bg"/>
    <FrameLayout
        android:id="@+id/llLiveTip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar_bg"
        app:layout_constraintEnd_toEndOf="@+id/img_avatar_bg"
        app:layout_constraintStart_toStartOf="@+id/img_avatar_bg"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/flag_layout"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img_avatar_bg"
        app:layout_constraintTop_toTopOf="@+id/img_avatar"/>
    <com.zhenai.business.widget.FlagLayout
        android:id="@+id/flag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintEnd_toEndOf="@+id/img_background"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_13sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_content_info"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dimen_4dp"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dimen_4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp9"
        android:lines="1"
        android:layout_marginEnd="@dimen/dp10"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dimen_4dp"
        app:bg_colorNormal="@color/black_40"
        app:bg_radius="@dimen/dp5"
        app:bg_shape="round"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_online"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/online"
        android:drawableStart="@drawable/ic_profile_online_v9"
        android:paddingEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_get_location"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_profile_location_v9"
        app:layout_constraintBottom_toBottomOf="@+id/img_avatar"
        app:layout_constraintStart_toEndOf="@+id/tv_online"/>
    <com.zhenai.business.widget.label_layout.LabelLayout
        android:id="@+id/label_layout_header_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp32"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:auto_select_effect="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_avatar_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_change_background"
        android:background="@drawable/bg_profile_change_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:text="@string/profile_change_background"
        android:drawableEnd="@drawable/ic_profile_change_background_right_arrow"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_change_background_guide"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_profile_change_background_popup_tips"
        app:layout_constraintEnd_toEndOf="@+id/tv_change_background"
        app:layout_constraintTop_toBottomOf="@+id/tv_change_background"/>
    <TextView
        android:textSize="@dimen/dimen_16sp"
        android:textColor="#ff26273c"
        android:id="@+id/tv_special_user_tips"
        android:paddingBottom="@dimen/dimen_5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp46"
        android:layout_marginRight="@dimen/dp16"
        android:minHeight="400dp"
        android:lineSpacingExtra="8dp"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_background"/>
</merge>
