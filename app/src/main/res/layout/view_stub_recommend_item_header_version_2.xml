<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_avatar"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp15"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarIcon2"/>
    <com.zhenai.common.widget.RadioImageView
        android:id="@+id/ivAvatarIcon2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:height_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:width_weight="1"/>
    <ImageView
        android:id="@+id/superVipImage"
        android:visibility="gone"
        android:layout_width="@dimen/dp120"
        android:layout_height="@dimen/dp36"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/top_recommend_button"
        android:visibility="gone"
        android:layout_width="113dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/icon_top_recommend_ex"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarIcon2"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/top_recommend_anm"
        android:visibility="gone"
        android:layout_width="113dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:autoPlay="false"
        app:clearsAfterStop="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarIcon2"
        app:layout_constraintEnd_toEndOf="parent"
        app:loopCount="-1"
        app:source="top_recommend.svga"/>
    <ImageView
        android:id="@+id/img_new_member_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:src="@drawable/icon_recommend_label_new_member"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/llLiveTip"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/llLiveTip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintBottom_toTopOf="@+id/tv_get_location"
        app:layout_constraintStart_toStartOf="parent"/>
    <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
        android:textSize="@dimen/dimen_12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_get_location"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp3"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp15"
        android:drawableLeft="@drawable/ic_recommend_location"
        android:drawablePadding="@dimen/dp4"
        android:layout_marginStart="@dimen/dp20"
        app:bg_colorGradientEnd="#7026273c"
        app:bg_colorGradientStart="#7026273c"
        app:bg_fillMode="linearGradient"
        app:bg_radius="@dimen/dp16"
        app:bg_shape="round"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarIcon2"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_normal_info_content"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatarIcon2">
        <TextView
            android:textSize="21sp"
            android:textColor="@color/color_26273c"
            android:ellipsize="end"
            android:id="@+id/tvNickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp15"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/tvWatchRecentActiveTime"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_aeafb3"
            android:gravity="end"
            android:id="@+id/tvWatchRecentActiveTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:layout_marginStart="@dimen/dimen_3dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvNickName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvNickName"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_all_flag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNickName"
            app:layout_constraintTop_toBottomOf="@+id/tvNickName">
            <com.zhenai.business.widget.FlagLayout
                android:id="@+id/flagLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/tv_real_name_certification"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:src="@drawable/ic_already_real_name_identity_v8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_6c6d75"
            android:ellipsize="end"
            android:id="@+id/tvUserInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:lines="1"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNickName"
            app:layout_constraintTop_toBottomOf="@+id/layout_all_flag"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_aeafb3"
            android:ellipsize="end"
            android:id="@+id/tvIPContent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:lines="1"
            app:layout_constraintStart_toStartOf="@+id/tvNickName"
            app:layout_constraintTop_toBottomOf="@+id/tvUserInfo"/>
        <ImageView
            android:id="@+id/ivIPAbout"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_ip_address_about"
            android:layout_marginStart="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvIPContent"
            app:layout_constraintStart_toEndOf="@+id/tvIPContent"
            app:layout_constraintTop_toTopOf="@+id/tvIPContent"/>
        <TextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_aeafb3"
            android:ellipsize="end"
            android:id="@+id/tvContentInfo"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:lines="1"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIPAbout"
            app:layout_constraintTop_toBottomOf="@+id/tvUserInfo"/>
        <me.yintaibing.universaldrawable.view.UniversalDrawableTextView
            android:textSize="@dimen/dimen_14sp"
            android:textColor="@color/color_b25a29"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/interactiveTag"
            android:background="@drawable/bg_interactive_tag"
            android:paddingTop="@dimen/dp4"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:maxLines="1"
            android:drawableLeft="@drawable/ic_recommend_interactive"
            android:drawablePadding="@dimen/dp5"
            android:paddingStart="@dimen/dp5"
            android:paddingEnd="@dimen/dp12"
            android:layout_marginStart="@dimen/dimen_15dp"
            android:layout_marginEnd="@dimen/dimen_5dp"
            app:bg_colorNormal="@color/color_fff6de"
            app:bg_colorStroke="@color/color_ffe7a6"
            app:bg_fillMode="color"
            app:bg_radius="@dimen/dp18"
            app:bg_shape="round"
            app:bg_strokeMode="solid"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvContentInfo"
            app:layout_constraintVertical_bias="0"
            app:layout_goneMarginStart="@dimen/dp14"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/special_user_view_stub"
        android:layout="@layout/activity_other_profile_special_user_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatarIcon2"/>
</merge>
