<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTitle"
        android:text="@string/moments_tab_txt"
        android:layout_below="@+id/superVipImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/recommendProfile9TitleTextViewStyle"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff9395a4"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/tvMore"
        android:text="查看所有"
        android:drawablePadding="3dp"
        app:drawableEndCompat="@drawable/ic_recommend_right_arrow_v8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/recommendProfile9TitleRightViewStyle"/>
    <com.zhenai.common.widget.ReadMoreTextView
        android:textSize="@dimen/dimen_15sp"
        android:textColor="@color/color_26273C"
        android:id="@+id/tv_recommend_moment_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:lineSpacingExtra="2dp"
        app:foldText="更多"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:showMaxLine="3"
        app:tipClickable="false"
        app:tipColor="@color/color_aeafb3"
        app:tipGravity="0"/>
    <FrameLayout
        android:id="@+id/multiTypeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="-2dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_recommend_moment_content"/>
</merge>
