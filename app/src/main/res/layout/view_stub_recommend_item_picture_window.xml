<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pic_window_content"
        android:background="@drawable/rectangle_ffffff_radius_15"
        android:paddingTop="@dimen/dp23"
        android:paddingBottom="@dimen/dimen_32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.zhenai.common.widget.BoldTextView
            android:id="@+id/tvTitle"
            android:text="相册"
            android:layout_marginStart="@dimen/dimen_15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/recommendProfile8TitleTextViewStyle"/>
        <TextView
            android:gravity="end|center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tvMore"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="invisible"
            android:text="查看所有"
            android:drawablePadding="3dp"
            android:layout_marginEnd="15dp"
            android:paddingVertical="5dp"
            app:drawableEndCompat="@drawable/ic_recommend_right_arrow_v8"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"
            style="@style/recommendProfile8TitleRightViewStyle"/>
        <com.zhenai.profile.recommend.widget.RecommendPictureWindowLayout
            android:id="@+id/pic_window_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginStart="@dimen/dimen_13dp"
            android:layout_marginEnd="@dimen/dimen_13dp"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
