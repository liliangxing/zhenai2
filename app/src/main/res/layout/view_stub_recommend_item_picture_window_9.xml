<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zhenai.common.widget.BoldTextView
        android:id="@+id/tvTitle"
        android:text="相册"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/recommendProfile9TitleTextViewStyle"/>
    <TextView
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/tvMore"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="invisible"
        android:text="查看所有"
        android:drawablePadding="3dp"
        android:paddingVertical="5dp"
        app:drawableEndCompat="@drawable/ic_recommend_right_arrow_v8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/recommendProfile9TitleRightViewStyle"/>
    <com.zhenai.profile.recommend.widget.RecommendPictureWindowLayout
        android:id="@+id/pic_window_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginStart="-2dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
</merge>
