<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/dimen_50dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/recommend_youlian_bg"
        android:scaleType="fitStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/sv_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_youlian_card_content"
            android:paddingTop="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_hn_avatar"
                android:layout_width="@dimen/dimen_50dp"
                android:layout_height="@dimen/dimen_50dp"
                android:layout_marginStart="29dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/avatar_cover"
                android:layout_width="78.5dp"
                android:layout_height="49.5dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/recommend_youlian_avatar_cover"
                app:layout_constraintEnd_toEndOf="@+id/iv_hn_avatar"
                app:layout_constraintStart_toStartOf="@+id/iv_hn_avatar"
                app:layout_constraintTop_toTopOf="@+id/iv_hn_avatar"/>
            <ImageView
                android:id="@+id/mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/recommend_youlian_quotation_mark"
                app:layout_constraintStart_toEndOf="@+id/avatar_cover"
                app:layout_constraintTop_toTopOf="@+id/iv_hn_avatar"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/white"
                android:id="@+id/hn_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22.5dp"
                app:layout_constraintEnd_toEndOf="@+id/avatar_cover"
                app:layout_constraintStart_toStartOf="@+id/avatar_cover"
                app:layout_constraintTop_toTopOf="@+id/avatar_cover"/>
            <TextView
                android:textSize="@dimen/dimen_14sp"
                android:textColor="@color/white"
                android:id="@+id/tv_hn_say"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mark"
                app:layout_constraintTop_toBottomOf="@+id/mark"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/user_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="98.5dp"
                android:layout_marginBottom="@dimen/dimen_10dp"
                android:layout_marginStart="@dimen/dimen_20dp"
                android:layout_marginEnd="@dimen/dimen_20dp"
                app:cardCornerRadius="@dimen/dimen_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/youlian_root"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/iv_youlian_water_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/youlian_water_mark"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="21sp"
                        android:textColor="@color/color_2e2f33"
                        android:id="@+id/tv_nick_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_16dp"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dimen_14sp"
                        android:textColor="@color/color_2e2f33"
                        android:id="@+id/tv_user_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_nick_name"/>
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/user_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/dimen_16dp"
                        android:layout_marginTop="@dimen/dimen_16dp"
                        android:layout_marginRight="@dimen/dimen_16dp"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:layout_marginHorizontal="@dimen/dimen_16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintTop_toBottomOf="@+id/tv_user_info"/>
                    <TextView
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/btn_details"
                        android:background="@drawable/bg_7f57db_4dp_radius_retangle"
                        android:layout_width="200dp"
                        android:layout_height="46dp"
                        android:layout_marginBottom="@dimen/dimen_16dp"
                        android:text="@string/details"
                        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dimen_13sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_hn_said"
                        android:background="@drawable/bg_hongniang_say_btn_shape"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:maxLines="2"
                        android:paddingStart="@dimen/dimen_20dp"
                        android:paddingEnd="@dimen/dimen_20dp"
                        app:layout_constraintLeft_toLeftOf="@+id/user_avatar"
                        app:layout_constraintRight_toRightOf="@+id/user_avatar"
                        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/right_overlay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/recommend_profile_next_one_icon"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/network_error_view_stub"
        android:layout="@layout/default_loading_fail_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.cardview.widget.CardView>
