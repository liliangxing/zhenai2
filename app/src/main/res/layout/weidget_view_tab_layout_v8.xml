<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CutLineStyle"/>
    <FrameLayout
        android:id="@+id/tab_recommend_iv_layout"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_recommend_tv"
        app:layout_constraintEnd_toEndOf="@+id/tab_recommend_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_recommend_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_recommend_rb"
        app:layout_constraintVertical_chainStyle="packed">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tab_recommend_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tab_button_recommend_normal_v8"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_text_selector_v8"
        android:id="@+id/tab_recommend_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recommend_tab_txt"
        app:layout_constraintBottom_toBottomOf="@+id/tab_recommend_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_recommend_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_recommend_rb"
        app:layout_constraintTop_toBottomOf="@+id/tab_recommend_iv_layout"/>
    <ImageView
        android:id="@+id/recommend_red_dot_nonum"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/red_point_dimen"
        android:layout_height="@dimen/red_point_dimen"
        app:layout_constraintEnd_toEndOf="@+id/tab_recommend_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_recommend_iv_layout"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/recommend_red_dot_count"
        android:background="@drawable/reddot_with_num"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:minWidth="18dp"
        app:layout_constraintEnd_toEndOf="@+id/tab_recommend_iv_layout"
        app:layout_constraintStart_toEndOf="@+id/tab_recommend_iv_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tab_recommend_rb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/tab_live_rb"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/tab_live_iv_layout"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_live_tv"
        app:layout_constraintEnd_toEndOf="@+id/tab_live_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_live_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_live_rb"
        app:layout_constraintVertical_chainStyle="packed">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tab_live_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tab_button_live_video_normal_v8"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_text_selector_v8"
        android:id="@+id/tab_live_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_tab_txt"
        app:layout_constraintBottom_toBottomOf="@+id/tab_live_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_live_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_live_rb"
        app:layout_constraintTop_toBottomOf="@+id/tab_live_iv_layout"/>
    <ImageView
        android:id="@+id/live_red_dot_nonum"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/red_point_dimen"
        android:layout_height="@dimen/red_point_dimen"
        app:layout_constraintEnd_toEndOf="@+id/tab_live_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_live_iv_layout"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/live_red_dot_count"
        android:background="@drawable/reddot_with_num"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:minWidth="18dp"
        app:layout_constraintEnd_toEndOf="@+id/tab_live_iv_layout"
        app:layout_constraintStart_toEndOf="@+id/tab_live_iv_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tab_live_rb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/tab_found_rb"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tab_recommend_rb"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/tab_live_ad_img"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_live_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_live_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_live_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_live_rb"
        app:lottie_autoPlay="true"
        app:lottie_fileName="animation/live_tab_ad_animation.json"
        app:lottie_imageAssetsFolder="images/live_tab_ad_img"
        app:lottie_loop="true"
        app:lottie_repeatCount="1"/>
    <FrameLayout
        android:id="@+id/tab_found_iv_layout"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_found_tv"
        app:layout_constraintEnd_toEndOf="@+id/tab_found_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_found_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_found_rb"
        app:layout_constraintVertical_chainStyle="packed">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tab_found_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tab_button_moments_normal_v8"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_text_selector_v8"
        android:id="@+id/tab_found_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/moments_tab_txt"
        app:layout_constraintBottom_toBottomOf="@+id/tab_found_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_found_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_found_rb"
        app:layout_constraintTop_toBottomOf="@+id/tab_found_iv_layout"/>
    <ImageView
        android:id="@+id/found_red_dot_nonum"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/red_point_dimen"
        android:layout_height="@dimen/red_point_dimen"
        app:layout_constraintEnd_toEndOf="@+id/tab_found_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_found_iv_layout"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/found_red_dot_count"
        android:background="@drawable/reddot_with_num"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:minWidth="18dp"
        app:layout_constraintEnd_toEndOf="@+id/tab_found_iv_layout"
        app:layout_constraintStart_toEndOf="@+id/tab_found_iv_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tab_found_rb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/tab_message_rb"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tab_live_rb"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/tab_message_iv_layout"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_message_tv"
        app:layout_constraintEnd_toEndOf="@+id/tab_message_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_message_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_message_rb"
        app:layout_constraintVertical_chainStyle="packed">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tab_message_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tab_button_message_normal_v8"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_text_selector_v8"
        android:id="@+id/tab_message_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_tab_txt"
        app:layout_constraintBottom_toBottomOf="@+id/tab_message_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_message_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_message_rb"
        app:layout_constraintTop_toBottomOf="@+id/tab_message_iv_layout"/>
    <FrameLayout
        android:id="@+id/rl_tab_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tab_message_iv_layout"
        app:layout_constraintEnd_toEndOf="@+id/tab_message_iv_layout"
        app:layout_constraintStart_toStartOf="@+id/tab_message_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_message_iv_layout"/>
    <ImageView
        android:id="@+id/message_red_dot_nonum"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/red_point_dimen"
        android:layout_height="@dimen/red_point_dimen"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="@+id/tab_message_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_message_iv_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/message_red_dot_count"
        android:background="@drawable/reddot_with_num"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:minWidth="18dp"
        android:minHeight="@dimen/dimen_18dp"
        android:lines="1"
        app:autoSizeMaxTextSize="9sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/tab_message_iv_layout"
        app:layout_constraintStart_toEndOf="@+id/tab_message_iv_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tab_message_rb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/tab_my_rb"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tab_found_rb"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/tab_mine_iv_layout"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_mine_tv"
        app:layout_constraintEnd_toEndOf="@+id/tab_my_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_my_rb"
        app:layout_constraintTop_toTopOf="@+id/tab_my_rb"
        app:layout_constraintVertical_chainStyle="packed">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tab_mine_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/tab_button_mine_normal_v8"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/tab_text_selector_v8"
        android:id="@+id/tab_mine_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/me_tab_txt"
        app:layout_constraintBottom_toBottomOf="@+id/tab_my_rb"
        app:layout_constraintEnd_toEndOf="@+id/tab_my_rb"
        app:layout_constraintStart_toStartOf="@+id/tab_my_rb"
        app:layout_constraintTop_toBottomOf="@+id/tab_mine_iv_layout"/>
    <ImageView
        android:id="@+id/my_red_dot_nonum"
        android:background="@drawable/reddot_white_stroke"
        android:visibility="gone"
        android:layout_width="@dimen/red_point_dimen"
        android:layout_height="@dimen/red_point_dimen"
        app:layout_constraintEnd_toEndOf="@+id/tab_mine_iv_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_mine_iv_layout"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/my_red_dot_count"
        android:background="@drawable/reddot_with_num"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:minWidth="18dp"
        app:layout_constraintEnd_toEndOf="@+id/tab_mine_iv_layout"
        app:layout_constraintStart_toEndOf="@+id/tab_mine_iv_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tab_my_rb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tab_message_rb"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
