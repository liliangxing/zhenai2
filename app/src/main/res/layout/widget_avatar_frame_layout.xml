<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/frame_iv_avatar_stroke"
        android:background="@drawable/live_voice_circle_bg"
        android:visibility="gone"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/avatar"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/frame_iv_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/default_circle_avatar"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mask_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_live_video_circle_mask_gray"/>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center"
        android:id="@+id/frame_svga_img_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/frame_img_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
