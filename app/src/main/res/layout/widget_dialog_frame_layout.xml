<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY">
    <FrameLayout
        android:id="@+id/svga_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/dialog_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <com.opensource.svgaplayer.SVGAImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_frame_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/left_click_view"
        android:background="@color/transparent"
        android:layout_width="27dp"
        android:layout_height="113dp"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/right_click_view"
        android:background="@color/transparent"
        android:layout_width="27dp"
        android:layout_height="113dp"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/left_bottom_click_view"
        android:background="@color/transparent"
        android:layout_width="113dp"
        android:layout_height="27dp"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/right_bottom_click_view"
        android:background="@color/transparent"
        android:layout_width="113dp"
        android:layout_height="27dp"/>
</FrameLayout>
