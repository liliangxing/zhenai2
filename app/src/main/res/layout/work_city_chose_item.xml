<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/work_city_item_bg"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:paddingStart="8dp">
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:id="@+id/work_city_first_chose_tag"
        android:background="@drawable/work_city_first_chose_tag"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="首选"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/work_city_chose_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/work_city_chose_close"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff767dff"
        android:ellipsize="end"
        android:id="@+id/work_city_first_chose_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/work_city_chose_close"
        app:layout_constraintStart_toEndOf="@+id/work_city_first_chose_tag"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
