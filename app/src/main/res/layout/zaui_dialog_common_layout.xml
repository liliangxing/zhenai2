<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_dialog_content"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_image"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#42475c"
            android:gravity="center"
            android:id="@+id/tv_primary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#666978"
            android:gravity="center"
            android:id="@+id/tv_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/view_line"
            android:background="#ffd8d8d8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#afafaf"
            android:gravity="center"
            android:id="@+id/tv_third_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:id="@+id/btn_top"
            android:background="@android:color/darker_gray"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:id="@+id/btn_bottom"
            android:background="@android:color/darker_gray"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/borderlessButtonStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_left"
                android:background="@android:color/darker_gray"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/borderlessButtonStyle"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/vertical_view_line"
                android:background="#ffd8d8d8"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <Button
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_right"
                android:background="@android:color/darker_gray"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_out_top_img"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="5dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:layout_marginRight="-16dp"
        android:layout_alignTop="@+id/view_dialog_content"
        android:layout_alignRight="@+id/view_dialog_content"
        android:elevation="10dp"
        app:srcCompat="@drawable/ic_common_dialog_close_btn"/>
</RelativeLayout>
