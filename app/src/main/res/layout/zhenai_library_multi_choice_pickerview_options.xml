<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textColor="#42475c"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:drawableLeft="@drawable/info_card_title_left_image"
        android:drawablePadding="9dp"/>
    <View
        android:paddingLeft="18dp"
        style="@style/CutLineStyle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/multiChoiceLv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="match_parent"
        android:layout_height="74dp">
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:text="@string/picker_view_cancel"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="@style/CommonMiddleStrokeBtnStyle"/>
        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:text="@string/picker_view_submit"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="@style/CommonMiddleFullBtnStyle"/>
    </LinearLayout>
</LinearLayout>
