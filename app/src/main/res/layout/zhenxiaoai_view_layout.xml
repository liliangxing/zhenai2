<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_icon_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zhenai.business.business.zhenxiaoai.widget.ZhenxiaoaiIconView
        android:id="@+id/view_zhenxiaoai_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_bottom_space_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="80dp"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/guideline_init_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom_space_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:visibility="gone"
        android:layout_width="301dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_init_dialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_init_dialog">
        <ImageView
            android:id="@+id/img_dialog_bg"
            android:background="@drawable/zhenxiaoai_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ff26273c"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_dialog_bg"/>
        <ImageView
            android:id="@+id/ic_zhenxiaoai_with_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/zhenxiaoai_ic_with_dialog_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_dialog_content"
            android:background="@drawable/zhenxiaoai_dialog_content_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignItems="flex_end"
            app:flexDirection="column"
            app:flexWrap="nowrap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="366dp"
            app:layout_constraintHeight_min="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title">
            <TextView
                android:textSize="13sp"
                android:textColor="#ff26273c"
                android:id="@+id/tv_content"
                android:paddingLeft="8dp"
                android:paddingTop="15dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:visibility="visible"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_flexShrink="1"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_content"
                android:paddingLeft="8dp"
                android:paddingTop="12dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_flexShrink="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#ff767dff"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:id="@+id/tv_re_get_steam"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="再次生成"
                android:drawableStart="@drawable/zhenxiaoai_ic_reget_steam"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_content"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <TextView
            android:textColor="@color/color_767dff"
            android:gravity="center"
            android:id="@+id/tv_button_left"
            android:background="@drawable/bg_ebecff_rectangle_24_radius"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_button_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_dialog_content"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/zhenxiaoai_button_text_selector"
            android:gravity="center"
            android:id="@+id/tv_button_right"
            android:background="@drawable/zhenxiaoai_button_bg_selector"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_button_left"
            app:layout_constraintTop_toTopOf="@+id/tv_button_left"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#191c32"
            android:id="@+id/tv_bottom_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/zhenxiaoai_content_create_by_ai"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_button_left"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_protocol"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bottom_tips">
            <CheckBox
                android:id="@+id/checkbox_agree"
                android:background="@drawable/user_privacy_check_box_selector_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@null"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff707095"
                android:id="@+id/tv_protocol_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <View
            android:id="@+id/view_bottom_space"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_protocol"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
